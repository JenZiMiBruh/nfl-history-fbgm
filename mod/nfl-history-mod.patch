+const HEAD_Y = -0.02;
+const HEAD_Z = 0.0;
+const FACE_R = 0.58;
+const FACE_W = 0.86;
+const FACE_H = 0.9;
+const FACE_Y = -0.08;
+const FACE_Z = 0.6;
+const FACE_X0 = 0.19;
+const FACE_X1 = 0.81;
+const FACE_Y0 = 0.32;
