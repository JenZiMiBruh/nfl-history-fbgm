+// the player's number and that season's logo for the sleeves. Undefined outside NFL History leagues or without data,
+// so the face keeps facesjs's own jersey.
+import { getNflJersey, type NflJersey } from "../../common/nflJerseys.ts";
+import g from "./g.ts";
+import { idb } from "../db/index.ts";
+import type { Player } from "../../common/types.ts";
+import { getTeamInfoBySeason } from "./getTeamInfoBySeason.ts";
+
+export type FaceJerseyInfo = {
+	jersey: NflJersey;
+	number?: string;
+	logo?: string;
+};
+
+export const faceJerseyFor = async (
+	tid: number | undefined,
+	season: number,
+	number?: string,
+): Promise<FaceJerseyInfo | undefined> => {
+	if (
+		tid === undefined ||
+		tid < 0 ||
+		!Object.hasOwn(g, "nflRealDataLastSeason")
+	) {
+		return;
+	}
+	const jersey = getNflJersey(tid, season - 1);
+	if (!jersey) {
+		return;
+	}
+	const info = await getTeamInfoBySeason(tid, season);
+	return { jersey, number, logo: info?.imgURL ?? info?.imgURLSmall };
+};
+
+// The number a player wore for a team in a season (his last one that season), else his current one
+export const numberFor = (
+	p: {
+		jerseyNumber?: string;
+		stats?: { tid: number; season: number; jerseyNumber?: string }[];
+	},
+	tid: number,
+	season: number,
+) =>
+	p.stats?.findLast(
+		(row) =>
+			row.tid === tid &&
+			row.season === season &&
+			row.jerseyNumber !== undefined,
+	)?.jerseyNumber ?? p.jerseyNumber;
+
+// NFL history mod: who and when, so the face shows his age and that season's expression (common/faceAging.ts)
+export const faceAgingFor = (
+	p: { pid: number; born: { year: number } },
+	season: number,
+) => ({ seed: p.pid, age: season - p.born.year, season });
+
+// NFL history mod: the face for a season with that season's mood, -1 to 1: mostly his team's record (once it has played
+// a few games), then how his overall moved from the season before, plus a lift for that season's awards
+export const faceAgingWithMood = async (p: Player, season: number) => {
+	const base = faceAgingFor(p, season);
+	const clamp = (x: number) => Math.max(-1, Math.min(1, x));
+
+	const tid =
+		p.stats.findLast(
+			(row) => row.season === season && !row.playoffs && row.tid >= 0,
+		)?.tid ?? (season === g.get("season") && p.tid >= 0 ? p.tid : undefined);
+	let team = 0;
+	if (tid !== undefined) {
+		const ts = await idb.merged.teamSeasons.getByTidSeason(tid, season);
+		if (ts) {
+			const tied = ts.tied ?? 0;
+			const gp = ts.won + ts.lost + tied + (ts.otl ?? 0);
+			if (gp >= 3) {
+				team = clamp(((ts.won + 0.5 * tied) / gp - 0.5) * 2.5);
+			}
+		}
+	}
+
+	const now = p.ratings.findLast((row) => row.season === season);
+	const before = p.ratings.findLast((row) => row.season === season - 1);
+	const own = now && before ? clamp((now.ovr - before.ovr) / 8) : 0;
+
+	const awards = p.awards.filter((award) => award.season === season);
+	const big = awards.some((award) =>
+		/most valuable|champion|super bowl|of the year/i.test(award.type ?? ""),
+	);
+	const award = big ? 0.5 : awards.length > 0 ? 0.25 : 0;
+
+	return { ...base, mood: clamp(0.6 * team + 0.4 * own + award) };
+};
