+// ---------- LI on: the trophy standing in the numerals ----------
+// painters for city art inside the numerals (also used by generated games), drawn into the box x0..x1, y0..y1
+type Painter = (p: string, x0: number, y0: number, x1: number, y1: number) => string;
+
+const band = (x0: number, x1: number, y: number, h: number, c: string) => `<rect x='${x0}' y='${y}' width='${x1 - x0}' height='${h}' fill='${c}'/>`;
+const palm = (x: number, y: number, h: number, c: string) =>
+	`<path d='M${x} ${y} Q${x + 3} ${y - h * 0.5} ${x + 1} ${y - h}' stroke='${c}' stroke-width='${(h * 0.06).toFixed(1)}' fill='none'/>` +
+	[-150, -120, -60, -30, -95].map((a) => {
+		const r = (a * Math.PI) / 180;
+		return `<path d='M${x + 1} ${y - h} Q${(x + 1 + Math.cos(r) * h * 0.25).toFixed(1)} ${(y - h + Math.sin(r) * h * 0.25 - 4).toFixed(1)} ${(x + 1 + Math.cos(r) * h * 0.45).toFixed(1)} ${(y - h + Math.sin(r) * h * 0.45 + h * 0.12).toFixed(1)}' stroke='${c}' stroke-width='${(h * 0.05).toFixed(1)}' fill='none'/>`;
+	}).join("");
+
+const PAINT: Record<string, Painter> = {
+	// Los Angeles / Inglewood: sunset bands, sun rays, palms
+	sunset: (p, x0, y0, x1, y1) => {
+		const h = y1 - y0;
+		return (
+			`<defs>${lin(`${p}su`, ["#E8364A", "#F25A3C", "#F7894A", "#F9B25E"])}</defs><rect x='${x0}' y='${y0}' width='${x1 - x0}' height='${h}' fill='url(#${p}su)'/>` +
+			[0.2, 0.42, 0.62, 0.8].map((k, i) => band(x0, x1, y0 + h * k, 2 + i, "#FFFFFF33")).join("") +
+			[0.12, 0.3, 0.55, 0.78, 0.92].map((k, i) => palm(x0 + (x1 - x0) * k, y1, h * (0.55 + (i % 2) * 0.2), "#8E1E3A")).join("")
+		);
+	},
+	// Glendale / Arizona: desert facets in teal, magenta and violet, with saguaros
+	desert: (p, x0, y0, x1, y1) => {
+		const w = x1 - x0;
+		const h = y1 - y0;
+		const cols = ["#2BB3A0", "#D6336C", "#6B3FA0", "#F25A3C", "#1B8C8C", "#B83280"];
+		let out = `<rect x='${x0}' y='${y0}' width='${w}' height='${h}' fill='#2BB3A0'/>`;
+		for (let i = 0; i < 9; i++) {
+			const a = x0 + (w * i) / 8;
+			out += `<polygon points='${a - 20},${y1} ${a + 14},${y0 + h * (0.15 + (i % 3) * 0.2)} ${a + 44},${y1}' fill='${cols[i % cols.length]}' opacity='0.9'/>`;
+		}
+		const cactus = (x: number) => `<path d='M${x} ${y1} V${y0 + h * 0.4} M${x} ${y0 + h * 0.65} H${x - 8} V${y0 + h * 0.5} M${x} ${y0 + h * 0.58} H${x + 8} V${y0 + h * 0.45}' stroke='#14524A' stroke-width='5' stroke-linecap='round' fill='none'/>`;
+		return out + cactus(x0 + w * 0.3) + cactus(x0 + w * 0.82);
+	},
+	// Las Vegas: violet night, towers and neon lines
+	neon: (p, x0, y0, x1, y1) => {
+		const w = x1 - x0;
+		const h = y1 - y0;
+		let out = `<defs>${lin(`${p}nv`, ["#4A2380", "#7B4BC4", "#C060D8"])}</defs><rect x='${x0}' y='${y0}' width='${w}' height='${h}' fill='url(#${p}nv)'/>`;
+		for (let i = 0; i < 12; i++) {
+			const bx = x0 + (w * i) / 12;
+			const bh = h * (0.35 + ((i * 37) % 11) / 18);
+			out += `<rect x='${bx.toFixed(1)}' y='${(y1 - bh).toFixed(1)}' width='${(w / 13).toFixed(1)}' height='${bh.toFixed(1)}' fill='#9A70D0' opacity='0.8'/>`;
+			out += `<rect x='${(bx + 3).toFixed(1)}' y='${(y1 - bh + 6).toFixed(1)}' width='2' height='${(bh - 10).toFixed(1)}' fill='#F2D0FF' opacity='0.6'/>`;
+		}
+		return out + band(x0, x1, y0 + h * 0.3, 2, "#FF4FD8") + band(x0, x1, y0 + h * 0.36, 1.5, "#4FE3FF");
+	},
+	// New Orleans: red with gold ironwork scrolls
+	filigree: (p, x0, y0, x1, y1) => {
+		const w = x1 - x0;
+		const h = y1 - y0;
+		let out = `<rect x='${x0}' y='${y0}' width='${w}' height='${h}' fill='#C8102E'/>`;
+		for (let i = 0; i < 7; i++) {
