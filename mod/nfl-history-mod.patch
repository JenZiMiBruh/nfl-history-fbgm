+// NFL history mod: the live game seen from high above, like a broadcast blimp shot (and like Basketball GM's
+// overhead court). The field is painted for the home team, the stands are full of generated fans in the home colors,
+// and every player is a round token with his face (Football GM's cartoon) in his team's uniform, his number, and his
+// name when he's in the play. It draws the same frames as the 3D view (NflField3D.tsx), on a plain 2D canvas, so it
+// stays smooth on phones.
+import { useEffect, useMemo, useRef, useState } from "react";
+import { generate } from "facesjs";
+import {
+	cartoonFace,
+	fieldTexture,
+	loadImage,
+	refFace,
+	shade,
+	type Frame3D,
+	type Setup3D,
+} from "./NflField3D.tsx";
+import { nflUniformFor } from "../../../common/nflUniforms.ts";
+
+const W = 120;
+const H = 53.3;
+const PX = 24; // world canvas pixels per yard (the field texture's scale)
+const SIDE = 11; // yards of sideline, bench area and stands beyond each sideline
+const END = 9; // and beyond each end line
+const VIEW = 38; // yards of field across the screen
+
+// ---- The stadium around the field: sideline apron, benches, and rows of fans ----
+const buildStadium = (
+	setup: Setup3D,
+	fieldImg: HTMLCanvasElement,
+	fans: HTMLImageElement[],
+) => {
+	const c = document.createElement("canvas");
+	c.width = Math.round((W + END * 2) * PX);
+	c.height = Math.round((H + SIDE * 2) * PX);
+	const g = c.getContext("2d")!;
+	const home = setup.teams[0]!;
+	const P = home.colors[0] ?? "#334155";
+	const S = home.colors[1] ?? "#ffffff";
+	// Concrete bowl, darker toward the back
+	const bowl = g.createRadialGradient(
+		c.width / 2,
+		c.height / 2,
+		c.height * 0.3,
+		c.width / 2,
+		c.height / 2,
+		c.width * 0.6,
+	);
+	bowl.addColorStop(0, "#3b4250");
+	bowl.addColorStop(1, "#171a21");
+	g.fillStyle = bowl;
+	g.fillRect(0, 0, c.width, c.height);
+	// Field surround: the turf runs a few yards past the lines, with a painted border in the home color
+	const fx = END * PX;
+	const fy = SIDE * PX;
+	g.fillStyle = setup.indoors ? "#2f6f3a" : "#2e7d32";
+	g.fillRect(fx - 4 * PX, fy - 4.5 * PX, (W + 8) * PX, (H + 9) * PX);
+	g.fillStyle = shade(P, -0.15);
+	g.fillRect(fx - 0.9 * PX, fy - 0.9 * PX, (W + 1.8) * PX, 0.9 * PX);
+	g.fillRect(fx - 0.9 * PX, fy + H * PX, (W + 1.8) * PX, 0.9 * PX);
+	g.drawImage(fieldImg, fx, fy, W * PX, H * PX);
+	// Team benches on the far sideline: home on the left of midfield, away on the right
+	const bench = (x0: number, col: string) => {
+		g.fillStyle = shade(col, -0.25);
+		g.fillRect((x0 + END) * PX, fy - 3.6 * PX, 26 * PX, 1.1 * PX);
+		g.fillStyle = "rgba(255,255,255,.18)";
+		for (let i = 0; i < 26; i += 2)
+			g.fillRect((x0 + END + i + 0.3) * PX, fy - 3.4 * PX, 1.3 * PX, 0.7 * PX);
+	};
+	bench(31, P);
+	bench(63, setup.teams[1]?.colors[0] ?? "#475569");
+	// Stands: rows of seats in the home colors, a fan in most of them
+	const rowGap = 1.55;
+	const seatGap = 1.35;
+	let k = 0;
+	const seatRow = (
+		x0: number,
+		y0: number,
+		len: number,
+		horizontal: boolean,
+		rows: number,
+		outward: number,
+	) => {
+		for (let r = 0; r < rows; r++) {
+			const off = r * rowGap * outward;
+			const n = Math.floor(len / seatGap);
+			// The row's seats
+			g.fillStyle = r % 2 ? shade(P, -0.35) : shade(P, -0.5);
+			if (horizontal)
+				g.fillRect(
+					x0 * PX,
+					(y0 + off - (outward < 0 ? rowGap : 0)) * PX,
+					len * PX,
+					rowGap * PX,
+				);
+			else
+				g.fillRect(
+					(x0 + off - (outward < 0 ? rowGap : 0)) * PX,
+					y0 * PX,
+					rowGap * PX,
+					len * PX,
+				);
+			for (let i = 0; i < n; i++) {
+				k++;
+				const pseudo = Math.sin(k * 12.9898) * 43758.5453;
+				const rnd = pseudo - Math.floor(pseudo);
+				if (rnd < 0.12 || fans.length === 0) continue; // an empty seat
+				const fan = fans[k % fans.length]!;
+				const size = 1.45 * PX;
+				const cx = horizontal
+					? (x0 + i * seatGap + seatGap / 2) * PX
+					: (x0 + off + (outward < 0 ? -rowGap / 2 : rowGap / 2)) * PX;
+				const cy = horizontal
+					? (y0 + off + (outward < 0 ? -rowGap / 2 : rowGap / 2)) * PX
+					: (y0 + i * seatGap + seatGap / 2) * PX;
+				const sw = fan.naturalWidth || 400;
+				const sh = fan.naturalHeight || 600;
+				// Head and shoulders of the bust
+				g.drawImage(
+					fan,
+					sw * 0.05,
+					sh * 0.02,
+					sw * 0.9,
+					sw * 0.9,
+					cx - size / 2,
+					cy - size / 2,
+					size,
+					size,
+				);
+			}
+		}
+	};
+	const rows = 4;
+	// Near and far sides (the far side is above the field), then the two ends
+	seatRow(END - 4, SIDE - 5.6, W + 8, true, rows, -1);
+	seatRow(END - 4, SIDE + H + 5.6, W + 8, true, rows, 1);
+	seatRow(END - 4.6, SIDE - 4, H + 8, false, rows - 1, -1);
+	seatRow(END + W + 4.6, SIDE - 4, H + 8, false, rows - 1, 1);
+	// Sponsor boards along the near sideline
+	const ads = [
+		"BLITZ COLA",
+		"ENDZONE AUTO",
+		"HUDDLE MOBILE",
+		"PIGSKIN PIZZA",
+		"AUDIBLE INSURANCE",
+		"HAIL MARY COFFEE",
+	];
+	g.font = `900 ${Math.round(0.9 * PX)}px "Arial Black", Arial, sans-serif`;
+	g.textAlign = "center";
+	g.textBaseline = "middle";
+	for (let i = 0; i < 6; i++) {
+		const x = (END + 6 + i * 19.5) * PX;
+		const y = (SIDE + H + 4.6) * PX;
+		g.fillStyle = i % 2 ? "#0f172a" : shade(P, -0.3);
+		g.fillRect(x, y - 0.6 * PX, 17 * PX, 1.2 * PX);
+		g.fillStyle = i % 2 ? S : "#ffffff";
+		g.fillText(ads[i]!, x + 8.5 * PX, y);
+	}
+	return c;
+};
+
+// ---- A player's token: the face in a circle ringed in the team color, the number on a badge ----
+const TOKEN = 128;
+type TokenOpts = {
+	colors: string[];
+	jersey?: string;
+	num?: string;
+	face?: HTMLImageElement;
+	ref?: boolean;
+	helmetOnly?: boolean;
+	logo?: HTMLImageElement;
+	helmetColor?: string;
+};
+const drawToken = (o: TokenOpts) => {
+	const c = document.createElement("canvas");
+	c.width = TOKEN;
+	c.height = TOKEN;
+	const g = c.getContext("2d")!;
+	const r = TOKEN / 2 - 6;
+	const cx = TOKEN / 2;
+	const cy = TOKEN / 2;
+	const ring = o.ref ? "#111111" : (o.jersey ?? o.colors[0] ?? "#334155");
+	// Base: jersey color disc (refs: stripes)
+	g.save();
+	g.beginPath();
+	g.arc(cx, cy, r, 0, Math.PI * 2);
+	g.clip();
+	if (o.ref) {
+		g.fillStyle = "#ffffff";
+		g.fillRect(0, 0, TOKEN, TOKEN);
+		g.fillStyle = "#111111";
+		for (let x = 0; x < TOKEN; x += 16) g.fillRect(x, 0, 8, TOKEN);
+	} else {
+		const bg = g.createLinearGradient(0, 0, 0, TOKEN);
+		bg.addColorStop(0, shade(ring, 0.2));
+		bg.addColorStop(1, shade(ring, -0.25));
+		g.fillStyle = bg;
+		g.fillRect(0, 0, TOKEN, TOKEN);
+	}
+	if (o.helmetOnly && !o.ref) {
+		// Helmet seen from above: the shell, a center stripe, the logo
+		const hc = o.helmetColor ?? o.colors[0] ?? "#334155";
+		const hg = g.createRadialGradient(
+			cx - r * 0.25,
+			cy - r * 0.3,
+			r * 0.1,
+			cx,
+			cy,
+			r * 0.9,
+		);
+		hg.addColorStop(0, shade(hc, 0.4));
+		hg.addColorStop(1, shade(hc, -0.35));
+		g.fillStyle = hg;
+		g.beginPath();
+		g.ellipse(cx, cy, r * 0.72, r * 0.82, 0, 0, Math.PI * 2);
+		g.fill();
+		g.fillStyle = o.colors[1] ?? "#ffffff";
+		g.fillRect(cx - 4, cy - r * 0.82, 8, r * 1.64);
+		if (o.logo && o.logo.naturalWidth) {
+			const lw = r * 0.7;
+			const lh = (lw * o.logo.naturalHeight) / o.logo.naturalWidth;
+			g.drawImage(o.logo, cx - lw / 2, cy - lh / 2, lw, lh);
+		}
+	} else if (o.face) {
+		// Head and shoulders (in the team's jersey, drawn by the face library)
+		const sw = o.face.naturalWidth || 400;
+		const sh = o.face.naturalHeight || 600;
+		// The whole head (top of the hair to the chin) plus the collar, filling the circle top to bottom
+		const cw = sw * 0.84;
+		const ch = sh * 0.8;
+		const dh = r * 2.25;
+		const dw = (dh * cw) / ch;
+		g.drawImage(
+			o.face,
+			(sw - cw) / 2,
+			sh * 0.03,
+			cw,
+			ch,
+			cx - dw / 2,
+			cy - r * 1.08,
+			dw,
+			dh,
+		);
+	}
+	g.restore();
+	// Ring
+	g.lineWidth = 7;
+	g.strokeStyle = o.ref ? "#111111" : shade(ring, -0.35);
+	g.beginPath();
+	g.arc(cx, cy, r, 0, Math.PI * 2);
+	g.stroke();
+	g.lineWidth = 3;
+	g.strokeStyle = o.ref ? "#ffffff" : (o.colors[1] ?? "#ffffff");
+	g.beginPath();
+	g.arc(cx, cy, r - 5, 0, Math.PI * 2);
+	g.stroke();
+	// Number badge
+	if (o.num && !o.ref) {
+		const br = 21;
+		const bx = cx + r * 0.68;
+		const by = cy + r * 0.68;
+		g.fillStyle = o.colors[1] ?? "#ffffff";
+		g.beginPath();
+		g.arc(bx, by, br, 0, Math.PI * 2);
+		g.fill();
+		g.lineWidth = 3;
+		g.strokeStyle = shade(ring, -0.4);
+		g.stroke();
+		g.fillStyle = ring;
+		g.font = `900 ${o.num.length > 1 ? 22 : 26}px "Arial Black", Arial, sans-serif`;
+		g.textAlign = "center";
+		g.textBaseline = "middle";
+		g.fillText(o.num, bx, by + 1);
+	}
+	return c;
+};
+
+export const NflFieldTop = ({
+	setup,
+	frame,
+}: {
+	setup: Setup3D;
+	frame: Frame3D;
+}) => {
+	const cnv = useRef<HTMLCanvasElement>(null);
+	const wrap = useRef<HTMLDivElement>(null);
+	const [stadium, setStadium] = useState<HTMLCanvasElement | undefined>();
+	const tokens = useRef(
+		new Map<string, { sig: string; img: HTMLCanvasElement; ready: boolean }>(),
+	);
+	const cam = useRef<{ x: number; y: number } | undefined>(undefined);
+	const logos = useRef(new Map<string, HTMLImageElement | undefined>());
+	const [, bump] = useState(0);
+
+	const homeColors = setup.teams[0]?.colors.join(",");
+	// The stadium: field (with the home logo), then fans once their faces are drawn
+	useEffect(() => {
+		let cancelled = false;
+		const go = async () => {
+			const logo = setup.homeLogo ? await loadImage(setup.homeLogo) : undefined;
+			const field = fieldTexture(setup, logo).image as HTMLCanvasElement;
+			if (cancelled) return;
+			setStadium(buildStadium(setup, field, []));
+			const colors = setup.teams[0]?.colors ?? ["#334155", "#ffffff"];
+			const alt = setup.teams[1]?.colors ?? colors;
+			const fans: HTMLImageElement[] = [];
+			for (let i = 0; i < 40; i++) {
+				// Most fans wear the home colors; a few came for the visitors
+				const away = i % 9 === 4;
+				const img = await cartoonFace(
+					-5000 - i,
+					generate(undefined, {
+						gender: i % 3 === 0 ? "female" : "male",
+					} as any),
+					away ? alt : colors,
+					"football",
+					true,
+				);
+				if (img) fans.push(img);
+				if (cancelled) return;
+			}
+			setStadium(buildStadium(setup, field, fans));
+		};
+		void go();
+		return () => {
+			cancelled = true;
+		};
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, [setup.homeLogo, homeColors, setup.indoors, setup.stadium]);
+
+	const logoFor = (url?: string) => {
+		if (!url) return undefined;
+		if (!logos.current.has(url)) {
+			logos.current.set(url, undefined);
+			void loadImage(url).then((img) => {
+				logos.current.set(url, img);
+				bump((x) => x + 1);
+			});
+		}
+		return logos.current.get(url);
+	};
+
+	// A token for each player, drawn once (again when his face or the logo arrives)
+	const tokenFor = (a: Frame3D["actors"][number]) => {
+		const team = setup.teams[a.team];
+		const cols = team?.colors ?? ["#334155", "#ffffff"];
+		const uni = a.ref ? undefined : nflUniformFor(team?.abbrev, cols);
+		const side = uni ? (a.away ? uni.road : uni.home) : undefined;
+		const helmetOnly = setup.style === "helmets";
+		const logo = helmetOnly ? logoFor(team?.logo) : undefined;
+		const sig = `${a.team}|${a.away}|${a.num}|${a.pid}|${a.ref ? 1 : 0}|${setup.style}|${cols.join(",")}|${logo ? 1 : 0}`;
+		const have = tokens.current.get(a.key);
+		if (have && have.sig === sig) return have.img;
+		const jersey = side?.jersey ?? (a.away ? "#f8fafc" : cols[0]);
+		const colorsFor = side
+			? [
+					side.jersey ?? cols[0]!,
+					side.num ?? cols[1] ?? "#ffffff",
+					cols[2] ?? "#000000",
+				]
+			: a.away
+				? ["#f8fafc", cols[0] ?? "#334155", cols[1] ?? "#000000"]
+				: cols;
+		const entry = {
+			sig,
+			img: drawToken({
+				colors: colorsFor,
+				jersey,
+				num: a.num,
+				ref: a.ref,
+				helmetOnly,
+				logo,
+				helmetColor: uni?.helmet,
+			}),
+			ready: false,
+		};
+		tokens.current.set(a.key, entry);
+		const faceInfo = a.pid !== undefined ? setup.faces.get(a.pid) : undefined;
+		const face = a.ref ? refFace(a.key) : faceInfo?.face;
+		if (face && !helmetOnly) {
+			const idx = Number(a.key.replace(/[^0-9]/g, "")) || 0;
+			void cartoonFace(
+				a.ref ? -100 - idx : a.pid!,
+				face,
+				a.ref ? ["#111111", "#ffffff", "#111111"] : colorsFor,
+				a.ref ? "football" : (faceInfo?.jersey ?? "football"),
+			).then((img) => {
+				const cur = tokens.current.get(a.key);
+				if (!img || !cur || cur.sig !== sig) return;
+				cur.img = drawToken({
+					colors: colorsFor,
+					jersey,
+					num: a.num,
+					ref: a.ref,
+					face: img,
+				});
+				cur.ready = true;
+			});
+		}
+		return entry.img;
+	};
+
+	// Draw this frame
+	useEffect(() => {
+		const el = cnv.current;
+		const box = wrap.current;
+		if (!el || !box) return;
+		const w = box.clientWidth;
+		const h = box.clientHeight;
+		const dpr = Math.min(2, window.devicePixelRatio || 1);
+		if (el.width !== Math.round(w * dpr) || el.height !== Math.round(h * dpr)) {
+			el.width = Math.round(w * dpr);
+			el.height = Math.round(h * dpr);
+		}
+		const g = el.getContext("2d")!;
+		g.setTransform(dpr, 0, 0, dpr, 0, 0);
+		g.fillStyle = "#0b1220";
+		g.fillRect(0, 0, w, h);
+		// Camera: follows the play, eased; kicks and the coin toss show more of the field
+		const zoomOut = frame.kickCam
+			? 1.25
+			: Math.max(1, 2 / Math.max(1, frame.camZoom));
+		const viewW = VIEW * zoomOut;
+		const s = w / viewW; // screen pixels per yard
+		const viewH = h / s;
+		const want = {
+			x: frame.camX,
+			y: frame.ball.visible ? frame.ball.y : H / 2,
+		};
+		const cur = cam.current ?? want;
+		cur.x += (want.x - cur.x) * 0.12;
+		cur.y += (want.y - cur.y) * 0.08;
+		cur.x = Math.max(-END + viewW / 2, Math.min(W + END - viewW / 2, cur.x));
+		cur.y = Math.max(-SIDE + viewH / 2, Math.min(H + SIDE - viewH / 2, cur.y));
+		cam.current = cur;
+		const sx = (x: number) => (x - cur.x) * s + w / 2;
+		const sy = (y: number) => (y - cur.y) * s + h / 2;
+		// Stadium and field
+		if (stadium) {
+			g.imageSmoothingQuality = "high";
+			g.drawImage(
+				stadium,
+				(cur.x - viewW / 2 + END) * PX,
+				(cur.y - viewH / 2 + SIDE) * PX,
+				viewW * PX,
+				viewH * PX,
+				0,
+				0,
+				w,
+				h,
+			);
+		}
+		// Line of scrimmage and line to gain
+		const line = (x: number | undefined, col: string) => {
+			if (x === undefined) return;
+			g.fillStyle = col;
+			g.fillRect(sx(x) - 0.15 * s, sy(0), 0.3 * s, H * s);
+		};
+		line(frame.los, "rgba(37,99,235,.9)");
+		line(frame.fd, "rgba(250,204,21,.95)");
+		// Players: shadow, token, name tag
+		const R = 1.45; // token radius in yards
+		const actors = [...frame.actors].sort((a, b) => a.y - b.y);
+		for (const a of actors) {
+			const x = sx(a.x);
+			const y = sy(a.y);
+			const rad = R * s * (a.kneel ? 0.92 : 1);
+			g.fillStyle = "rgba(0,0,0,.35)";
+			g.beginPath();
+			g.ellipse(
+				x + rad * 0.18,
+				y + rad * 0.28,
+				rad * 0.98,
+				rad * 0.9,
+				0,
+				0,
+				Math.PI * 2,
+			);
+			g.fill();
+			if (a.holding) {
+				g.fillStyle = "rgba(250,204,21,.55)";
+				g.beginPath();
+				g.arc(x, y, rad * 1.32, 0, Math.PI * 2);
+				g.fill();
+			}
+			g.drawImage(tokenFor(a), x - rad, y - rad, rad * 2, rad * 2);
+		}
+		// Name tags on top of everyone
+		g.font = `800 ${Math.max(10, Math.round(0.62 * s))}px system-ui, sans-serif`;
+		g.textAlign = "center";
+		g.textBaseline = "middle";
+		for (const a of actors) {
+			if (!a.tag || !a.name) continue;
+			const label = a.name.split(" ").slice(-1)[0]!;
+			const tw = g.measureText(label).width + 10;
+			const x = sx(a.x);
+			const y = sy(a.y) + R * s + 0.55 * s;
+			const team = setup.teams[a.team];
+			g.fillStyle = a.holding ? "#facc15" : "rgba(15,23,42,.88)";
+			g.beginPath();
+			g.roundRect(x - tw / 2, y - 0.45 * s, tw, 0.9 * s, 0.45 * s);
+			g.fill();
+			g.strokeStyle = team?.colors[0] ?? "#ffffff";
+			g.lineWidth = 1.5;
+			g.stroke();
+			g.fillStyle = a.holding ? "#111111" : "#ffffff";
+			g.fillText(label, x, y + 0.5);
+		}
+		// The ball: grows and its shadow drifts as it goes up; spins in flight
+		if (frame.ball.visible) {
+			const bx = sx(frame.ball.x);
+			const by = sy(frame.ball.y);
+			const up = frame.ball.z;
+			const k = 1 + up * 0.05;
+			g.fillStyle = "rgba(0,0,0,.35)";
+			g.beginPath();
+			g.ellipse(
+				bx + up * 0.12 * s,
+				by + up * 0.2 * s,
+				0.45 * s,
+				0.25 * s,
+				0,
+				0,
+				Math.PI * 2,
+			);
+			g.fill();
+			const ang =
+				frame.ball.dx || frame.ball.dy
+					? Math.atan2(frame.ball.dy ?? 0, frame.ball.dx ?? 0)
+					: 0;
+			g.save();
+			g.translate(bx, by - up * 0.25 * s);
+			g.rotate(frame.ball.mode === "flip" ? frame.ball.spin : ang);
+			const bw = 0.55 * s * k;
+			const bh =
+				(frame.ball.mode === "spiral"
+					? 0.32 + 0.04 * Math.sin(frame.ball.spin * 3)
+					: 0.32) *
+				s *
+				k;
+			g.fillStyle = "#7a3b12";
+			g.beginPath();
+			g.ellipse(0, 0, bw, bh, 0, 0, Math.PI * 2);
+			g.fill();
+			g.strokeStyle = "#ffffff";
+			g.lineWidth = Math.max(1, 0.06 * s);
+			g.beginPath();
+			g.moveTo(-bw * 0.35, 0);
+			g.lineTo(bw * 0.35, 0);
+			g.stroke();
+			g.restore();
+		}
+		// Coin toss: a gold coin flipping above the referee
+		if (frame.coin) {
+			const cx = sx(frame.coin.x);
+			const cy = sy(frame.coin.y) - frame.coin.z * 0.6 * s;
+			g.fillStyle = "#fbbf24";
+			g.strokeStyle = "#92400e";
+			g.lineWidth = 2;
+			g.beginPath();
+			g.ellipse(
+				cx,
+				cy,
+				0.6 * s,
+				0.6 * s * Math.max(0.12, Math.abs(Math.cos(frame.coin.flip))),
+				0,
+				0,
+				Math.PI * 2,
+			);
+			g.fill();
+			g.stroke();
+		}
+		// Flag
+		if (frame.flag) {
+			g.fillStyle = "#facc15";
+			g.beginPath();
+			g.arc(sx(frame.flag.x), sy(frame.flag.y), 0.45 * s, 0, Math.PI * 2);
+			g.fill();
+		}
+		// Callouts: a white bubble over the play; the kick result big in the middle
+		const bubble = (
+			text: string,
+			x: number,
+			y: number,
+			big = false,
+			good = true,
+		) => {
+			g.font = `900 ${Math.round((big ? 1.5 : 0.85) * s)}px system-ui, sans-serif`;
+			const tw = g.measureText(text).width + (big ? 30 : 18);
+			const bh = (big ? 2.4 : 1.5) * s;
+			g.fillStyle = big
+				? good
+					? "#16a34a"
+					: "#dc2626"
+				: "rgba(255,255,255,.96)";
+			g.beginPath();
+			g.roundRect(x - tw / 2, y - bh / 2, tw, bh, bh / 2);
+			g.fill();
+			g.fillStyle = big ? "#ffffff" : "#0f172a";
+			g.fillText(text, x, y + 1);
+		};
+		if (frame.callout)
+			bubble(
+				frame.callout.text,
+				Math.min(w - 120, Math.max(120, sx(frame.callout.x))),
+				Math.max(30, sy(frame.callout.y) - 3.2 * s),
+			);
+		if (frame.result)
+			bubble(frame.result.text, w / 2, h * 0.3, true, frame.result.good);
+	});
+
+	return (
+		<div
+			ref={wrap}
+			style={{
+				position: "relative",
+				width: "100%",
+				aspectRatio: "16 / 9",
+				background: "#0b1220",
+			}}
+		>
+			<canvas
+				ref={cnv}
+				style={{ display: "block", width: "100%", height: "100%" }}
+			/>
+		</div>
+	);
+};
