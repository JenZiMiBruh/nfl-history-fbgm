+// NFL history mod: the real NFL calendar for every game. Dates, kickoff times, TV slots (Monday Night Football,
+// Sunday Night Football, Thursday Night Football, Thanksgiving, Christmas), stadium, roof and weather.
+//
+// Seasons with real data (1966 through the current one) use the real date, time and weather of each game, read
+// from /nfl/game_info.json (made by build_game_info.js in the NFL History project). Kickoff times before 1999 and
+// anything the data lacks are filled in by the rules the NFL used in that era. Seasons after the real data get a
+// made-up but believable calendar: the same slots the NFL uses today, and weather drawn from each stadium's real
+// weather in that month. Everything is deterministic, so a game always shows the same info.
+
+// [days after Sep 1 of the season's start year, kickoff minutes ET, temp F, wind mph, condition, roof, stadium if neutral]
+type Rec = [
+	number,
+	number | null,
+	number | null,
+	number | null,
+	number,
+	number | null,
+	string | null,
+];
+type SbRec = [
+	number,
+	number | null,
+	number | null,
+	number | null,
+	number,
+	number | null,
+	string,
+];
+
+export type NflCalendarData = {
+	v: number;
+	seasons: Record<
+		string,
+		{
+			reg: Record<string, Rec>;
+			post: [string, (Rec | SbRec | [number, number | null])[]][];
+			stadiums: Record<string, string>;
+		}
+	>;
+	// stadium -> roof and, by month, [mean temp, temp spread, mean wind, rain rate, snow rate]
+	climate: Record<
+		string,
+		{
+			roof: number;
+			m: Record<string, [number, number, number, number, number]>;
+		}
+	>;
+	teamStadium: Record<string, string>;
+	futureSuperBowls: Record<string, [string, string, number]>;
+};
+
+export const ROOF = { outdoors: 0, dome: 1, open: 2, closed: 3 } as const;
+const COND_TEXT = ["", "Rain", "Snow", "Fog"];
+
+export type NflGameInfo = {
+	date: Date; // UTC midnight of the game's date
+	dateText: string; // "Sun, Nov 8, 2026"
+	minutes: number; // kickoff, minutes after midnight ET
+	timeText: string; // "8:15 PM ET"
+	timeEstimated: boolean; // true when the real kickoff time isn't known
+	slot: string | undefined; // "Monday Night Football", "Thanksgiving", ...
+	primetime: boolean;
+	stadium: string | undefined;
+	indoors: boolean;
+	temp: number | undefined;
+	wind: number | undefined;
+	cond: number; // 0 clear, 1 rain, 2 snow, 3 fog
+	weatherText: string; // "41°F · Wind 12 mph · Snow" or "Indoors"
+	real: boolean; // date and time from the real schedule
+	week: number | undefined; // regular season week
+	round: string | undefined; // "Wild Card", "Divisional", "Conference Championship", "Super Bowl LXI"
+	superBowl: boolean;
+	network?: string; // "CBS", "FOX", "ESPN"... who carried it (by the era's TV deals)
+};
+
+export type NflCalendarGame = {
+	day: number;
+	homeTid: number;
+	awayTid: number;
+	awayAfc?: boolean; // the visiting team plays in the AFC (Sunday afternoon games went to the visitor's network)
+	playoffs?: boolean;
+	neutralSite?: boolean;
+};
+
+let dataPromise: Promise<NflCalendarData | undefined> | undefined;
+export const loadNflCalendarData = () => {
+	if (!dataPromise) {
+		dataPromise = fetch("/nfl/game_info.json")
+			.then((r) => (r.ok ? r.json() : undefined))
+			.catch(() => undefined);
+	}
+	return dataPromise;
+};
+
+const ROMAN: [number, string][] = [
+	[1000, "M"],
+	[900, "CM"],
+	[500, "D"],
+	[400, "CD"],
+	[100, "C"],
+	[90, "XC"],
+	[50, "L"],
+	[40, "XL"],
+	[10, "X"],
+	[9, "IX"],
+	[5, "V"],
+	[4, "IV"],
+	[1, "I"],
+];
+export const romanNumeral = (n: number) => {
+	let out = "";
+	for (const [value, letters] of ROMAN) {
+		while (n >= value) {
+			out += letters;
+			n -= value;
+		}
+	}
+	return out;
+};
+
+// Seasons are named by the year they end: the 2026 season (Super Bowl LXI, February 2027) is 2027.
+// Super Bowl 50 was the one time the NFL used a number instead of Roman numerals.
+export const superBowlName = (season: number) => {
+	const n = season - 1966;
+	if (n < 1) {
+		return "NFL Championship";
+	}
+	return `Super Bowl ${n === 50 ? "50" : romanNumeral(n)}`;
+};
+
+const DAY = 86400000;
+const utc = (y: number, m: number, d: number) => new Date(Date.UTC(y, m, d));
+const addDays = (date: Date, n: number) => new Date(date.getTime() + n * DAY);
+const laborDay = (year: number) => {
+	const sep1 = utc(year, 8, 1);
+	return addDays(sep1, (8 - sep1.getUTCDay()) % 7);
+};
+const thanksgiving = (year: number) => {
+	const nov1 = utc(year, 10, 1);
+	return addDays(nov1, ((4 - nov1.getUTCDay() + 7) % 7) + 21);
+};
+// The Sunday of week 1: the Sunday after Labor Day (1970s-80s seasons often started earlier; close enough)
+export const weekOneSunday = (season: number) =>
+	addDays(laborDay(season - 1), 6);
+
+const dateFormat = new Intl.DateTimeFormat("en-US", {
+	weekday: "short",
+	month: "short",
+	day: "numeric",
+	year: "numeric",
+	timeZone: "UTC",
+});
+export const formatDate = (date: Date) => dateFormat.format(date);
+export const formatTime = (minutes: number) => {
+	const h = Math.floor(minutes / 60);
+	const m = minutes % 60;
+	return `${((h + 11) % 12) + 1}:${String(m).padStart(2, "0")} ${h >= 12 ? "PM" : "AM"} ET`;
+};
+
+// Small seeded random numbers, so made-up info is the same every time
+const hashString = (s: string) => {
+	let h = 2166136261;
+	for (let i = 0; i < s.length; i++) {
+		h = Math.imul(h ^ s.charCodeAt(i), 16777619);
+	}
+	return h >>> 0;
+};
+const seeded = (seed: string) => {
+	let a = hashString(seed);
+	return () => {
+		a = (a + 0x6d2b79f5) | 0;
+		let t = Math.imul(a ^ (a >>> 15), 1 | a);
+		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+	};
+};
+const gaussian = (rand: () => number) =>
+	Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());
+
+// Teams that usually host late-afternoon games (Mountain and Pacific time)
+const westernHome = (tid: number, startYear: number) =>
+	tid === 9 ||
+	tid === 16 ||
+	tid === 17 ||
+	tid === 27 ||
+	tid === 28 ||
+	(tid === 0 && startYear >= 1988) ||
+	(tid === 18 && (startYear <= 1994 || startYear >= 2016));
+
+const INTERNATIONAL =
+	/Wembley|Tottenham|Twickenham|Azteca|Allianz Arena|Deutsche Bank Park|Frankfurt|Corinthians|Neo Qu|Croke|Bernab|Olympiastadion|Melbourne|Rogers Centre|Tokyo|Dublin/i;
+
+const slotFor = (
+	date: Date,
+	minutes: number,
+	startYear: number,
+	stadium: string | undefined,
+) => {
+	const wd = date.getUTCDay();
+	const m = date.getUTCMonth();
+	const d = date.getUTCDate();
+	let slot: string | undefined;
+	let primetime = minutes >= 19 * 60;
+	if (m === 11 && d === 25) {
+		slot = "Christmas";
+	} else if (date.getTime() === thanksgiving(date.getUTCFullYear()).getTime()) {
+		slot = "Thanksgiving";
+	} else if (
+		startYear >= 2002 &&
+		primetime &&
+		wd >= 3 &&
+		wd <= 5 &&
+		date.getTime() < weekOneSunday(startYear + 1).getTime() &&
+		!(stadium && INTERNATIONAL.test(stadium))
+	) {
+		slot = "NFL Kickoff Game";
+	} else if (wd === 1 && startYear >= 1970) {
+		slot = "Monday Night Football";
+		primetime = true;
+	} else if (wd === 4 && startYear >= 2006) {
+		slot = "Thursday Night Football";
+		primetime = true;
+	} else if (wd === 0 && primetime) {
+		slot = startYear >= 1987 ? "Sunday Night Football" : "Sunday Night";
+	} else if (wd === 6) {
+		slot = primetime ? "Saturday Night" : "Saturday";
+	} else if (wd === 5) {
+		slot = "Friday Night";
+	} else if (wd === 3) {
+		slot = "Wednesday Night";
+	}
+	if (stadium && INTERNATIONAL.test(stadium)) {
+		slot = slot ? `International Series · ${slot}` : "International Series";
+	}
+	return { slot, primetime };
+};
+
+// Kickoff time when the real one isn't known (before 1999): what the NFL usually did that day of the week
+const defaultMinutes = (
+	date: Date,
+	startYear: number,
+	homeTid: number,
+	rand: () => number,
+) => {
+	const wd = date.getUTCDay();
+	if (wd === 1) {
+		return startYear >= 2006 ? 20 * 60 + 15 : 21 * 60;
+	}
+	if (wd === 4) {
+		if (date.getTime() === thanksgiving(date.getUTCFullYear()).getTime()) {
+			return homeTid === 10
+				? 12 * 60 + 30
+				: homeTid === 8
+					? 16 * 60 + 30
+					: 20 * 60 + 20;
+		}
+		return 20 * 60 + 15;
+	}
+	if (wd === 6) {
+		return rand() < 0.5 ? 16 * 60 + 30 : 12 * 60 + 30;
+	}
+	if (wd === 0) {
+		if (westernHome(homeTid, startYear)) {
+			return startYear >= 1999
+				? rand() < 0.5
+					? 16 * 60 + 5
+					: 16 * 60 + 25
+				: 16 * 60;
+		}
+		return rand() < 0.15
+			? startYear >= 1999
+				? 16 * 60 + 25
+				: 16 * 60
+			: 13 * 60;
+	}
+	return 20 * 60 + 15;
+};
+
+const stadiumFor = (data: NflCalendarData, season: number, homeTid: number) => {
+	const s = data.seasons[season];
+	if (s?.stadiums[homeTid]) {
+		return s.stadiums[homeTid];
+	}
+	// After the real data (or a franchise that didn't play that year): the nearest season we know
+	for (let y = season; y >= 1967; y--) {
+		const st = data.seasons[y]?.stadiums[homeTid];
+		if (st) {
+			return st;
+		}
+	}
+	return data.teamStadium[homeTid];
+};
+
+// Weather drawn from the stadium's real weather that month
+const madeUpWeather = (
+	data: NflCalendarData,
+	stadium: string | undefined,
+	date: Date,
+	rand: () => number,
+) => {
+	const climate = stadium ? data.climate[stadium] : undefined;
+	if (!climate) {
+		return { temp: undefined, wind: undefined, cond: 0 };
+	}
+	const month = date.getUTCMonth() + 1;
+	const order = [9, 10, 11, 12, 1, 2];
+	let row = climate.m[month];
+	if (!row) {
+		// Nearest month with data (a January game somewhere that rarely hosted one)
+		const i = order.indexOf(month);
+		for (let k = 1; k < 6 && !row; k++) {
+			row = climate.m[order[i - k]!] ?? climate.m[order[i + k]!];
+		}
+	}
+	if (!row) {
+		return { temp: undefined, wind: undefined, cond: 0 };
+	}
+	const [mean, spread, wind, rainRate, snowRate] = row;
+	const temp = Math.round(mean + spread * gaussian(rand));
+	const r = rand();
+	const cond =
+		temp <= 34 && r < snowRate * 1.5
+			? 2
+			: r < rainRate + snowRate
+				? temp <= 32
+					? 2
+					: 1
+				: r > 0.985
+					? 3
+					: 0;
+	return {
+		temp,
+		wind: Math.max(0, Math.round(wind + 4 * gaussian(rand))),
+		cond,
+	};
+};
+
+const finish = (
+	partial: {
+		date: Date;
+		minutes: number;
+		timeEstimated: boolean;
+		stadium: string | undefined;
+		roof: number | null | undefined;
+		temp: number | null | undefined;
+		wind: number | null | undefined;
+		cond: number;
+		real: boolean;
+		week: number | undefined;
+		round: string | undefined;
+		superBowl: boolean;
+	},
+	startYear: number,
+): NflGameInfo => {
+	const indoors = partial.roof === ROOF.dome || partial.roof === ROOF.closed;
+	const { slot, primetime } = slotFor(
+		partial.date,
+		partial.minutes,
+		startYear,
+		partial.stadium,
+	);
+	const temp = indoors || partial.temp == null ? undefined : partial.temp;
+	const wind = indoors || partial.wind == null ? undefined : partial.wind;
+	const cond = indoors ? 0 : partial.cond;
+	let weatherText = "";
+	if (indoors) {
+		weatherText = partial.roof === ROOF.closed ? "Roof closed" : "Indoors";
+	} else {
+		const parts = [];
+		if (temp !== undefined) {
+			parts.push(`${temp}°F`);
+		}
+		if (wind !== undefined && wind > 0) {
+			parts.push(`Wind ${wind} mph`);
+		}
+		if (cond) {
+			parts.push(COND_TEXT[cond]);
+		}
+		weatherText = parts.join(" · ");
+	}
+	return {
+		date: partial.date,
+		dateText: formatDate(partial.date),
+		minutes: partial.minutes,
+		timeText: formatTime(partial.minutes),
+		timeEstimated: partial.timeEstimated,
+		slot: partial.superBowl ? undefined : slot,
+		primetime: primetime || partial.superBowl,
+		stadium: partial.stadium,
+		indoors,
+		temp,
+		wind,
+		cond,
+		weatherText,
+		real: partial.real,
+		week: partial.week,
+		round: partial.round,
+		superBowl: partial.superBowl,
+	};
+};
+
+export const calendarKey = (g: {
+	day: number;
+	homeTid: number;
+	awayTid: number;
+}) => `${g.day}:${g.homeTid}:${g.awayTid}`;
+
+const ROUND_NAMES: Record<string, string> = {
+	WC: "Wild Card",
+	DIV: "Divisional Round",
+	CON: "Conference Championship",
+};
+
+// Info for every game of a season, keyed by calendarKey. games: completed and scheduled games of the season.
+export const buildSeasonCalendar = (
+	data: NflCalendarData | undefined,
+	season: number,
+	games: NflCalendarGame[],
+	numPlayoffRounds: number,
+) => {
+	const out = new Map<string, NflGameInfo>();
+	const startYear = season - 1;
+	const sep1 = utc(startYear, 8, 1);
+	const realSeason = data?.seasons[season];
+
+	// Regular season: weeks are the distinct days in order
+	const regular = games.filter((g) => !g.playoffs);
+	const regDays = [...new Set(regular.map((g) => g.day))].sort((a, b) => a - b);
+	const weekOf = new Map(regDays.map((d, i) => [d, i + 1]));
+	const numWeeks = regDays.length;
+	let lastRegDate = addDays(
+		weekOneSunday(season),
+		7 * Math.max(numWeeks - 1, 0),
+	);
+
+	const byWeek = new Map<number, NflCalendarGame[]>();
+	for (const g of regular) {
+		const week = weekOf.get(g.day)!;
+		const list = byWeek.get(week) ?? [];
+		list.push(g);
+		byWeek.set(week, list);
+	}
+
+	const thanksgivingDate = thanksgiving(startYear);
+	for (const [week, list] of byWeek) {
+		const sunday = addDays(weekOneSunday(season), 7 * (week - 1));
+		// Made-up slots for this week's games that have no real record: shuffled, then the NFL's slots in order
+		const madeUp = list
+			.filter((g) => !realSeason?.reg[`${g.homeTid}-${g.awayTid}`])
+			.sort(
+				(a, b) =>
+					hashString(`${season}-${week}-${a.homeTid}-${a.awayTid}`) -
+					hashString(`${season}-${week}-${b.homeTid}-${b.awayTid}`),
+			);
+		const slots = new Map<NflCalendarGame, { date: Date; minutes: number }>();
+		const take = (
+			pred: (g: NflCalendarGame) => boolean,
+			date: Date,
+			minutes: number,
+		) => {
+			const g = madeUp.find((x) => !slots.has(x) && pred(x));
+			if (g) {
+				slots.set(g, { date, minutes });
+			}
+		};
+		const thursday = addDays(sunday, -3);
+		const isThanksgivingWeek =
+			thursday.getTime() === thanksgivingDate.getTime();
+		if (isThanksgivingWeek) {
+			take((g) => g.homeTid === 10, thursday, 12 * 60 + 30);
+			take((g) => g.homeTid === 8, thursday, 16 * 60 + 30);
+			if (startYear >= 2006) {
+				take(() => true, thursday, 20 * 60 + 20);
+			}
+		} else if (
+			week < numWeeks &&
+			(startYear >= 2012 || (week === 1 && startYear >= 2002))
+		) {
+			take(() => true, thursday, 20 * 60 + 15);
+		}
+		if (startYear >= 1987) {
+			take(() => true, sunday, startYear >= 2006 ? 20 * 60 + 20 : 20 * 60);
+		}
+		if (startYear >= 1970 && !(week === numWeeks && startYear >= 2010)) {
+			take(
+				() => true,
+				addDays(sunday, 1),
+				startYear >= 2006 ? 20 * 60 + 15 : 21 * 60,
+			);
+		}
+		if (
+			startYear >= 1970 &&
+			week >= numWeeks - 2 &&
+			sunday.getUTCMonth() === 11
+		) {
+			take(() => true, addDays(sunday, -1), 16 * 60 + 30);
+			if (startYear >= 2006) {
+				take(() => true, addDays(sunday, -1), 20 * 60 + 15);
+			}
+		}
+
+		for (const g of list) {
+			const key = calendarKey(g);
+			const rand = seeded(`${season}:${key}`);
+			const rec = realSeason?.reg[`${g.homeTid}-${g.awayTid}`];
+			if (rec) {
+				const date = addDays(sep1, rec[0]);
+				const stadium = rec[6] ?? stadiumFor(data!, season, g.homeTid);
+				const climateRoof = stadium ? data!.climate[stadium]?.roof : undefined;
+				const roof = rec[5] ?? climateRoof;
+				let { 2: temp, 3: wind } = rec;
+				let cond = rec[4];
+				if (temp === null && roof !== ROOF.dome && roof !== ROOF.closed) {
+					({ temp, wind, cond } = madeUpWeather(
+						data!,
+						stadium,
+						date,
+						rand,
+					) as any);
+				}
+				out.set(
+					key,
+					finish(
+						{
+							date,
+							minutes:
+								rec[1] ?? defaultMinutes(date, startYear, g.homeTid, rand),
+							timeEstimated: rec[1] === null,
+							stadium,
+							roof,
+							temp,
+							wind,
+							cond,
+							real: true,
+							week,
+							round: undefined,
+							superBowl: false,
+						},
+						startYear,
+					),
+				);
+			} else {
+				const slot = slots.get(g);
+				const date = slot?.date ?? sunday;
+				const stadium = data ? stadiumFor(data, season, g.homeTid) : undefined;
+				const roof = stadium ? data!.climate[stadium]?.roof : undefined;
+				const weather = data
+					? madeUpWeather(data, stadium, date, rand)
+					: { temp: undefined, wind: undefined, cond: 0 };
+				out.set(
+					key,
+					finish(
+						{
+							date,
+							minutes:
+								slot?.minutes ??
+								defaultMinutes(date, startYear, g.homeTid, rand),
+							timeEstimated: false,
+							stadium,
+							roof,
+							...weather,
+							real: false,
+							week,
+							round: undefined,
+							superBowl: false,
+						},
+						startYear,
+					),
+				);
+			}
+			const info = out.get(key)!;
+			if (info.date > lastRegDate) {
+				lastRegDate = info.date;
+			}
+		}
+	}
+
+	// Playoffs: rounds are the distinct playoff days in order, lined up with the real rounds from the end
+	// (the last round is the Super Bowl)
+	const playoffGames = games.filter((g) => g.playoffs);
+	const playoffDays = [...new Set(playoffGames.map((g) => g.day))].sort(
+		(a, b) => a - b,
+	);
+	const realPost = realSeason?.post ?? [];
+	const lastRegSunday = addDays(lastRegDate, (7 - lastRegDate.getUTCDay()) % 7);
+	for (const [i, day] of playoffDays.entries()) {
+		// Rounds count from the first: every round has games, and later rounds aren't scheduled until they start
+		const roundIndex = i;
+		const fromEnd = numPlayoffRounds - 1 - roundIndex;
+		const isSuperBowl = fromEnd === 0;
+		const realRound =
+			realPost.length > fromEnd
+				? realPost[realPost.length - 1 - fromEnd]
+				: undefined;
+		const roundCode = isSuperBowl
+			? "SB"
+			: fromEnd === 1
+				? "CON"
+				: fromEnd === 2
+					? "DIV"
+					: "WC";
+		const roundName = isSuperBowl
+			? superBowlName(season)
+			: ROUND_NAMES[roundCode];
+		const list = playoffGames
+			.filter((g) => g.day === day)
+			.sort((a, b) => a.homeTid - b.homeTid);
+		for (const [j, g] of list.entries()) {
+			const key = calendarKey(g);
+			const rand = seeded(`${season}:${key}`);
+			let date: Date;
+			let minutes: number;
+			let real = false;
+			let stadium: string | undefined;
+			let roof: number | null | undefined;
+			let weather:
+				| { temp?: number | null; wind?: number | null; cond: number }
+				| undefined;
+			const realGame = realRound?.[1][j % realRound[1].length];
+			if (realGame) {
+				date = addDays(sep1, realGame[0]);
+				minutes =
+					realGame[1] ??
+					(isSuperBowl
+						? 18 * 60 + 30
+						: defaultMinutes(date, startYear, g.homeTid, rand));
+				real = realGame[1] !== null;
+			} else {
+				// Weeks after the regular season: Wild Card the next weekend, then one round a week, and two weeks
+				// off before the Super Bowl (from the 2001 season on; one week before that)
+				const weeksAfter =
+					1 + roundIndex + (isSuperBowl && startYear >= 2001 ? 1 : 0);
+				const sunday = addDays(lastRegSunday, 7 * weeksAfter);
+				if (isSuperBowl) {
+					date = sunday;
+					minutes = 18 * 60 + 30;
+				} else {
+					// Saturday and Sunday games, plus a Monday night Wild Card game from the 2020 season on
+					const n = list.length;
+					const plan: [number, number][] =
+						roundCode === "CON"
+							? [
+									[0, 15 * 60],
+									[0, 18 * 60 + 30],
+								]
+							: roundCode === "WC" && n >= 6 && startYear >= 2020
+								? [
+										[-1, 16 * 60 + 30],
+										[-1, 20 * 60 + 15],
+										[0, 13 * 60],
+										[0, 16 * 60 + 30],
+										[0, 20 * 60 + 15],
+										[1, 20 * 60 + 15],
+									]
+								: [
+										[-1, 16 * 60 + 30],
+										[-1, 20 * 60 + 15],
+										[0, 13 * 60],
+										[0, 16 * 60 + 30],
+									];
+					const [offset, min] = plan[j % plan.length]!;
+					date = addDays(sunday, offset);
+					minutes = min;
+				}
+			}
+			if (isSuperBowl) {
+				const sb =
+					realGame && realGame.length === 7 ? (realGame as SbRec) : undefined;
+				const future = data?.futureSuperBowls[season];
+				if (sb) {
+					stadium = sb[6];
+					roof = sb[5] ?? (stadium ? data!.climate[stadium]?.roof : undefined);
+					weather = { temp: sb[2], wind: sb[3], cond: sb[4] };
+				} else if (future) {
+					const [ymd, st, r] = future;
+					const [y, m, d] = ymd.split("-").map(Number) as [
+						number,
+						number,
+						number,
+					];
+					date = utc(y, m - 1, d);
+					stadium = st;
+					roof = r;
+				} else if (data) {
+					// A warm-weather or domed host, rotating like the NFL does
+					const hosts = [
+						"Caesars Superdome",
+						"Hard Rock Stadium",
+						"State Farm Stadium",
+						"SoFi Stadium",
+						"Mercedes-Benz Stadium",
+						"Allegiant Stadium",
+						"Raymond James Stadium",
+						"Levi's Stadium",
+						"NRG Stadium",
+						"AT&T Stadium",
+						"U.S. Bank Stadium",
+						"Lucas Oil Stadium",
+					].filter((h) => data.climate[h]);
+					stadium = hosts[season % hosts.length];
+					roof = stadium ? data.climate[stadium]?.roof : undefined;
+				}
+			} else {
+				stadium = data ? stadiumFor(data, season, g.homeTid) : undefined;
+				roof = stadium ? data!.climate[stadium]?.roof : undefined;
+			}
+			if (!weather || weather.temp == null) {
+				weather = data
+					? madeUpWeather(data, stadium, date, rand)
+					: { temp: undefined, wind: undefined, cond: 0 };
+			}
+			out.set(
+				key,
+				finish(
+					{
+						date,
+						minutes,
+						timeEstimated: realGame ? realGame[1] === null : false,
+						stadium,
+						roof,
+						temp: weather.temp,
+						wind: weather.wind,
+						cond: weather.cond,
+						real,
+						week: undefined,
+						round: roundName,
+						superBowl: isSuperBowl,
+					},
+					startYear,
+				),
+			);
+		}
+	}
+
+	// Who carried each game
+	for (const g of games) {
+		const info = out.get(calendarKey(g));
+		if (info) info.network = networkFor(info, season, g.awayAfc);
+	}
+	return out;
+};
+
+// Game of the Week: the regular season game between the two best teams (by win % going in), judged by the worse
+// of the two records, like a flexed Sunday night game. records: tid -> [won, lost] before that week.
+export const pickGameOfTheWeek = <G extends NflCalendarGame>(
+	games: G[],
+	records: Map<number, [number, number]>,
+) => {
+	let best: G | undefined;
+	let bestScore = -1;
+	for (const g of games) {
+		const pct = (tid: number) => {
+			const [w, l] = records.get(tid) ?? [0, 0];
+			return w + l > 0 ? w / (w + l) : 0.5;
+		};
+		const score =
+			Math.min(pct(g.homeTid), pct(g.awayTid)) +
+			0.01 * (pct(g.homeTid) + pct(g.awayTid));
+		if (score > bestScore) {
+			bestScore = score;
+			best = g;
+		}
+	}
+	return best;
+};
+
+// Where the real NFL calendar is at each Football GM phase (for the offseason, which has no games)
+export const offseasonText = (phase: number, season: number) => {
+	// PHASE: 0 preseason, 1 regular season, 2 after trade deadline, 3 playoffs, 4 before draft, 5 draft, 6 after draft,
+	// 7 re-sign players, 8 free agency
+	const y = season;
+	switch (phase) {
+		case 0:
+			return `Training camp · August ${y - 1}`;
+		case 4:
+			return `After the Super Bowl · February ${y}`;
+		case 5:
+			return `NFL Draft · April ${y}`;
+		case 6:
+			return `After the draft · May ${y}`;
+		case 7:
+			return `Re-signing players · March ${y}`;
+		case 8:
+			return `Free agency · March ${y}`;
+		default:
+			return undefined;
+	}
+};
+
+// The TV network for a game, by the TV deals of the era. Sunday afternoons went to the visiting team's conference
+// network (NFC: CBS, then FOX from 1994; AFC: NBC, then CBS from 1998); the night games and the Super Bowl by their
+// deals. Names only, no logos.
+const SB_NET: Record<number, string> = {
+	1985: "ABC",
+	1986: "NBC",
+	1987: "CBS",
+	1988: "ABC",
+	1989: "NBC",
+	1990: "CBS",
+	1991: "ABC",
+	1992: "CBS",
+	1993: "NBC",
+	1994: "NBC",
+	1995: "ABC",
+	1996: "NBC",
+	1997: "FOX",
+	1998: "NBC",
+	1999: "FOX",
+	2000: "ABC",
+	2001: "CBS",
+	2002: "FOX",
+	2003: "ABC",
+	2004: "CBS",
+	2005: "FOX",
+	2006: "ABC",
+	2007: "CBS",
+	2008: "FOX",
+	2009: "NBC",
+	2010: "CBS",
+	2011: "FOX",
+	2012: "NBC",
+	2013: "CBS",
+	2014: "FOX",
+	2015: "NBC",
+	2016: "CBS",
+	2017: "FOX",
+	2018: "NBC",
+	2019: "CBS",
+	2020: "FOX",
+	2021: "CBS",
+	2022: "NBC",
+	2023: "FOX",
+	2024: "CBS",
+	2025: "FOX",
+	2026: "NBC",
+	2027: "ABC",
+};
+export const networkFor = (
+	info: NflGameInfo,
+	season: number,
+	awayAfc: boolean | undefined,
+): string => {
+	const y = season - 1; // the season's start year
+	const slot = info.slot ?? "";
+	const night = info.minutes >= 19 * 60;
+	const afternoon = () => {
+		if (y < 1970) return awayAfc ? "NBC" : "CBS";
+		if (awayAfc) return y >= 1998 ? "CBS" : "NBC";
+		return y >= 1994 ? "FOX" : "CBS";
+	};
+	if (info.superBowl)
+		return (
+			SB_NET[season] ??
+			(season < 1985
+				? season % 2
+					? "CBS"
+					: "NBC"
+				: ["CBS", "FOX", "NBC", "ABC"][(season - 2028 + 400) % 4]!)
+		);
+	if (info.round) {
+		if (night && y >= 2014 && info.round.startsWith("Wild"))
+			return ["ESPN", "NBC", "FOX"][season % 3]!;
+		return afternoon();
+	}
+	if (slot.includes("Monday")) return y >= 2006 ? "ESPN" : "ABC";
+	if (slot.includes("Thursday"))
+		return y >= 2022
+			? "Prime Video"
+			: y >= 2018
+				? "FOX"
+				: y >= 2014
+					? "CBS"
+					: "NFL Network";
+	if (slot.includes("Kickoff")) return "NBC";
+	if (slot.includes("Sunday Night"))
+		return y >= 2006
+			? "NBC"
+			: y >= 1990 && y <= 1997 && (info.week ?? 99) <= 8
+				? "TNT"
+				: y >= 1987
+					? "ESPN"
+					: "ABC";
+	if (slot.includes("Thanksgiving"))
+		return night ? (y >= 2012 ? "NBC" : "NFL Network") : afternoon();
+	if (slot.includes("Christmas"))
+		return y >= 2024
+			? "Netflix"
+			: night
+				? y >= 2006
+					? "NFL Network"
+					: "ESPN"
+				: afternoon();
+	if (
+		slot.includes("Saturday") ||
+		slot.includes("Friday") ||
+		slot.includes("Wednesday")
+	)
+		return night && y >= 2006 ? "NFL Network" : night ? "ESPN" : afternoon();
+	if (night) return y >= 2006 ? "NBC" : y >= 1987 ? "ESPN" : "ABC";
+	return afternoon();
+};
