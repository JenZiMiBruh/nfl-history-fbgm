+const atSeason = <T extends [number, ...unknown[]]>(
+	list: T[] | undefined,
+	season: number,
+) => {
+	if (!list || list.length === 0) {
+		return undefined;
+	}
+	let pick = list[0]!;
+	for (const row of list) {
+		if (row[0] <= season) {
+			pick = row;
+		}
+	}
+	return pick;
+};
