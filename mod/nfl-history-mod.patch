+
+// The Lombardi trophy, centered at x, standing on y (bottom), h tall: a football tipped forward on a tapered,
+// faceted stand and a stepped base, in brushed silver
+const lombardi = (id: string, x: number, bottom: number, h: number) => {
+	const s = h / 100;
+	const X = (v: number) => (x + v * s).toFixed(1);
+	const Y = (v: number) => (bottom - (100 - v) * s).toFixed(1);
+	return (
+		`<g>` +
+		// base: two steps
+		`<path d='M${X(-15)} ${Y(100)} L${X(15)} ${Y(100)} L${X(13)} ${Y(92)} L${X(-13)} ${Y(92)} Z' fill='url(#${id}s2)'/>` +
+		`<path d='M${X(-11)} ${Y(92)} L${X(11)} ${Y(92)} L${X(9.5)} ${Y(86)} L${X(-9.5)} ${Y(86)} Z' fill='url(#${id}s1)'/>` +
+		// stand: concave sides rising to the cradle
+		`<path d='M${X(-9)} ${Y(86)} C${X(-4)} ${Y(70)} ${X(-3)} ${Y(52)} ${X(-7)} ${Y(38)} L${X(7)} ${Y(38)} C${X(3)} ${Y(52)} ${X(4)} ${Y(70)} ${X(9)} ${Y(86)} Z' fill='url(#${id}s1)'/>` +
+		`<path d='M${X(0)} ${Y(86)} C${X(1.5)} ${Y(70)} ${X(1.2)} ${Y(52)} ${X(0)} ${Y(38)} L${X(7)} ${Y(38)} C${X(3)} ${Y(52)} ${X(4)} ${Y(70)} ${X(9)} ${Y(86)} Z' fill='#000' opacity='0.18'/>` +
+		// cradle
+		`<path d='M${X(-10)} ${Y(38)} L${X(10)} ${Y(38)} L${X(7)} ${Y(33)} L${X(-7)} ${Y(33)} Z' fill='url(#${id}s2)'/>` +
+		// football, tipped
+		`<g transform='rotate(-28 ${X(0)} ${Y(20)})'>` +
+		`<ellipse cx='${X(0)}' cy='${Y(20)}' rx='${(19 * s).toFixed(1)}' ry='${(11.5 * s).toFixed(1)}' fill='url(#${id}s1)'/>` +
+		`<ellipse cx='${X(-3)}' cy='${Y(16)}' rx='${(12 * s).toFixed(1)}' ry='${(4.5 * s).toFixed(1)}' fill='#fff' opacity='0.35'/>` +
+		`<path d='M${X(-8)} ${Y(20)} L${X(8)} ${Y(20)}' stroke='#6B7480' stroke-width='${(1.4 * s).toFixed(2)}'/>` +
+		[-6, -3, 0, 3, 6]
+			.map(
+				(d) =>
+					`<path d='M${X(d)} ${Y(17.5)} L${X(d)} ${Y(22.5)}' stroke='#6B7480' stroke-width='${(1.2 * s).toFixed(2)}'/>`,
+			)
+			.join("") +
+		`</g></g>`
+	);
+};
+
+export const silverDefs = (id: string) =>
+	`<linearGradient id='${id}s1' x1='0' x2='1'><stop offset='0' stop-color='#8E959E'/><stop offset='0.35' stop-color='#F4F6F8'/><stop offset='0.55' stop-color='#C9CED4'/><stop offset='1' stop-color='#7C838C'/></linearGradient>` +
+	`<linearGradient id='${id}s2' x1='0' x2='1'><stop offset='0' stop-color='#6F7680'/><stop offset='0.5' stop-color='#D7DBE0'/><stop offset='1' stop-color='#5F666F'/></linearGradient>`;
+
+const star = (cx: number, cy: number, r: number, fill: string) => {
+	const pts: string[] = [];
+	for (let i = 0; i < 10; i++) {
+		const a = -Math.PI / 2 + (i * Math.PI) / 5;
+		const rr = i % 2 === 0 ? r : r * 0.42;
+		pts.push(
+			`${(cx + rr * Math.cos(a)).toFixed(1)},${(cy + rr * Math.sin(a)).toFixed(1)}`,
+		);
+	}
+	return `<polygon points='${pts.join(" ")}' fill='${fill}'/>`;
+};
+
+const DARK = "#0B0F1A";
+
+// seeded random numbers for a game (the same logo every time)
+const rand = (seed: number) => {
+	let st = (seed * 2654435761) >>> 0;
+	return () => {
+		st = (st + 0x6d2b79f5) >>> 0;
+		let t = st;
+		t = Math.imul(t ^ (t >>> 15), t | 1);
+		t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+	};
+};
+
+const mix = (a: string, b: string, k: number) => {
+	const p = (h: string) =>
+		[1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
+	const x = p(a);
+	const y = p(b);
+	return `#${x
+		.map((v, i) =>
+			Math.round(v + (y[i]! - v) * k)
+				.toString(16)
+				.padStart(2, "0"),
+		)
+		.join("")}`;
+};
+
+// Metal for the numerals and the trophy: silver, or gold for Super Bowl 50
+const metalDefs = (id: string, gold: boolean) =>
+	gold
+		? `<linearGradient id='${id}s1' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFF4C4'/><stop offset='0.42' stop-color='#E9BE4A'/><stop offset='0.52' stop-color='#A97A12'/><stop offset='1' stop-color='#F3D271'/></linearGradient>` +
+			`<linearGradient id='${id}s2' x1='0' x2='1'><stop offset='0' stop-color='#8A6410'/><stop offset='0.5' stop-color='#F1D27A'/><stop offset='1' stop-color='#7A560C'/></linearGradient>`
+		: `<linearGradient id='${id}s1' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFFFFF'/><stop offset='0.45' stop-color='#C9CFD6'/><stop offset='0.55' stop-color='#8B939D'/><stop offset='1' stop-color='#E3E7EB'/></linearGradient>` +
+			`<linearGradient id='${id}s2' x1='0' x2='1'><stop offset='0' stop-color='#6F7680'/><stop offset='0.5' stop-color='#D7DBE0'/><stop offset='1' stop-color='#5F666F'/></linearGradient>`;
+
+// ---------- the host city, drawn: objects that sit on the horizon of each logo's scene ----------
+type Motif =
+	| "palms"
+	| "waves"
+	| "skyline"
+	| "mesa"
+	| "bridge"
+	| "fleur"
+	| "star"
+	| "mountains"
+	| "neon";
+const MOTIFS: Record<string, Motif[]> = {
+	"Los Angeles": ["mountains", "palms"],
+	Pasadena: ["mountains", "palms"],
+	Inglewood: ["palms", "skyline"],
+	Miami: ["waves", "palms"],
+	Tampa: ["waves", "palms"],
+	"San Diego": ["waves", "palms"],
+	Jacksonville: ["waves", "bridge"],
+	"New Orleans": ["skyline", "fleur"],
+	Houston: ["skyline", "star"],
+	Arlington: ["skyline", "star"],
+	Tempe: ["mesa"],
+	Glendale: ["mesa"],
+	Stanford: ["bridge", "mountains"],
+	"Santa Clara": ["bridge", "mountains"],
+	"Las Vegas": ["skyline", "neon"],
+	Pontiac: ["skyline"],
+	Detroit: ["skyline"],
+	Minneapolis: ["skyline"],
+	Indianapolis: ["skyline"],
+	Atlanta: ["skyline"],
+	"East Rutherford": ["skyline", "bridge"],
+};
+
+const skyline = (r: () => number, y: number, color: string) => {
+	let x = 6;
+	let d = `M0 ${y}`;
+	while (x < 256) {
+		const w = 10 + r() * 16;
+		const h = 18 + r() * 52;
+		d += ` L${x.toFixed(1)} ${y} L${x.toFixed(1)} ${(y - h).toFixed(1)}`;
+		if (r() < 0.25) {
+			d += ` L${(x + w / 2 - 1).toFixed(1)} ${(y - h).toFixed(1)} L${(x + w / 2).toFixed(1)} ${(y - h - 12).toFixed(1)} L${(x + w / 2 + 1).toFixed(1)} ${(y - h).toFixed(1)}`;
+		}
+		d += ` L${(x + w).toFixed(1)} ${(y - h).toFixed(1)} L${(x + w).toFixed(1)} ${y}`;
+		x += w + 1 + r() * 3;
+	}
+	return `<path d='${d} L256 ${y} L256 ${y + 40} L0 ${y + 40} Z' fill='${color}'/>`;
+};
+const palm = (x: number, y: number, h: number, lean: number, color: string) => {
+	const tx = x + lean;
+	const ty = y - h;
+	const trunk = `<path d='M${x - 3} ${y} Q${x + lean * 0.3} ${y - h * 0.5} ${tx - 1.5} ${ty} L${tx + 1.5} ${ty} Q${x + lean * 0.3 + 4} ${y - h * 0.5} ${x + 3} ${y} Z' fill='${color}'/>`;
+	const fronds = [-150, -115, -70, -30, 10]
+		.map((a) => {
+			const rad = (a * Math.PI) / 180;
+			const ex = tx + Math.cos(rad) * h * 0.45;
+			const ey = ty + Math.sin(rad) * h * 0.45 + h * 0.12;
+			const mx = tx + Math.cos(rad) * h * 0.25;
+			const my = ty + Math.sin(rad) * h * 0.25 - h * 0.08;
+			return `<path d='M${tx} ${ty} Q${mx.toFixed(1)} ${(my - 4).toFixed(1)} ${ex.toFixed(1)} ${ey.toFixed(1)} Q${mx.toFixed(1)} ${(my + 3).toFixed(1)} ${tx} ${ty + 2} Z' fill='${color}'/>`;
+		})
+		.join("");
+	return trunk + fronds;
+};
+const waves = (y: number, a: string, b: string) => {
+	const band = (yy: number, col: string) => {
+		let d = `M0 ${yy}`;
+		for (let x = 0; x <= 256; x += 32) {
+			d += ` Q${x + 8} ${yy - 6} ${x + 16} ${yy} T${x + 32} ${yy}`;
+		}
+		return `<path d='${d} L256 ${yy + 60} L0 ${yy + 60} Z' fill='${col}'/>`;
+	};
+	return band(y, a) + band(y + 12, b);
+};
+const mesa = (y: number, color: string, cactus: string) =>
+	`<path d='M0 ${y} L0 ${y - 22} L34 ${y - 22} L46 ${y - 40} L96 ${y - 40} L110 ${y - 18} L150 ${y - 18} L162 ${y - 34} L196 ${y - 34} L212 ${y - 12} L256 ${y - 12} L256 ${y + 40} L0 ${y + 40} Z' fill='${color}'/>` +
+	`<path d='M206 ${y} L206 ${y - 38} Q206 ${y - 44} 211 ${y - 44} Q216 ${y - 44} 216 ${y - 38} L216 ${y} Z M206 ${y - 18} L198 ${y - 18} L198 ${y - 30} Q198 ${y - 34} 201 ${y - 34} Q204 ${y - 34} 204 ${y - 30} L204 ${y - 24} L206 ${y - 24} Z M216 ${y - 24} L222 ${y - 24} L222 ${y - 32} Q222 ${y - 36} 225 ${y - 36} Q228 ${y - 36} 228 ${y - 32} L228 ${y - 18} L216 ${y - 18} Z' fill='${cactus}'/>`;
+const bridge = (y: number, color: string) =>
+	`<path d='M0 ${y - 14} L256 ${y - 14} L256 ${y - 10} L0 ${y - 10} Z' fill='${color}'/>` +
+	[70, 186]
+		.map(
+			(x) =>
+				`<path d='M${x - 5} ${y} L${x - 4} ${y - 62} L${x + 4} ${y - 62} L${x + 5} ${y} Z M${x - 6} ${y - 44} L${x + 6} ${y - 44} L${x + 6} ${y - 40} L${x - 6} ${y - 40} Z' fill='${color}'/>`,
+		)
+		.join("") +
+	`<path d='M0 ${y - 40} Q38 ${y - 16} 70 ${y - 60} Q128 ${y - 4} 186 ${y - 60} Q218 ${y - 16} 256 ${y - 40}' fill='none' stroke='${color}' stroke-width='2.5'/>` +
+	`<path d='M0 ${y - 10} L256 ${y - 10} L256 ${y + 40} L0 ${y + 40} Z' fill='${mix(color, "#000000", 0.2)}'/>`;
+const mountains = (y: number, color: string) =>
+	`<path d='M0 ${y} L0 ${y - 30} L40 ${y - 58} L70 ${y - 36} L110 ${y - 70} L150 ${y - 40} L190 ${y - 62} L230 ${y - 34} L256 ${y - 46} L256 ${y + 40} L0 ${y + 40} Z' fill='${color}'/>`;
+const fleur = (x: number, y: number, s: number, color: string) =>
+	`<g transform='translate(${x} ${y}) scale(${s})'><path d='M0 -30 C9 -20 9 -8 0 2 C-9 -8 -9 -20 0 -30 Z M-3 0 C-14 -2 -22 -14 -14 -22 C-8 -26 -4 -16 -3 -8 Z M3 0 C14 -2 22 -14 14 -22 C8 -26 4 -16 3 -8 Z M-12 4 L12 4 L12 9 L-12 9 Z M-2 9 L2 9 L4 20 L-4 20 Z' fill='${color}'/></g>`;
+const sparkle = (x: number, y: number, r: number, color: string) =>
+	`<path d='M${x} ${y - r} L${x + r * 0.22} ${y - r * 0.22} L${x + r} ${y} L${x + r * 0.22} ${y + r * 0.22} L${x} ${y + r} L${x - r * 0.22} ${y + r * 0.22} L${x - r} ${y} L${x - r * 0.22} ${y - r * 0.22} Z' fill='${color}'/>`;
+
+// The scene behind a logo: a sky in the host colors, a sun, and the city on the horizon (y)
+const scene = (
+	n: number,
+	c: [string, string, string],
+	id: string,
+	horizon: number,
+) => {
+	const r = rand(n);
+	const host = superBowlHost(n);
+	const motifs = MOTIFS[host] ?? ["skyline"];
+	const sil = mix(c[0], DARK, 0.7);
+	let out =
+		`<linearGradient id='${id}sky' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='${mix(c[0], DARK, 0.35)}'/><stop offset='0.6' stop-color='${c[0]}'/><stop offset='1' stop-color='${mix(c[1], "#FFFFFF", 0.25)}'/></linearGradient>` +
+		`<radialGradient id='${id}sun' cx='0.5' cy='0.5' r='0.5'><stop offset='0' stop-color='#FFF6D5'/><stop offset='0.6' stop-color='${mix(c[1], "#FFD27A", 0.5)}'/><stop offset='1' stop-color='${c[1]}' stop-opacity='0'/></radialGradient>`;
+	out = `<defs>${out}</defs><rect x='0' y='0' width='256' height='256' fill='url(#${id}sky)'/>`;
+	out += `<circle cx='128' cy='${horizon - 6}' r='70' fill='url(#${id}sun)'/>`;
+	for (const m of motifs) {
+		if (m === "skyline") out += skyline(r, horizon, sil);
+		else if (m === "mountains") out += mountains(horizon, mix(sil, c[0], 0.35));
+		else if (m === "mesa") out += mesa(horizon, mix(c[1], DARK, 0.45), sil);
+		else if (m === "bridge") out += bridge(horizon, sil);
+		else if (m === "waves")
+			out += waves(horizon - 4, mix(c[2], DARK, 0.15), mix(c[2], DARK, 0.45));
+		else if (m === "palms")
+			out +=
+				palm(34, horizon + 4, 66, 10, sil) +
+				palm(222, horizon + 4, 58, -9, sil) +
+				palm(204, horizon + 6, 44, -4, sil);
+		else if (m === "fleur")
+			out += fleur(128, horizon - 50, 0.9, mix(c[1], "#FFFFFF", 0.2));
+		else if (m === "star")
+			out += star(128, horizon - 58, 20, mix(c[2], "#FFFFFF", 0.3));
+		else if (m === "neon")
+			out +=
+				sparkle(40, horizon - 70, 7, "#FFFFFF") +
+				sparkle(214, horizon - 80, 9, c[2]) +
+				sparkle(190, horizon - 46, 5, "#FFFFFF");
+	}
+	return (
+		out +
+		`<rect x='0' y='${horizon + 14}' width='256' height='120' fill='${mix(c[2], DARK, 0.55)}'/>`
+	);
+};
+
+// The numeral, heavy and metallic, with a dark edge so it reads over any scene
+// a future era's numeral face (null: each layout's own)
+let FACE: string | null = null;
+
+const numeral = (
+	id: string,
+	text: string,
+	x: number,
+	y: number,
+	size: number,
+	maxW: number,
+	font: string,
+	edge: string,
+	italic = false,
+	extrude = false,
+	anchor = "middle",
+) => {
+	font = FACE ?? font;
+	const per = font === SERIF ? 0.66 : font === COND ? 0.5 : 0.82;
+	const base = `x='${x}' y='${y}' text-anchor='${anchor}' font-family="${font}" font-weight='900' font-size='${size.toFixed(0)}'${italic ? " font-style='italic'" : ""}${fitText(text, size, maxW, per)}`;
+	const w = size / 9;
+	let out = "";
+	if (extrude) {
+		for (let i = 5; i >= 1; i--) {
+			out += `<text ${base} transform='translate(${(i * w * 0.35).toFixed(1)} ${(i * w * 0.35).toFixed(1)})' fill='${DARK}' stroke='${DARK}' stroke-width='${(w * 1.4).toFixed(1)}' stroke-linejoin='round'>${text}</text>`;
+		}
+	}
+	return (
+		out +
+		`<text ${base} fill='${DARK}' stroke='${DARK}' stroke-width='${(w * 2.6).toFixed(1)}' stroke-linejoin='round'>${text}</text>` +
+		`<text ${base} fill='url(#${id}s1)' stroke='${edge}' stroke-width='${(w * 1.1).toFixed(1)}' stroke-linejoin='round' paint-order='stroke'>${text}</text>`
+	);
+};
+
+// A ribbon with SUPER BOWL (always fits)
+const ribbon = (
+	y: number,
+	w: number,
+	c: string,
+	text = "SUPER BOWL",
+	font = BLOCK,
+) => {
+	const x0 = 128 - w / 2;
+	const x1 = 128 + w / 2;
+	return (
+		`<path d='M${x0 - 16} ${y + 4} L${x0} ${y + 4} L${x0} ${y + 28} L${x0 - 16} ${y + 28} L${x0 - 8} ${y + 16} Z M${x1 + 16} ${y + 4} L${x1} ${y + 4} L${x1} ${y + 28} L${x1 + 16} ${y + 28} L${x1 + 8} ${y + 16} Z' fill='${mix(c, DARK, 0.45)}'/>` +
+		`<rect x='${x0}' y='${y}' width='${w}' height='28' fill='${c}' stroke='${DARK}' stroke-width='2.5'/>` +
+		`<text x='128' y='${y + 20.5}' text-anchor='middle' font-family="${font}" font-weight='900' font-size='17' letter-spacing='2' fill='#FFFFFF' textLength='${w - 24}' lengthAdjust='spacingAndGlyphs'>${text}</text>`
+	);
+};
+
+const sizeFor = (num: string, big: number) =>
+	num.length <= 2
+		? big
+		: num.length <= 3
+			? big * 0.86
+			: num.length <= 4
+				? big * 0.74
+				: big * 0.62;
+
+// I-X: vintage. A roundel (or pennant shield) with a soft scene, cream serif numerals, the game's city and year.
+const classic = (n: number, c: [string, string, string], id: string) => {
+	const num = superBowlName(n);
+	const shield = n % 2 === 0;
+	const shape = shield
+		? `M40 12 L216 12 L216 146 C216 200 176 230 128 248 C80 230 40 200 40 146 Z`
+		: `M128 10 A118 118 0 1 1 127.9 10 Z`;
+	return (
+		`<defs>${metalDefs(id, false)}<clipPath id='${id}k'><path d='${shape}'/></clipPath><path id='${id}arc' d='M44 128 A84 84 0 0 1 212 128'/></defs>` +
+		`<path d='${shape}' fill='${DARK}'/>` +
+		`<g clip-path='url(#${id}k)' transform='translate(128 128) scale(0.94) translate(-128 -128)'>${scene(n, c, id, 182)}</g>` +
+		`<path d='${shape}' fill='none' stroke='#F2E6C9' stroke-width='4' transform='translate(128 128) scale(0.94) translate(-128 -128)'/>` +
+		(shield
+			? `<rect x='40' y='24' width='176' height='34' fill='#F2E6C9'/><text x='128' y='49' text-anchor='middle' font-family="${SERIF}" font-weight='700' font-size='22' letter-spacing='3' fill='${DARK}' textLength='150' lengthAdjust='spacingAndGlyphs'>SUPER BOWL</text>`
+			: `<text font-family="${SERIF}" font-weight='700' font-size='24' letter-spacing='3' fill='#F2E6C9'><textPath href='#${id}arc' startOffset='50%' text-anchor='middle'>SUPER BOWL</textPath></text>`) +
+		`<text x='128' y='${132 + sizeFor(num, 96) * 0.34}' text-anchor='middle' font-family="${SERIF}" font-weight='700' font-size='${sizeFor(num, 96).toFixed(0)}' fill='#F7F1E1' stroke='${DARK}' stroke-width='7' stroke-linejoin='round' paint-order='stroke'${fitText(num, sizeFor(num, 96), 150, 0.62)}>${num}</text>` +
+		`<text x='128' y='214' text-anchor='middle' font-family="${SERIF}" font-weight='700' font-size='12' letter-spacing='1.5' fill='#F2E6C9'${fitText(superBowlHost(n) + " · 0000", 12, 120, 0.7)}>${superBowlHost(n).toUpperCase()} · ${1966 + n}</text>`
+	);
+};
+
+// XI-XXV: the 80s. A slanted badge, a sunset over the city with speed stripes, extruded chrome italic numerals.
+const eighties = (n: number, c: [string, string, string], id: string) => {
+	const num = superBowlName(n);
+	const round = n % 2 === 1;
+	const shape = round
+		? `M128 16 A112 112 0 1 1 127.9 16 Z`
+		: `M34 26 L236 26 L222 214 L20 214 Z`;
+	return (
+		`<defs>${metalDefs(id, false)}<clipPath id='${id}k'><path d='${shape}'/></clipPath></defs>` +
+		`<path d='${shape}' fill='${DARK}' transform='translate(128 120) scale(1.06) translate(-128 -120)'/>` +
+		`<g clip-path='url(#${id}k)'>${scene(n, c, id, 176)}` +
+		[c[1], "#FFFFFF", c[2]]
+			.map(
+				(col, i) =>
+					`<path d='M-10 ${92 + i * 10} L266 ${62 + i * 10} L266 ${67 + i * 10} L-10 ${97 + i * 10} Z' fill='${col}' opacity='0.9'/>`,
+			)
+			.join("") +
+		`</g>` +
+		`<path d='${shape}' fill='none' stroke='${c[1]}' stroke-width='4'/>` +
+		numeral(id, num, 124, 158, sizeFor(num, 96), 168, BLOCK, c[0], true, true) +
+		ribbon(214, 170, c[0], "SUPER BOWL", BLOCK)
+	);
+};
+
+// XXVI-XLIV: the crest era. A shield or diamond with the city scene, the trophy rising behind the numerals, a ribbon.
+const crest = (n: number, c: [string, string, string], id: string) => {
+	const num = superBowlName(n);
+	const kind = 0;
+	const shape =
+		kind === 0
+			? `M128 8 L226 32 C226 128 196 194 128 248 C60 194 30 128 30 32 Z`
+			: kind === 1
+				? `M128 6 L250 128 L128 250 L6 128 Z`
+				: `M128 10 A118 118 0 1 1 127.9 10 Z`;
+	return (
+		`<defs>${metalDefs(id, false)}<clipPath id='${id}k'><path d='${shape}'/></clipPath></defs>` +
+		`<path d='${shape}' fill='${DARK}'/>` +
+		`<g clip-path='url(#${id}k)' transform='translate(128 128) scale(0.93) translate(-128 -128)'>${scene(n, c, id, 170)}</g>` +
+		`<path d='${shape}' fill='none' stroke='${c[1]}' stroke-width='4' transform='translate(128 128) scale(0.93) translate(-128 -128)'/>` +
+		lombardi(id, 128, 150, 120) +
+		numeral(id, num, 128, 178, sizeFor(num, 70), 150, SERIF, c[0]) +
+		ribbon(192, 150, c[0])
+	);
+};
+
+// XLV on: the modern mark. A full trophy in front of split numerals (or one numeral behind it), a scene disc
+// behind, SUPER BOWL below. Super Bowl 50 in gold.
+const modern = (n: number, c: [string, string, string], id: string) => {
+	const num = superBowlName(n);
+	const gold = n === 50;
+	// the numeral splits at the trophy: the longer half on the left (LV|I, LX|I, XL|VIII reads as XLV|III)
+	const cut = Math.ceil(num.length / 2);
+	const left = num.slice(0, cut);
+	const right = num.slice(cut);
+	// one size for both halves, set off the trophy's stand by a clear gap, never squeezed
+	const longest = Math.max(left.length, right.length);
+	const gap = 19;
+	const room = 128 - gap - 8;
+	const size = Math.min(110, room / (longest * 0.72));
+	const y = 176;
+	const top = y - size * 0.7 * 1.22;
+	const attrs = `font-family="${FACE ?? SERIF}" font-weight='700' font-size='${size.toFixed(0)}'`;
+	const stretch = `translate(0 ${y}) scale(1 1.22) translate(0 ${-y})`;
+	const halves = (extra: string) =>
+		`<text x='${128 - gap}' y='${y}' text-anchor='end' transform='${stretch}' ${attrs}${extra}>${left}</text>` +
+		(right
+			? `<text x='${128 + gap}' y='${y}' text-anchor='start' transform='${stretch}' ${attrs}${extra}>${right}</text>`
+			: "");
+	const w = size / 9;
+	const bevel = gold ? "#7A560C" : "#5D6670";
+	return (
+		`<defs>${metalDefs(id, gold)}` +
+		`<clipPath id='${id}t'>${halves("")}</clipPath>` +
+		`<linearGradient id='${id}in' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='${mix(c[0], "#FFFFFF", 0.15)}'/><stop offset='1' stop-color='${mix(c[0], DARK, 0.35)}'/></linearGradient>` +
+		`</defs>` +
+		// a soft shadow, then the silver (or gold) rim, then the host city inside the letters
+		halves(
+			` fill='#000' opacity='0.22' dx='2.5' dy='2' stroke='#000' stroke-width='${(w * 2.4).toFixed(1)}' stroke-linejoin='round'`,
+		) +
+		halves(
+			` fill='url(#${id}s1)' stroke='url(#${id}s1)' stroke-width='${(w * 2.4).toFixed(1)}' stroke-linejoin='round'`,
+		) +
+		halves(
+			` fill='none' stroke='${bevel}' stroke-width='${(w * 0.9).toFixed(1)}' stroke-linejoin='round'`,
+		) +
+		`<g clip-path='url(#${id}t)'><rect x='0' y='0' width='256' height='256' fill='url(#${id}in)'/>` +
+		(n >= 55
+			? `<g transform='translate(0 ${(top - 40).toFixed(0)})'>${scene(n, c, id + "x", 150)}</g>`
+			: "") +
+		`</g>` +
+		halves(
+			` fill='none' stroke='#FFFFFF' stroke-opacity='0.55' stroke-width='${(w * 0.35).toFixed(1)}'`,
+		) +
+		`<g transform='translate(128 0) scale(0.8 1) translate(-128 0)'>${lombardi(id, 128, 214, 206)}</g>` +
+		`<text x='128' y='238' text-anchor='middle' font-family="${BLOCK}" font-weight='900' font-size='22' letter-spacing='4' fill='${gold ? "#B8861B" : c[0]}' textLength='176' lengthAdjust='spacingAndGlyphs'>SUPER BOWL</text>`
+	);
+};
+
+// ---------- more layouts per era ----------
+
+// XI-XXV: widescreen: the numerals sit on a wide strip of the city at sunset, SUPER BOWL in a slanted bar above
+const eightiesWide = (n: number, c: [string, string, string], id: string) => {
+	const num = superBowlName(n);
+	return (
+		`<defs>${metalDefs(id, false)}<clipPath id='${id}k'><rect x='14' y='104' width='228' height='92' rx='10'/></clipPath></defs>` +
+		`<rect x='8' y='98' width='240' height='104' rx='14' fill='${DARK}'/>` +
+		`<g clip-path='url(#${id}k)' transform='translate(0 26)'>${scene(n, c, id, 160)}</g>` +
+		`<path d='M24 44 L240 44 L228 82 L12 82 Z' fill='${c[1]}' stroke='${DARK}' stroke-width='4'/>` +
+		`<text x='126' y='72' text-anchor='middle' font-family="${BLOCK}" font-style='italic' font-weight='900' font-size='26' fill='${DARK}' textLength='190' lengthAdjust='spacingAndGlyphs'>SUPER BOWL</text>` +
+		numeral(id, num, 124, 176, sizeFor(num, 92), 196, BLOCK, c[0], true, true) +
+		[c[0], c[2]]
+			.map(
+				(col, i) =>
+					`<rect x='30' y='${212 + i * 9}' width='196' height='5' fill='${col}'/>`,
+			)
+			.join("")
+	);
+};
+
+// XXVI-XLIV: side by side: the trophy on the left of a wide oval, the numerals on the right over the city
+const crestSide = (n: number, c: [string, string, string], id: string) => {
+	const num = superBowlName(n);
+	return (
+		`<defs>${metalDefs(id, false)}<clipPath id='${id}k'><ellipse cx='128' cy='128' rx='116' ry='86'/></clipPath></defs>` +
+		`<ellipse cx='128' cy='128' rx='124' ry='94' fill='${DARK}'/>` +
+		`<g clip-path='url(#${id}k)'>${scene(n, c, id, 168)}</g>` +
+		`<ellipse cx='128' cy='128' rx='116' ry='86' fill='none' stroke='${c[1]}' stroke-width='4'/>` +
+		lombardi(id, 66, 196, 150) +
+		numeral(id, num, 160, 150, sizeFor(num, 70), 140, SERIF, c[0]) +
+		ribbon(206, 160, c[0])
+	);
+};
+
+// Generated Super Bowl eras after the real ones: which template and numeral face Super Bowl n uses
+const FACES = [SERIF, BLOCK, COND, `Rockwell,'Roboto Slab',Georgia,serif`];
+const futureEra = (n: number) => {
+	const layouts = [modern, crestSide, crest, eightiesWide, eighties];
+	let start = 62;
+	let era = 0;
+	let prev = 0;
+	for (;;) {
+		const r = rand(1000 + era);
+		const len = 6 + Math.floor(r() * 5);
+		// never the same template twice in a row; the first generated era is not the modern mark it follows
+		let pick = Math.floor(r() * layouts.length);
+		if (pick === prev) {
+			pick =
+				(pick + 1 + Math.floor(r() * (layouts.length - 1))) % layouts.length;
+		}
+		const face = FACES[Math.floor(r() * FACES.length)]!;
+		if (n < start + len) {
+			return { layout: layouts[pick]!, face, era, start, end: start + len - 1 };
+		}
+		start += len;
+		prev = pick;
+		era++;
+	}
+};
+
+export type SuperBowlStyle = "classic" | "eighties" | "crest" | "modern";
+
+export const superBowlStyle = (n: number): SuperBowlStyle =>
+	n <= 10 ? "classic" : n <= 25 ? "eighties" : n <= 44 ? "crest" : "modern";
+
+const cache = new Map<string, string>();
+
+// The logo for Super Bowl n as an SVG data URL. colors overrides the host city's (e.g. a league's own palette).
+export const superBowlLogo = (
+	n: number,
+	opts: { style?: SuperBowlStyle; colors?: [string, string, string]; bare?: boolean } = {},
+) => {
+	const style = opts.style ?? superBowlStyle(n);
+	const colors = opts.colors ??
+		CITY[superBowlHost(n)] ?? ["#013369", "#D50A0A", "#A5ACAF"];
+	const key = `${n}|${style}|${colors.join()}|${opts.bare ? 1 : 0}`;
+	const hit = cache.get(key);
+	if (hit) {
+		return hit;
+	}
+	const id = `sb${n}${style[0]}`;
+	// real eras through LXI; after that, generated eras: a block of 6-10 games shares one template and numeral face,
+	// each block different from the one before (like XLV-L sharing the silver mark)
+	// the real logos (I-LXI) are their own designs, on white like the originals; generated games get the host city's
+	// themed marks
+	const plain = !opts.style && !opts.colors;
+	const realBody = plain
+		? (realEarlyLogo(n, superBowlHost(n)) ?? realLateLogo(n, superBowlName(n)))
+		: undefined;
+	const genBody =
+		!realBody && !opts.style && n > 61
+			? generatedLogo(n, superBowlName(n), superBowlHost(n), colors)
+			: undefined;
+	if (realBody || genBody) {
+		const out = url(
+			opts.bare
+				? // no white card: the logo cut out like a sticker, a white edge hugging its shape, for banners and dark backgrounds
+					`<svg xmlns='http://www.w3.org/2000/svg' viewBox='-12 -12 280 280'><defs><filter id='sbh' filterUnits='userSpaceOnUse' x='-12' y='-12' width='280' height='280'><feMorphology in='SourceAlpha' operator='dilate' radius='7' result='d'/><feFlood flood-color='#fff'/><feComposite in2='d' operator='in' result='w'/><feMerge><feMergeNode in='w'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><g filter='url(#sbh)'>${realBody ?? genBody}</g></svg>`
+				: `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256'><rect x='4' y='4' width='248' height='248' rx='18' fill='#fff'/>${realBody ?? genBody}</svg>`,
+		);
+		cache.set(key, out);
+		return out;
+	}
+	const future = n > 61 ? futureEra(n) : undefined;
+	FACE = future?.face ?? null;
+	const body = future
+		? future.layout(n, colors, id)
+		: (n <= 10
+				? classic
+				: n <= 20
+					? eighties
+					: n <= 25
+						? eightiesWide
+						: n <= 35
+							? crest
+							: n <= 44
+								? crestSide
+								: modern)(n, colors, id);
+	FACE = null;
+	const out = url(
+		`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256'>${body}</svg>`,
+	);
+	cache.set(key, out);
+	return out;
+};
