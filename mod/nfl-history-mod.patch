@@ -0,0 +1,28 @@
+import { PHASE } from "../../common/constants.ts";
+import { g } from "../util/index.ts";
+
+// NFL history mod: keep real players on their real teams while the league is inside the real data.
+// With Historical Rosters on, AI teams don't trade with each other, only sign real players who really played for
+// them that season, and release real players who aren't theirs each preseason. The user's own team is never touched.
+
+// The season a roster move counts for: after the draft, moves are for next season
+export const nflRosterSeason = () =>
+	g.get("phase") >= PHASE.AFTER_DRAFT ? g.get("season") + 1 : g.get("season");
+
+export const nflRealRostersActive = (season: number = nflRosterSeason()) =>
+	__SPORT === "football" &&
+	!!g.get("nflHistoricalRosters") &&
+	Object.hasOwn(g, "nflRealDataLastSeason") &&
+	season <= (g as any).nflRealDataLastSeason;
+
+// May this player join this team? Players without real data (generated ones) can go anywhere.
+export const nflCanJoin = (
+	p: { realTeams?: Record<string, number> },
+	tid: number,
+	season: number = nflRosterSeason(),
+) => {
+	if (!nflRealRostersActive(season) || !p.realTeams) {
+		return true;
+	}
+	return p.realTeams[season] === tid;
+};
