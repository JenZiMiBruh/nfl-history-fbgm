+	const f = o.facing ?? 1;
+	const skin = o.skin ?? "#c68a5e";
+	const side = o.ref
+		? undefined
+		: o.uni
+			? o.away
+				? o.uni.road
+				: o.uni.home
+			: undefined;
+	const jersey = o.ref ? "#ffffff" : (side?.jersey ?? (o.away ? "#f8fafc" : P));
+	const trim = o.ref
+		? "#111111"
+		: side?.stripe && side.stripe !== side.jersey
+			? side.stripe
+			: o.away
+				? P
+				: (o.colors[1] ?? "#ffffff");
+	const pants = o.ref
+		? "#1f2937"
+		: (side?.pants ?? (o.away ? "#e2e8f0" : (o.colors[1] ?? "#f1f5f9")));
