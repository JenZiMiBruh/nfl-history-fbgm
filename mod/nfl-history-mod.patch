+// 2010-2012: grunge paint flung out from behind him, in his team's colors, stadium lights above
+const Paint = ({ colors, seed }: { colors: string[]; seed: number }) => {
+	const r = rnd(seed);
+	const out: ReactNode[] = [];
+	for (let i = 0; i < 90; i++) {
+		const a = r() * Math.PI * 2;
+		const dd = 14 + r() * 62;
+		const x = 50 + Math.cos(a) * dd;
+		const y = 64 + Math.sin(a) * dd * 1.15;
+		const s = i < 14 ? 3 + r() * 8 : 0.4 + r() * 2.4;
+		out.push(
+			<g key={i} fill={colors[i % colors.length]} opacity={0.5 + r() * 0.45}>
+				<ellipse cx={x} cy={y} rx={s * 1.4} ry={s * 0.7} transform={`rotate(${(a * 180) / Math.PI} ${x} ${y})`} />
+				<circle cx={x + Math.cos(a) * s * 2} cy={y + Math.sin(a) * s * 2} r={s * 0.3} />
+				<circle cx={x + Math.cos(a) * s * 3} cy={y + Math.sin(a) * s * 3} r={s * 0.16} />
+			</g>,
+		);
+	}
+	return (
+		<Svg>
+			<rect width="100" height="140" fill="#fbfaf8" />
+			<rect width="100" height="30" fill="url(#none)" />
+			{[12, 30, 70, 88].map((x) => (
