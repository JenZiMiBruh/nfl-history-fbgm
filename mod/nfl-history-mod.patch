+				</button>
+				<button
+					type="button"
+					className="btn btn-sm"
+					style={{
+						background: "rgba(2,6,23,.75)",
+						color: "#ffffff",
+						border: "1px solid rgba(255,255,255,.35)",
+						minWidth: 30,
+						fontWeight: 700,
+					}}
+					onClick={() => st && (st.userZoom = Math.min(4, st.userZoom * 1.3))}
+					aria-label="Zoom in"
