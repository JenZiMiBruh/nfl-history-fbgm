+						style={{
+							position: "absolute",
+							inset: 0,
+							animation: "nflc-push 3s ease-out both",
+						}}
+					>
+						<defs>
+							<radialGradient id="nflcBg" cx="50%" cy="38%" r="75%">
+								<stop offset="0" stopColor={mid} />
+								<stop offset="1" stopColor={dark} />
+							</radialGradient>
+							<linearGradient id="nflcGloss" x1="0" x2="1" y1="0" y2="1">
+								<stop offset="0" stopColor="#fff" stopOpacity=".22" />
+								<stop offset=".5" stopColor="#fff" stopOpacity="0" />
+								<stop offset="1" stopColor="#000" stopOpacity=".25" />
+							</linearGradient>
