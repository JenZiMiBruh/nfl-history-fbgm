+										>
+											{d}
+										</div>
+									))}
+									{cells.map((date, i) => {
+										if (!date) {
+											return <div key={i} />;
+										}
+										const list = byDate.get(dayKey(date)) ?? [];
+										const mine = list.find(
+											(x) =>
+												x.game.homeTid === focusTid ||
+												x.game.awayTid === focusTid,
+										);
+										// The day's most notable slot sets its color (Super Bowl > playoffs > holidays > primetime)
+										const notable = list
+											.map((x) => slotStyle(x.info))
+											.find(Boolean);
+										const allPrimetime =
+											list.length > 0 && list.every((x) => x.info.primetime);
+										const st = list.find(
+											(x) => x.info.superBowl || x.info.round,
+										)
+											? slotStyle(list[0]!.info)
+											: allPrimetime ||
+												  list.some((x) =>
+														/Thanksgiving|Christmas|Kickoff/.test(
+															x.info.slot ?? "",
+														),
+												  )
+												? notable
+												: undefined;
+										const inWeek = week?.entries.some(
+											(x) => dayKey(x.info.date) === dayKey(date),
+										);
+										const opp = mine
+											? teams[
+													mine.game.homeTid === focusTid
+														? mine.game.awayTid
+														: mine.game.homeTid
+												]
+											: undefined;
+										return (
+											<div
+												key={i}
+												onClick={() => {
+													if (list[0]) {
+														const e = list[0].info;
+														setSelectedWeek(
+															e.week !== undefined
+																? `w${e.week}`
+																: `p${e.round}`,
+														);
+														setFocusDay(dayKey(date));
+													}
+												}}
+												title={
+													list.length
+														? `${list.length} game${list.length > 1 ? "s" : ""}${st ? ` · ${st.label}` : ""}`
+														: undefined
+												}
+												className="rounded text-center"
+												style={{
+													cursor: list.length ? "pointer" : undefined,
+													height: 40,
+													padding: "2px 0",
+													background: st
+														? st.bg
+														: list.length
+															? "var(--bs-secondary-bg)"
+															: undefined,
+													color: st ? st.fg : undefined,
+													outline: inWeek
+														? "2px solid var(--bs-primary)"
+														: undefined,
+													fontSize: "0.7rem",
+													lineHeight: 1.15,
+													opacity: list.length ? 1 : 0.45,
+												}}
+											>
+												<div style={{ fontWeight: list.length ? 700 : 400 }}>
+													{date.getUTCDate()}
+												</div>
+												{opp ? (
+													<img
+														src={opp.imgURL}
+														alt={opp.abbrev}
+														title={`${mine!.game.homeTid === focusTid ? "vs" : "@"} ${opp.abbrev}`}
+														style={{
+															width: 18,
+															height: 18,
+															objectFit: "contain",
+														}}
+													/>
+												) : list.length ? (
+													<div style={{ opacity: 0.8 }}>{list.length}</div>
+												) : null}
+											</div>
+										);
+									})}
+								</div>
+							</div>
+						);
+					})}
+				</div>
+			</details>
+		</>
+	);
+};
+
+// The calendar page
+const NflCalendar = (props: View<"nflCalendar">) => {
+	const { teamTid, teams, season } = props;
+	useTitleBar({
+		title:
+			teamTid !== undefined && teams[teamTid]
+				? `${teams[teamTid]!.region} ${teams[teamTid]!.name} Calendar`
+				: "Calendar",
+		jumpTo: true,
+		jumpToSeason: season,
+		dropdown: {
+			fields: [{ key: "season", options: { type: "seasons" }, value: season }],
+			urlOverride: (values) =>
+				teamTid !== undefined && teams[teamTid]
+					? ["calendar", values.season, `${teams[teamTid]!.abbrev}_${teamTid}`]
+					: ["calendar", values.season],
+		},
+	});
+	return <NflCalendarBody {...props} />;
+};
+
+export default NflCalendar;
