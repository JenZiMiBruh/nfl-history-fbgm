+// NFL history mod: watch each play. A top-down field with all 22 players; when the game sim reports a play it's
+// acted out: the snap, the quarterback's drop, the handoff or the throw, the catch, the run after the catch, and
+// the tackle and pileup. Kickoffs, punts, field goals, sacks, interceptions, fumbles, penalties and kneel-downs have
+// their own formations.
+//
+// The outcome (yards, who had the ball, touchdowns, made or missed kicks) always matches the sim; the paths in
+// between are drawn to fit it, with variety so the same result doesn't look the same twice:
+//   - players sway at the line before the snap and react at different moments after it
+//   - linemen battle in pairs, shoving back and forth
+//   - routes and runs follow smooth curves (Catmull-Rom splines through the waypoints)
+//   - runs come in three styles (inside plunge, cutback, bounce outside); misses in three (overthrow, swatted, dropped)
+//   - after a tackle, nearby players gather into a pileup
+// The ball always belongs to a player (it moves with whoever holds it) except while it's snapped, thrown, kicked or
+// loose, so it can't drift away from the ball carrier. Plays queue up, so an animation is never cut off by the next.
+import { setLiveFaces } from "./liveFaces.ts";
+import { chooseSmallLogo } from "../../util/chooseSmallLogo.ts";
+import { NflDebug, override, type Scenario } from "./NflDebug.tsx";
+import { FX, fx, setFx, type FxKey } from "./NflSettings.ts";
+import { useEffect, useMemo, useRef, useState } from "react";
+import { display } from "facesjs";
+import { readableOn, useNflGameInfo } from "../../components/NflGameInfo.tsx";
+import { NflFieldTop } from "./NflFieldTop.tsx";
+import { Motion, type Goal } from "./NflMotion.ts";
+import {
+	NflField3D,
+	faceFingerprint,
+	webglAvailable,
+	type Frame3D,
+	type PlayerStyle,
+} from "./NflField3D.tsx";
+import { toWorker } from "../../util/toWorker.ts";
+import { cutscenes } from "./NflCutscene.ts";
+
+// Field coordinates in yards: x 0-120 (end zones 0-10 and 110-120), y 0-53.3
+const W = 120;
+const H = 53.3;
+const MID = H / 2;
+const HASH_A = H * 0.4;
+const HASH_B = H * 0.6;
+const POST_HALF = 3.08; // goalposts are 18 ft 6 in apart
+
+type Pt = { x: number; y: number };
+type Path = { t: number; x: number; y: number }[];
+// delay: reaction time after the snap (fraction of the play); jitter: how much the player sways and shoves
+type Actor = {
+	block?: string;
+	id: string;
+	side: "o" | "d";
+	num?: string;
+	pid?: number;
+	name?: string;
+	key?: boolean;
+	path: Path;
+	kneel?: number;
+	delay?: number;
+	jitter?: number;
+};
+type Pl = { num?: string; pid?: number; name?: string };
+type BallSeg =
+	| { t0: number; t1: number; hold: string }
+	// (startZ/endZ: heights at either end, for a flight that doesn't start or end on the ground: a kick through the uprights
+	// into the net behind them)
+	| {
+			t0: number;
+			t1: number;
+			from: Pt | string;
+			to: Pt | string;
+			peak: number;
+			spin?: boolean;
+			startZ?: number;
+			endZ?: number;
+	  }
+	| { t0: number; t1: number; at: Pt };
+export type PlayPacket = {
+	id: number;
+	events: any[];
+	before: { t: 0 | 1; s: number; toGo: number; awaitingKickoff: boolean };
+	after: {
+		t: 0 | 1;
+		s: number;
+		toGo?: number;
+		awaitingKickoff?: boolean;
+		clock?: number;
+	}; // clock: seconds left in the quarter after the play
+	// Filled in if a flag comes in right after the play
+	penalty?: { name: string; accepted: boolean; ev?: any; evs?: any[] };
+};
+type Team = {
+	abbrev: string;
+	region: string;
+	name: string;
+	colors?: string[];
+	imgURL?: string;
+	imgURLSmall?: string;
+	players?: any[];
+};
+type Play = {
+	actors: Actor[];
+	ball: BallSeg[];
+	label: string;
+	kind: string;
+	oTeam: 0 | 1;
+	result?: { t: number; text: string; x: number };
+	flag?: { t: number; x: number; y: number };
+	endY: number; // where the ball ended up across the field, for the next snap's hash mark
+	callouts: { t: number; text: string }[];
+	cues: { t: number; s: Sound }[];
+	packet?: PlayPacket;
+	// Seconds the real thing takes (kicks), and the share of the timeline after which the play is over
+	secs?: number;
+	endT?: number;
+};
+type Numbers = {
+	o: Record<string, Pl>;
+	d: Record<string, Pl>;
+	poolO: Pl[];
+	poolD: Pl[];
+	all?: Pl[];
+	allO?: Pl[];
+	allD?: Pl[];
+};
+
+const LEFT_T = 1; // the away team is on the left and drives right, like the game's own field
+// Teams switch ends after the first and third quarters (like the NFL): in the 2nd and 4th quarters everything is mirrored.
+// Set at the top of every render from the quarter on the scoreboard (one game on screen at a time).
+let FIELD_FLIP = false;
+const dirOf = (t: 0 | 1) => ((t === LEFT_T) !== FIELD_FLIP ? 1 : -1);
+const xOf = (t: 0 | 1, s: number) => 10 + (dirOf(t) > 0 ? s : 100 - s);
+const clamp = (v: number, lo: number, hi: number) =>
+	Math.max(lo, Math.min(hi, v));
+const rnd = (a: number, b: number) => a + Math.random() * (b - a);
+const pick = <T,>(xs: T[]) => xs[Math.floor(Math.random() * xs.length)]!;
+const inField = (p: Pt): Pt => ({
+	x: clamp(p.x, 0.5, W - 0.5),
+	y: clamp(p.y, 1, H - 1),
+});
+const hashFor = (y: number) => (y < HASH_A ? HASH_A : y > HASH_B ? HASH_B : y);
+
+// Position on a path: a smooth curve through the waypoints, easing out of the first one (a player getting going)
+const at = (path: Path, t: number): Pt => {
+	if (t <= path[0]!.t) return path[0]!;
+	for (let i = 1; i < path.length; i++) {
+		const p1 = path[i - 1]!;
+		const p2 = path[i]!;
+		if (t <= p2.t) {
+			let k = p2.t === p1.t ? 1 : (t - p1.t) / (p2.t - p1.t);
+			if (i === 1) k = k * k * (3 - 2 * k) * 0.5 + k * 0.5;
+			const p0 = path[i - 2] ?? p1;
+			const p3 = path[i + 1] ?? p2;
+			const k2 = k * k;
+			const k3 = k2 * k;
+			const cr = (a: number, b: number, c: number, d: number) =>
+				0.5 *
+				(2 * b +
+					(-a + c) * k +
+					(2 * a - 5 * b + 4 * c - d) * k2 +
+					(-a + 3 * b - 3 * c + d) * k3);
+			return { x: cr(p0.x, p1.x, p2.x, p3.x), y: cr(p0.y, p1.y, p2.y, p3.y) };
+		}
+	}
+	return path.at(-1)!;
+};
+const P = (...pts: [number, Pt][]): Path =>
+	pts.map(([t, p]) => ({ t, ...inField(p) }));
+
+// Small steady noise per player: sway before the snap, shoving in the trenches
+const hash = (s: string) => {
+	let h = 7;
+	for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
+	return (h >>> 0) / 4294967296;
+};
+const actorAt = (a: Actor, t: number, now: number): Pt => {
+	const delay = a.delay ?? 0;
+	const tt = delay > 0 ? clamp((t - delay) / (1 - delay), 0, 1) : t;
+	const p = at(a.path, tt);
+	// No sway: a target that wobbles makes a player shuffle back and forth around it
+	void now;
+	return p;
+};
+
+const ballPos = (play: Play, t: number, now: number) => {
+	const actor = (id: string) => play.actors.find((a) => a.id === id);
+	const posOf = (ref: Pt | string, when: number): Pt =>
+		typeof ref === "string"
+			? actor(ref)
+				? actorAt(actor(ref)!, when, now)
+				: { x: 60, y: MID }
+			: ref;
+	const seg =
+		play.ball.find((s) => t >= s.t0 && t <= s.t1) ??
+		(t < play.ball[0]!.t0 ? play.ball[0]! : play.ball.at(-1)!);
+	if ("hold" in seg) return { ...posOf(seg.hold, t), z: 0 };
+	if ("at" in seg) return { ...seg.at, z: 0 };
+	const from = posOf(seg.from, seg.t0);
+	const to = posOf(seg.to, seg.t1);
+	const k =
+		seg.t1 === seg.t0 ? 1 : clamp((t - seg.t0) / (seg.t1 - seg.t0), 0, 1);
+	return {
+		x: from.x + (to.x - from.x) * k,
+		y: from.y + (to.y - from.y) * k,
+		z:
+			4 * k * (1 - k) * seg.peak +
+			k * ((seg as any).endZ ?? 0) +
+			(1 - k) * ((seg as any).startZ ?? 0),
+	};
+};
+
+// Formations at the line of scrimmage x0, centered on the hash cy, offense going direction d
+type Formation = "shotgun" | "iform" | "singleback" | "spread";
+const offense = (
+	x0: number,
+	cy: number,
+	d: number,
+	f: Formation,
+): Record<string, Pt> => {
+	const base: Record<string, Pt> = {
+		LT: { x: x0 - d * 1, y: cy - 4.6 },
+		LG: { x: x0 - d * 1, y: cy - 2.3 },
+		C: { x: x0 - d * 0.7, y: cy },
+		RG: { x: x0 - d * 1, y: cy + 2.3 },
+		RT: { x: x0 - d * 1, y: cy + 4.6 },
+		TE: { x: x0 - d * 1.2, y: cy + 7 },
+		QB: { x: x0 - d * 1.6, y: cy },
+		RB: { x: x0 - d * 7, y: cy },
+		WR1: { x: x0 - d * 1, y: 5 },
+		WR2: { x: x0 - d * 1, y: H - 5 },
+		WR3: { x: x0 - d * 1.6, y: cy < MID ? H - 14 : 14 },
+	};
+	if (f === "shotgun") {
+		base.QB = { x: x0 - d * 5, y: cy };
+		base.RB = { x: x0 - d * 5, y: cy - 2 };
+	} else if (f === "iform") {
+		base.WR3 = { x: x0 - d * 4.5, y: cy }; // the fullback
+		base.RB = { x: x0 - d * 7.5, y: cy };
+	} else if (f === "spread") {
+		base.QB = { x: x0 - d * 5, y: cy };
+		base.RB = { x: x0 - d * 5, y: cy + 2 };
+		base.TE = { x: x0 - d * 1.6, y: cy < MID ? 14 : H - 14 };
+	}
+	return base;
+};
+const defense = (x0: number, cy: number, d: number): Record<string, Pt> => ({
+	DE1: { x: x0 + d * 1.2, y: cy - 6 },
+	DT1: { x: x0 + d * 1.2, y: cy - 1.6 },
+	DT2: { x: x0 + d * 1.2, y: cy + 1.6 },
+	DE2: { x: x0 + d * 1.2, y: cy + 6 },
+	LB1: { x: x0 + d * 5, y: cy - 6.5 },
+	LB2: { x: x0 + d * 5, y: cy },
+	LB3: { x: x0 + d * 5, y: cy + 6.5 },
+	CB1: { x: x0 + d * 7, y: 5.5 },
+	CB2: { x: x0 + d * 7, y: H - 5.5 },
+	S1: { x: x0 + d * 13, y: cy - 9 },
+	S2: { x: x0 + d * 13, y: cy + 9 },
+});
+const OL = ["LT", "LG", "C", "RG", "RT"];
+const DL = ["DE1", "DT1", "DT2", "DE2"];
+const BACK7 = ["LB1", "LB2", "LB3", "CB1", "CB2", "S1", "S2"];
+
+type Sound =
+	| "snap"
+	| "kick"
+	| "catch"
+	| "thud"
+	| "whistle"
+	| "roar"
+	| "groan"
+	| "organ";
+// Broadcast touches for a play: callouts over the action and sound cues, timed to the animation
+const presentation = (
+	kind: string,
+	ev: any[],
+	result: Play["result"],
+	flag: Play["flag"],
+) => {
