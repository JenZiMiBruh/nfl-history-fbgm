+	// the Pacific: teal swells with curling white crests
+	waves: (p, x0, y0, x1, y1) => {
+		const w = x1 - x0;
+		const h = y1 - y0;
+		let out = `<defs>${lin(`${p}wv`, ["#0B5E6B", "#0E8C96", "#29B3B0"])}</defs><rect x='${x0}' y='${y0}' width='${w}' height='${h}' fill='url(#${p}wv)'/>`;
+		// each swell rises from the left and curls over at its crest
+		const curl = (cx: number, cy: number, r: number) =>
+			`<path d='M${cx - r * 2.2} ${cy + r} Q${cx - r} ${cy + r} ${cx - r * 0.6} ${cy - r * 0.2} Q${cx} ${cy - r * 1.4} ${cx + r} ${cy - r * 0.6} Q${cx + r * 1.2} ${cy + r * 0.2} ${cx + r * 0.3} ${cy + r * 0.2} Q${cx - r * 0.2} ${cy} ${cx + r * 0.2} ${cy - r * 0.4}' fill='none' stroke='#F7F3E8' stroke-width='${(r * 0.28).toFixed(1)}' stroke-linecap='round'/>` +
+			`<path d='M${cx - r * 2.2} ${cy + r * 1.5} Q${cx - r * 0.8} ${cy + r * 1.4} ${cx - r * 0.2} ${cy + r * 0.6}' fill='none' stroke='#7FE0D4' stroke-width='${(r * 0.16).toFixed(1)}' stroke-linecap='round'/>`;
