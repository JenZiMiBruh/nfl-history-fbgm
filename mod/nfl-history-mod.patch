+		g.lineTo(ex, ey);
+		g.stroke();
+		g.strokeStyle = skin;
+		g.lineWidth = 17;
+		g.beginPath();
+		g.moveTo(ex, ey);
+		g.lineTo(hx, hy);
+		g.stroke();
+		g.fillStyle = "#6b3410";
+		g.beginPath();
