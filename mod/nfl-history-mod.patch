@@ -0,0 +1,299 @@
+// NFL history mod: betting lines and projections on the Calendar. The line comes from the same formula Football GM
+// uses for its own spreads (team ratings, 3 points for home field); the win chance from the line (NFL games are about a
+// 13.5-point standard deviation). Projected records add the win chances of the games left to the record so far, so they
+// move every week as results come in and ratings change. All of it is computed from the current ratings.
+
+type Team = {
+	abbrev: string;
+	region: string;
+	name: string;
+	colors: [string, string, string];
+	ovr?: number;
+};
+type Game = {
+	homeTid: number;
+	awayTid: number;
+	homePts?: number;
+	awayPts?: number;
+	neutralSite: boolean;
+	playoffs: boolean;
+	pending?: boolean;
+};
+
+const SD = 13.5;
+const erf = (x: number) => {
+	// Abramowitz-Stegun approximation
+	const t = 1 / (1 + 0.3275911 * Math.abs(x));
+	const y =
+		1 -
+		((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) *
+			t +
+			0.254829592) *
+			t *
+			Math.exp(-x * x);
+	return x >= 0 ? y : -y;
+};
+const cdf = (z: number) => 0.5 * (1 + erf(z / Math.SQRT2));
+
+// Points the home team is favored by (negative: the visitors are favored)
+export const lineFor = (teams: Record<number, Team>, g: Game) => {
+	const h = teams[g.homeTid]?.ovr;
+	const a = teams[g.awayTid]?.ovr;
+	if (h === undefined || a === undefined) return undefined;
+	return Math.round(((3 / 10) * (h - a) + (g.neutralSite ? 0 : 3)) * 2) / 2;
+};
+export const homeWinChance = (line: number) => cdf(line / SD);
+
+export const GameLine = ({
+	teams,
+	game,
+}: {
+	teams: Record<number, Team>;
+	game: Game;
+}) => {
+	if (game.homePts !== undefined || game.pending) return null;
+	const line = lineFor(teams, game);
+	if (line === undefined) return null;
+	const p = homeWinChance(line);
+	const favHome = line >= 0;
+	const fav = teams[favHome ? game.homeTid : game.awayTid];
+	const pct = Math.round((favHome ? p : 1 - p) * 100);
+	return (
+		<span
+			className="badge border text-body fw-semibold"
+			title={`Win chance from the line: ${fav?.abbrev} ${pct}%`}
+			style={{ fontVariantNumeric: "tabular-nums" }}
+		>
+			{line === 0 ? "PK" : `${fav?.abbrev} −${Math.abs(line)}`} · {pct}%
+		</span>
+	);
+};
+
+// Record so far and projected final record for a team (regular season)
+export const projectTeam = (
+	teams: Record<number, Team>,
+	games: Game[],
+	tid: number,
+) => {
+	let w = 0;
+	let l = 0;
+	let tie = 0;
+	let expW = 0;
+	let left = 0;
+	const byWeek: { actual?: number; proj: number }[] = [];
+	for (const g of games) {
+		if (g.playoffs || (g.homeTid !== tid && g.awayTid !== tid)) continue;
+		const home = g.homeTid === tid;
+		if (g.homePts !== undefined && g.awayPts !== undefined) {
+			const my = home ? g.homePts : g.awayPts;
+			const op = home ? g.awayPts : g.homePts;
+			if (my > op) w++;
+			else if (my < op) l++;
+			else tie++;
+		} else {
+			const line = lineFor(teams, g);
+			const p = line === undefined ? 0.5 : homeWinChance(line);
+			expW += home ? p : 1 - p;
+			left++;
+		}
+		byWeek.push({
+			actual: g.homePts !== undefined ? w + tie / 2 : undefined,
+			proj: w + tie / 2 + expW,
+		});
+	}
+	const projW = w + expW;
+	return { w, l, tie, projW, projL: l + (left - expW), left, byWeek };
+};
+
+// A team's season so far (solid) and where it's headed (dashed), game by game
+export const TeamProjection = ({
+	teams,
+	games,
+	tid,
+}: {
+	teams: Record<number, Team>;
+	games: Game[];
+	tid: number;
+}) => {
+	const p = projectTeam(teams, games, tid);
+	const t = teams[tid];
+	if (!t || p.byWeek.length === 0) return null;
+	const W = 420;
+	const H = 120;
+	const n = p.byWeek.length;
+	const maxW = Math.max(n, 1);
+	const x = (i: number) => 20 + (i / Math.max(1, n - 1)) * (W - 30);
+	const y = (v: number) => H - 18 - (v / maxW) * (H - 30);
+	const actual = p.byWeek
+		.map((b, i) => (b.actual !== undefined ? `${x(i)},${y(b.actual)}` : ""))
+		.filter(Boolean);
+	const lastActual = p.byWeek.reduce(
+		(k, b, i) => (b.actual !== undefined ? i : k),
+		-1,
+	);
+	const proj = p.byWeek
+		.map((b, i) => (i >= lastActual ? `${x(i)},${y(b.proj)}` : ""))
+		.filter(Boolean);
+	const col = t.colors[0];
+	return (
+		<div className="d-flex flex-wrap gap-4 align-items-center mb-3">
+			<div>
+				<div className="text-body-secondary small">Record</div>
+				<div className="fs-3 fw-bold lh-1">
+					{p.w}-{p.l}
+					{p.tie ? `-${p.tie}` : ""}
+				</div>
+			</div>
+			<div>
+				<div className="text-body-secondary small">Projected</div>
+				<div className="fs-3 fw-bold lh-1">
+					{p.projW.toFixed(1)}-{p.projL.toFixed(1)}
+				</div>
+				<div className="text-body-secondary small">
+					{p.left} games left, from the betting lines
+				</div>
+			</div>
+			<svg
+				viewBox={`0 0 ${W} ${H}`}
+				style={{ width: "100%", maxWidth: W }}
+				role="img"
+				aria-label="Wins so far and projected"
+			>
+				{[0.25, 0.5, 0.75, 1].map((f) => (
+					<line
+						key={f}
+						x1={20}
+						x2={W - 10}
+						y1={y(maxW * f)}
+						y2={y(maxW * f)}
+						stroke="currentColor"
+						strokeOpacity={0.12}
+					/>
+				))}
+				<polyline
+					points={proj.join(" ")}
+					fill="none"
+					stroke={col}
+					strokeOpacity={0.6}
+					strokeWidth={2.5}
+					strokeDasharray="6 5"
+				/>
+				<polyline
+					points={actual.join(" ")}
+					fill="none"
+					stroke={col}
+					strokeWidth={3}
+				/>
+				<text
+					x={W - 10}
+					y={y(p.projW) - 6}
+					textAnchor="end"
+					fontSize={12}
+					fill="currentColor"
+				>
+					{p.projW.toFixed(1)} wins
+				</text>
+				<text x={20} y={H - 4} fontSize={11} fill="currentColor" opacity={0.6}>
+					Game 1
+				</text>
+				<text
+					x={W - 10}
+					y={H - 4}
+					fontSize={11}
+					fill="currentColor"
+					opacity={0.6}
+					textAnchor="end"
+				>
+					Game {n}
+				</text>
+			</svg>
+		</div>
+	);
+};
+
+// Every team's projected wins as bars, best first
+export const LeagueProjections = ({
+	teams,
+	games,
+}: {
+	teams: Record<number, Team>;
+	games: Game[];
+}) => {
+	const rows = Object.keys(teams)
+		.map(Number)
+		.filter(
+			(tid) =>
+				teams[tid]?.ovr !== undefined &&
+				games.some(
+					(g) => !g.playoffs && (g.homeTid === tid || g.awayTid === tid),
+				),
+		)
+		.map((tid) => ({ tid, ...projectTeam(teams, games, tid) }))
+		.sort((a, b) => b.projW - a.projW);
+	if (rows.length === 0) return null;
+	const most = Math.max(...rows.map((r) => r.w + r.l + r.tie + r.left), 1);
+	return (
+		<div className="mb-4" style={{ maxWidth: 980 }}>
+			<h2 className="mb-1">Projected wins</h2>
+			<p className="text-body-secondary small mb-2">
+				Record so far (solid) plus the expected wins from the betting lines of
+				the games left (light). Updates every week.
+			</p>
+			<div
+				className="d-grid gap-1"
+				style={{ gridTemplateColumns: "repeat(auto-fill, minmax(300px, 1fr))" }}
+			>
+				{rows.map((r) => {
+					const t = teams[r.tid]!;
+					return (
+						<div key={r.tid} className="d-flex align-items-center gap-2 small">
+							<span className="fw-semibold" style={{ width: 40 }}>
+								{t.abbrev}
+							</span>
+							<div
+								className="flex-grow-1 rounded"
+								style={{
+									height: 14,
+									background: "rgba(128,128,128,.15)",
+									position: "relative",
+									overflow: "hidden",
+								}}
+							>
+								<div
+									style={{
+										position: "absolute",
+										left: 0,
+										top: 0,
+										bottom: 0,
+										width: `${(r.w / most) * 100}%`,
+										background: t.colors[0],
+									}}
+								/>
+								<div
+									style={{
+										position: "absolute",
+										left: `${(r.w / most) * 100}%`,
+										top: 0,
+										bottom: 0,
+										width: `${((r.projW - r.w) / most) * 100}%`,
+										background: t.colors[0],
+										opacity: 0.35,
+									}}
+								/>
+							</div>
+							<span
+								style={{
+									width: 76,
+									textAlign: "right",
+									fontVariantNumeric: "tabular-nums",
+								}}
+							>
+								{r.projW.toFixed(1)}-{r.projL.toFixed(1)}
+							</span>
+						</div>
+					);
+				})}
+			</div>
+		</div>
+	);
+};
