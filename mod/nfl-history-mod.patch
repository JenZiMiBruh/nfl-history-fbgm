+// NFL history mod: worker functions for Live Football and the calendar
+import { castCoverVote } from "../views/nflCoverVote.ts";
+import { player, team } from "../core/index.ts";
+import { idb } from "../db/index.ts";
+import { g } from "../util/index.ts";
+import { faceJerseyFor } from "../util/faceJerseyFor.ts";
+import { getNflSeasonGames } from "../views/nflCalendar.ts";
+
+// NFL history mod: every game of a season, for game dates, times and weather (common/nflCalendar.ts)
+const getNflSeasonGamesApi = async (season: number) =>
+	getNflSeasonGames(season);
+
+// NFL history mod: faces (or real photos) and jerseys of the players in a live game, for the animated field
+const getNflGameFaces = async (pids: number[]) => {
+	const out: {
+		pid: number;
+		face?: unknown;
+		imgURL?: string;
+		jersey?: string;
+		move?: { spd: number; elu: number; stre: number; hgt: number };
+		nfl?: unknown;
+	}[] = [];
+	for (const pid of pids) {
+		const p = await idb.cache.players.get(pid);
+		if (p) {
+			// How he moves in the animated live game: speed, elusiveness, strength, size
+			const r: any = p.ratings.at(-1);
+			const move =
+				r && typeof r.spd === "number"
+					? {
+							spd: r.spd,
+							elu: r.elu ?? 50,
+							stre: r.stre ?? 50,
+							hgt: r.hgt ?? 50,
+						}
+					: undefined;
+			out.push({
+				pid,
+				// NFL history mod: the same face every other page shows, aged and with this season's mood (common/faceAging.ts)
+				face: p.face || undefined,
+				imgURL: p.imgURL || undefined,
+				jersey:
+					p.tid >= 0 ? (await idb.cache.teams.get(p.tid))?.jersey : undefined,
+				move,
+				// NFL history mod: his real jersey this season, so live-view pictures show the player page's jersey and arms
+				nfl:
+					p.tid >= 0
+						? await faceJerseyFor(p.tid, g.get("season"), p.jerseyNumber)
+						: undefined,
+			});
+		}
+	}
+	return out;
+};
+
+// NFL history mod: everything the live game's pregame show and broadcast graphics need for the two teams: records, points
+// per game, season leaders, starters with their ratings and season lines, the division standings, and the MVP race
+// No spoilers: the live game (and anything played that day or later) is already in the database when it's watched,
+// so the records, team stats and season lines here are taken back to before that day
+const undoFrom = async (season: number, day: number | undefined) => {
+	const team = new Map<
+		number,
+		{
+			won: number;
+			lost: number;
+			tied: number;
+			gp: number;
+			pts: number;
+			oppPts: number;
+		}
+	>();
+	const player = new Map<number, Record<string, number>>();
+	if (day === undefined) return { team, player };
+	const games: any[] = await idb.merged.games.getAll({ season });
+	for (const gm of games) {
+		if (gm.day === undefined || gm.day < day || gm.playoffs) continue;
+		const [a, b] = gm.teams;
+		for (const [t, o] of [
+			[a, b],
+			[b, a],
+		]) {
+			const x = team.get(t.tid) ?? {
+				won: 0,
+				lost: 0,
+				tied: 0,
+				gp: 0,
+				pts: 0,
+				oppPts: 0,
+			};
+			x.gp++;
+			x.pts += t.pts ?? 0;
+			x.oppPts += o.pts ?? 0;
+			if (t.pts > o.pts) x.won++;
+			else if (t.pts < o.pts) x.lost++;
+			else x.tied++;
+			team.set(t.tid, x);
+			for (const pl of t.players ?? []) {
+				const s = player.get(pl.pid) ?? {};
+				for (const k of Object.keys(pl))
+					if (typeof pl[k] === "number" && k !== "pid")
+						s[k] = (s[k] ?? 0) + pl[k];
+				if (!pl.gp) s.gp = (s.gp ?? 0) + ((pl.min ?? 1) > 0 ? 1 : 0);
+				player.set(pl.pid, s);
+			}
+		}
+	}
+	return { team, player };
+};
+const unspoilStats = (
+	stats: any,
+	minus: Record<string, number> | undefined,
+) => {
+	if (!stats || !minus) return stats;
+	const out = { ...stats };
+	for (const k of Object.keys(out))
+		if (typeof out[k] === "number" && typeof minus[k] === "number")
+			out[k] = Math.max(0, out[k] - minus[k]);
+	return out;
+};
+
+const getNflPregame = async (
+	arg: number[] | { tids: number[]; day?: number },
+) => {
+	const tids = Array.isArray(arg) ? arg : arg.tids;
+	const day = Array.isArray(arg) ? undefined : arg.day;
+	const season = g.get("season");
+	const undo = await undoFrom(season, day);
+	const allTs = (
+		await idb.cache.teamSeasons.indexGetAll("teamSeasonsBySeasonTid", [
+			[season],
+			[season, "Z"],
+		])
+	).map((x: any) => {
+		const u = undo.team.get(x.tid);
+		return u
+			? {
+					...x,
+					won: Math.max(0, x.won - u.won),
+					lost: Math.max(0, x.lost - u.lost),
+					tied: Math.max(0, (x.tied ?? 0) - u.tied),
+				}
+			: x;
+	});
+	const teamsAll = await idb.cache.teams.getAll();
+	const STAT = [
+		"gp",
+		"pss",
+		"pssCmp",
+		"pssYds",
+		"pssTD",
+		"pssInt",
+		"rus",
+		"rusYds",
+		"rusTD",
+		"rec",
+		"recYds",
+		"recTD",
+		"defTck",
+		"defSk",
+		"defInt",
+	];
+	const RAT = [
+		"pos",
+		"ovr",
+		"ovrs",
+		"spd",
+		"stre",
+		"elu",
+		"thv",
+		"thp",
+		"tha",
+		"bsc",
+		"rbk",
+		"pbk",
+		"hnd",
+		"rtr",
+		"tck",
+		"prs",
+		"pcv",
+	];
+	const teams = [];
+	for (const tid of tids) {
+		const t = teamsAll.find((x) => x.tid === tid);
+		const ts = allTs.find((x) => x.tid === tid);
+		const stats0 = (
+			await idb.cache.teamStats.indexGetAll("teamStatsByPlayoffsTid", [
+				[false, tid],
+				[false, tid],
+			])
+		).find((x: any) => x.season === season) as any;
+		const ut = undo.team.get(tid);
+		const stats =
+			stats0 && ut
+				? {
+						...stats0,
+						gp: Math.max(0, (stats0.gp ?? 0) - ut.gp),
+						pts: Math.max(0, (stats0.pts ?? 0) - ut.pts),
+						oppPts: Math.max(0, (stats0.oppPts ?? 0) - ut.oppPts),
+					}
+				: stats0;
+		const players = await idb.cache.players.indexGetAll("playersByTid", tid);
+		const pp: any[] = await player.formatAll(players, {
+			attrs: [
+				"pid",
+				"name",
+				"jerseyNumber",
+				"injury",
+				"face",
+				"imgURL",
+				"age",
+				"hgt",
+				"weight",
+				"college",
+				"draft",
+				"awards",
+			],
+			ratings: RAT as any,
+			stats: STAT as any,
+			season,
+			tid,
+			showNoStats: true,
+			showRookies: true,
+			fuzz: true,
+		});
+		for (const p of pp) p.stats = unspoilStats(p.stats, undo.player.get(p.pid));
+		const byPid = new Map(pp.map((p) => [p.pid, p]));
+		const depth: any = (t as any)?.depth ?? {};
+		const pick = (pos: string, n: number) =>
+			((depth[pos] ?? []) as number[])
+				.map((pid) => byPid.get(pid))
+				.filter((p) => p && !(p.injury && p.injury.gamesRemaining > 0))
+				.slice(0, n)
+				.map((p) => ({
+					pid: p.pid,
+					name: p.name,
+					num: p.jerseyNumber,
+					pos,
+					ovr: p.ratings?.ovrs?.[pos] ?? p.ratings?.ovr,
+					ratings: p.ratings,
+					stats: p.stats,
+					face: p.face,
+					imgURL: p.imgURL || undefined,
+					bio: {
+						age: p.age,
+						hgt: p.hgt,
+						weight: p.weight,
+						college: p.college,
+						draft: p.draft,
+						mvp: (p.awards ?? []).filter(
+							(x: any) => x.type === "Most Valuable Player",
+						).length,
+						allLeague: (p.awards ?? []).filter((x: any) =>
+							/All-League/.test(x.type),
+						).length,
+						proBowl: (p.awards ?? []).filter((x: any) =>
+							/All-Star|Pro Bowl/.test(x.type),
+						).length,
+					},
+				}));
+		const leader = (key: string) => {
+			const best = [...pp].sort(
+				(a, b) => (b.stats?.[key] ?? 0) - (a.stats?.[key] ?? 0),
+			)[0];
+			return best && (best.stats?.[key] ?? 0) > 0
+				? {
+						pid: best.pid,
+						name: best.name,
+						pos: best.ratings?.pos,
+						stats: best.stats,
+						face: best.face,
+						imgURL: best.imgURL || undefined,
+					}
+				: undefined;
+		};
+		const gp = stats?.gp ?? 0;
+		teams.push({
+			tid,
+			won: ts?.won ?? 0,
+			lost: ts?.lost ?? 0,
+			tied: ts?.tied ?? 0,
+			cid: ts?.cid ?? (t as any)?.cid,
+			did: ts?.did ?? (t as any)?.did,
+			ptsPerGame: gp ? (stats.pts ?? 0) / gp : undefined,
+			oppPtsPerGame: gp ? (stats.oppPts ?? 0) / gp : undefined,
+			offense: [
+				...pick("QB", 1),
+				...pick("RB", 1),
+				...pick("WR", 3),
+				...pick("TE", 1),
+				...pick("OL", 5),
+			],
+			defense: [
+				...pick("DL", 4),
+				...pick("LB", 3),
+				...pick("CB", 2),
+				...pick("S", 2),
+			],
+			leaders: {
+				pass: leader("pssYds"),
+				rush: leader("rusYds"),
+				rec: leader("recYds"),
+				sacks: leader("defSk"),
+			},
+		});
+	}
+	// Division standings for each team
+	const divisions = teams.map((tm) =>
+		allTs
+			.filter((x) => x.did === tm.did)
+			.map((x) => ({
+				tid: x.tid,
+				abbrev: teamsAll.find((y) => y.tid === x.tid)?.abbrev ?? "",
+				won: x.won,
+				lost: x.lost,
+				tied: x.tied ?? 0,
+			}))
+			.sort((a, b) => b.won - a.won || a.lost - b.lost),
+	);
+	// The MVP race: a simple value from the season lines (yards, touchdowns, turnovers), top five
+	const everyone = await idb.cache.players.indexGetAll("playersByTid", [
+		0,
+		Infinity,
+	]);
+	const ev: any[] = await player.formatAll(everyone, {
+		attrs: ["pid", "name", "tid", "abbrev", "face", "imgURL"],
+		ratings: ["pos"],
+		stats: STAT as any,
+		season,
+		showNoStats: false,
+		fuzz: true,
+	});
+	for (const p of ev) p.stats = unspoilStats(p.stats, undo.player.get(p.pid));
+	const value = (s: any) =>
+		(s?.pssYds ?? 0) / 25 +
+		(s?.pssTD ?? 0) * 4 -
+		(s?.pssInt ?? 0) * 2.5 +
+		(s?.rusYds ?? 0) / 12 +
+		(s?.rusTD ?? 0) * 5 +
+		(s?.recYds ?? 0) / 12 +
+		(s?.recTD ?? 0) * 5 +
+		(s?.defSk ?? 0) * 3 +
+		(s?.defInt ?? 0) * 4;
+	const mvp = ev
+		.map((p) => ({
+			pid: p.pid,
+			name: p.name,
+			abbrev: p.abbrev,
+			pos: p.ratings?.pos,
+			face: p.face,
+			imgURL: p.imgURL || undefined,
+			value: value(p.stats),
+			stats: p.stats,
+			tid: p.tid,
+			won: allTs.find((x) => x.tid === p.tid)?.won ?? 0,
+		}))
+		.map((p) => ({ ...p, value: p.value * (0.6 + 0.08 * p.won) }))
+		.sort((a, b) => b.value - a.value)
+		.slice(0, 5);
+	const gamesPlayed = Math.max(
+		0,
+		...teams.map((tm) => tm.won + tm.lost + tm.tied),
+	);
+	// The playoff picture in each team's conference: division leaders seeded first, then the wild cards, then the teams
+	// in the hunt, each with a rough playoff chance (projected wins against the pace of the last seed in)
+	const numGames = g.get("numGames");
+	const pct = (x: any) =>
+		(x.won + 0.5 * (x.tied ?? 0)) / Math.max(1, x.won + x.lost + (x.tied ?? 0));
+	const phi = (z: number) => 1 / (1 + Math.exp(-1.702 * z));
+	const conferences = [...new Set(teams.map((tm) => tm.cid))].map((cid) => {
+		const rows = allTs
+			.filter((x) => x.cid === cid)
+			.map((x) => ({
+				tid: x.tid,
+				did: x.did,
+				abbrev: teamsAll.find((y) => y.tid === x.tid)?.abbrev ?? "",
+				won: x.won,
+				lost: x.lost,
+				tied: x.tied ?? 0,
+			}));
+		const byDiv = new Map<number, typeof rows>();
+		for (const r of rows) byDiv.set(r.did, [...(byDiv.get(r.did) ?? []), r]);
+		const leaders = [...byDiv.values()]
+			.map((d) => [...d].sort((p, q) => pct(q) - pct(p))[0]!)
+			.sort((p, q) => pct(q) - pct(p));
+		const rest = rows
+			.filter((r) => !leaders.includes(r))
+			.sort((p, q) => pct(q) - pct(p));
+		const seeds = Math.min(
+			rows.length,
+			Math.max(leaders.length, Math.min(7, Math.round(rows.length * 0.45))),
+		);
+		const order = [...leaders, ...rest];
+		const proj = (r: any) =>
+			r.won +
+			0.5 * r.tied +
+			Math.max(0, numGames - (r.won + r.lost + r.tied)) * (0.5 * pct(r) + 0.25);
+		const cutoff = order[seeds - 1] ? proj(order[seeds - 1]) : 0;
+		const firstOut = order[seeds] ? proj(order[seeds]) : cutoff - 1;
+		const line = (cutoff + firstOut) / 2;
+		return order.slice(0, seeds + 4).map((r, k) => {
+			const left = Math.max(0, numGames - (r.won + r.lost + r.tied));
+			const sd = Math.sqrt(left * 0.25) + 0.6;
+			const chance =
+				left === 0 ? (k < seeds ? 1 : 0) : phi((proj(r) - line) / sd);
+			return {
+				tid: r.tid,
+				abbrev: r.abbrev,
+				won: r.won,
+				lost: r.lost,
+				tied: r.tied,
+				seed: k < seeds ? k + 1 : undefined,
+				chance,
+			};
+		});
+	});
+	return { season, teams, divisions, mvp, gamesPlayed, conferences };
+};
+
+// NFL history mod: one player's card for the live game's player intros: ratings, this season's line, bio and honors
+// (with the game's day, his season line is taken back to before today: this game is already simulated and in the
+// database when it's watched, so its later touchdowns would otherwise show up early)
+const getNflPlayerCard = async (
+	arg: number | { pid: number; day?: number },
+) => {
+	const pid = typeof arg === "number" ? arg : arg.pid;
+	const day = typeof arg === "number" ? undefined : arg.day;
+	const season = g.get("season");
+	const p = await idb.cache.players.get(pid);
+	if (!p) return undefined;
+	const [pp]: any[] = await player.formatAll([p], {
+		attrs: [
+			"pid",
+			"name",
+			"jerseyNumber",
+			"face",
+			"imgURL",
+			"age",
+			"hgt",
+			"weight",
+			"college",
+			"draft",
+			"awards",
+		],
+		ratings: [
+			"pos",
+			"ovr",
+			"ovrs",
+			"spd",
+			"stre",
+			"elu",
+			"thv",
+			"thp",
+			"tha",
+			"bsc",
+			"rbk",
+			"pbk",
+			"hnd",
+			"rtr",
+		] as any,
+		stats: [
+			"gp",
+			"pss",
+			"pssCmp",
+			"pssYds",
+			"pssTD",
+			"pssInt",
+			"rus",
+			"rusYds",
+			"rusTD",
+			"rec",
+			"recYds",
+			"recTD",
+		] as any,
+		season,
+		showNoStats: true,
+		showRookies: true,
+		fuzz: true,
+	});
+	if (!pp) return undefined;
+	const pos = pp.ratings?.pos ?? "QB";
+	return {
+		pid,
+		name: pp.name,
+		num: pp.jerseyNumber,
+		pos,
+		ovr: pp.ratings?.ovrs?.[pos] ?? pp.ratings?.ovr,
+		ratings: pp.ratings,
+		stats:
+			day === undefined
+				? pp.stats
+				: unspoilStats(pp.stats, (await undoFrom(season, day)).player.get(pid)),
+		face: pp.face,
+		imgURL: pp.imgURL || undefined,
+		bio: {
+			age: pp.age,
+			hgt: pp.hgt,
+			weight: pp.weight,
+			college: pp.college,
+			draft: pp.draft,
+			mvp: (pp.awards ?? []).filter(
+				(x: any) => x.type === "Most Valuable Player",
+			).length,
+			allLeague: (pp.awards ?? []).filter((x: any) => /All-League/.test(x.type))
+				.length,
+			proBowl: (pp.awards ?? []).filter((x: any) =>
+				/All-Star|Pro Bowl/.test(x.type),
+			).length,
+		},
+	};
+};
+
+// NFL history mod: for the live game's halftime show: the rest of this week's games (finals, or not played yet) and the
+// league leaders so far this season
+
+// NFL history mod: fun facts for a game, the way a broadcast fills the quiet moments. Everything is as of before the
+// game's day (no spoilers). Kinds: streak, home/away record, the all-time series and the last meeting, league ranks,
+// career milestones within reach, rookies, a team that turned it around from last season, era notes, and what the game
+// means in the division. Each fact names the team (tid) or player (pid) it's about.
+const getNflFacts = async ({
+	tids,
+	day,
+}: {
+	tids: [number, number];
+	day?: number;
+}) => {
+	const season = g.get("season");
+	const [homeTid, awayTid] = tids;
+	const teamsAll = await idb.cache.teams.getAll();
+	const T = (tid: number) => teamsAll.find((t) => t.tid === tid) as any;
+	const name = (tid: number) => T(tid)?.name ?? "";
+	const region = (tid: number) => T(tid)?.region ?? "";
+	const facts: {
+		text: string;
+		kind: string;
+		tid?: number;
+		pid?: number;
+		w: number;
+	}[] = [];
+	const add = (
+		kind: string,
+		text: string,
+		w: number,
+		extra: { tid?: number; pid?: number } = {},
+	) => facts.push({ kind, text, w, ...extra });
+	const undo = await undoFrom(season, day);
+	// This season's games before today
+	const games: any[] = (await idb.merged.games.getAll({ season }))
+		.filter((gm: any) => day === undefined || (gm.day ?? 0) < day)
+		.sort((a: any, b: any) => (a.day ?? 0) - (b.day ?? 0));
+	const resultsOf = (tid: number) =>
+		games
+			.filter((gm) => gm.teams[0].tid === tid || gm.teams[1].tid === tid)
+			.map((gm) => {
+				const me = gm.teams[0].tid === tid ? 0 : 1;
+				const a = gm.teams[me].pts;
+				const b = gm.teams[1 - me].pts;
+				return {
+					home: me === 0,
+					r: a > b ? "W" : a < b ? "L" : "T",
+					opp: gm.teams[1 - me].tid,
+					pts: a,
+					oppPts: b,
+				};
+			});
+	for (const tid of tids) {
+		const rs = resultsOf(tid);
+		if (rs.length >= 3) {
+			let n = 0;
+			const last = rs.at(-1)!.r;
+			for (let i = rs.length - 1; i >= 0 && rs[i]!.r === last; i--) n++;
+			if (n >= 3 && last !== "T")
+				add(
+					"streak",
+					`The ${name(tid)} have ${last === "W" ? "won" : "lost"} ${n} straight`,
+					n >= 5 ? 3 : 2,
+					{ tid },
+				);
+			const home = rs.filter((x) => x.home);
+			const hw = home.filter((x) => x.r === "W").length;
+			if (
+				tid === homeTid &&
+				home.length >= 3 &&
+				(hw === home.length || hw === 0)
+			)
+				add(
+					"home",
+					hw
+						? `The ${name(tid)} are unbeaten at home this season (${hw}-0)`
+						: `The ${name(tid)} are still looking for their first home win (0-${home.length})`,
+					2,
+					{ tid },
+				);
+			const pf = rs.reduce((a, x) => a + x.pts, 0) / rs.length;
+			if (pf >= 28)
+				add(
+					"offense",
+					`The ${name(tid)} are scoring ${pf.toFixed(1)} points a game`,
+					2,
+					{ tid },
+				);
+		}
+	}
+	// The all-time series (every season in the league's history) and the last meeting
+	try {
+		const all: any[] = await idb.league.getAll("headToHeads" as any);
+		const lo = Math.min(homeTid, awayTid);
+		const hi = Math.max(homeTid, awayTid);
+		let w = 0,
+			l = 0,
+			t = 0,
+			first: number | undefined;
+		for (const h of all) {
+			if (h.season >= season) continue;
+			const r = h.regularSeason?.[lo]?.[hi];
+			const pl = h.playoffs?.[lo]?.[hi];
+			for (const x of [r, pl]) {
+				if (!x) continue;
+				w += x.won ?? 0;
+				l += x.lost ?? 0;
+				t += x.tied ?? 0;
+				if ((x.won ?? 0) + (x.lost ?? 0) + (x.tied ?? 0) > 0)
+					first = first === undefined ? h.season : Math.min(first, h.season);
+			}
+		}
+		for (const gm of games) {
+			const ts = [gm.teams[0].tid, gm.teams[1].tid];
+			if (!ts.includes(lo) || !ts.includes(hi)) continue;
+			const loPts = gm.teams[ts.indexOf(lo)].pts;
+			const hiPts = gm.teams[ts.indexOf(hi)].pts;
+			if (loPts > hiPts) w++;
+			else if (loPts < hiPts) l++;
+			else t++;
+		}
+		const n = w + l + t;
+		if (n >= 4) {
+			const leader = w === l ? undefined : w > l ? lo : hi;
+			const a = Math.max(w, l),
+				b = Math.min(w, l);
+			add(
+				"series",
+				leader === undefined
+					? `The all-time series is dead even at ${a}-${b}${t ? `-${t}` : ""}`
+					: `The ${name(leader)} lead the all-time series ${a}-${b}${t ? `-${t}` : ""}${first ? ` (since ${first - 1})` : ""}`,
+				3,
+				{ tid: leader },
+			);
+		}
+		const meet = games
+			.filter(
+				(gm) =>
+					[gm.teams[0].tid, gm.teams[1].tid].includes(lo) &&
+					[gm.teams[0].tid, gm.teams[1].tid].includes(hi),
+			)
+			.at(-1);
+		if (meet) {
+			const wi = meet.teams[0].pts >= meet.teams[1].pts ? 0 : 1;
+			add(
+				"meeting",
+				`Earlier this season: ${region(meet.teams[wi].tid)} ${meet.teams[wi].pts}, ${region(meet.teams[1 - wi].tid)} ${meet.teams[1 - wi].pts}`,
+				3,
+			);
+		}
+	} catch {
+		// no history in this league
+	}
+	// League ranks (points for and against a game)
+	const allTs: any[] = await idb.cache.teamSeasons.indexGetAll(
+		"teamSeasonsBySeasonTid",
+		[[season], [season, "Z"]],
+	);
+	const stats: any[] = [];
+	for (const ts of allTs) {
+		const st = (
+			await idb.cache.teamStats.indexGetAll("teamStatsByPlayoffsTid", [
+				[false, ts.tid],
+				[false, ts.tid],
+			])
+		).find((x: any) => x.season === season) as any;
+		const u = undo.team.get(ts.tid);
+		const gp = (st?.gp ?? 0) - (u?.gp ?? 0);
+		if (gp > 0)
+			stats.push({
+				tid: ts.tid,
+				ppg: ((st.pts ?? 0) - (u?.pts ?? 0)) / gp,
+				oppg: ((st.oppPts ?? 0) - (u?.oppPts ?? 0)) / gp,
+			});
+	}
+	const ord = (n: number) =>
+		`${n}${n % 10 === 1 && n % 100 !== 11 ? "st" : n % 10 === 2 && n % 100 !== 12 ? "nd" : n % 10 === 3 && n % 100 !== 13 ? "rd" : "th"}`;
+	const ranks = tids.map((tid) => {
+		const me = stats.find((x) => x.tid === tid);
+		if (!me) return { tid };
+		const off = 1 + stats.filter((x) => x.ppg > me.ppg).length;
+		const def = 1 + stats.filter((x) => x.oppg < me.oppg).length;
+		if (off <= 5)
+			add(
+				"rank",
+				`The ${name(tid)} are ${ord(off)} in the league in scoring (${me.ppg.toFixed(1)} a game)`,
+				2,
+				{ tid },
+			);
+		if (def <= 5)
+			add(
+				"rank",
+				`The ${name(tid)} defense is ${ord(def)} in points allowed (${me.oppg.toFixed(1)} a game)`,
+				2,
+				{ tid },
+			);
+		if (off >= stats.length - 2 && stats.length > 8)
+			add(
+				"rank",
+				`The ${name(tid)} offense ranks ${ord(off)} of ${stats.length} in scoring`,
+				1,
+				{ tid },
+			);
+		return { tid, off, def, ppg: me.ppg, oppg: me.oppg };
+	});
+	// Last season vs this one
+	for (const tid of tids) {
+		const now = allTs.find((x) => x.tid === tid);
+		const lastTs = (await team.getFormattedAll({
+			attrs: ["tid"],
+			seasonAttrs: ["won", "lost"],
+			season: season - 1,
+			tid,
+		} as any)) as any;
+		const lw = lastTs?.seasonAttrs?.won;
+		const u = undo.team.get(tid);
+		const w = (now?.won ?? 0) - (u?.won ?? 0);
+		if (lw !== undefined && lw <= 5 && w >= lw + 1 && w >= 5)
+			add(
+				"turnaround",
+				`The ${name(tid)} won ${lw} games all of last season. They already have ${w}`,
+				3,
+				{ tid },
+			);
+	}
+	// Players: career milestones within reach, rookies, colleges
+	for (const tid of tids) {
+		const players = await idb.cache.players.indexGetAll("playersByTid", tid);
+		const pp: any[] = await player.formatAll(players, {
+			attrs: ["pid", "name", "draft", "college", "age"],
+			ratings: ["pos", "ovr"],
+			stats: [
+				"pssYds",
+				"pssTD",
+				"rusYds",
+				"rusTD",
+				"recYds",
+				"recTD",
+				"defSk",
+				"gp",
+			] as any,
+			regularSeason: true,
+			fuzz: true,
+		} as any);
+		const top = [...pp]
+			.sort(
+				(a, b) =>
+					(b.ratings?.at?.(-1)?.ovr ?? b.ratings?.ovr ?? 0) -
+					(a.ratings?.at?.(-1)?.ovr ?? a.ratings?.ovr ?? 0),
+			)
+			.slice(0, 14);
+		for (const pl of top) {
+			const c = pl.careerStats;
+			if (!c) continue;
+			const m = undo.player.get(pl.pid) ?? {};
+			const cur = (k: string) => (c[k] ?? 0) - (m[k] ?? 0);
+			const marks: [string, number[], string, number][] = [
+				[
+					"pssYds",
+					[10000, 20000, 30000, 40000, 50000, 60000, 70000, 80000],
+					"passing yards",
+					340,
+				],
+				["pssTD", [100, 200, 300, 400, 500, 600], "touchdown passes", 3],
+				["rusYds", [5000, 10000, 15000], "rushing yards", 130],
+				["recYds", [5000, 10000, 15000], "receiving yards", 130],
+				["defSk", [50, 100, 150, 200], "career sacks", 2],
+			];
+			for (const [k, steps, what, reach] of marks) {
+				const v = cur(k);
+				const next = steps.find((x) => x > v);
+				if (next && next - v <= reach)
+					add(
+						"milestone",
+						`${pl.name} needs ${Math.ceil(next - v).toLocaleString()} more ${what} to reach ${next.toLocaleString()} for his career`,
+						3,
+						{ tid, pid: pl.pid },
+					);
+			}
+			if (
+				pl.draft?.year === season - 1 &&
+				pl.draft.pick > 0 &&
+				pl.draft.round === 1
+			)
+				add(
+					"rookie",
+					`Rookie ${pl.ratings?.pos ?? ""} ${pl.name} was the No. ${(pl.draft.round - 1) * 32 + pl.draft.pick} pick in this year's draft`.replace(
+						"  ",
+						" ",
+					),
+					2,
+					{ tid, pid: pl.pid },
+				);
+		}
+	}
+	// Era notes
+	const ERA: [number, string][] = [
+		[1970, "The first season after the AFL-NFL merger"],
+		[
+			1978,
+			"The first 16-game season, and the year the rules opened up the passing game",
+		],
+		[
+			1994,
+			"The first season of the two-point conversion and the salary cap era",
+		],
+		[2002, "The first season with 32 teams and eight divisions"],
+		[2011, "Kickoffs moved to the 35 this season: more touchbacks"],
+		[2015, "Extra points moved back to the 15 this season"],
+		[2022, "The first season of the 17-game schedule"],
+	];
+	for (const [yr, txt] of ERA) if (season === yr) add("era", txt, 2);
+	// What's at stake: the division right now, and what a win does
+	const stakes: string[] = [];
+	const rec = (tid: number) => {
+		const ts = allTs.find((x) => x.tid === tid);
+		const u = undo.team.get(tid);
+		return {
+			tid,
+			did: ts?.did,
+			w: (ts?.won ?? 0) - (u?.won ?? 0),
+			l: (ts?.lost ?? 0) - (u?.lost ?? 0),
+		};
+	};
+	for (const tid of tids) {
+		const me = rec(tid);
+		const div = allTs
+			.filter((x) => x.did === me.did)
+			.map((x) => rec(x.tid))
+			.sort((a, b) => b.w - a.w || a.l - b.l);
+		const leader = div[0];
+		if (!leader || me.w + me.l < 3) continue;
+		if (leader.tid === tid) {
+			const second = div[1];
+			if (second && me.w - second.w <= 1)
+				stakes.push(
+					`A win keeps the ${name(tid)} in first place in the division`,
+				);
+			else
+				stakes.push(
+					`The ${name(tid)} lead their division by ${me.w - (second?.w ?? 0)} games`,
+				);
+		} else if (leader.w - me.w <= 1)
+			stakes.push(`A win would put the ${name(tid)} in a tie for first place`);
+		else if (leader.w - me.w >= 4)
+			stakes.push(
+				`The ${name(tid)} are ${leader.w - me.w} games out of first place`,
+			);
+		if (tids.every((x) => rec(x).did === me.did) && tid === tids[0])
+			stakes.push("A division game: this one counts double in the race");
+	}
+	facts.sort((a, b) => b.w - a.w || Math.random() - 0.5);
+	return { facts, stakes, ranks };
+};
+
+const getNflAround = async ({ day, gid }: { day: number; gid?: number }) => {
+	const season = g.get("season");
+	const undo = await undoFrom(season, day);
+	const teamsAll = await idb.cache.teams.getAll();
+	const ab = (tid: number) => teamsAll.find((t) => t.tid === tid)?.abbrev ?? "";
+	const img = (tid: number) =>
+		(teamsAll.find((t) => t.tid === tid) as any)?.imgURLSmall ??
+		(teamsAll.find((t) => t.tid === tid) as any)?.imgURL;
+	const games = (await getNflSeasonGames(season)).games
+		.filter((x) => x.day === day && x.gid !== gid && x.awayTid >= 0)
+		.map((x) => ({
+			home: ab(x.homeTid),
+			away: ab(x.awayTid),
+			homeImg: img(x.homeTid),
+			awayImg: img(x.awayTid),
+			// (games on the same day are already simulated, but they haven't finished in the broadcast's time: no scores)
+			homePts: undefined as number | undefined,
+			awayPts: undefined as number | undefined,
+		}));
+	const players = await idb.cache.players.indexGetAll("playersByTid", [
+		0,
+		Infinity,
+	]);
+	const pp: any[] = await player.formatAll(players, {
+		attrs: ["pid", "name", "abbrev"],
+		ratings: ["pos"],
+		stats: [
+			"pssYds",
+			"pssTD",
+			"rusYds",
+			"rusTD",
+			"recYds",
+			"recTD",
+			"defSk",
+		] as any,
+		season,
+		showNoStats: false,
+		fuzz: true,
+	});
+	for (const p of pp) p.stats = unspoilStats(p.stats, undo.player.get(p.pid));
+	const top = (key: string) =>
+		[...pp]
+			.sort((a, b) => (b.stats?.[key] ?? 0) - (a.stats?.[key] ?? 0))
+			.slice(0, 3)
+			.filter((p) => (p.stats?.[key] ?? 0) > 0)
+			.map((p) => ({
+				name: p.name,
+				abbrev: p.abbrev,
+				value: Math.round(p.stats[key]),
+				td: p.stats[
+					key === "pssYds"
+						? "pssTD"
+						: key === "rusYds"
+							? "rusTD"
+							: key === "recYds"
+								? "recTD"
+								: "defSk"
+				],
+			}));
+	return {
+		games,
+		leaders: {
+			pass: top("pssYds"),
+			rush: top("rusYds"),
+			rec: top("recYds"),
+			sacks: top("defSk"),
+		},
+	};
+};
+
+export {
+	getNflSeasonGamesApi,
+	getNflGameFaces,
+	getNflPregame,
+	getNflPlayerCard,
+	getNflFacts,
+	getNflAround,
+	castCoverVote,
+};
