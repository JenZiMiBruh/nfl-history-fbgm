+// NFL history mod: the era designs drawn on the jersey cards (JerseyNumber.tsx), in its 100 x 112 box. Each design is a
+// list of filled paths with a color role ("trim" = the team's first stripe color, "stripe" = the second, "body" = the
+// jersey itself); the card clips them to the jersey outline, so shapes may run past its edges. Which team and season
+// wears which: STYLES in common/nflJerseys.ts.
+
+export type Cut = "classic" | "nineties" | "modern";
+type Pt = [number, number];
+export type DesignPath = { d: string; role: "trim" | "stripe" | "body" };
+
+// The left sleeve of each cut: shoulder point, cuff (outer, inner), armpit. The right sleeve mirrors it.
+const SLEEVES: Record<Cut, { o0: Pt; o1: Pt; i1: Pt; i0: Pt }> = {
+	// 1966-1984: loose, sleeves down toward the elbow
+	classic: { o0: [13, 18], o1: [2, 46], i1: [16, 52], i0: [22, 40] },
+	// 1985-2011: shorter sleeves
+	nineties: { o0: [14, 18], o1: [2.5, 41], i1: [16, 48], i0: [22, 37] },
+	// 2012 on: Nike's tight cut, cap sleeves
+	modern: { o0: [14, 18], o1: [4, 33], i1: [16.5, 41.5], i0: [22, 35] },
+};
+
+const SHELLS: Record<Cut, string> = {
+	classic:
+		"L72 9 Q82 11 87 18 L98 46 L84 52 L78 40 L79 104 Q79 107 76 107 L24 107 Q21 107 21 104 L22 40 L16 52 L2 46 L13 18 Q18 11 28 9 Z",
+	nineties:
+		"L73 10 Q81 12 86 18 L97.5 41 L84 48 L78 37 L78 104 Q78 107 75 107 L25 107 Q22 107 22 104 L22 37 L16 48 L2.5 41 L14 18 Q19 12 27 10 Z",
+	modern:
+		"L73 10 Q81 12 86 18 L96 33 L83.5 41.5 L78 35 L78 104 Q78 107 75 107 L25 107 Q22 107 22 104 L22 35 L16.5 41.5 L4 33 L14 18 Q19 12 27 10 Z",
+};
+
+// The jersey outline: the back has a shallow round collar, the front a V-neck
+export const outline = (cut: Cut, front: boolean) =>
+	`${front ? "M37 8 L50 22 L63 8" : "M36 9 Q50 14 64 9"} ${SHELLS[cut]}`;
+
+// Where the armpit is, for the side designs and the number's room
+export const armpitY = (cut: Cut) => SLEEVES[cut].i0[1];
+
+const lerp = (a: Pt, b: Pt, t: number): Pt => [
+	a[0] + (b[0] - a[0]) * t,
+	a[1] + (b[1] - a[1]) * t,
+];
+const f = (p: Pt) => `${p[0].toFixed(2)} ${p[1].toFixed(2)}`;
+const poly = (pts: Pt[]) => `M${pts.map(f).join(" L")} Z`;
+const mirror = (pts: Pt[]): Pt[] => pts.map(([x, y]) => [100 - x, y]);
+const both = (pts: Pt[]) => `${poly(pts)} ${poly(mirror(pts))}`;
+
+// A band around the sleeve, from a to b (0 = at the cuff, 1 = at the shoulder), pushed past both edges so the clip
+// trims it cleanly
+const band = (cut: Cut, a: number, b: number) => {
+	const { o0, o1, i1, i0 } = SLEEVES[cut];
+	const out = (t: number): Pt => {
+		const p = lerp(o1, o0, t);
+		const q = lerp(i1, i0, t);
+		return lerp(q, p, 1.35);
+	};
+	// exactly at the seam on the inside: past it is the body, where a band would show
+	const inn = (t: number): Pt => lerp(i1, i0, t);
+	return both([out(a), inn(a), inn(b), out(b)]);
+};
+
+// Points in the sleeve's own frame: u runs from the top of the shoulder by the collar (0) to the middle of the cuff (1),
+// v across it (outward positive), in jersey units
+const sleeveFrame = (cut: Cut, from: Pt = [30, 10.5]) => {
+	const { o1, i1 } = SLEEVES[cut];
+	const top: Pt = from;
+	const cuff = lerp(o1, i1, 0.5);
+	const len = Math.hypot(cuff[0] - top[0], cuff[1] - top[1]);
+	const ux = (cuff[0] - top[0]) / len;
+	const uy = (cuff[1] - top[1]) / len;
+	// outward normal (toward the outer edge of the left sleeve)
+	const vx = uy;
+	const vy = -ux;
+	return (u: number, v: number): Pt => [
+		top[0] + ux * u * len + vx * v,
+		top[1] + uy * u * len + vy * v,
+	];
+};
+
+// Generated designs (seasons after the real data ends, common/nflGenLook.ts): "g:" and underscore-separated parts, each a
+// letter, numbers and a color role (t = the first stripe color, s = the second).
+//   sleeves  b<a>-<b><r>   a band around the sleeve from a to b (percent, cuff to shoulder)
+//            y<q|v|s><d><r> a yoke over the shoulders, its lower edge curved, V-cut or straight, d above the armpit
+//            e<q|v|s><d><r> a thin line just under a yoke's lower edge (same d as the yoke)
+//            l<v>-<w><r>   a loop over the shoulder and down the sleeve, v across it, w wide
+//   sides    p<w><r>       a straight panel down the side, w wide
+//            t<w><r>       a panel tapering from w wide at the armpit to a point at the hem
+//            n<o>-<w><r>   a thin line down the side, o in from the seam, w wide
+const roleOf = (c: string): DesignPath["role"] =>
+	c === "s" ? "stripe" : "trim";
+// a yoke (thick = 0) or a thin ribbon along its lower edge, the edge curved (q), V-cut (v) or straight (s)
+const yokeEdge = (shape: string, depth: number, cut: Cut, thick = 0) => {
+	const y = armpitY(cut) - depth;
+	// along the edge at height h, right to left / left to right
+	const rl = (h: number) =>
+		shape === "v"
+			? `L50 ${h + 9} L-2 ${h}`
+			: shape === "s"
+				? `L-2 ${h}`
+				: `Q50 ${h + 7} -2 ${h}`;
+	const lr = (h: number) =>
+		shape === "v"
+			? `L50 ${h + 9} L102 ${h}`
+			: shape === "s"
+				? `L102 ${h}`
+				: `Q50 ${h + 7} 102 ${h}`;
+	if (thick > 0) {
+		return `M-2 ${y} ${lr(y)} L102 ${y + thick} ${rl(y + thick)} Z`;
+	}
+	return `M-2 -2 H102 V${y} ${rl(y)} Z`;
+};
+const genDesign = (kind: string, cut: Cut): DesignPath[] => {
+	const at = sleeveFrame(cut, [22, 13]);
+	const x = SLEEVES[cut].i0[0];
+	const ay = armpitY(cut);
+	const out: DesignPath[] = [];
+	for (const part of kind.slice(2).split("_")) {
+		const m = /^([a-z])([qvs]?)(-?[\d.]+)(?:-([\d.]+))?([ts])$/.exec(part);
+		if (!m) {
+			continue;
+		}
+		const [, op, shape, n1s, n2s, r] = m;
+		const n1 = Number(n1s);
+		const n2 = Number(n2s ?? 0);
+		const role = roleOf(r!);
+		if (op === "b") {
+			out.push({ d: band(cut, n1 / 100, n2 / 100), role });
+		} else if (op === "y") {
+			out.push({ d: yokeEdge(shape || "q", n1, cut), role });
+		} else if (op === "e") {
+			out.push({ d: yokeEdge(shape || "q", n1, cut, 1.6), role });
+		} else if (op === "l") {
+			out.push({
+				d: both([
+					at(0.05, n1),
+					at(0.05, n1 + n2),
+					at(1.2, n1 + n2 * 1.5),
+					at(1.2, n1),
+				]),
+				role,
+			});
+		} else if (op === "p") {
+			out.push({
+				d: both([
+					[x, ay + 1],
+					[x + n1, ay + 3],
+					[x + n1, 110],
+					[x - 3, 110],
+				]),
+				role,
+			});
+		} else if (op === "t") {
+			out.push({
+				d: both([
+					[x, ay + 1],
+					[x + n1, ay + 3],
+					[x + 0.8, 110],
+					[x - 3, 110],
+				]),
+				role,
+			});
+		} else if (op === "n") {
+			out.push({
+				d: both([
+					[x + n1, ay + 4],
+					[x + n1 + n2, ay + 5],
+					[x + n1 + n2, 110],
+					[x + n1, 110],
+				]),
+				role,
+			});
+		}
+	}
+	return out;
+};
+
+export const sleeveDesign = (kind: string, cut: Cut): DesignPath[] => {
+	if (kind.startsWith("g:")) {
+		return genDesign(kind, cut);
+	}
+	// starting a little out on the shoulder keeps bolts and shoulder stripes clear of the name bar
+	const at = sleeveFrame(cut, [22, 13]);
+	switch (kind) {
+		case "stripes":
+			// two bands near the cuff with a thin line of the second color between them
+			return [
+				{
+					d: band(cut, 0.07, 0.22) + " " + band(cut, 0.29, 0.44),
+					role: "trim",
+				},
+				{ d: band(cut, 0.22, 0.29), role: "stripe" },
+			];
+		case "cuffs":
+			// two thin stripes right at the sleeve end, leaving room for the logo above (Jaguars 1997-2008)
+			return [
+				{ d: band(cut, 0.04, 0.1) + " " + band(cut, 0.14, 0.2), role: "trim" },
+			];
+		case "northwestern":
+			// wide - thin - wide, the thin one in the trim color with second-color edges (Bears, Browns)
+			return [
+				{ d: band(cut, 0.05, 0.46), role: "stripe" },
+				{
+					d:
+						band(cut, 0.07, 0.18) +
+						" " +
+						band(cut, 0.22, 0.3) +
+						" " +
+						band(cut, 0.33, 0.44),
+					role: "trim",
+				},
+			];
+		case "shoulder":
+			// two loops over the top of the shoulder and down the sleeve (Colts)
+			return [
+				{
+					d:
+						both([at(0.05, 2.2), at(0.05, 4.4), at(1.2, 6.6), at(1.2, 4.4)]) +
+						" " +
+						both([at(0.05, -1.4), at(0.05, 0.8), at(1.2, 1.6), at(1.2, -0.6)]),
+					role: "trim",
+				},
+			];
+		case "horn":
+		case "wings": {
+			// starts at the shoulder seam, so it stays on the sleeve and off the back
+			const frame = sleeveFrame(cut, lerp([27, 10], SLEEVES[cut].o0, 0.55));
+			// (the frame's v points in toward the back, so the horn uses -v to bow out over the sleeve)
+			const on = (u: number, v: number) => frame(u, -v);
+			// a crescent: broad where it starts at the top of the shoulder, bowing out over the sleeve and tapering to a
+			// point that curls back in toward the body near the cuff (Rams horns, Vikings horns, Eagles wings)
+			const n = 18;
+			const center = (t: number) =>
+				-1.5 +
+				3.5 * Math.sin(Math.PI * Math.min(t, 1) * 0.85) -
+				(t > 0.8 ? (t - 0.8) * 12 : 0);
+			const width = (t: number) => 7 * (1 - t) + 0.8;
+			const outer: Pt[] = [];
+			const inner: Pt[] = [];
+			for (let i = 0; i <= n; i++) {
+				const t = i / n;
+				const u = t * 1.05;
+				const notch = kind === "wings" && i % 4 === 2 ? 1.6 : 0;
+				outer.push(on(u, center(t) + width(t) / 2));
+				inner.push(on(u, center(t) - width(t) / 2 + notch));
+			}
+			return [{ d: both([...outer, ...inner.reverse()]), role: "trim" }];
+		}
+		case "bolt":
+			// a lightning bolt from the top of the shoulder down the sleeve (Chargers)
+			return [
+				{
+					d: both([
+						at(0.0, 3),
+						at(0.5, 7.5),
+						at(0.47, 4.5),
+						at(1.15, 7),
+						at(0.58, 0.5),
+						at(0.62, 3.2),
+						at(0.04, -0.5),
+					]),
+					role: "trim",
+				},
+			];
+		case "tiger":
+		case "tigerfill": {
+			// tapered stripes reaching in from both edges of the sleeve (Bengals 1981-2003, 2021 on); tigerfill: the whole
+			// sleeve in the trim color with the stripes in the jersey color (Bengals 2004-2020)
+			const { o0, o1, i0, i1 } = SLEEVES[cut];
+			const pts: string[] = [];
+			for (const t of [0.12, 0.42, 0.72]) {
+				const a = lerp(o1, o0, t);
+				const b = lerp(o1, o0, t + 0.14);
+				const tip = lerp(lerp(o1, i1, 0.72), lerp(o0, i0, 0.72), t + 0.12);
+				pts.push(
+					both([lerp(a, a, 0), [a[0] - 3, a[1]], [b[0] - 3, b[1]], b, tip]),
+				);
+			}
+			for (const t of [0.26, 0.56]) {
+				const a = lerp(i1, i0, t);
+				const b = lerp(i1, i0, t + 0.12);
+				const tip = lerp(lerp(i1, o1, 0.6), lerp(i0, o0, 0.6), t + 0.06);
+				pts.push(both([a, [a[0] + 3, a[1]], [b[0] + 3, b[1]], b, tip]));
+			}
+			if (kind === "tigerfill") {
+				return [
+					{ d: band(cut, -0.2, 1.2), role: "trim" },
+					{ d: pts.join(" "), role: "body" },
+				];
+			}
+			return [{ d: pts.join(" "), role: "trim" }];
+		}
+		case "capdip": {
+			// a cap over the shoulders in the trim color, dipping from the collar down across the sleeve, edged by a thin line
+			// of the second color, and a cuff in the trim color (Buccaneers 2014-19: pewter cap, orange edge)
+			const { o0, o1, i0, i1 } = SLEEVES[cut];
+			const inner = lerp(i1, i0, 0.58);
+			const outer = lerp(o1, o0, 0.58);
+			const far: Pt = [outer[0] - 6, outer[1] - 1];
+			const mid: Pt = [27, 15];
+			const neck: Pt = [36, 9.5];
+			const edge = 1.7;
+			return [
+				{
+					d:
+						both([
+							[-2, -2],
+							[38, -2],
+							neck,
+							mid,
+							inner,
+							outer,
+							far,
+							[-2, far[1]],
+						]) +
+						" " +
+						band(cut, 0.03, 0.11),
+					role: "trim",
+				},
+				{
+					d: both([
+						neck,
+						mid,
+						inner,
+						outer,
+						far,
+						[far[0], far[1] + edge],
+						[outer[0], outer[1] + edge],
+						[inner[0], inner[1] + edge],
+						[mid[0], mid[1] + edge],
+						[neck[0], neck[1] + edge],
+					]),
+					role: "stripe",
+				},
+			];
+		}
+		case "yoke":
+			// the shoulders in the second color, with three slanted claw marks across each shoulder (Jaguars 2013-17)
+			return [
+				{
+					d: `M-2 -2 H102 V${armpitY(cut) - 4} Q50 ${armpitY(cut) + 2} -2 ${armpitY(cut) - 4} Z`,
+					role: "trim",
+				},
+				{
+					d: [0, 1, 2]
+						.flatMap((i) => {
+							const x = 14 + i * 5;
+							const claw = (sx: number) =>
+								`M${sx} 3 L${sx + 1.6} 3 L${sx - 2.4} ${armpitY(cut) - 9} L${sx - 3.4} ${armpitY(cut) - 9} Z`;
+							// mirrored on the other shoulder
+							return [claw(x), claw(100 - x + 2)];
+						})
+						.join(" "),
+					role: "stripe",
+				},
+			];
+		default:
+			return [];
+	}
+};
+
+export const sideDesign = (kind: string, cut: Cut): DesignPath[] => {
+	if (kind.startsWith("g:")) {
+		return genDesign(kind, cut);
+	}
+	const y = armpitY(cut);
+	const x = SLEEVES[cut].i0[0];
+	switch (kind) {
+		case "piping":
+			// curved piping from the armpit to the hem (Broncos '97, Falcons '03, Seahawks '02)
+			return [
+				// a thin line hugging the side seam, with a hairline of the second color inside it
+				{
+					d: both([
+						[x, y + 1],
+						[x + 1.5, y + 2],
+						[x + 3, y + 22],
+						[x + 3.2, 110],
+						[x + 1.4, 110],
+						[x + 1.2, y + 22],
+					]),
+					role: "trim",
+				},
+				{
+					d: both([
+						[x + 3.2, y + 6],
+						[x + 4.2, y + 22],
+						[x + 4.4, 110],
+						[x + 3.6, 110],
+						[x + 3.4, y + 22],
+					]),
+					role: "stripe",
+				},
+			];
+		case "panel":
+			// straight panels down the sides
+			return [
+				{
+					d: both([
+						[x, y + 1],
+						[x + 4, y + 3],
+						[x + 4, 110],
+						[x - 3, 110],
+					]),
+					role: "trim",
+				},
+			];
+		case "tiger":
+			// side panels with tiger stripes (Bengals 2004-20)
+			return [
+				{
+					d: both([
+						[x, y + 1],
+						[x + 4.5, y + 3],
+						[x + 4.5, 110],
+						[x - 3, 110],
+					]),
+					role: "trim",
+				},
+				{
+					d: [0, 1, 2, 3]
+						.map((i) =>
+							both([
+								[x - 3, y + 8 + i * 16],
+								[x + 4, y + 12 + i * 16],
+								[x - 3, y + 15 + i * 16],
+							]),
+						)
+						.join(" "),
+					role: "body",
+				},
+			];
+		default:
+			return [];
+	}
+};
+
+// A spot on the left sleeve, t from the cuff (0) to the shoulder (1), centered across it, with the angle (degrees) to
+// lay something along the sleeve. The right sleeve mirrors it (x -> 100 - x, angle -> -angle).
+export const sleeveSpot = (cut: Cut, t: number) => {
+	const { o0, o1, i1, i0 } = SLEEVES[cut];
+	const p = lerp(lerp(o1, i1, 0.5), lerp(o0, i0, 0.5), t);
+	// the cuff line's direction gives the badge's "horizontal"
+	const angle = (Math.atan2(i1[1] - o1[1], i1[0] - o1[0]) * 180) / Math.PI;
+	return { x: p[0], y: p[1], angle };
+};
