+	const where = { 45: "NORTH TEXAS 2011", 46: "INDIANAPOLIS 2012", 47: "NEW ORLEANS", 48: "NEW YORK NEW JERSEY 2014", 49: "ARIZONA 02.01.15", 50: "SAN FRANCISCO BAY AREA" }[n]!;
+	const defs =
+		`<defs>${trophyDefs(p)}${lin(`${p}sv`, ["#F4F6F8", "#B9C0C8", "#8A929C"])}${lin(`${p}nm`, ["#FFFFFF", "#D3D8DE", "#8C949E", "#C9CED4", "#F2F4F6"])}${lin(`${p}gd`, ["#FFF1B8", "#E2B13C", "#9C6E10", "#F0CF6E"])}</defs>`;
+	if (n === 50) {
+		// the gold 50 with the trophy standing in the 0
+		return (
+			defs +
+			stadium(50, p) +
+			`<path d='M30 66 H92 V86 H54 V100 H72 Q94 100 94 122 V140 Q94 162 72 162 H30 V142 H70 V124 H30 Z' fill='url(#${p}gd)' stroke='#8A6410' stroke-width='2'/>` +
+			`<path fill-rule='evenodd' d='M120 66 H208 Q226 66 226 84 V144 Q226 162 208 162 H120 Q102 162 102 144 V84 Q102 66 120 66 Z M132 86 V142 H196 V86 Z' fill='url(#${p}gd)' stroke='#8A6410' stroke-width='2'/>` +
+			trophy(p, 164, 24, 122) +
+			`<rect x='52' y='146' width='152' height='20' fill='url(#${p}sv)' stroke='#444' stroke-width='2'/>` +
+			txt("SUPER BOWL", { y: 162, size: 15, fill: "#2A2F36", font: "Arial", ls: 3 }) +
+			txt(where, { y: 190, size: 11, fill: "#C9A227", font: "Arial", weight: 700, ls: 1 }) +
+			txt("02.07.2016", { y: 204, size: 11, fill: "#C9A227", font: "Arial", weight: 700, ls: 1 })
+		);
+	}
+	let g = glyphPaths(num, 128, 168, 54, 1.5, 5, 0);
+	if (g.width > 226) {
+		g = glyphPaths(num, 128, 168, 54, (1.5 * 226) / g.width, 5, 0);
+	}
+	const k = 0.54;
+	return (
+		defs +
+		`<g transform='translate(128 0) scale(1.3 1.05) translate(-128 6)'>${stadium(n, p)}</g>` +
+		trophy(p, 128, 6, 146) +
