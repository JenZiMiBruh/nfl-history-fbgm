+					<Players label="NFLPA" />
+				</>
+			),
+		};
+	} else if (y <= 2021) {
+		const IT: TypeStyle = { skew: -12, track: 6 };
+		const L = {
+			2015: { disc: [49, 45.5, 18], row: [4, 96, 63.5], fill: "metal-dark" },
+			2016: { disc: [50, 45, 18], row: [4, 96, 63], fill: "#ffffff" },
+			2017: { disc: [50, 45, 18], row: [4, 96, 63], fill: "#ffffff" },
+			2018: { disc: [50, 52, 18], row: [8, 92, 68.5], fill: "#ffffff" },
+			2019: { disc: [50, 47, 18], row: [6, 94, 63], fill: "#ffffff" },
+			2020: { disc: [50, 50, 18], row: [10, 90, 63], fill: "#ffffff" },
+			2021: { disc: [17, 50, 11], row: [26, 92, 50], fill: "#ffffff" },
+		}[y as 2015]!;
+		clear = y === 2021 ? L.row[2]! - 6 : L.disc[1]! - L.disc[2]! / 2.8;
+		const bg =
+			y <= 2017 ? (
+				<Stadium />
+			) : y === 2018 ? (
+				<Stadium night />
+			) : y <= 2020 ? (
+				<>
+					<div style={{ position: "absolute", inset: 0, background: t.loud }} />
+					<div style={{ position: "absolute", inset: 0, background: "radial-gradient(ellipse at 50% 35%, rgba(255,255,255,.22), rgba(0,0,0,.15) 85%)" }} />
+				</>
+			) : (
+				<Collage main={t.main} second={t.second} />
+			);
+		s = {
+			pic: y === 2021 ? [12, 48] : [2, 54],
+			bg,
+			over: (
+				<>
+					<At x={L.disc[0]!} y={L.disc[1]!}>
+						<EaDisc d={px(L.disc[2]!)} />
+					</At>
+					{Row({ x1: L.row[0]!, x2: L.row[1]!, c: L.row[2]!, st: IT, fill: L.fill, yearFill: y === 2021 ? "#ffffff" : "metal-red", shadow: true, shieldScale: 1.5, stroke: L.fill === "#ffffff" ? "#1a1a1a" : undefined, strokeW: L.fill === "#ffffff" ? px(0.25) : 0 })}
+					<Players label="NFLPA" />
+				</>
+			),
+		};
+	} else {
+		// 2022 on: the title in a strip across the top
+		// the backdrop changes every decade after the real ones (2030s paint, 2040s a wall of color, 2050s streaks, 2060s
+		// the stadium, 2070s the collage, then around again), always in his team's colors where the real ones were
+		const decade = y >= 2030 ? Math.floor((y - 2030) / 10) % 5 : -1;
+		const light = y === 2022 || decade === 0 || decade === 4;
+		const TOP: TypeStyle = { track: 6 };
+		const future =
+			decade === 0 ? (
+				<Paint colors={[t.main, t.second, t.dark, "#9aa0a6"]} seed={seed} />
+			) : decade === 1 ? (
+				<>
+					<div style={{ position: "absolute", inset: 0, background: t.loud }} />
+					<div style={{ position: "absolute", inset: 0, background: "radial-gradient(ellipse at 50% 35%, rgba(255,255,255,.22), rgba(0,0,0,.15) 85%)" }} />
+				</>
+			) : decade === 2 ? (
+				<Streaks c={t.ring} seed={seed} />
+			) : decade === 3 ? (
+				<Stadium night />
+			) : decade === 4 ? (
+				<Collage main={t.main} second={t.second} />
+			) : null;
+		s = {
+			pic: [15, 62],
+			bg: future ?? (light ? (
+				<div style={{ position: "absolute", inset: 0, background: "linear-gradient(180deg, #fbf9f5, #e7e1d6)" }} />
+			) : (
+				<div style={{ position: "absolute", inset: 0, background: `radial-gradient(ellipse at 50% 34%, ${mix(t.ring, "#ffffff", 0.12)} 0%, ${mix(t.dark, "#000000", 0.35)} 58%, #040506 100%)` }} />
+			)),
+			over: (
+				<>
+					<div style={{ position: "absolute", left: "4.5%", top: "7.5%", transform: "translateY(-50%)", display: "flex", alignItems: "center", gap: px(1.6) }}>
+						<EaBadge d={px(9)} dark={light} />
+						<TitleRow width={px(62)} year={yr} style={TOP} fill={light ? "#111111" : "#ffffff"} yearFill={light ? "#111111" : "#ffffff"} modernShield shieldScale={1.25} />
+					</div>
+					<Players label="NFLPA" />
+				</>
+			),
+		};
+	}
+
+	const [picTop, picWide] = s.pic;
+	const chin = (w: number) => picTop + 0.62 * (w * 1.925) / 1.4;
+	const wide = chin(picWide) > clear - 1.5 ? Math.max(26, ((clear - 1.5 - picTop) * 1.4) / (0.62 * 1.925)) : picWide;
+
+	return (
+		<div style={{ width: W, height: H, position: "relative", overflow: "hidden", borderRadius: W * 0.008, boxShadow: "0 8px 24px rgba(0,0,0,.45)", background: "#fff", flex: "none" }}>
+			{s.bg}
+			<div style={{ position: "absolute", top: `${picTop}%`, left: `${(100 - wide) / 2}%`, width: `${wide}%`, filter: `drop-shadow(0 ${W * 0.01}px ${W * 0.02}px rgba(0,0,0,.5))` }}>
+				<PlayerPicture colors={p.colors} face={p.face as FaceConfig | undefined} imgURL={p.face ? undefined : p.imgURL} nfl={p.nfl as any} />
+			</div>
+			{/* the band sits over his lower body, like the real ones */}
+			{s.under ? <div style={{ position: "absolute", inset: 0, pointerEvents: "none" }}>{s.under}</div> : null}
+			{s.strip ? <div style={{ position: "absolute", top: 0, left: 0, right: 0, height: "6%", background: "#0b0b0b" }} /> : null}
+			{s.over}
+			<Esrb />
+		</div>
+	);
+};
+
+export { NflShield };
