+// Gridiron Almanac native app: engine calls made by the Kotlin app instead of Football GM's own web UI.
+import { getDefaultSettings } from "../views/newLeague.ts";
+import { unwrapGameAttribute } from "../../common/unwrapGameAttribute.ts";
+import { gameAttributesArrayToObject } from "../../common/gameAttributesArrayToObject.ts";
+import { helpers } from "../util/index.ts";
+import { DEFAULT_CONFS, DEFAULT_DIVS } from "../../common/constants.ts";
+import type { Conditions } from "../../common/types.ts";
+
+type CreateLeague = (params: any, conditions: Conditions) => Promise<number>;
+type InitialCheck = (
+	params: { file: unknown; includePlayersInBasicInfo?: boolean; leagueCreationID?: string },
+	conditions: Conditions,
+) => Promise<{ basicInfo: any; schemaErrors: unknown[] }>;
+
+// Settings from the league file over the defaults, the way the New League screen does it.
+const settingsFromFile = (gameAttributes: Record<string, unknown> | undefined) => {
+	const settings: any = helpers.deepCopy(getDefaultSettings());
+	if (gameAttributes) {
+		for (const key of Object.keys(settings)) {
+			if (key === "noStartingInjuries" || key === "randomization" || key === "realStats" || key === "giveMeWorstRoster") {
+				continue;
+			}
+			const value = unwrapGameAttribute(gameAttributes as any, key as any);
+			if (value !== undefined) {
+				settings[key] = key === "repeatSeason" ? (value as any)?.type : value;
+			}
+		}
+	}
+	return settings;
+};
+
+/**
+ * Creates a league from a league file on the phone (path to a .json file), like New League → Upload league file.
+ * Returns the new league's id.
+ */
+export const makeCreateLeagueFromFile =
+	(createLeague: CreateLeague, initialCheck: InitialCheck) =>
+	async (
+		{ path, tid, name }: { path: string; tid?: number; name?: string },
+		conditions: Conditions,
+	) => {
+		const HostFile = (globalThis as any).__HostFile;
+		const file = new HostFile(path);
+		const leagueCreationID = `native-${Date.now()}`;
+		const { basicInfo } = await initialCheck({ file, leagueCreationID }, conditions);
+
+		if (Array.isArray(basicInfo.gameAttributes)) {
+			basicInfo.gameAttributes = gameAttributesArrayToObject(basicInfo.gameAttributes);
+		}
+		const ga = basicInfo.gameAttributes ?? {};
+
+		let teams = helpers.deepCopy(basicInfo.teams ?? []);
+		for (const t of teams) {
+			if (!Object.hasOwn(t, "pop") && t.seasons?.length > 0) {
+				t.pop = t.seasons.at(-1).pop;
+			}
+			if (typeof t.pop !== "number" || Number.isNaN(t.pop)) {
+				t.pop = 1;
+			}
+		}
+		teams = helpers.addPopRank(teams);
+
+		let userTid = tid;
+		if (userTid === undefined) {
+			const fromFile = Array.isArray(ga.userTid) ? ga.userTid.at(-1)?.value : ga.userTid;
+			userTid = typeof fromFile === "number" ? fromFile : 0;
+		}
+
+		return createLeague(
+			{
+				name: name ?? basicInfo.meta?.name ?? "NFL League",
+				tid: userTid,
+				file,
+				url: undefined,
+				keptKeys: Array.from(basicInfo.keys),
+				shuffleRosters: false,
+				importLid: undefined,
+				getLeagueOptions: undefined,
+				confs: ga.confs ? unwrapGameAttribute(ga, "confs") : DEFAULT_CONFS,
+				divs: ga.divs ? unwrapGameAttribute(ga, "divs") : DEFAULT_DIVS,
+				teamsFromInput: teams,
+				settings: settingsFromFile(ga),
+				fromFile: {
+					gameAttributes: ga,
+					maxGid: basicInfo.maxGid,
+					hasRookieContracts: basicInfo.hasRookieContracts ?? true,
+					startingSeason: basicInfo.startingSeason,
+					teams: basicInfo.teams,
+					version: basicInfo.version,
+				},
+				startingSeasonFromInput: undefined,
+				leagueCreationID,
+			},
+			conditions,
+		);
+	};
