+export const NflScoreboard = (b: BoardProps) => {
+	useBroadcastFonts();
+	// (no rain or snow falling over the score bug: the weather is on the field)
+	const weather = null;
+	const Board = {
+		glossy: Glossy,
+		flat: Flat,
+		glass: Glass,
+		angular: Angular,
+		sleek: Sleek,
+		premium: Premium,
+		caption: Caption,
+		boxy: Boxy,
+		corner: Corner,
+		xmas: Xmas,
+	}[b.p.pkg];
+	const dt = b.info?.date;
+	const ovh = (window as any).__nflOverride?.holiday as string | undefined;
+	const hol =
+		ovh === "christmas" || ovh === "halloween"
+			? (ovh as "christmas" | "halloween")
+			: ovh
+				? undefined
+				: b.p.key === "christmas"
+					? "christmas"
+					: dt && dt.getUTCMonth() === 9 && dt.getUTCDate() >= 25
+						? "halloween"
+						: undefined;
+	return (
+		<HolidayCtx.Provider value={hol}>
+			<style>{`@keyframes nflh-blink { 0%, 100% { opacity: 1; filter: brightness(1.3); } 50% { opacity: .55; filter: brightness(.85); } }`}</style>
+			<div style={{ position: "relative" }}>
+				<Board {...b} />
+				{weather}
+				{/* The network carrying the game, tucked under the bug's corner */}
+				{b.info?.network && b.p.pkg !== "caption" ? (
+					<span
+						style={{
+							position: "absolute",
+							right: 4,
+							top: "100%",
+							marginTop: 2,
+							background: "rgba(15,23,42,.88)",
+							color: "#ffffff",
+							fontSize: 10,
+							fontWeight: 800,
+							letterSpacing: 1,
+							padding: "1px 6px",
+							borderRadius: 3,
+							fontFamily: "system-ui, sans-serif",
+						}}
+					>
+						{b.info.network}
+					</span>
+				) : null}
+			</div>
+		</HolidayCtx.Provider>
+	);
+};
