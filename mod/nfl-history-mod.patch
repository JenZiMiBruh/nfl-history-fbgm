index 000000000..7fcc8b673
--- /dev/null
+++ b/src/ui/views/LiveGame/NflCrew.ts
@@ -0,0 +1,289 @@
+// NFL history mod: the broadcast crew and their gear in the 3D stadium. Everything here moves with the game:
+//   - the Skycam: a camera pod hung on four cables from the corners of the stadium, flying above and behind the play
+//   - the cart camera: a motorized cart with a jib arm and a studio camera, driving along the far sideline with the ball
+//   - the end-zone cranes: a long crane behind each end zone, its arm sweeping slowly, the camera at the tip
+//   - the kicking nets behind the goalposts, raised for field goals and extra points and lowered after
+// Used by NflField3D.tsx: build once, then update() every frame with where the ball is and whether a kick is on.
+import * as THREE from "three";
+
+const W = 120;
+const H = 53.3;
+const MID = H / 2;
+
+const mat = (
+	color: string,
+	extra: Partial<THREE.MeshStandardMaterialParameters> = {},
+) =>
+	new THREE.MeshStandardMaterial({
+		color,
+		roughness: 0.55,
+		metalness: 0.35,
+		...extra,
+	});
+
+// A broadcast camera: body, lens and hood, a red light on top when it's live
+const studioCamera = (scale = 1) => {
+	const g = new THREE.Group();
+	const body = new THREE.Mesh(
+		new THREE.BoxGeometry(0.9 * scale, 0.6 * scale, 1.2 * scale),
+		mat("#1f2937"),
+	);
+	const lens = new THREE.Mesh(
+		new THREE.CylinderGeometry(0.22 * scale, 0.28 * scale, 0.9 * scale, 18),
+		mat("#0b0f19", { metalness: 0.6 }),
+	);
+	lens.rotation.x = Math.PI / 2;
+	lens.position.z = 0.95 * scale;
+	const glass = new THREE.Mesh(
+		new THREE.CircleGeometry(0.2 * scale, 18),
+		new THREE.MeshStandardMaterial({
+			color: "#1e3a8a",
+			metalness: 0.9,
+			roughness: 0.1,
+		}),
+	);
+	glass.position.z = 1.41 * scale;
+	const hood = new THREE.Mesh(
+		new THREE.BoxGeometry(0.7 * scale, 0.5 * scale, 0.25 * scale),
+		mat("#111827"),
+	);
+	hood.position.z = 1.5 * scale;
+	const tally = new THREE.Mesh(
+		new THREE.SphereGeometry(0.07 * scale, 8, 8),
+		new THREE.MeshStandardMaterial({
+			color: "#ef4444",
+			emissive: "#ef4444",
+			emissiveIntensity: 1.5,
+		}),
+	);
+	tally.position.set(0, 0.36 * scale, -0.3 * scale);
+	g.add(body, lens, glass, hood, tally);
+	g.traverse((o: any) => {
+		if (o.isMesh) o.castShadow = false;
+	});
+	return g;
+};
+
+export class BroadcastCrew {
+	group = new THREE.Group();
+	skyPod: THREE.Group;
+	cables: THREE.LineSegments;
+	anchors = [
+		new THREE.Vector3(-16, 42, -24),
+		new THREE.Vector3(W + 16, 42, -24),
+		new THREE.Vector3(-16, 42, H + 26),
+		new THREE.Vector3(W + 16, 42, H + 26),
+	];
+	cart: THREE.Group;
+	cartArm: THREE.Group;
+	cranes: { pivot: THREE.Group; phase: number }[] = [];
+	nets: THREE.Mesh[] = [];
+	netLift = 0;
+	skyAt = new THREE.Vector3(W / 2, 18, MID + 8);
+	cartX = W / 2;
+
+	constructor() {
+		// Skycam: the pod and its four cables
+		this.skyPod = new THREE.Group();
+		const pod = new THREE.Mesh(
+			new THREE.SphereGeometry(0.7, 16, 12),
+			mat("#111827"),
+		);
+		const ring = new THREE.Mesh(
+			new THREE.TorusGeometry(0.85, 0.08, 8, 24),
+			mat("#9ca3af", { metalness: 0.8 }),
+		);
+		ring.rotation.x = Math.PI / 2;
+		const cam = studioCamera(0.55);
+		cam.position.y = -0.75;
+		cam.rotation.x = 0.5;
+		this.skyPod.add(pod, ring, cam);
+		this.group.add(this.skyPod);
+		const cg = new THREE.BufferGeometry();
+		cg.setAttribute(
+			"position",
+			new THREE.BufferAttribute(new Float32Array(8 * 3), 3),
+		);
+		this.cables = new THREE.LineSegments(
+			cg,
+			new THREE.LineBasicMaterial({
+				color: "#111111",
+				transparent: true,
+				opacity: 0.55,
+			}),
+		);
+		this.cables.frustumCulled = false;
+		this.group.add(this.cables);
+
+		// Cart camera on the far sideline: a cart, a column, a jib arm with the camera and a counterweight
+		this.cart = new THREE.Group();
+		const base = new THREE.Mesh(
+			new THREE.BoxGeometry(2.4, 0.7, 1.4),
+			mat("#27272a"),
+		);
+		base.position.y = 0.6;
+		for (const [wx, wz] of [
+			[-0.9, 0.7],
+			[0.9, 0.7],
+			[-0.9, -0.7],
+			[0.9, -0.7],
+		] as [number, number][]) {
+			const wheel = new THREE.Mesh(
+				new THREE.CylinderGeometry(0.28, 0.28, 0.2, 12),
+				mat("#0a0a0a"),
+			);
+			wheel.rotation.x = Math.PI / 2;
+			wheel.position.set(wx, 0.28, wz);
+			this.cart.add(wheel);
+		}
+		const column = new THREE.Mesh(
+			new THREE.CylinderGeometry(0.12, 0.16, 2.2, 10),
+			mat("#52525b"),
+		);
+		column.position.y = 2;
+		this.cartArm = new THREE.Group();
+		this.cartArm.position.y = 3.1;
+		const arm = new THREE.Mesh(
+			new THREE.BoxGeometry(0.16, 0.16, 5),
+			mat("#71717a"),
+		);
+		arm.position.z = 1;
+		const weight = new THREE.Mesh(
+			new THREE.BoxGeometry(0.6, 0.5, 0.6),
+			mat("#18181b"),
+		);
+		weight.position.z = -1.5;
+		const jibCam = studioCamera(0.5);
+		jibCam.position.z = 3.6;
+		this.cartArm.add(arm, weight, jibCam);
+		this.cart.add(base, column, this.cartArm);
+		this.cart.position.set(W / 2, 0, -2.2);
+		this.group.add(this.cart);
+
+		// Cranes behind each end zone
+		for (const x of [-9, W + 9]) {
+			const crane = new THREE.Group();
+			const tower = new THREE.Mesh(
+				new THREE.CylinderGeometry(0.3, 0.5, 6, 10),
+				mat("#3f3f46"),
+			);
+			tower.position.y = 3;
+			const pivot = new THREE.Group();
+			pivot.position.y = 6.2;
+			const boom = new THREE.Mesh(
+				new THREE.BoxGeometry(0.25, 0.25, 12),
+				mat("#a1a1aa"),
+			);
+			boom.position.z = 3.5;
+			const counter = new THREE.Mesh(
+				new THREE.BoxGeometry(0.9, 0.8, 0.9),
+				mat("#18181b"),
+			);
+			counter.position.z = -2.6;
+			const cc = studioCamera(0.55);
+			cc.position.z = 9.6;
+			cc.rotation.x = 0.35;
+			pivot.add(boom, counter, cc);
+			pivot.rotation.y = x < 0 ? Math.PI / 2 : -Math.PI / 2;
+			crane.add(tower, pivot);
+			crane.position.set(x, 0, MID + 14);
+			this.group.add(crane);
+			this.cranes.push({ pivot, phase: x < 0 ? 0 : 2 });
+		}
+
+		// The kicking nets behind each goalpost (down until a kick)
+		const netTex = (() => {
+			const c = document.createElement("canvas");
+			c.width = c.height = 64;
+			const g = c.getContext("2d")!;
+			g.strokeStyle = "rgba(255,255,255,.9)";
+			g.lineWidth = 2;
+			for (let i = 0; i <= 64; i += 8) {
+				g.beginPath();
+				g.moveTo(i, 0);
+				g.lineTo(i, 64);
+				g.moveTo(0, i);
+				g.lineTo(64, i);
+				g.stroke();
+			}
+			const t = new THREE.CanvasTexture(c);
+			t.wrapS = t.wrapT = THREE.RepeatWrapping;
+			t.repeat.set(9, 4);
+			return t;
+		})();
+		for (const x of [-1.2, W + 1.2]) {
+			const net = new THREE.Mesh(
+				new THREE.PlaneGeometry(18, 8),
+				new THREE.MeshBasicMaterial({
+					map: netTex,
+					transparent: true,
+					opacity: 0.75,
+					side: THREE.DoubleSide,
+					depthWrite: false,
+				}),
+			);
+			net.rotation.y = Math.PI / 2;
+			net.position.set(x, -4, MID);
+			this.group.add(net);
+			this.nets.push(net);
+		}
+	}
+
+	netHit = [-1e9, -1e9];
+	update(
+		ball: { x: number; y: number; h?: number },
+		dt: number,
+		opts: { kicking: boolean; od: 1 | -1 },
+	) {
+		const k = Math.min(1, dt * 1.5);
+		// The Skycam flies above and a little behind the play
+		const want = new THREE.Vector3(ball.x - opts.od * 10, 17, ball.y + 7);
+		this.skyAt.lerp(want, k);
+		this.skyPod.position.copy(this.skyAt);
+		this.skyPod.lookAt(ball.x, 0, ball.y);
+		const pos = this.cables.geometry.getAttribute(
+			"position",
+		) as THREE.BufferAttribute;
+		this.anchors.forEach((a, i) => {
+			pos.setXYZ(i * 2, a.x, a.y, a.z);
+			pos.setXYZ(i * 2 + 1, this.skyAt.x, this.skyAt.y + 0.6, this.skyAt.z);
+		});
+		pos.needsUpdate = true;
+		// The cart drives along the far sideline with the ball, the jib aimed at it
+		this.cartX +=
+			(Math.max(22, Math.min(W - 22, ball.x)) - this.cartX) *
+			Math.min(1, dt * 0.9);
+		this.cart.position.x = this.cartX;
+		this.cartArm.rotation.y =
+			Math.atan2(ball.x - this.cartX, ball.y + 2.2) * 0.8;
+		this.cartArm.rotation.x = -0.18;
+		// The cranes sweep slowly
+		const t = performance.now() / 1000;
+		for (const cr of this.cranes)
+			cr.pivot.rotation.x = Math.sin(t * 0.25 + cr.phase) * 0.12 - 0.05;
+		// The nets go up for a kick and come down after
+		this.netLift +=
+			((opts.kicking ? 1 : 0) - this.netLift) * Math.min(1, dt * 2.2);
+		// The ball hitting a net: it jolts back and shivers for a moment
+		const now = performance.now();
+		this.nets.forEach((net, i) => {
+			net.position.y = -4 + this.netLift * 11.5;
+			net.visible = this.netLift > 0.02;
+			const bottom = net.position.y - 4;
+			if (
+				ball.h !== undefined &&
+				Math.abs(ball.x - net.position.x) < 0.7 &&
+				Math.abs(ball.y - MID) < 9 &&
+				ball.h > bottom &&
+				now - this.netHit[i]! > 1500
+			)
+				this.netHit[i] = now;
+			const k = (now - this.netHit[i]!) / 700;
+			const shake =
+				k >= 0 && k < 1 ? Math.sin(k * Math.PI * 5) * (1 - k) * 0.35 : 0;
+			net.position.x =
+				(i === 0 ? -1.2 : W + 1.2) + (i === 0 ? -1 : 1) * Math.abs(shake);
+			net.scale.y = 1 - Math.abs(shake) * 0.08;
+		});
+	}
+}
diff --git a/src/ui/views/LiveGame/NflCutscene.ts b/src/ui/views/LiveGame/NflCutscene.ts
