new file mode 100644
index 000000000..4293303cd
--- /dev/null
+++ b/tools/native/RecordStore.js
@@ -0,0 +1,137 @@
+// Gridiron Almanac native engine: fake-indexeddb's RecordStore (v6.2.6) with a fast deleteByValue.
+// The original scans the whole index on every write to remove a row's old index entries, which makes saving a
+// league quadratic. This keeps a lookup from each value (the row's primary key, in an index) to its records.
+import FDBKeyRange from "../../node_modules/fake-indexeddb/build/esm/FDBKeyRange.js";
+import { cmpKeys } from "../../node_modules/fake-indexeddb/build/esm/lib/cmp.js";
+import BinarySearchTree from "../../node_modules/fake-indexeddb/build/esm/lib/binarySearchTree.js";
+
+// A string that is equal for equal IndexedDB keys (numbers, strings, dates, binary, arrays of those)
+const keyId = (k) => {
+	if (typeof k === "number") return "n" + k;
+	if (typeof k === "string") return "s" + k;
+	if (k instanceof Date) return "d" + k.getTime();
+	if (Array.isArray(k)) return "a[" + k.map(keyId).join(",") + "]";
+	if (ArrayBuffer.isView(k)) return "b" + Array.from(new Uint8Array(k.buffer, k.byteOffset, k.byteLength)).join(".");
+	if (k instanceof ArrayBuffer) return "b" + Array.from(new Uint8Array(k)).join(".");
+	return "o" + String(k);
+};
+
+class RecordStore {
+	constructor(keysAreUnique) {
+		this.keysAreUnique = keysAreUnique;
+		this.records = new BinarySearchTree(this.keysAreUnique);
+		// value id -> records with that value (only meaningful for indexes, where value is the primary key)
+		this.byValue = new Map();
+	}
+	_track(record) {
+		if (this.keysAreUnique) return;
+		const id = keyId(record.value);
+		let list = this.byValue.get(id);
+		if (!list) {
+			list = [];
+			this.byValue.set(id, list);
+		}
+		list.push(record);
+	}
+	_untrack(record) {
+		if (this.keysAreUnique) return;
+		const id = keyId(record.value);
+		const list = this.byValue.get(id);
+		if (!list) return;
+		const i = list.indexOf(record);
+		if (i >= 0) list.splice(i, 1);
+		if (list.length === 0) this.byValue.delete(id);
+	}
+	get(key) {
+		const range = key instanceof FDBKeyRange ? key : FDBKeyRange.only(key);
+		return this.records.getRecords(range).next().value;
+	}
+	put(newRecord, noOverwrite = false) {
+		const overwritten = this.records.put(newRecord, noOverwrite);
+		if (overwritten) this._untrack(overwritten);
+		this._track(newRecord);
+		return overwritten;
+	}
+	delete(key) {
+		const range = key instanceof FDBKeyRange ? key : FDBKeyRange.only(key);
+		const deletedRecords = [...this.records.getRecords(range)];
+		for (const record of deletedRecords) {
+			this.records.delete(record);
+			this._untrack(record);
+		}
+		return deletedRecords;
+	}
+	deleteByValue(key) {
+		if (!this.keysAreUnique && !(key instanceof FDBKeyRange && (key.lower === undefined || key.upper === undefined || cmpKeys(key.lower, key.upper) !== 0 || key.lowerOpen || key.upperOpen))) {
+			// Exact key: look its records up directly
+			const exact = key instanceof FDBKeyRange ? key.lower : key;
+			const list = this.byValue.get(keyId(exact));
+			if (!list) return [];
+			const deletedRecords = list.slice();
+			for (const record of deletedRecords) this.records.delete(record);
+			this.byValue.delete(keyId(exact));
+			return deletedRecords;
+		}
+		const range = key instanceof FDBKeyRange ? key : FDBKeyRange.only(key);
+		const deletedRecords = [];
+		for (const record of this.records.getAllRecords()) {
+			if (range.includes(record.value)) {
+				deletedRecords.push(record);
+			}
+		}
+		for (const record of deletedRecords) {
+			this.records.delete(record);
+			this._untrack(record);
+		}
+		return deletedRecords;
+	}
+	clear() {
+		const deletedRecords = [...this.records.getAllRecords()];
+		this.records = new BinarySearchTree(this.keysAreUnique);
+		this.byValue = new Map();
+		return deletedRecords;
+	}
+	values(range, direction = "next") {
+		const descending = direction === "prev" || direction === "prevunique";
+		const records = range ? this.records.getRecords(range, descending) : this.records.getAllRecords(descending);
+		return {
+			[Symbol.iterator]: () => {
+				const next = () => records.next();
+				if (direction === "next" || direction === "prev") {
+					return { next };
+				}
+				if (direction === "nextunique") {
+					let previousValue = undefined;
+					return {
+						next: () => {
+							let current = next();
+							while (!current.done && previousValue !== undefined && cmpKeys(previousValue.key, current.value.key) === 0) {
+								current = next();
+							}
+							previousValue = current.value;
+							return current;
+						},
+					};
+				}
+				let current = next();
+				let nextResult = next();
+				return {
+					next: () => {
+						while (!nextResult.done && cmpKeys(current.value.key, nextResult.value.key) === 0) {
+							current = nextResult;
+							nextResult = next();
+						}
+						const result = current;
+						current = nextResult;
+						nextResult = next();
+						return result;
+					},
+				};
+			},
+		};
+	}
+	size() {
+		return this.records.size();
+	}
+}
+export default RecordStore;
