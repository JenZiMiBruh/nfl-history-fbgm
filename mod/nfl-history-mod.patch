diff --git a/src/common/faceAging.ts b/src/common/faceAging.ts
new file mode 100644
index 000000000..235cb5af2
--- /dev/null
+++ b/src/common/faceAging.ts
@@ -0,0 +1,353 @@
+// NFL history mod: player faces change with age and from season to season. Derived, never stored: the same player
+// (seed: pid) at the same season always gets the same face, so a page shows the same face every time and every page
+// agrees. Per-player traits (how early and how much he grays, whether and when he balds, when lines appear) come
+// from the player alone; the expression comes from the player and the season.
+import { type FaceConfig, svgs } from "facesjs";
+
+export type FaceAging = {
+	seed: number;
+	age: number;
+	season: number;
+	// how that season went for him, -1 (awful) to 1 (great): his team's record and his own play (worker faceJerseyFor.ts)
+	mood?: number;
+};
+
+// Small, fast, stable hash into [0, 1)
+const rand = (...parts: (number | string)[]) => {
+	let h = 2166136261;
+	for (const ch of parts.join("|")) {
+		h ^= ch.charCodeAt(0);
+		h = Math.imul(h, 16777619);
+	}
+	h ^= h >>> 13;
+	h = Math.imul(h, 0x5bd1e995);
+	h ^= h >>> 15;
+	return (h >>> 0) / 4294967296;
+};
+
+const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
+const clamp01 = (x: number) => Math.max(0, Math.min(1, x));
+
+const hexToRgb = (hex: string) => {
+	const m = /^#?([\da-f]{6})$/i.exec(hex.trim());
+	if (!m) {
+		return undefined;
+	}
+	const n = Number.parseInt(m[1]!, 16);
+	return [(n >> 16) & 255, (n >> 8) & 255, n & 255] as const;
+};
+const rgbToHex = (rgb: readonly number[]) =>
+	`#${rgb.map((c) => Math.round(c).toString(16).padStart(2, "0")).join("")}`;
+
+// Hair heads toward gray, then silver: dark hair through salt-and-pepper, light hair just fades lighter
+const grayHair = (color: string, amount: number) => {
+	const rgb = hexToRgb(color);
+	if (!rgb || amount <= 0) {
+		return color;
+	}
+	const light = (rgb[0] + rgb[1] + rgb[2]) / 3;
+	// silver for dark hair, a pale ash for blond and red
+	const target = light > 140 ? [222, 214, 200] : [178, 178, 176];
+	const late = amount > 0.7 ? [226, 226, 224] : target;
+	return rgbToHex(rgb.map((c, i) => lerp(c, late[i]!, amount)));
+};
+
+// Balding goes one small step at a time, and only from hairstyles near the balding ones
+const BALD_STEPS: Record<string, string> = {
+	short2: "short",
+	short3: "short",
+	parted: "short",
+	"middle-part": "short",
+	"messy-short": "short",
+	hair: "short",
+	short: "crop",
+	crop: "short-bald",
+	"crop-fade": "short-bald",
+	"crop-fade2": "short-bald",
+	// a light buzz is already nearly bald: the horseshoe would be a bigger change than going smooth
+	"short-fade": "bald",
+	"short-fade-2": "bald",
+	"short-bald": "bald",
+};
+
+// Facial hair a player may grow with age, from a light mustache to a full beard
+const GROWN = [
+	"mustache1",
+	"goatee1",
+	"fullgoatee",
+	"beard1",
+	"beard2",
+	"beard3",
+	"beard4",
+	"logan",
+	"honest-abe",
+];
+
+// Crow's feet: a fan of short lines off the outer corner of each eye (facesjs has none). Eye lines are drawn on the
+// whole face before the eyes, whose outer corners sit near x 107 and 293 at y 310, so these start just outside them.
+// depth 1: two short lines, 2: three, 3: three longer ones
+const CROWS_FEET: Record<number, string> = {
+	1: "M100 303q-7-3-13-6M100 314q-7 2-13 4",
+	2: "M101 302q-8-4-15-8M100 310q-8 0-15 0M101 318q-7 3-14 7",
+	3: "M102 301q-10-5-19-10M101 310q-10 0-19 0M102 319q-9 4-18 9",
+};
+// Registers the face's own eye line plus crow's feet as a new eye line, and returns its id
+const withCrowsFeet = (eyeLineId: string, depth: number) => {
+	const table = svgs.eyeLine as Record<string, string>;
+	const id = `${eyeLineId}+crows${depth}`;
+	if (!table[id]) {
+		const left = CROWS_FEET[depth]!;
+		// mirrored for the right eye: every q's x step flips, and so does each start point
+		const right = left
+			.split("M")
+			.filter(Boolean)
+			.map((seg) => {
+				const [start, curve] = seg.split("q") as [string, string];
+				const [x, y] = start.trim().split(" ").map(Number) as [number, number];
+				const nums = curve.match(/-?\d+/g)!.map(Number);
+				return `M${400 - x} ${y}q${-nums[0]!} ${nums[1]} ${-nums[2]!} ${nums[3]}`;
+			})
+			.join("");
+		table[id] =
+			(table[eyeLineId] ?? "") +
+			`<path fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-opacity="0.75" d="${left}${right}"/>`;
+	}
+	return id;
+};
+
+// Beards a player might grow for a season or a few: mostly full ones, a scruffy offseason look
+const SPELL_BEARDS = [
+	"beard1",
+	"beard2",
+	"beard3",
+	"beard4",
+	"beard5",
+	"fullgoatee",
+	"logan",
+];
+
+const EXPRESSIONS = {
+	happy: {
+		mouths: ["smile-closed", "smile", "smile3", "smile4"],
+		brow: [-10, 3],
+	},
+	neutral: {
+		mouths: ["straight", "mouth2", "mouth3", "mouth4", "mouth5", "side"],
+		brow: [0, 9],
+	},
+	intense: { mouths: ["angry", "closed"], brow: [11, 20] },
+} as const;
+
+export const ageFace = (face: FaceConfig, aging: FaceAging): FaceConfig => {
+	const { seed, age, season } = aging;
+	const out = structuredClone(face);
+
+	// Graying, in one of three ways: a few barely gray, some go silver early and all the way, most somewhere between
+	const grayStyle = rand(seed, "grayStyle");
+	const [grayStart, graySpan, grayMax] =
+		grayStyle < 0.15
+			? [
+					lerp(34, 42, rand(seed, "grayStart")),
+					14,
+					lerp(0.1, 0.3, rand(seed, "grayMax")),
+				]
+			: grayStyle < 0.35
+				? [
+						lerp(26, 31, rand(seed, "grayStart")),
+						lerp(6, 10, rand(seed, "graySpan")),
+						lerp(0.8, 0.98, rand(seed, "grayMax")),
+					]
+				: [
+						lerp(30, 40, rand(seed, "grayStart")),
+						lerp(8, 16, rand(seed, "graySpan")),
+						lerp(0.45, 0.9, rand(seed, "grayMax")),
+					];
+	const gray = clamp01((age - grayStart) / graySpan) * grayMax;
+	if (out.hair && typeof out.hair.color === "string") {
+		out.hair.color = grayHair(out.hair.color, gray);
+	}
+
+	// How weathered he gets: lines come up to 4 years earlier for some, up to 4 later for others
+	// (someone who barely grays always gets his lines on time or early, so he still looks his age)
+	const weatheredRoll = (rand(seed, "weathered") - 0.5) * 8;
+	const weathered = grayStyle < 0.15 ? Math.abs(weatheredRoll) : weatheredRoll;
+	const lineAge = (lo: number, hi: number, key: string) =>
+		lerp(lo, hi, rand(seed, key)) - weathered;
+
+	// Weight: about a third fill out over the years, a few get leaner
+	if (typeof out.fatness === "number") {
+		const weight = rand(seed, "weight");
+		const progress = clamp01((age - 27) / 12);
+		const change =
+			weight < 0.35
+				? lerp(0.12, 0.35, rand(seed, "weightAmount"))
+				: weight > 0.88
+					? -0.12
+					: 0;
+		out.fatness = clamp01(out.fatness + change * progress);
+	}
+
+	// Ears and noses keep growing a little, more for some than others
+	const growth = lerp(0.4, 1, rand(seed, "growth")) * clamp01((age - 30) / 14);
+	if (out.ear && typeof out.ear.size === "number") {
+		out.ear.size = Math.min(1.6, out.ear.size + 0.18 * growth);
+	}
+	if (out.nose && typeof out.nose.size === "number") {
+		out.nose.size = Math.min(1.4, out.nose.size + 0.12 * growth);
+	}
+
+	// Facial hair: some grow a beard or mustache in their 30s, a few shave theirs off for good
+	if (out.facialHair) {
+		const change = rand(seed, "beardChange");
+		const when = lerp(28, 36, rand(seed, "beardAge"));
+		if (age >= when) {
+			if (change < 0.25 && out.facialHair.id === "none") {
+				out.facialHair.id =
+					GROWN[Math.floor(rand(seed, "beardStyle") * GROWN.length)]!;
+			} else if (change > 0.9 && out.facialHair.id !== "none") {
+				out.facialHair.id = "none";
+			}
+		}
+
+		// Beard spells at any age: some seasons a clean-shaven player shows up with a beard (always his own style)
+		// and keeps it 1 to 3 seasons; some players are far more prone to it than others. Bearded players now and then
+		// have a clean-shaven spell the same way.
+		const bearded = out.facialHair.id !== "none";
+		const prone = rand(seed, "beardProne");
+		const pStart = bearded ? 0.05 : 0.04 + 0.16 * prone * prone;
+		let spell = false;
+		for (let s = season - 2; s <= season; s++) {
+			const length = 1 + Math.floor(rand(seed, s, "spellLength") * 3);
+			if (rand(seed, s, "spellStart") < pStart && s + length > season) {
+				spell = true;
+			}
+		}
+		if (spell && age >= 21) {
+			out.facialHair.id = bearded
+				? "none"
+				: SPELL_BEARDS[
+						Math.floor(rand(seed, "spellStyle") * SPELL_BEARDS.length)
+					]!;
+		}
+	}
+
+	// Reading glasses for a few, from their mid-30s
+	if (
+		out.glasses?.id === "none" &&
+		rand(seed, "glasses") < 0.12 &&
+		age >= lerp(33, 41, rand(seed, "glassesAge"))
+	) {
+		out.glasses.id = "glasses2-black";
+	}
+
+	// Balding: about 1 in 3 players, starting from 29 to 38, a step every 2 to 4 years
+	if (out.hair && rand(seed, "balds") < 0.35) {
+		const start = lerp(29, 38, rand(seed, "baldStart"));
+		const every = lerp(2, 4, rand(seed, "baldEvery"));
+		// only a few go all the way
+		const maxSteps = rand(seed, "baldAll") < 0.25 ? 4 : 3;
+		const steps =
+			age < start
+				? 0
+				: Math.min(maxSteps, 1 + Math.floor((age - start) / every));
+		for (let i = 0; i < steps; i++) {
+			const next = BALD_STEPS[out.hair.id];
+			const fromBuzz = out.hair.id.startsWith("short-fade");
+			if (!next || (next === "bald" && maxSteps < 4 && !fromBuzz)) {
+				break;
+			}
+			out.hair.id = next;
+		}
+	}
+
+	// Lines: each kind shows up at its own age, never removed once there
+	if (
+		out.eyeLine?.id === "none" &&
+		age >= Math.min(36, lineAge(28, 35, "eyeLineAge"))
+	) {
+		out.eyeLine.id = `line${1 + Math.floor(rand(seed, "eyeLine") * 6)}`;
+	}
+	if (out.smileLine && age >= lineAge(30, 38, "smileLineAge")) {
+		if (out.smileLine.id === "none") {
+			out.smileLine.id = `line${1 + Math.floor(rand(seed, "smileLine") * 4)}`;
+			out.smileLine.size = 0.8;
+		}
+		// deeper with age
+		out.smileLine.size = Math.min(
+			2.25,
+			Math.max(out.smileLine.size ?? 1, 0.8 + (age - 30 + weathered) * 0.08),
+		);
+	}
+	const foreheadFree =
+		!out.miscLine ||
+		["none", "blush", "freckles1", "freckles2"].includes(out.miscLine.id);
+	if (
+		out.miscLine &&
+		foreheadFree &&
+		age >= Math.min(41, lineAge(31, 40, "foreheadAge"))
+	) {
+		// deeper creases later on
+		out.miscLine.id =
+			age >= 38 - weathered
+				? rand(seed, "forehead") < 0.5
+					? "forehead5"
+					: "forehead2"
+				: `forehead${3 + Math.floor(rand(seed, "forehead") * 2)}`;
+	}
+
+	// Expression for this season, leaning toward the player's own temperament
+	// Expression for this season: how the season went (mood) moves it most, his temperament a little; a great
+	// season still leaves a stern face possible and a losing one a smile, just much less often
+	const temperament = rand(seed, "temperament");
+	const mood = Math.max(-1, Math.min(1, aging.mood ?? 0));
+	const roll = rand(seed, season, "expression");
+	const happyShare = Math.max(
+		0.04,
+		Math.min(0.9, 0.2 + 0.3 * temperament + 0.4 * mood),
+	);
+	const intenseShare = Math.max(
+		0.03,
+		Math.min(0.75, 0.25 - 0.12 * temperament - 0.3 * mood),
+	);
+	const kind: keyof typeof EXPRESSIONS =
+		roll < happyShare
+			? "happy"
+			: roll < 1 - intenseShare
+				? "neutral"
+				: "intense";
+	const expression = EXPRESSIONS[kind];
+	if (out.mouth) {
+		out.mouth.id =
+			expression.mouths[
+				Math.floor(rand(seed, season, "mouth") * expression.mouths.length)
+			]!;
+	}
+	if (out.eyebrow) {
+		out.eyebrow.angle = Math.round(
+			lerp(expression.brow[0], expression.brow[1], rand(seed, season, "brow")),
+		);
+	}
+	// The eyes vary a little too, but never tilt below level
+	if (out.eye) {
+		const base = Math.max(0, out.eye.angle ?? 0);
+		out.eye.angle = Math.max(
+			0,
+			Math.round(base + lerp(-3, 3, rand(seed, season, "eye"))),
+		);
+	}
+
+	// Crow's feet from the 30s, deeper over the years and more for weathered faces; a smile that season deepens them
+	if (out.eyeLine) {
+		const start = lineAge(31, 39, "crowsAge");
+		if (age >= start - (kind === "happy" ? 3 : 0)) {
+			const years = age - start;
+			const depth = Math.min(
+				3,
+				(years >= 7 ? 3 : years >= 3 ? 2 : 1) + (kind === "happy" ? 1 : 0),
+			);
+			out.eyeLine.id = withCrowsFeet(out.eyeLine.id, depth);
+		}
+	}
+
+	return out;
+};
