+// NFL history mod: the team's look history on the team history page: every real home jersey era, worn by the player who
+// played the most games in it (his number and name; the card flips to the front on hover) and every logo it has used, with the seasons each was worn
+import { JerseyNumber } from "../../components/JerseyNumber.tsx";
+import HideableSection from "../../components/HideableSection.tsx";
+import type { NflJersey } from "../../../common/nflJerseys.ts";
+
+type Looks = {
+	jerseys: { start: number; end: number; j: NflJersey; name?: string; number?: string }[];
+	logos: { start: number; end: number; imgURL: string }[];
+};
+
+const years = (a: number, b: number) => (a === b ? `${a - 1}` : `${a - 1}–${b - 1}`);
+
+const LookHistory = ({ looks }: { looks?: Looks }) => {
+	if (!looks || (looks.jerseys.length === 0 && looks.logos.length === 0)) {
+		return null;
+	}
+	return (
+		<HideableSection title="Jersey and logo history" className="mt-3">
+			{looks.jerseys.length > 0 ? (
+				<>
+					<h3>Home jerseys</h3>
+					<div className="d-flex flex-wrap gap-2 mb-3">
+						{looks.jerseys.map((row) => (
+							<JerseyNumber
+								key={row.start}
+								number={row.number ?? "00"}
+								name={row.name}
+								start={row.start - 1}
+								end={row.end - 1}
+								t={{
+									colors: [row.j.body, row.j.stripe1 ?? "#ffffff", row.j.stripe2 ?? "#000000"] as [string, string, string],
+									name: "",
+									region: "",
+									nflJersey: row.j,
+								}}
+							/>
+						))}
+					</div>
+				</>
+			) : null}
+			{looks.logos.length > 0 ? (
+				<>
+					<h3>Logos</h3>
+					<div className="d-flex flex-wrap gap-3">
+						{looks.logos.map((row) => (
+							<div key={row.start} className="text-center" style={{ width: 96 }}>
+								<img alt="" src={row.imgURL} style={{ width: 80, height: 80, objectFit: "contain" }} />
+								<div className="small text-body-secondary">{years(row.start, row.end)}</div>
+							</div>
+						))}
+					</div>
+				</>
+			) : null}
+		</HideableSection>
+	);
+};
+
+export default LookHistory;
