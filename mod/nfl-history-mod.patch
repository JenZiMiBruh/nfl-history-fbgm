+						if (rel.tag_name && !String(v.version).includes("alpha") && isNewer(rel.tag_name, v.version)) {
+							setLatest(rel.tag_name);
+						}
+					})
+					.catch(() => {});
+				if (localStorage.getItem(SEEN_KEY) !== v.version) {
+					localStorage.setItem(SEEN_KEY, v.version);
+					setShow("new");
+				}
+			} catch {
+				// no files (or no storage): nothing to show
+			}
+		})();
+	}, []);
+
+	if (!version) {
+		return null;
+	}
+
+	// At the top of every page, in the page flow (not fixed: a fixed button covered the sidebar and roster rows on
+	// phones). Controller puts an empty #nfl-top-strip under the title bar; until it's there, this stays at the bottom.
+	const strip = (
+		<>
+			{latest ? (
+				<div
+					className="d-flex flex-wrap align-items-center gap-2 px-3 py-2 mb-2 rounded text-white"
+					style={{ background: "#0b5ed7" }}
+				>
+					<b>⬆ NFL History {latest} is out</b>
+					{updateStatus ? (
+						<span>{updateStatus}</span>
+					) : (
+						<>
+							<span className="opacity-75">You have v{version}.</span>
+							<button className="btn btn-sm btn-light fw-bold" type="button" onClick={update}>
+								Update now
+							</button>
+						</>
+					)}
+				</div>
+			) : null}
+			<div ref={setAlphaSlot} />
+			<div className="d-flex justify-content-end mb-1">
+				<button
+					className="btn btn-sm btn-outline-secondary py-0"
+					type="button"
+					onClick={() => setShow("all")}
+				>
+					📰 What's new in NFL History v{version}
+				</button>
+			</div>
+		</>
+	);
+
+	return (
+		<>
+			{slot ? createPortal(strip, slot) : <div className="px-3 pb-3">{strip}</div>}
+			<NflLiveAlpha version={version} ready={show === undefined} slot={alphaSlot} />
+			<Modal show={show !== undefined} onHide={() => setShow(undefined)} size="lg" scrollable>
+				<Modal.Header closeButton>
+					<Modal.Title>
+						{show === "new" ? "What's new in the NFL History mod" : "NFL History changelog"}
+					</Modal.Title>
+				</Modal.Header>
+				<Modal.Body>
+					{/* The poll first, where it's seen without scrolling past the changelog */}
+					<NflPoll />
+					{render(changelog, show === "new")}
+				</Modal.Body>
+				<Modal.Footer>
+					{show === "new" ? (
+						<button className="btn btn-secondary" type="button" onClick={() => setShow("all")}>
+							Full changelog
+						</button>
+					) : null}
+					<button className="btn btn-primary" type="button" onClick={() => setShow(undefined)}>
+						Close
+					</button>
+				</Modal.Footer>
+			</Modal>
+		</>
+	);
+};
