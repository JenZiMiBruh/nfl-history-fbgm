+	if (s.rus && (pos === "RB" || pos === "QB" || s.rus > 20))
+		parts.push(`${s.rus} car, ${Math.round(s.rusYds)} yds, ${s.rusTD} TD`);
+	if (s.rec)
+		parts.push(`${s.rec} rec, ${Math.round(s.recYds)} yds, ${s.recTD} TD`);
