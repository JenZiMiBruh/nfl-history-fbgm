+	"East Rutherford": "lonestar",
+};
+
+type ModernLook = {
+	// silver numerals with a colored edge, or the city's art inside them
+	edge?: string;
+	edge2?: string;
+	paint?: string;
+	bar: string;
+	barText: string;
+	outline?: string;
+};
+
+const MODERN: Record<number, ModernLook> = {
+	51: { edge: "#C8102E", edge2: "#0B2265", bar: "#C8102E", barText: "#fff" },
+	52: { edge: "#1A8FD8", edge2: "#0B2265", bar: "#1A6FB5", barText: "#fff" },
+	53: { edge: "#1D57A4", edge2: "#7CC0F0", bar: "#1D57A4", barText: "#fff" },
+	54: { edge: "#D9B44A", edge2: "#8A6A1E", bar: "#138A8A", barText: "#fff" },
+	55: { edge: "#2BB3C0", edge2: "#F59A1C", bar: "#F59A1C", barText: "#fff" },
+	56: { paint: "sunset", bar: "silver", barText: "#1B2A44", outline: "#2E6FB0" },
+	57: { paint: "desert", bar: "silver", barText: "#1B2A44", outline: "#1B6B74" },
+	58: { paint: "neon", bar: "silver", barText: "#3A1D6E", outline: "#3A1D6E" },
+	59: { paint: "filigree", bar: "silver", barText: "#8E0C21", outline: "#8E0C21" },
+	60: { paint: "bay", bar: "silver", barText: "#1B2A44", outline: "#1B2A44" },
+	61: { paint: "waves", bar: "silver", barText: "#1B2A44", outline: "#F28C28" },
+};
+
+export const trophyNumerals = (n: number, num: string, look: ModernLook, p: string) => {
+	const seq = withTrophy(num);
+	const top = 80;
+	const h = 94;
+	const k = h / 100;
+	let g = glyphPaths(seq, 128, top, h, 1.18, 7, 36);
+	const fit = Math.min(1.18, (1.18 * 226) / g.width);
+	g = glyphPaths(seq, 128, top, h, fit, 7, 36);
+	const letters = g.items.filter((it) => it.ch !== "T");
+	const slot = g.items.find((it) => it.ch === "T")!;
+	const shapes = (attrs: string, dx = 0, dy = 0) =>
+		letters.map((it) => `<path transform='translate(${dx} ${dy}) ${it.tf}' d='${GLYPH[it.ch]!.d}' ${attrs}/>`).join("");
+	const sw = (v: number) => (v / k).toFixed(2);
+	const x0 = g.left - 6;
+	const x1 = g.left + g.width + 6;
+	const clip = `<clipPath id='${p}cl'>${letters.map((it) => `<path transform='${it.tf}' d='${GLYPH[it.ch]!.d}'/>`).join("")}</clipPath>`;
+	// depth: the letters' sides, stepping down and to the left
+	const depth = (col: string) => [5, 4, 3, 2, 1].map((i) => shapes(`fill='${col}'`, -i * 0.9, i * 0.8)).join("");
+	let body = clip;
+	if (look.paint) {
+		const ol = look.outline ?? "#333";
+		body +=
+			depth(ol) +
+			`<g clip-path='url(#${p}cl)'>${PAINT[look.paint]!(p, x0, top, x1, top + h)}` +
+			// a silver bevel just inside the edge
+			shapes(`fill='none' stroke='url(#${p}ls)' stroke-width='${sw(7)}'`) +
+			`</g>` +
+			shapes(`fill='none' stroke='${ol}' stroke-width='${sw(1.4)}'`);
+	} else {
+		body +=
+			depth(look.edge2 ?? "#333") +
+			shapes(`fill='${look.edge}'`) +
+			// the silver face, shifted so the colored bevel shows down the left and along the bottom
+			`<g clip-path='url(#${p}cl)'>${shapes(`fill='url(#${p}ls)'`, 4, -3)}${shapes(`fill='none' stroke='#FFFFFF' stroke-width='${sw(1.2)}' opacity='0.9'`, 4, -3)}</g>` +
+			shapes(`fill='none' stroke='#4B525B' stroke-width='${sw(1.2)}'`);
+	}
+	const barFill = look.bar === "silver" ? `url(#${p}bs)` : look.bar;
+	const bx = Math.max(16, x0);
+	const bw = Math.min(224, x1 - x0);
+	return (
+		`<defs>${trophyDefs(p)}${lin(`${p}ls`, ["#F4F6F8", "#C3C9CF", "#838B95", "#C9CED4", "#EEF0F2"])}${lin(`${p}bs`, ["#FDFDFD", "#D3D7DC", "#9AA2AC"])}</defs>` +
+		body +
+		trophy(p, slot.cx, 10, 172) +
+		`<rect x='${bx}' y='178' width='${bw}' height='22' rx='2' fill='${barFill}' stroke='${look.bar === "silver" ? "#59616B" : "#fff"}' stroke-width='2'/>` +
+		(look.bar === "silver" ? "" : `<rect x='${bx + 2}' y='180' width='${bw - 4}' height='7' fill='#fff' opacity='0.25'/>`) +
+		txt("SUPER BOWL", { y: 195, size: 16, fill: look.barText, font: "Arial", ls: 4, w: Math.min(180, bw - 30) })
+	);
+};
+
+const FIT: Record<number, [number, number]> = {
+	31: [1.12, 6],
+	32: [1.12, 0],
+	33: [1.14, 0],
+	35: [1.1, 0],
+	36: [1.08, 0],
+	37: [1.1, 0],
+	40: [1.08, -6],
+	42: [1.12, -8],
+};
+
+// The real logo for Super Bowl XXVI-LXI, or undefined
+export const realLateLogo = (n: number, num: string): string | undefined => {
+	const p = `r${n}`;
+	if (n >= 26 && n <= 44) {
+		// a few crests are drawn small; scale them up to fill the canvas like the rest
+		const fit = FIT[n];
+		const body = crest(n, p);
+		return fit && body ? `<g transform='translate(128 128) scale(${fit[0]}) translate(-128 ${-128 + fit[1]})'>${body}</g>` : body;
+	}
+	if (n >= 45 && n <= 50) {
+		return silverEra(n, p);
+	}
+	const look = MODERN[n];
+	return look ? trophyNumerals(n, num, look, p) : undefined;
+};
+
+// ---------- generated games after LXI ----------
+// Every few years the look changes, like the real eras did: the trophy in the numerals filled with the host city's
+// art, the trophy over a city badge, or a crest. The city's theme and colors always come through.
+const rnd = (seed: number) => {
+	let st = (seed * 2654435761) >>> 0;
+	return () => {
+		st = (st + 0x6d2b79f5) >>> 0;
+		let t = st;
+		t = Math.imul(t ^ (t >>> 15), t | 1);
+		t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+	};
+};
+
+const genEra = (n: number) => {
+	let start = 62;
+	let era = 0;
+	let prev = 0;
+	for (;;) {
+		const r = rnd(500 + era);
+		const len = 6 + Math.floor(r() * 5);
+		// the first generated era carries on the real look; after that the look changes every era
+		const kind = era === 0 ? 0 : (prev + 1 + Math.floor(r() * 2)) % 3;
+		if (n < start + len) {
+			return { kind, era };
+		}
+		start += len;
+		prev = kind;
+		era++;
+	}
+};
+
+export const generatedLogo = (n: number, num: string, host: string, colors: [string, string, string]) => {
+	const p = `g${n}`;
+	const theme = CITY_THEME[host] ?? "sunset";
+	const { kind } = genEra(n);
+	const [c1, c2] = colors;
+	if (kind === 0) {
+		return trophyNumerals(n, num, { paint: theme, bar: "silver", barText: c1, outline: c1 }, p);
+	}
+	if (kind === 1) {
+		// the trophy over a round city badge, numerals in metal below
+		const g = glyphPaths(num, 128, 166, 44, 1.15, 6, 0);
+		const fit = Math.min(1, 210 / g.width);
+		const gg = fit < 1 ? glyphPaths(num, 128, 166, 44, 1.15 * fit, 6, 0) : g;
+		return (
+			`<defs>${trophyDefs(p)}${lin(`${p}nm`, ["#FFFFFF", "#D3D8DE", "#8C949E", "#C9CED4", "#F2F4F6"])}<clipPath id='${p}cc'><circle cx='128' cy='92' r='60'/></clipPath></defs>` +
+			`<circle cx='128' cy='92' r='66' fill='${c1}'/>` +
+			`<g clip-path='url(#${p}cc)'>${PAINT[theme]!(p, 60, 30, 196, 156)}</g>` +
+			`<circle cx='128' cy='92' r='60' fill='none' stroke='#fff' stroke-width='4'/>` +
+			trophy(p, 128, 22, 128) +
+			`<path d='M40 140 L216 140 L208 160 L48 160 Z' fill='${c1}' stroke='#fff' stroke-width='2'/>` +
+			txt("SUPER BOWL", { y: 155, size: 14, fill: "#fff", font: "Arial", ls: 4 }) +
+			gg.items.map((it) => `<path transform='${it.tf}' d='${GLYPH[it.ch]!.d}' fill='url(#${p}nm)' stroke='${c1}' stroke-width='4'/>`).join("") +
+			txt(host.toUpperCase(), { y: 232, size: 11, fill: c1, font: "Arial", weight: 700, ls: 2 })
+		);
+	}
+	// a crest: the shield holds the city's art, metal numerals across it, SUPER BOWL banner
+	const g = glyphPaths(num, 128, 108, 64, 1, 6, 0);
+	const fit = Math.min(1, 200 / g.width);
+	const gg = fit < 1 ? glyphPaths(num, 128, 108, 64, fit, 6, 0) : g;
+	return (
+		`<defs>${lin(`${p}nm`, ["#FFFFFF", "#D3D8DE", "#8C949E", "#C9CED4", "#F2F4F6"])}<clipPath id='${p}sh'><path d='M44 34 L212 34 L212 120 Q212 190 128 224 Q44 190 44 120 Z'/></clipPath></defs>` +
+		`<path d='M38 28 L218 28 L218 120 Q218 196 128 232 Q38 196 38 120 Z' fill='${c1}'/>` +
+		`<g clip-path='url(#${p}sh)'>${PAINT[theme]!(p, 44, 34, 212, 224)}</g>` +
+		`<path d='M44 34 L212 34 L212 120 Q212 190 128 224 Q44 190 44 120 Z' fill='none' stroke='${c2}' stroke-width='4'/>` +
+		`<path d='M18 54 L238 54 L226 72 L238 90 L18 90 L30 72 Z' fill='${c1}' stroke='#fff' stroke-width='3'/>` +
+		txt("SUPER BOWL", { y: 81, size: 24, fill: "#fff", font: BLOCK, ls: 2, w: 170 }) +
+		gg.items.map((it) => `<path transform='${it.tf}' d='${GLYPH[it.ch]!.d}' fill='url(#${p}nm)' stroke='${c1}' stroke-width='5'/>`).join("") +
+		gg.items.map((it) => `<path transform='${it.tf}' d='${GLYPH[it.ch]!.d}' fill='none' stroke='#fff' stroke-width='1.5'/>`).join("")
+	);
+};
