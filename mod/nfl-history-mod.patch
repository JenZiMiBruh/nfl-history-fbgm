+// NFL history mod: retire real players exactly when their real careers end. p.realTeams lists each later season
+// he really played (season -> team). Returns undefined past the real data, so the normal logic decides.
+const checkNflRealRetirement = async (
+	p: Player,
+): Promise<boolean | undefined> => {
+	const realTeams = (p as any).realTeams as Record<string, number> | undefined;
+	const lastSeason = Object.hasOwn(g, "nflRealDataLastSeason")
+		? ((g as any).nflRealDataLastSeason as number)
+		: undefined;
+	if (
+		__SPORT !== "football" ||
+		realTeams === undefined ||
+		lastSeason === undefined ||
+		!g.get("nflRealRetirements")
+	) {
+		return undefined;
+	}
+	const next = g.get("season") + 1;
+	if (next > lastSeason) {
+		return undefined;
+	}
+	if (realTeams[next] !== undefined) {
+		return false;
+	}
+	// Sat out next season: retire now, and come back for his next real season
+	const later = Object.keys(realTeams)
+		.map(Number)
+		.filter((s) => s > next)
+		.sort((a, b) => a - b)[0];
+	if (later !== undefined) {
+		await idb.cache.scheduledEvents.add({
+			type: "unretirePlayer",
+			season: later - 1,
+			phase: PHASE.DRAFT_LOTTERY,
+			info: { pid: p.pid, tid: realTeams[later] } as any,
+		});
+	}
+	return true;
+};
