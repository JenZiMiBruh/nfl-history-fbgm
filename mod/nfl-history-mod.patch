+// "MADDEN [shield] 12" as one row fitted to a width (px)
+export const TitleRow = ({
+	width,
+	year,
+	style,
+	fill,
+	yearFill,
+	stroke,
+	strokeW,
+	shadow,
+	modernShield,
+	shieldScale = 1.6,
+	extra,
+}: {
+	width: number;
+	year: string;
+	style: TypeStyle;
+	fill: string;
+	yearFill: string;
+	stroke?: string;
+	strokeW?: number;
+	shadow?: boolean;
+	modernShield: boolean;
+	shieldScale?: number;
+	extra?: ReactNode;
+}) => {
+	// widths in glyph units: MADDEN, gap, shield (0.8 x its height), gap, year
+	const wM = textWidth("MADDEN", style);
+	const wY = textWidth(year, style);
+	const slant = Math.abs(Math.tan(((style.skew ?? 0) * Math.PI) / 180)) * 100;
+	const gap = 14;
+	const total = wM + gap + 80 * shieldScale + gap + wY + slant;
+	const h = (width / total) * 100;
+	return (
+		<div style={{ display: "flex", alignItems: "center", gap: (gap * h) / 100, width }}>
+			<Word text="MADDEN" h={h} style={style} fill={fill} stroke={stroke} strokeW={strokeW} shadow={shadow} />
+			<NflShield h={h * shieldScale} modern={modernShield} />
+			<Word text={year} h={h} style={style} fill={yearFill} stroke={stroke} strokeW={strokeW} shadow={shadow} />
+			{extra}
+		</div>
+	);
+};
