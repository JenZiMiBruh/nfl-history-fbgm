@@ -0,0 +1,100 @@
+// NFL history mod: real moves during a season (Jerry Rice to Seattle after 3 games in 2004). Each player's
+// realMoves lists [season, games played with his first team, new team, jersey]; after each day of games, players
+// whose team has played that many games move to the new team.
+import { PHASE, PLAYER } from "../../../common/constants.ts";
+import { idb } from "../../db/index.ts";
+import { g } from "../../util/index.ts";
+import { player, team } from "../index.ts";
+import {
+	getContractExp,
+	getCurrentContract,
+	getNearestContractAmount,
+} from "../../../common/contracts.ts";
+import { endContract } from "../contract/index.ts";
+import type { FlatContractInfo, Player } from "../../../common/types.ts";
+
+// The contract a player takes on a real move: what's left of his current one (which ends here, owed by nobody, since
+// the new team takes it over at the same pay), or a one-year deal at his value if it has run out
+export const nflMoveContract = (p: Player, season: number): FlatContractInfo => {
+	const current = getCurrentContract(p);
+	if (current && getContractExp(current) >= season) {
+		const carried = {
+			amount: getNearestContractAmount(current, season),
+			exp: getContractExp(current),
+		};
+		endContract(current, { season: g.get("season"), phase: g.get("phase") });
+		return carried;
+	}
+	return { amount: player.genContract(p).amount, exp: season };
+};
+
+type RealMove = {
+	season: number;
+	afterGames: number;
+	tid: number;
+	jerseyNumber?: string;
+	done?: boolean;
+};
+
+export const applyNflRealMoves = async () => {
+	if (
+		__SPORT !== "football" ||
+		!Object.hasOwn(g, "nflHistoricalRosters") ||
+		!g.get("nflHistoricalRosters")
+	) {
+		return false;
+	}
+	const season = g.get("season");
+	const players = await idb.cache.players.indexGetAll("playersByTid", [
+		PLAYER.FREE_AGENT,
+		Infinity,
+	]);
+	const teamSeasons = await idb.cache.teamSeasons.indexGetAll(
+		"teamSeasonsBySeasonTid",
+		[[season], [season, "Z"]],
+	);
+	const gamesPlayed = (tid: number) => {
+		const ts = teamSeasons.find((row) => row.tid === tid);
+		return ts ? ts.won + ts.lost + ts.tied + (ts.otl ?? 0) : 0;
+	};
+	const teams = await idb.cache.teams.getAll();
+
+	const moved = new Set<number>();
+	for (const p of players) {
+		const moves = (p as any).realMoves as RealMove[] | undefined;
+		if (!moves) {
