+// NFL history mod: a game's real calendar info (TV slot, date, kickoff, stadium, weather) for box scores, the live
+// game screen and the playoffs page. The data comes from common/nflCalendar.ts.
+import { useEffect, useState } from "react";
+import {
+	buildSeasonCalendar,
+	calendarKey,
+	loadNflCalendarData,
+	offseasonText,
+	superBowlName,
+	type NflGameInfo,
+} from "../../common/nflCalendar.ts";
+import { toWorker } from "../util/toWorker.ts";
+import { superBowlLogo, superBowlNumber } from "../../common/nflSuperBowl.ts";
+
+type SeasonCalendar = Map<string, NflGameInfo>;
+
+// One calendar per season, rebuilt when the season's games change (a new playoff round, a new schedule)
+const cache = new Map<number, { count: number; calendar: SeasonCalendar }>();
+
+const inFlight = new Map<
+	number,
+	{ at: number; promise: Promise<SeasonCalendar> }
+>();
+export const getSeasonCalendar = (season: number) => {
+	const now = Date.now();
+	const hit = inFlight.get(season);
+	if (hit && now - hit.at < 2000) {
+		return hit.promise;
+	}
+	const promise = getSeasonCalendarUncached(season);
+	inFlight.set(season, { at: now, promise });
+	return promise;
+};
+
+const getSeasonCalendarUncached = async (season: number) => {
+	const [data, { games, numPlayoffRounds }] = await Promise.all([
+		loadNflCalendarData(),
+		toWorker("main", "getNflSeasonGames", season),
+	]);
+	const cached = cache.get(season);
+	if (cached && cached.count === games.length) {
+		return cached.calendar;
+	}
+	const calendar = buildSeasonCalendar(data, season, games, numPlayoffRounds);
+	cache.set(season, { count: games.length, calendar });
+	return calendar;
+};
+
+export const useNflGameInfo = (
+	season: number,
+	day: number | undefined,
+	homeTid: number,
+	awayTid: number,
+) => {
+	const [info, setInfo] = useState<NflGameInfo | undefined>();
+	useEffect(() => {
+		let cancelled = false;
+		if (day === undefined || homeTid < 0 || awayTid < 0) {
+			setInfo(undefined);
+			return;
+		}
+		(async () => {
+			try {
+				const calendar = await getSeasonCalendar(season);
+				if (!cancelled) {
+					setInfo(calendar.get(calendarKey({ day, homeTid, awayTid })));
+				}
+			} catch {
+				// No calendar (a plain league, or the data file is missing): show nothing
+			}
+		})();
+		return () => {
+			cancelled = true;
+		};
+	}, [season, day, homeTid, awayTid]);
+	return info;
+};
+
+export const weatherIcon = (info: NflGameInfo) => {
+	if (info.indoors) {
+		return "🏟️";
+	}
+	if (info.cond === 2) {
+		return "❄️";
+	}
+	if (info.cond === 1) {
+		return "🌧️";
+	}
+	if (info.cond === 3) {
+		return "🌫️";
+	}
+	const hour = Math.floor(info.minutes / 60);
+	if (hour >= 18) {
+		return "🌙";
+	}
+	if (info.temp !== undefined && info.temp <= 32) {
+		return "🥶";
+	}
+	return "☀️";
+};
+
+export const NflGameInfoLine = ({
+	season,
+	day,
+	homeTid,
+	awayTid,
+	className,
+}: {
+	season: number;
+	day: number | undefined;
+	homeTid: number;
+	awayTid: number;
+	className?: string;
+}) => {
+	const info = useNflGameInfo(season, day, homeTid, awayTid);
+	if (!info) {
+		return null;
+	}
+	const title =
+		info.round ??
+		info.slot ??
+		(info.week !== undefined ? `Week ${info.week}` : undefined);
+	return (
+		<div className={`text-center small ${className ?? ""}`}>
+			{title ? (
+				<div className={info.primetime ? "fw-bold" : "fw-semibold"}>
+					{info.superBowl ? "🏆 " : info.primetime ? "🌙 " : null}
+					{title}
+					{info.week !== undefined && info.slot ? (
+						<span className="text-body-secondary fw-normal">
+							{" "}
+							· Week {info.week}
+						</span>
+					) : null}
+				</div>
+			) : null}
+			<div className="text-body-secondary">
+				{info.dateText} · {info.timeEstimated ? "about " : null}
+				{info.timeText}
+				{info.stadium ? <> · {info.stadium}</> : null}
+				{info.network ? <> · 📺 {info.network}</> : null}
+				{info.weatherText ? (
+					<>
+						{" "}
+						· {weatherIcon(info)} {info.weatherText}
+					</>
+				) : null}
+			</div>
+		</div>
+	);
+};
+
+export const SuperBowlHeader = ({ season }: { season: number }) => {
+	const [info, setInfo] = useState<NflGameInfo | undefined>();
+	useEffect(() => {
+		let cancelled = false;
+		(async () => {
+			try {
+				const calendar = await getSeasonCalendar(season);
+				const sb = [...calendar.values()].find((x) => x.superBowl);
+				if (!cancelled) {
+					setInfo(sb);
+				}
+			} catch {
+				// no calendar
+			}
+		})();
+		return () => {
+			cancelled = true;
+		};
+	}, [season]);
+	return (
+		<div className="mb-3">
+			<h2 className="mb-0 d-flex align-items-center gap-2">
+				{superBowlNumber(season) !== undefined ? (
+					<img
+						alt=""
+						src={superBowlLogo(superBowlNumber(season)!)}
+						style={{ width: 72, height: 72 }}
+					/>
+				) : null}
+				{superBowlName(season)}
+			</h2>
+			{info ? (
+				<div className="text-body-secondary">
+					{info.dateText} · {info.timeText}
+					{info.stadium ? <> · {info.stadium}</> : null}
+					{info.weatherText ? (
+						<>
+							{" "}
+							· {weatherIcon(info)} {info.weatherText}
+						</>
+					) : null}
+				</div>
+			) : null}
+		</div>
+	);
+};
+
+// One line for a schedule card: slot, day and kickoff, weather
+export const NflGameInfoCompact = ({
+	season,
+	day,
+	homeTid,
+	awayTid,
+}: {
+	season: number;
+	day: number | undefined;
+	homeTid: number;
+	awayTid: number;
+}) => {
+	const info = useNflGameInfo(season, day, homeTid, awayTid);
+	if (!info) {
+		return null;
+	}
+	const label = info.superBowl ? `🏆 ${info.round}` : (info.round ?? info.slot);
+	return (
+		<div className="small mb-1 d-flex flex-wrap gap-1 align-items-center">
+			{label ? (
+				<span
+					className="badge"
+					style={{
+						background: slotStyle(info)?.bg ?? "#475569",
+						color: slotStyle(info)?.fg ?? "#ffffff",
+					}}
+				>
+					{info.primetime && !info.superBowl ? "🌙 " : null}
+					{label}
+				</span>
+			) : null}
+			<span className="text-body-secondary">
+				{info.dateText.replace(/, d{4}$/, "")} · {info.timeText}
+				{info.network ? <> · 📺 {info.network}</> : null}
+				{info.weatherText ? (
+					<>
+						{" "}
+						· {weatherIcon(info)} {info.weatherText}
+					</>
+				) : null}
+			</span>
+		</div>
+	);
+};
+
+// Where the league is in the NFL year: the next game day ("Week 2 · Sun, Sep 20"), the playoff round, or the
+// offseason month. Shown under the phase in the top bar.
+export const useNflNow = (
+	season: number,
+	phase: number,
+	statusText: string,
+) => {
+	const [text, setText] = useState<string | undefined>();
+	useEffect(() => {
+		let cancelled = false;
+		// never keep the last phase's text (it stayed on "Training camp" all season when the week lookup was slow or failed)
+		setText(offseasonText(phase, season));
+		(async () => {
+			try {
+				const off = offseasonText(phase, season);
+				if (off) {
+					return;
+				}
+				const [{ games }, calendar] = await Promise.all([
+					toWorker("main", "getNflSeasonGames", season),
+					getSeasonCalendarUncached(season),
+				]);
+				const next = games
+					.filter((g) => g.homePts === undefined)
+					.sort((a, b) => a.day - b.day)[0];
+				const info = next ? calendar.get(calendarKey(next)) : undefined;
+				if (!cancelled) {
+					setText(
+						info
+							? `${info.superBowl ? superBowlName(season) : (info.round ?? `Week ${info.week}`)} · ${info.dateText.replace(/, \d{4}$/, "")}`
+							: undefined,
+					);
+				}
+			} catch {
+				if (!cancelled) {
+					setText(undefined);
+				}
+			}
+		})();
+		return () => {
+			cancelled = true;
+		};
+	}, [season, phase, statusText]);
+	return text;
+};
+
+// Text color for a background: whichever of near-black or white has more contrast (WCAG relative luminance)
+export const readableOn = (hex: string) => {
+	const n = Number.parseInt(hex.slice(1), 16);
+	const lin = (c: number) => {
+		const x = c / 255;
+		return x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4;
+	};
+	const L =
+		0.2126 * lin((n >> 16) & 255) +
+		0.7152 * lin((n >> 8) & 255) +
+		0.0722 * lin(n & 255);
+	return (L + 0.05) / 0.05 > 1.05 / (L + 0.05) ? "#111111" : "#ffffff";
+};
+
+// Short labels and colors for the TV slots (text color is picked from the background, see slotStyle)
+const slotColors = (
+	info: NflGameInfo,
+): { label: string; bg: string } | undefined => {
+	if (info.superBowl) {
+		return { label: "Super Bowl", bg: "#c9a227" };
+	}
+	if (info.round) {
+		return {
+			label: info.round.replace(" Championship", "").replace(" Round", ""),
+			bg: "#5b6b8c",
+		};
+	}
+	const s = info.slot ?? "";
+	if (s.includes("Kickoff")) {
+		return { label: "Kickoff", bg: "#d4380d" };
+	}
+	if (s.includes("Thanksgiving")) {
+		return { label: "Thanksgiving", bg: "#a0522d" };
+	}
+	if (s.includes("Christmas")) {
+		return { label: "Christmas", bg: "#1e7b3c" };
+	}
+	if (s.includes("Monday")) {
+		return { label: "MNF", bg: "#be185d" };
+	}
+	if (s.includes("Thursday")) {
+		return { label: "TNF", bg: "#6f42c1" };
+	}
+	if (s.includes("Sunday Night")) {
+		return { label: "SNF", bg: "#1d4ed8" };
+	}
+	if (s.includes("International")) {
+		return { label: "Intl", bg: "#0e7490" };
+	}
+	if (s.startsWith("Saturday")) {
+		return { label: "Sat", bg: "#475569" };
+	}
+	if (s) {
+		return { label: s.replace(" Night", ""), bg: "#475569" };
+	}
+	return undefined;
+};
+
+export const slotStyle = (info: NflGameInfo) => {
+	const c = slotColors(info);
+	return c ? { ...c, fg: readableOn(c.bg) } : undefined;
+};
