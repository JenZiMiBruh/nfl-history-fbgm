+				setStatus("Loading NFL history (16 MB)...");
+				await loadNflScript();
+				const response = await fetch("/nfl/NFL_Master_1966_2026.json.gz");
+				if (!response.ok) {
+					throw new Error(`HTTP ${response.status}`);
+				}
+				const master = await readMaster(await response.blob());
+				if (!cancelled) {
+					nflMaster = master;
+					setLoaded(true);
+					setStatus("");
+				}
+			} catch {
+				if (!cancelled) {
+					setStatus("");
+				}
+			}
+			if (!cancelled) {
