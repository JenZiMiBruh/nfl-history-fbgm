+
+// NFL history mod: injury countdowns tick once per week for every rostered player, including on a bye. These turn
+// "his team's next games" into weeks on the schedule, so a bye never counts as a game served.
+export const weeksForTeamGames = async (
+	tid: number,
+	gamesBefore: number,
+	gamesOut: number,
+) => {
+	const schedule = await season.getSchedule();
+	const days = [...new Set(schedule.map((game) => game.day))].sort(
+		(a, b) => (a ?? 0) - (b ?? 0),
+	);
+	let played = 0;
+	let delay = 0;
+	let span = 0;
+	for (const day of days) {
+		if (played >= gamesBefore + gamesOut) {
+			break;
+		}
+		const hasGame = schedule.some(
