+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { createPortal } from "react-dom";
+import { Modal } from "react-bootstrap";
+
+// NFL history mod: the Live Football alpha announcement. On the regular mod it opens every time the game is opened
+// (a big card with a short confetti burst) until the player clicks "Stop asking", and offers a one-click switch: the
+// launcher downloads the alpha build and restarts the game, and leagues stay where they are (same browser storage).
+// A strip at the top of every page keeps the way in visible. On the alpha build the strip says so, with a way back.
+// It only appears while the site's live-alpha.json says the alpha is out, so it can be turned on or off without a release.
+const CONFIG =
+	"https://jenzimibruh.github.io/nfl-history-fbgm/data/live-alpha.json";
+const HERO =
+	"https://jenzimibruh.github.io/nfl-history-fbgm/assets/live/field.jpg";
+// a new key: the old one-time "No thanks" (nflLiveAlphaSeen) doesn't count as "Stop asking"
+const STOP_KEY = "nflLiveAlphaStopAsking";
+// set just before NFL History reopens itself as the new app, so the switch carries on by itself afterwards
+const REOPEN_KEY = "nflLiveAlphaAfterReopen";
+// once per page load (opening the game), not again on every page change inside it
+let askedThisLoad = false;
+const ISSUES =
+	"https://github.com/JenZiMiBruh/nfl-history-fbgm/issues/new/choose";
+
+type Config = {
+	active?: boolean;
+	// the GitHub release page, for people the one-click switch can't reach (an old launcher, an odd network)
+	release?: string;
+	trailer?: string;
+};
+
+const store = {
+	get: (k: string) => {
+		try {
+			return localStorage.getItem(k);
+		} catch {
+			return null;
+		}
+	},
+	set: (k: string, v: string) => {
+		try {
+			localStorage.setItem(k, v);
+		} catch {}
+	},
+};
+
+// A short burst, then it stops: celebration, not a screensaver. Skipped with reduced motion.
+const Burst = () => {
+	const ref = useRef<HTMLCanvasElement>(null);
+	useEffect(() => {
+		const canvas = ref.current;
+		if (
+			!canvas ||
+			window.matchMedia?.("(prefers-reduced-motion: reduce)").matches
+		) {
+			return;
+		}
+		const ctx = canvas.getContext("2d");
+		if (!ctx) {
+			return;
+		}
+		const dpr = Math.min(window.devicePixelRatio || 1, 2);
+		const w = canvas.clientWidth;
+		const h = canvas.clientHeight;
+		canvas.width = w * dpr;
+		canvas.height = h * dpr;
+		ctx.scale(dpr, dpr);
+		const colors = ["#ffb81c", "#ffffff", "#2c8a54", "#d50a0a", "#013369"];
+		const bits = Array.from({ length: 140 }, (_, i) => {
+			const fromLeft = i % 2 === 0;
+			const angle =
+				(fromLeft ? -1 : -Math.PI + 1) + (Math.random() - 0.5) * 0.9;
+			const speed = 7 + Math.random() * 7;
+			return {
+				x: fromLeft ? 0 : w,
+				y: h * 0.75,
+				vx: Math.cos(angle) * speed,
+				vy: Math.sin(angle) * speed - 3,
+				r: Math.random() * Math.PI,
+				vr: (Math.random() - 0.5) * 0.4,
+				s: 5 + Math.random() * 5,
+				c: colors[i % colors.length]!,
+			};
+		});
+		let frame = 0;
+		let raf = 0;
+		const tick = () => {
+			frame += 1;
+			ctx.clearRect(0, 0, w, h);
+			const fade = Math.max(0, 1 - Math.max(0, frame - 90) / 60);
+			ctx.globalAlpha = fade;
+			for (const b of bits) {
+				b.vy += 0.22;
+				b.vx *= 0.99;
+				b.x += b.vx;
+				b.y += b.vy;
+				b.r += b.vr;
+				ctx.save();
+				ctx.translate(b.x, b.y);
+				ctx.rotate(b.r);
+				ctx.fillStyle = b.c;
+				ctx.fillRect(-b.s / 2, -b.s / 4, b.s, b.s / 2);
+				ctx.restore();
+			}
+			if (fade > 0) {
+				raf = requestAnimationFrame(tick);
+			}
+		};
+		raf = requestAnimationFrame(tick);
+		return () => cancelAnimationFrame(raf);
+	}, []);
+	return (
+		<canvas
+			ref={ref}
+			aria-hidden="true"
+			style={{
+				position: "absolute",
+				inset: 0,
+				width: "100%",
+				height: "100%",
+				pointerEvents: "none",
+				zIndex: 2,
+			}}
+		/>
+	);
+};
+
+// Ask the launcher to switch, then wait for the game to come back on the other build and reload
+const useSwitch = (to: "alpha" | "stable") => {
+	const [status, setStatus] = useState<
+		"idle" | "working" | "reopening" | "failed"
+	>("idle");
+	const go = async () => {
+		setStatus("working");
+		const ok = await fetch(
+			`http://${location.hostname}:3099/channel?to=${to}`,
+			{
+				method: "POST",
+			},
+		)
+			.then((r) => r.ok)
+			.catch(() => false);
+		if (!ok) {
+			// An older launcher (players who updated from v1.25.0 or before) can't switch. The update brought the new
+			// app, NFL History.exe: the game's server reopens it, and the switch carries on once it's back.
+			const reopening =
+				to === "alpha" &&
+				(await fetch("/nfl-reopen", { method: "POST" })
+					.then((r) => r.status === 202)
+					.catch(() => false));
+			if (!reopening) {
+				setStatus("failed");
+				return;
+			}
+			store.set(REOPEN_KEY, "1");
+			setStatus("reopening");
+			let wentDown = false;
+			const since = Date.now();
+			const wait = setInterval(async () => {
+				const up = await fetch("/nfl/version.json", { cache: "no-store" })
+					.then((r) => r.ok)
+					.catch(() => false);
+				if (!up) {
+					wentDown = true;
+				} else if (wentDown) {
+					clearInterval(wait);
+					location.reload();
+				}
+				if (Date.now() - since > 5 * 60 * 1000) {
+					clearInterval(wait);
+					store.set(REOPEN_KEY, "");
+					setStatus("failed");
+				}
+			}, 2000);
+			return;
+		}
+		const started = Date.now();
+		const timer = setInterval(async () => {
+			try {
+				const v = await fetch("/nfl/version.json", { cache: "no-store" }).then(
+					(r) => r.json(),
+				);
+				const onAlpha = String(v.version).includes("alpha");
+				if (onAlpha === (to === "alpha")) {
+					clearInterval(timer);
+					location.reload();
+				}
+			} catch {
+				// restarting
+			}
+			if (Date.now() - started > 20 * 60 * 1000) {
+				clearInterval(timer);
+				setStatus("failed");
+			}
+		}, 4000);
+	};
+	return { status, go };
+};
+
+// Puts the strip at the top of the page (NflWhatsNew passes the spot); without one it stays where it is
+const Top = ({ slot, children }: { slot?: HTMLElement | null; children: ReactNode }) =>
+	slot ? createPortal(children, slot) : <>{children}</>;
+
+const AlphaBar = () => {
+	const back = useSwitch("stable");
+	return (
+		<div
+			className="d-flex flex-wrap align-items-center gap-2 small px-3 py-2 mb-2 rounded"
+			style={{
+				background: "#0a0e14",
+				color: "#fff",
+				borderLeft: "4px solid #ffb81c",
+			}}
+		>
+			<b style={{ color: "#ffb81c" }}>LIVE FOOTBALL ALPHA</b>
+			<span className="opacity-75">
+				Thanks for testing! Found something off?
+			</span>
+			<a
+				href={ISSUES}
+				target="_blank"
+				rel="noopener noreferrer"
+				style={{ color: "#ffb81c" }}
+			>
+				Report a bug
+			</a>
+			<span className="opacity-50">·</span>
+			{back.status === "working" ? (
+				<span>Switching back... the game restarts by itself.</span>
+			) : back.status === "failed" ? (
+				<span>
+					Couldn't switch from here: close NFL History, delete channel.txt in
+					the mod folder, then open NFL History again.
+				</span>
+			) : (
+				<button
+					type="button"
+					className="btn btn-link btn-sm p-0"
+					style={{ color: "#fff" }}
+					onClick={back.go}
+				>
+					Back to the regular mod
+				</button>
+			)}
+		</div>
+	);
+};
+
+export const NflLiveAlpha = ({
+	version,
+	ready = true,
+	slot,
+}: {
+	version: string;
+	// false while the What's new window is open: one window at a time
+	ready?: boolean;
+	slot?: HTMLElement | null;
+}) => {
+	const onAlpha = version.includes("alpha");
+	const [config, setConfig] = useState<Config>();
+	const [show, setShow] = useState(false);
+	const [wantShow, setWantShow] = useState(false);
+	const [stopped, setStopped] = useState(() => !!store.get(STOP_KEY));
+	const sw = useSwitch("alpha");
+
+	// open the card once the What's new window (if any) is closed
+	useEffect(() => {
+		if (wantShow && ready) {
+			// after the What's new window has faded out, so the two never show at once
+			const t = setTimeout(() => {
+				setWantShow(false);
+				setShow(true);
+			}, 450);
+			return () => clearTimeout(t);
+		}
+	}, [wantShow, ready]);
+
+	// Back after reopening as the new app: carry on with the switch
+	useEffect(() => {
+		if (!onAlpha && store.get(REOPEN_KEY)) {
+			store.set(REOPEN_KEY, "");
+			setShow(true);
+			sw.go();
+		}
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, []);
+
+	useEffect(() => {
+		if (onAlpha) {
+			return;
+		}
+		fetch(CONFIG, { cache: "no-cache" })
+			.then((r) => (r.ok ? r.json() : undefined))
+			.then((c: Config | undefined) => {
+				if (!c?.active) {
+					return;
+				}
+				setConfig(c);
+				if (!store.get(STOP_KEY) && !askedThisLoad) {
+					askedThisLoad = true;
+					setWantShow(true);
+				}
+			})
+			.catch(() => {});
+	}, [onAlpha]);
+
+	if (onAlpha) {
+		return (
+			<Top slot={slot}>
+				<AlphaBar />
+			</Top>
+		);
+	}
+	if (!config) {
+		return null;
+	}
+
+	// "Not now" closes it until the game is opened again; "Stop asking" for good (the strip shrinks to a small button)
+	const close = (forever: boolean) => {
+		if (forever) {
+			store.set(STOP_KEY, "1");
+			setStopped(true);
+		}
+		setShow(false);
+	};
+
+	return (
+		<>
+			<Top slot={slot}>
+				{stopped ? (
+					<button
+						type="button"
+						className="btn btn-sm fw-bold mb-2"
+						style={{ background: "#ffb81c", color: "#0a0e14" }}
+						onClick={() => setShow(true)}
+					>
+						🏈 Try the Live Football alpha
+					</button>
+				) : (
+					<div
+						className="d-flex flex-wrap align-items-center gap-2 px-3 py-2 mb-2 rounded"
+						style={{
+							background: "#0a0e14",
+							color: "#fff",
+							borderLeft: "4px solid #ffb81c",
+						}}
+					>
+						<b style={{ color: "#ffb81c" }}>🏈 LIVE FOOTBALL ALPHA IS OUT</b>
+						<span className="opacity-75">
+							Watch your league's games play out on the field.
+						</span>
+						<button
+							type="button"
+							className="btn btn-sm fw-bold"
+							style={{ background: "#ffb81c", color: "#0a0e14" }}
+							onClick={() => setShow(true)}
+						>
+							See what's new
+						</button>
+					</div>
+				)}
+			</Top>
+			<Modal
+				show={show}
+				onHide={() => close(false)}
+				centered
+				size="lg"
+				contentClassName="overflow-hidden border-0"
+			>
+				<div
+					style={{ position: "relative", background: "#0a0e14", color: "#fff" }}
+				>
+					{show ? <Burst /> : null}
+					<button
+						type="button"
+						className="btn-close btn-close-white"
+						aria-label="Close"
+						onClick={() => close(false)}
+						style={{ position: "absolute", top: 14, right: 14, zIndex: 3 }}
+					/>
+					<div
+						style={{
+							height: 210,
+							background: `linear-gradient(180deg, rgba(10,14,20,0) 35%, #0a0e14 100%), url(${HERO}) center/cover`,
+						}}
+					/>
+					<div
+						className="px-4 pb-4"
+						style={{ marginTop: -54, position: "relative", zIndex: 1 }}
+					>
+						<span
+							className="badge mb-2"
+							style={{
+								background: "#ffb81c",
+								color: "#0a0e14",
+								letterSpacing: 1.5,
+							}}
+						>
+							NEW · ALPHA
+						</span>
+						<h2
+							className="fw-bold mb-2"
+							style={{
+								fontSize: "clamp(28px, 6vw, 44px)",
+								lineHeight: 1.05,
+								textTransform: "uppercase",
+							}}
+						>
+							Live Football is here
+						</h2>
+						<p className="mb-3 opacity-75" style={{ fontSize: 17 }}>
+							Stop just simming. Watch any game in your league play out on the
+							field, with a TV-style broadcast around it.
+						</p>
+						<ul className="mb-4 ps-3" style={{ lineHeight: 1.7 }}>
+							<li>
+								<b>Watch any game</b> play out in a 3D stadium
+							</li>
+							<li>
+								<b>The full TV show:</b> game open, pregame, score bugs, replays
+								and big-play graphics
+							</li>
+							<li>
+								<b>Also new:</b> the league calendar and championship banners
+							</li>
+						</ul>
+						{sw.status === "reopening" ? (
+							<div className="alert alert-warning mb-0">
+								<b>NFL History is now its own app.</b> It's reopening as{" "}
+								<b>NFL History.exe</b> (in your mod folder; your old shortcut opens
+								it too). This page reloads when it's back and carries on to the
+								alpha by itself. About a minute.
+							</div>
+						) : sw.status === "working" ? (
+							<div className="alert alert-warning mb-0">
+								<b>Switching to the alpha...</b> This takes a few minutes the
+								first time. The game restarts by itself and this page reloads
+								when it's ready. Your leagues stay right where they are.
+							</div>
+						) : sw.status === "failed" ? (
+							<div className="alert alert-light mb-0">
+								<div className="fw-bold mb-1">One more step: restart NFL History.</div>
+								<div className="mb-2">
+									Close NFL History completely, open it again, and click{" "}
+									<b>Play the alpha now</b> once more. Your leagues stay right
+									where they are.
+								</div>
+								<div className="small text-body-secondary">
+									Still stuck?{" "}
+									<a
+										href={
+											config.release ??
+											"https://github.com/JenZiMiBruh/nfl-history-fbgm/releases"
+										}
+										target="_blank"
+										rel="noopener noreferrer"
+									>
+										Download the alpha
+									</a>{" "}
+									and unzip it into its own folder.
+								</div>
+							</div>
+						) : (
+							<div className="d-flex flex-wrap align-items-center gap-2">
+								<button
+									type="button"
+									className="btn btn-lg fw-bold px-4"
+									style={{ background: "#ffb81c", color: "#0a0e14" }}
+									onClick={sw.go}
+								>
+									Play the alpha now
+								</button>
+								{config.trailer ? (
+									<a
+										className="btn btn-lg btn-outline-light"
+										href={config.trailer}
+										target="_blank"
+										rel="noopener noreferrer"
+									>
+										Watch the trailer
+									</a>
+								) : null}
+								<div className="ms-auto d-flex gap-1">
+									<button
+										type="button"
+										className="btn btn-outline-light"
+										onClick={() => close(false)}
+									>
+										Not now
+									</button>
+									<button
+										type="button"
+										className="btn btn-link text-white"
+										style={{ opacity: 0.75 }}
+										onClick={() => close(true)}
+									>
+										Stop asking
+									</button>
+								</div>
+							</div>
+						)}
