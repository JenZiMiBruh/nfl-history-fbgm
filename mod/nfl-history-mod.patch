+// NFL history mod: each player's face and real jersey for the live game, as the player page shows them (the face aged
+// and with this season's mood, the jersey with arms and pads). Filled by NflPlayField from the worker
+// (getNflGameFaces); read by every picture in the live view so they all match the rest of the game. Only faces the
+// players already have: nothing here makes one up.
+import type { FaceJersey } from "../../components/faceJersey.ts";
+
+type LiveFace = { face?: any; imgURL?: string; nfl?: FaceJersey };
+
+const byPid = new Map<number, LiveFace>();
+
+export const setLiveFaces = (
+	list: { pid: number; face?: any; imgURL?: string; nfl?: unknown }[],
+) => {
+	for (const f of list) {
+		byPid.set(f.pid, {
+			face: f.face,
+			imgURL: f.imgURL,
+			nfl: f.nfl as FaceJersey | undefined,
+		});
+	}
+};
+
+export const liveFace = (pid: number | undefined) =>
+	pid === undefined ? undefined : byPid.get(pid);
