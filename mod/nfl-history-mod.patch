+const playTheme = (key: string) => {
+	try {
+		const Ctx = (window.AudioContext ?? (window as any).webkitAudioContext) as
+			| typeof AudioContext
+			| undefined;
+		if (!Ctx) return () => {};
+		const ctx = new Ctx();
+		const master = ctx.createGain();
+		master.gain.value = 0.15;
+		const filter = ctx.createBiquadFilter();
+		filter.type = "lowpass";
+		filter.frequency.value = 2300;
+		filter.connect(master);
+		master.connect(ctx.destination);
+		const chords = THEMES[key] ?? THEMES.default!;
+		const beat = 0.44;
+		chords.forEach((chord, i) => {
+			const t0 = ctx.currentTime + 0.05 + i * beat;
+			const len = i === chords.length - 1 ? beat * 3.2 : beat * 0.92;
+			for (const note of chord) {
+				for (const det of [-7, 7]) {
+					const o = ctx.createOscillator();
+					o.type = "sawtooth";
+					o.frequency.value = 440 * 2 ** ((note - 69) / 12);
+					o.detune.value = det;
+					const g = ctx.createGain();
+					g.gain.setValueAtTime(0, t0);
+					g.gain.linearRampToValueAtTime(0.12, t0 + 0.03);
+					g.gain.exponentialRampToValueAtTime(0.06, t0 + len * 0.6);
+					g.gain.exponentialRampToValueAtTime(0.0001, t0 + len);
+					o.connect(g);
+					g.connect(filter);
+					o.start(t0);
+					o.stop(t0 + len + 0.05);
+				}
+			}
+			const k = ctx.createOscillator();
+			k.type = "sine";
+			k.frequency.setValueAtTime(110, t0);
+			k.frequency.exponentialRampToValueAtTime(45, t0 + 0.25);
+			const kg = ctx.createGain();
+			kg.gain.setValueAtTime(0.5, t0);
+			kg.gain.exponentialRampToValueAtTime(0.001, t0 + 0.35);
+			k.connect(kg);
+			kg.connect(master);
+			k.start(t0);
+			k.stop(t0 + 0.4);
+		});
+		return () => void ctx.close();
+	} catch {
+		return () => {};
+	}
+};
