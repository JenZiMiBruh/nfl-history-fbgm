+const SPR_W = 192;
+const SPR_H = 288;
+type DrawOpts = {
+	colors: string[];
+	away: boolean;
+	num?: string;
+	head?: HTMLImageElement;
+	headKind: "photo" | "cartoon" | "helmet";
+	ref?: boolean;
+	facing?: 1 | -1;
+	stride?: number; // 0-3, the running cycle
+	logo?: HTMLImageElement;
+	skin?: string;
+	// The team's real uniform (helmet, mask, and this side's jersey, numbers, pants, stripe, socks), when known
+	uni?: NflUniform;
+	pose?: "throw";
+};
+export const shade = (hex: string, amt: number) => {
+	const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
+	if (!m) return hex;
+	const n = parseInt(m[1]!, 16);
+	const f = (c: number) =>
+		Math.max(
+			0,
+			Math.min(255, Math.round(amt < 0 ? c * (1 + amt) : c + (255 - c) * amt)),
+		);
+	return `rgb(${f((n >> 16) & 255)},${f((n >> 8) & 255)},${f(n & 255)})`;
+};
+// The head of a Football GM face: the library draws a 400x600 bust, the head is a square near the top
+const faceCrop = (img: HTMLImageElement) => {
+	const sw = img.naturalWidth || 400;
+	const sh = img.naturalHeight || 600;
+	// The whole head, top of the hair to the chin (taller than wide)
+	const w = sw * 0.8;
+	return { sx: (sw - w) / 2, sy: sh * 0.04, sw: w, sh: sh * 0.74 };
+};
