+} from "../components/NflGameInfo.tsx";
+import { ScoreboardGallery } from "./LiveGame/NflScoreboard.tsx";
+import {
+	FeaturedView,
+	WallCalendar,
+	type CalEvent,
+} from "./NflCalendarViews.tsx";
+
+// Which view of the league calendar: the wall calendar (default), the original list, or a featured game with the
+// week beside the projections. Remembered per browser.
+type CalView = "calendar" | "list" | "featured";
+const VIEW_KEY = "nflCalendarView";
+const readView = (): CalView => {
+	try {
+		const v = localStorage.getItem(VIEW_KEY);
+		if (v === "list" || v === "featured") return v;
+	} catch {}
+	return "calendar";
+};
+
+type Game = View<"nflCalendar">["games"][number];
+type Teams = View<"nflCalendar">["teams"];
+type Entry = { game: Game; info: NflGameInfo };
+
+const MONTHS = [
+	"January",
+	"February",
+	"March",
+	"April",
+	"May",
+	"June",
+	"July",
+	"August",
+	"September",
+	"October",
+	"November",
+	"December",
+];
+const WEEKDAYS = [
+	"Sunday",
+	"Monday",
+	"Tuesday",
+	"Wednesday",
+	"Thursday",
+	"Friday",
+	"Saturday",
+];
+const dayKey = (date: Date) => date.toISOString().slice(0, 10);
+const shortDate = new Intl.DateTimeFormat("en-US", {
+	month: "short",
+	day: "numeric",
+	timeZone: "UTC",
+});
+
+const Pill = ({ info, full }: { info: NflGameInfo; full?: boolean }) => {
+	const st = slotStyle(info);
+	if (!st) {
+		return null;
+	}
+	return (
+		<span
+			className="badge me-1"
+			style={{
+				background: st.bg,
+				color: st.fg,
+				fontWeight: 600,
+				letterSpacing: 0.2,
+			}}
+		>
+			{full
+				? info.superBowl
+					? `🏆 ${info.round}`
+					: (info.round ?? info.slot)
+				: st.label}
+			{info.network ? (
+				<span style={{ opacity: 0.8, fontWeight: 500 }}> · {info.network}</span>
+			) : null}
+		</span>
+	);
+};
+
+const Logo = ({
+	t,
+	size = 28,
+}: {
+	t: Teams[number] | undefined;
+	size?: number;
+}) =>
+	t?.imgURL ? (
+		<img
+			src={t.imgURL}
+			alt=""
+			style={{ width: size, height: size, objectFit: "contain" }}
+		/>
+	) : (
+		<span style={{ display: "inline-block", width: size }} />
+	);
+
+// Sunday kickoff windows
+const windowName = (info: NflGameInfo) => {
+	if (info.slot) {
+		return info.slot;
+	}
+	const h = info.minutes / 60;
+	if (info.date.getUTCDay() === 0) {
+		if (h < 12) return "Morning (International)";
+		if (h < 15) return "Early afternoon";
+		if (h < 19) return "Late afternoon";
+	}
+	return undefined;
+};
+
+const GameCard = ({
+	entry,
+	teams,
+	userTid,
+	season,
+	gotw,
