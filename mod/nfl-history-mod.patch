+								p={{ ...presentationFor(slot[1]), pkg }}
+								info={slot[1]}
+								away={{ ...away, pts: sit.a, timeouts: 2, ptsQtrs: [sit.a] }}
+								home={{ ...home, pts: sit.h, timeouts: 1, ptsQtrs: [sit.h] }}
+								possession={i % 2 === 0 ? 0 : 1}
+								quarter={sit.quarter}
+								time={sit.time}
+								situation={sit.situation}
+								redZone={sit.redZone}
+								gameOver={sit.gameOver}
+							/>
+						</div>
+					</div>
+				))}
+				{combos.length > 120 ? (
+					<div className="small text-body-secondary">
+						Showing the first 120: narrow the filters to see the rest.
+					</div>
+				) : null}
+			</div>
+		</div>
+	);
+};
