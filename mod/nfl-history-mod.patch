diff --git a/src/worker/views/nflCalendar.ts b/src/worker/views/nflCalendar.ts
new file mode 100644
index 000000000..b0d694d36
--- /dev/null
+++ b/src/worker/views/nflCalendar.ts
@@ -0,0 +1,236 @@
+// NFL history mod: the Calendar page. Every game of a season, played and scheduled, with the teams' branding that
+// season. The real dates, times, slots and weather are worked out in the UI (common/nflCalendar.ts).
+import { player, season as seasonCore, team } from "../core/index.ts";
+import { idb } from "../db/index.ts";
+import { g } from "../util/index.ts";
+import { defineView } from "../util/defineView.ts";
+import { PHASE } from "../../common/constants.ts";
+import { isTradeDeadline } from "../../common/specialGames.ts";
+import type { RouteParams } from "../../ui/router/types.ts";
+import { validateSeason, validateTeam } from "../util/processInputs.ts";
+
+export type NflSeasonGame = {
+	gid?: number;
+	day: number;
+	homeTid: number;
+	awayTid: number;
+	playoffs: boolean;
+	neutralSite: boolean;
+	homePts?: number;
+	awayPts?: number;
+	// A next-round playoff game that is waiting for an opponent (awayTid -1 is TBD)
+	pending?: boolean;
+	// The visitor plays in the AFC (for which network carried it)
+	awayAfc?: boolean;
+};
+
+// Every game of the season: completed games first, then what's left on the schedule (current season only)
+export const getNflSeasonGames = async (season: number) => {
+	const games: NflSeasonGame[] = [];
+	const completed = await idb.merged.games.getAll({ season });
+	for (const game of completed) {
+		if (game.day === undefined || game.teams[0].tid < 0) {
+			continue;
+		}
+		games.push({
+			gid: game.gid,
+			day: game.day,
+			homeTid: game.teams[0].tid,
+			awayTid: game.teams[1].tid,
+			playoffs: !!game.playoffs,
+			neutralSite: !!game.neutralSite,
+			homePts: game.teams[0].pts,
+			awayPts: game.teams[1].pts,
+		});
+	}
+	if (season === g.get("season")) {
+		const isPlayoffs = g.get("phase") === PHASE.PLAYOFFS;
+		for (const game of await seasonCore.getSchedule()) {
+			if (game.homeTid < 0 || game.awayTid < 0) {
+				continue;
+			}
+			games.push({
+				gid: game.gid,
+				day: game.day,
+				homeTid: game.homeTid,
+				awayTid: game.awayTid,
+				playoffs: isPlayoffs,
+				neutralSite: !!game.finals,
+			});
+		}
+	}
+	// Playoffs: the next round's games already known, like a team with a first-round bye waiting for the Wild Card
+	// winner. They go on the day after the last playoff day, with -1 for an opponent not decided yet.
+	if (season === g.get("season") && g.get("phase") === PHASE.PLAYOFFS) {
+		const playoffSeries = await idb.cache.playoffSeries.get(season);
+		if (playoffSeries) {
+			const r = playoffSeries.currentRound;
+			const lastDay = Math.max(
+				0,
+				...games.filter((x) => x.playoffs).map((x) => x.day),
+			);
+			const scheduled = new Set(
+				games
+					.filter((x) => x.playoffs && x.day === lastDay)
+					.flatMap((x) => [x.homeTid, x.awayTid]),
+			);
+			const next: { home: number; away: number }[] = [];
+			// Teams with a bye this round
+			for (const m of playoffSeries.series[r] ?? []) {
+				if (!m.away && !scheduled.has(m.home.tid)) {
+					next.push({ home: m.home.tid, away: -1 });
+				}
+			}
+			// Next round matchups filled in so far
+			for (const m of playoffSeries.series[r + 1] ?? []) {
+				const h = m.home?.tid;
+				const a = m.away?.tid;
+				if (h !== undefined && !next.some((x) => x.home === h)) {
+					next.push({ home: h, away: a ?? -1 });
+				}
+			}
+			for (const { home, away } of next) {
+				games.push({
+					day: lastDay + 1,
+					homeTid: home,
+					awayTid: away,
+					playoffs: true,
+					neutralSite: false,
+					pending: true,
+				});
+			}
+		}
+	}
+
+	// Which visitors are AFC teams (the conference named AFC or American; 0 is the AFC in the default leagues)
+	try {
+		const confs: any[] = g.get("confs", season) ?? [];
+		const afcCid =
+			confs.find((c) => /AFC|American/i.test(c.name ?? ""))?.cid ?? 0;
+		const ts: any[] = await team.getFormattedAll({
+			attrs: ["tid"],
+			seasonAttrs: ["cid"],
+			season,
+		} as any);
+		const afc = new Set(
+			ts.filter((t) => t.seasonAttrs?.cid === afcCid).map((t) => t.tid),
+		);
+		for (const x of games) x.awayAfc = afc.has(x.awayTid);
+	} catch {
+		// no conferences: every game falls back to one network
+	}
+	return {
+		games,
+		// a league started at a later round has no games for the rounds before it
+		numPlayoffRounds:
+			g.get("numGamesPlayoffSeries", season).length -
+			((g as any).nflStartBracket?.season === season
+				? (g as any).nflStartBracket.round
+				: 0),
+	};
+};
+
+const processInputs = (params: RouteParams<"nflCalendar">) => {
+	// A team page link adds the team: then the page shows that team's season
+	let teamTid: number | undefined;
+	// ("mine" is the user's own team, for the Team menu link; a season that isn't a number is the current one)
+	if (params.abbrev === "mine") {
+		teamTid = g.get("userTid");
+	} else if (params.abbrev !== undefined) {
+		const tid = validateTeam(params.abbrev);
+		teamTid = tid >= 0 ? tid : undefined;
+	}
+	return {
+		season:
+			params.season === undefined || !/^d+$/.test(String(params.season))
+				? g.get("season")
+				: validateSeason(params.season),
+		teamTid,
+	};
+};
+
+export default defineView({
+	id: "nflCalendar",
+	processInputs,
+	load: async ({ inputs, updateEvents, prevInputs }) => {
+		if (
+			updateEvents.has("firstRun") ||
+			updateEvents.has("gameSim") ||
+			updateEvents.has("newPhase") ||
+			inputs.season !== prevInputs?.season ||
+			inputs.teamTid !== prevInputs?.teamTid
+		) {
+			const { games, numPlayoffRounds } = await getNflSeasonGames(
+				inputs.season,
+			);
+
+			const teams: Record<
+				number,
+				{
+					abbrev: string;
+					region: string;
+					name: string;
+					imgURL?: string;
+					colors: [string, string, string];
+					ovr?: number;
+				}
+			> = {};
+			for (const t of await idb.cache.teams.getAll()) {
+				const ts = await idb.merged.teamSeasons.getByTidSeason(
+					t.tid,
+					inputs.season,
+				);
+				teams[t.tid] = {
+					abbrev: ts?.abbrev ?? t.abbrev,
+					region: ts?.region ?? t.region,
+					name: ts?.name ?? t.name,
+					imgURL: ts?.imgURLSmall ?? ts?.imgURL ?? t.imgURLSmall ?? t.imgURL,
+					colors: ts?.colors ?? t.colors,
+				};
+			}
+			// Team ratings for the betting lines and projections (this season only)
+			if (inputs.season === g.get("season")) {
+				for (const tid of Object.keys(teams).map(Number)) {
+					const raw = await idb.cache.players.indexGetAll("playersByTid", tid);
+					const ps = await player.formatAll(raw, {
+						attrs: ["injury", "pid", "value", "tid"],
+						ratings: ["ovr", "pos", "ovrs"],
+						season: g.get("season"),
+						fuzz: true,
+					});
+					teams[tid]!.ovr = team.ovr(ps as any, {
+						playoffs: g.get("phase") === PHASE.PLAYOFFS,
+					});
+				}
+			}
+
+			// Upcoming day: the first game left on the schedule
+			let currentDay: number | undefined;
+			// The trade deadline: its day while it is still on the schedule; after it passes (or for other seasons) the
+			// page places it from the tradeDeadline setting (the share of the regular season played before it)
+			let tradeDeadlineDay: number | undefined;
+			if (inputs.season === g.get("season")) {
+				const schedule = await seasonCore.getSchedule();
+				currentDay = schedule[0]?.day;
+				tradeDeadlineDay = schedule.find((x) =>
+					isTradeDeadline(x.homeTid, x.awayTid),
+				)?.day;
+			}
+
+			return {
+				currentDay,
+				games,
+				numPlayoffRounds,
+				tradeDeadlineDay,
+				tradeDeadline: g.get("tradeDeadline") as number,
+				phase: g.get("phase"),
+				currentSeason: g.get("season"),
+				season: inputs.season,
+				startingSeason: g.get("startingSeason"),
+				teams,
+				teamTid: inputs.teamTid,
+				userTid: g.get("userTid"),
+			};
+		}
+	},
+});
diff --git a/src/worker/views/nflCoverVote.ts b/src/worker/views/nflCoverVote.ts
new file mode 100644
index 000000000..20c144d6d
--- /dev/null
+++ b/src/worker/views/nflCoverVote.ts
@@ -0,0 +1,381 @@
+// NFL history mod: the yearly cover vote (common/nflCover.ts). The ballot for a cover season is drawn from the season
+// before it: the best players still in the league, a few per position so it isn't eight quarterbacks. It opens after the
+// draft and closes when the regular season starts; then the fans' votes (simulated, the same every time for that
+// season) plus the user's own pick decide the cover.
+import { league, player } from "../core/index.ts";
+import { idb } from "../db/index.ts";
+import { g, helpers } from "../util/index.ts";
+import { defineView } from "../util/defineView.ts";
+import { faceJerseyFor } from "../util/faceJerseyFor.ts";
+import { PHASE } from "../../common/constants.ts";
+import type {
+	NflCoverPlayer,
+	NflCoverSeason,
+	NflCovers,
+} from "../../common/nflCover.ts";
+import {
+	FIRST_VOTE_SEASON,
+	maddenTitle,
+	REAL_COVERS,
+} from "../../common/nflCover.ts";
+
+// The season the league picks up from: NFL History league files keep the whole real history, so their startingSeason
+// is the first year of it (1967); the real story runs through nflRealDataLastSeason, where the user takes over
+const leagueStart = () =>
+	Math.max(g.get("startingSeason"), Object.hasOwn(g, "nflRealDataLastSeason") ? ((g as any).nflRealDataLastSeason as number) : 0);
+
+// The season whose cover is being chosen (or was just chosen)
+const coverSeasonNow = () => {
+	const season = g.get("season");
+	return g.get("phase") >= PHASE.DRAFT ? season + 1 : season;
+};
+const isOpen = (coverSeason: number) =>
+	coverSeason > g.get("season") || g.get("phase") <= PHASE.PRESEASON;
+
+// A steady random number for a player and season (the same fan vote every time)
+const noise = (pid: number, season: number) => {
+	let h = 2166136261 ^ (pid * 7919 + season * 104729);
+	h = Math.imul(h ^ (h >>> 15), 2246822519);
+	h = Math.imul(h ^ (h >>> 13), 3266489917);
+	return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
+};
+
+const lineFor = (pos: string, s: any) => {
+	const n = (x: number | undefined) =>
+		Math.round(x ?? 0).toLocaleString("en-US");
+	if (pos === "QB")
+		return `${n(s.pssYds)} pass yds, ${n(s.pssTD)} TD`;
+	if (pos === "RB")
+		return `${n(s.rusYds)} rush yds, ${n((s.rusTD ?? 0) + (s.recTD ?? 0))} TD`;
+	if (pos === "WR" || pos === "TE")
+		return `${n(s.rec)} rec, ${n(s.recYds)} yds, ${n(s.recTD)} TD`;
+	if (["DL", "LB"].includes(pos))
+		return `${(s.defSk ?? 0).toFixed(1).replace(/\.0$/, "")} sacks, ${n(s.defTck)} tackles`;
+	if (["CB", "S"].includes(pos))
+		return `${n(s.defInt)} INT, ${n(s.defPssDef)} passes defended`;
+	return `${n(s.gp)} games`;
+};
+
+// How a season reads for each position: one number to rank the players at that position by
+const statScore = (pos: string, s: any) => {
+	const v = (x: number | undefined) => x ?? 0;
+	if (pos === "QB") return v(s.pssYds) + 25 * v(s.pssTD) + 8 * v(s.rusYds) / 10;
+	if (pos === "RB") return v(s.rusYds) + v(s.recYds) * 0.8 + 40 * (v(s.rusTD) + v(s.recTD));
+	if (pos === "WR" || pos === "TE") return v(s.recYds) + 6 * v(s.rec) + 40 * v(s.recTD);
+	if (pos === "DL" || pos === "LB") return 60 * v(s.defSk) + 4 * v(s.defTck) + 50 * v(s.defInt);
+	if (pos === "CB" || pos === "S") return 70 * v(s.defInt) + 12 * v(s.defPssDef) + 3 * v(s.defTck);
+	return 0;
+};
+
+// The fans' pull toward a player, mostly from what he did last season. A cover can go to the MVP, a Super Bowl hero,
+// the best at his position, or a young player everyone is talking about, so each of those counts, plus a little luck.
+// Returns the score and the headline reason.
+const popularity = (p: any, last: number, posRank: number, posCount: number, prevOvr?: number) => {
+	const aw = (p.awards ?? []).filter((a: any) => a.season === last);
+	const has = (re: RegExp) => aw.some((a: any) => re.test(a.type));
+	const pos = p.ratings?.pos ?? "";
+	const ovr = p.ratings?.ovr ?? 0;
+	const reasons: [number, string][] = [];
+	let score = ovr * 0.55;
+	if (has(/Most Valuable Player/)) reasons.push([22, "MVP"]);
+	if (has(/Super Bowl MVP|Finals MVP/)) reasons.push([14, "Super Bowl MVP"]);
+	if (has(/Won Championship/)) reasons.push([8, "Super Bowl champion"]);
+	if (has(/Offensive Player of the Year|Defensive Player of the Year/)) reasons.push([11, "Player of the Year"]);
+	if (has(/Rookie of the Year/)) reasons.push([8, "Rookie of the Year"]);
+	if (has(/League .* Leader/)) reasons.push([5, "League leader"]);
+	if (has(/First Team All/)) reasons.push([6, "First-team All-Pro"]);
+	else if (has(/Second Team All/)) reasons.push([3, "All-Pro"]);
+	if (has(/Pro Bowl|All-Star/)) reasons.push([2, "Pro Bowl"]);
+	// the best seasons at his position
+	if (posCount > 0 && p.stats?.gp) {
+		const bonus = posRank === 0 ? 12 : posRank === 1 ? 8 : posRank === 2 ? 5 : posRank < posCount * 0.1 ? 2 : 0;
+		if (bonus) reasons.push([bonus, posRank === 0 ? `Best ${pos} season` : "Big season"]);
+	}
+	// buzz: young and rising fast
+	const age = p.age ?? 30;
+	const jump = prevOvr !== undefined ? ovr - prevOvr : 0;
+	if (age <= 25 && jump >= 5) reasons.push([7, "Rising star"]);
+	else if (age <= 24) reasons.push([2, "Young star"]);
+	// the cover goes to faces fans know: quarterbacks most, then the other skill positions
+	if (pos === "QB") score += 6;
+	else if (["RB", "WR", "TE"].includes(pos)) score += 3;
+	for (const [v] of reasons) score += v;
+	score += 7 * noise(p.pid, last + 1);
+	const why = reasons.sort((a, b) => b[0] - a[0])[0]?.[1];
+	return { score, why };
+};
+
+const buildBallot = async (coverSeason: number): Promise<NflCoverPlayer[]> => {
+	const last = coverSeason - 1;
+	const raw = await idb.cache.players.indexGetAll("playersByTid", [0, Infinity]);
+	const ps: any[] = await player.formatAll(raw, {
+		attrs: ["pid", "name", "tid", "face", "imgURL", "awards", "age", "jerseyNumber"],
+		ratings: ["pos", "ovr"],
+		stats: [
+			"gp",
+			"pssYds",
+			"pssTD",
+			"rusYds",
+			"rusTD",
+			"rec",
+			"recYds",
+			"recTD",
+			"defSk",
+			"defTck",
+			"defInt",
+			"defPssDef",
+		],
+		season: last,
+		showNoStats: true,
+		fuzz: true,
+	});
+	const played = ps.filter((p) => (p.stats?.gp ?? 0) >= 8);
+	// (a brand-new league has no last season: then it goes on ratings alone)
+	const pool = played.length >= 8 ? played : ps;
+	// rank each position's seasons
+	const byPos = new Map<string, any[]>();
+	for (const p of pool) {
+		const pos = p.ratings?.pos ?? "";
+		byPos.set(pos, [...(byPos.get(pos) ?? []), p]);
+	}
+	const rankOf = new Map<number, { rank: number; count: number }>();
+	for (const [pos, list] of byPos) {
+		list
+			.map((p) => ({ p, v: statScore(pos, p.stats ?? {}) }))
+			.sort((a, b) => b.v - a.v)
+			.forEach(({ p }, i) => rankOf.set(p.pid, { rank: i, count: list.length }));
+	}
+	const prevOvrOf = new Map<number, number>();
+	for (const r of raw) {
+		const prev = r.ratings.filter((x) => x.season <= last - 1).at(-1);
+		if (prev) prevOvrOf.set(r.pid, prev.ovr);
+	}
+	const scored = pool
+		.map((p) => {
+			const rk = rankOf.get(p.pid) ?? { rank: 99, count: 0 };
+			const { score, why } = popularity(p, last, rk.rank, rk.count, prevOvrOf.get(p.pid));
+			return { p, score, why };
+		})
+		.sort((a, b) => b.score - a.score);
+	const perPos = new Map<string, number>();
+	const picked: { p: any; score: number; why?: string }[] = [];
+	for (const x of scored) {
+		const pos = x.p.ratings?.pos ?? "";
+		const cap = pos === "QB" ? 3 : 2;
+		if ((perPos.get(pos) ?? 0) >= cap) continue;
+		perPos.set(pos, (perPos.get(pos) ?? 0) + 1);
+		picked.push(x);
+		if (picked.length === 8) break;
+	}
+	const out: NflCoverPlayer[] = [];
+	for (const { p, score, why } of picked) {
+		const t = await idb.cache.teams.get(p.tid);
+		out.push({
+			pid: p.pid,
+			name: p.name,
+			pos: p.ratings?.pos ?? "",
+			tid: p.tid,
+			abbrev: t?.abbrev ?? "",
+			region: t?.region ?? "",
+			teamName: t?.name ?? "",
+			colors: (t?.colors ?? ["#334155", "#ffffff", "#000000"]) as [
+				string,
+				string,
+				string,
+			],
+			logo: t?.imgURL ?? t?.imgURLSmall,
+			face: p.face,
+			imgURL: p.imgURL || undefined,
+			ovr: p.ratings?.ovr ?? 0,
+			line: p.stats?.gp ? lineFor(p.ratings?.pos ?? "", p.stats) : "",
+			pop: Math.round(score * 10) / 10,
+			why,
+			nfl: await faceJerseyFor(p.tid, last, p.jerseyNumber),
+		});
+	}
+	return out;
+};
+
+// The fans' shares for a ballot (percent). Mostly the players' seasons (pop); your own vote is one voice among
+// millions, worth a small push, never enough to carry someone the fans don't want.
+const sharesFor = (c: NflCoverSeason) => {
+	const w = c.candidates.map((p) => {
+		const base = (p.pop ?? p.ovr) + (c.userPick === p.pid ? 2 : 0);
+		return Math.exp((base - 60) / 5);
+	});
+	const sum = w.reduce((a, b) => a + b, 0) || 1;
+	const raw = w.map((x) => (x / sum) * 100);
+	// whole percents that add up to 100
+	const floored = raw.map(Math.floor);
+	let left = 100 - floored.reduce((a, b) => a + b, 0);
+	const order = raw
+		.map((x, i) => ({ i, r: x - Math.floor(x) }))
+		.sort((a, b) => b.r - a.r);
+	for (const { i } of order) {
+		if (left <= 0) break;
+		floored[i]! += 1;
+		left--;
+	}
+	return floored;
+};
+
+const save = async (covers: NflCovers) => {
+	await league.setGameAttributes({ nflCovers: covers });
+};
+
+
+// The real covers up to the league's first season, using the league's own copy of each player when he's in it
+// (his face and that season's team), otherwise just the name and the real team.
+// (years: which real covers to fill, default every one up to the league's first season; award: also put the cover in
+// the player's awards, only for the ones that are the league's own history)
+const fillRealCovers = async (covers: NflCovers, years?: number[], award = true) => {
+	const start = leagueStart();
+	const missing = (years ?? Object.keys(REAL_COVERS).map(Number).filter((y) => y <= start)).filter((y) => REAL_COVERS[y] && !covers[y]);
+	if (missing.length === 0) return false;
+	const all: any[] = await idb.merged.players.getAll({ activeAndRetired: true });
+	const teams = await idb.cache.teams.getAll();
+	let fake = -1;
+	for (const y of missing) {
+		const stars: NflCoverPlayer[] = [];
+		for (const r of REAL_COVERS[y]!) {
+			const p = all.find(
+				(x) => { const bare = (n: string) => n.replace(/ (Jr.|Sr.|II|III|IV)$/, "").trim(); return bare(`${x.firstName} ${x.lastName}`) === bare(r.name); },
+			);
+			// his team that season (the season before the title year), else the real abbreviation
+			const st = p?.stats?.filter((s: any) => s.season === y - 1 && !s.playoffs).at(-1);
+			const t =
+				(st ? teams.find((x) => x.tid === st.tid) : undefined) ??
+				teams.find((x) => x.abbrev === r.abbrev);
+			const ts = t
+				? await idb.cache.teamSeasons.indexGet("teamSeasonsByTidSeason", [t.tid, y - 1])
+				: undefined;
+			const rat = p?.ratings?.filter((x: any) => x.season <= y - 1).at(-1);
+			stars.push({
+				pid: p?.pid ?? fake--,
+				name: r.name,
+				pos: r.pos,
+				tid: t?.tid ?? -1,
+				abbrev: ts?.abbrev ?? t?.abbrev ?? r.abbrev,
+				region: ts?.region ?? t?.region ?? "",
+				teamName: ts?.name ?? t?.name ?? "",
+				colors: (ts?.colors ?? t?.colors ?? ["#013369", "#D50A0A", "#FFFFFF"]) as [string, string, string],
+				logo: ts?.imgURL ?? t?.imgURL ?? t?.imgURLSmall,
+				face: p?.face,
+				imgURL: p?.imgURL || undefined,
+				ovr: rat?.ovr ?? 0,
+				line: "",
+				nfl: t ? await faceJerseyFor(t.tid, y - 1, st?.jerseyNumber ?? p?.jerseyNumber) : undefined,
+			});
+		}
+		if (award) {
+			for (const st of stars) {
+				await giveAward(st.pid, y);
+			}
+		}
+		covers[y] = stars.length
+			? { season: y, candidates: [stars[0]!], winner: stars[0]!.pid, real: true, coStar: stars[1] }
+			: { season: y, candidates: [], real: true };
+	}
+	return true;
+};
+
+// The cover goes in the player's awards, so it shows on his page, the awards lists and the league history
+const AWARD = "Madden Cover Athlete";
+const giveAward = async (pid: number, season: number) => {
+	if (pid < 0) return;
+	const p = await idb.cache.players.get(pid);
+	if (!p) return;
+	if (p.awards.some((a) => a.type === AWARD && a.season === season)) return;
+	p.awards.push({ season, type: AWARD });
+	await idb.cache.players.put(p);
+};
+
+// Opens the ballot when it's time, and decides the cover once the season has started. Runs at every phase change
+// (and when the page opens), so the history fills in whether or not anyone visits the vote.
+const ensure = async () => {
+	const covers: NflCovers = helpers.deepCopy(g.get("nflCovers") ?? {});
+	const season = coverSeasonNow();
+	let changed = await fillRealCovers(covers);
+	if (
+		!covers[season] &&
+		season >= FIRST_VOTE_SEASON &&
+		// (a real cover decides the years the real story covers; the first year without one is the first vote)
+		(season > leagueStart() || !REAL_COVERS[season])
+	) {
+		const candidates = await buildBallot(season);
+		if (candidates.length >= 2) {
+			covers[season] = { season, candidates };
+			changed = true;
+		}
+	}
+	// (covers saved before players wore the mod's jerseys get them now)
+	for (const c of Object.values(covers)) {
+		for (const p of [...c.candidates, ...(c.coStar ? [c.coStar] : [])]) {
+			if (!p.nfl && p.tid >= 0) {
+				p.nfl = await faceJerseyFor(p.tid, c.season - 1);
+				if (p.nfl) changed = true;
+			}
+		}
+	}
+	for (const c of Object.values(covers)) {
+		if (c.winner === undefined && !isOpen(c.season) && c.candidates.length) {
+			const shares = sharesFor(c);
+			c.shares = shares;
+			c.winner = c.candidates[shares.indexOf(Math.max(...shares))]!.pid;
+			await giveAward(c.winner, c.season);
+			changed = true;
+		}
+	}
+	if (changed) await save(covers);
+	return { covers, season };
+};
+
+export const ensureCovers = async () => {
+	try {
+		await ensure();
+	} catch (err) {
+		console.error(err);
+	}
+};
+
+export const castCoverVote =async (pid: number) => {
+	const { covers, season } = await ensure();
+	const c = covers[season];
+	if (!c || !isOpen(season) || c.userPick !== undefined) return;
+	if (!c.candidates.some((p) => p.pid === pid)) return;
+	c.userPick = pid;
+	await save(covers);
+};
+
+export default defineView({
+	id: "nflCoverVote",
+	load: async () => {
+		const { covers, season } = await ensure();
+		const c = covers[season];
+		// the real-life covers up to now that came out after the league began (the league votes on its own; these are
+		// shown beside them as the real history)
+		const realLater: NflCovers = {};
+		const start = leagueStart();
+		await fillRealCovers(
+			realLater,
+			Object.keys(REAL_COVERS)
+				.map(Number)
+				.filter((y) => y > start && y <= season),
+			false,
+		);
+		return {
+			season,
+			title: maddenTitle(season),
+			firstVoteSeason: FIRST_VOTE_SEASON,
+			open: isOpen(season),
+			current: c,
+			// the fans' running shares, shown once you've voted
+			liveShares: c && c.userPick !== undefined ? sharesFor(c) : undefined,
+			past: Object.values(covers)
+				.filter((x) => (x.winner !== undefined || x.real) && x.season !== season)
+				.sort((a, b) => b.season - a.season),
+			realLater: Object.values(realLater).sort((a, b) => b.season - a.season),
+			userTid: g.get("userTid"),
+		};
+	},
+});
