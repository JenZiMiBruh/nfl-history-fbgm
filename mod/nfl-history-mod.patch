+// The calendar itself (the page and the compact one on the dashboard share it)
+export const NflCalendarBody = ({
+	embedded,
+	currentDay,
+	currentSeason,
+	games,
+	numPlayoffRounds,
+	phase,
+	season,
+	teams,
+	teamTid,
+	tradeDeadline,
+	tradeDeadlineDay,
+	userTid,
+}: View<"nflCalendar"> & { embedded?: boolean }) => {
+	// A team calendar (from a team page) centers on that team; otherwise on yours
+	const focusTid = teamTid ?? userTid;
+
+	const [data, setData] = useState<NflCalendarData | undefined>();
+	const [loaded, setLoaded] = useState(false);
+	useEffect(() => {
+		loadNflCalendarData().then((d) => {
+			setData(d);
+			setLoaded(true);
+		});
+	}, []);
+
+	const calendar = useMemo(
+		() =>
+			loaded
+				? buildSeasonCalendar(data, season, games, numPlayoffRounds)
+				: new Map<string, NflGameInfo>(),
+		[loaded, data, season, games, numPlayoffRounds],
+	);
+
+	// Every game with its info, sorted by kickoff
+	const entries = useMemo(() => {
+		const out: Entry[] = [];
+		for (const game of games) {
+			const info = calendar.get(calendarKey(game));
+			if (info) {
+				out.push({ game, info });
+			}
+		}
+		out.sort(
+			(a, b) =>
+				a.info.date.getTime() - b.info.date.getTime() ||
+				a.info.minutes - b.info.minutes,
+		);
+		return out;
+	}, [games, calendar]);
+
+	const byDate = useMemo(() => {
+		const map = new Map<string, Entry[]>();
+		for (const e of entries) {
+			const k = dayKey(e.info.date);
+			const list = map.get(k) ?? [];
+			list.push(e);
+			map.set(k, list);
+		}
+		return map;
+	}, [entries]);
+
+	// NFL weeks: regular season weeks, then each playoff round
+	const weeks = useMemo(() => {
+		const map = new Map<
+			string,
+			{ label: string; sub: string; entries: Entry[] }
+		>();
+		for (const e of entries) {
+			const id =
+				e.info.week !== undefined ? `w${e.info.week}` : `p${e.info.round}`;
+			const w = map.get(id) ?? {
+				label:
+					e.info.week !== undefined
+						? `Week ${e.info.week}`
+						: e.info.superBowl
+							? "Super Bowl"
+							: (e.info.round ?? ""),
+				sub: "",
+				entries: [],
+			};
+			w.entries.push(e);
+			map.set(id, w);
+		}
+		for (const w of map.values()) {
+			const first = w.entries[0]!.info.date;
+			const last = w.entries.at(-1)!.info.date;
+			w.sub =
+				first.getTime() === last.getTime()
+					? shortDate.format(first)
+					: `${shortDate.format(first)} – ${shortDate.format(last)}`;
+		}
+		return [...map.entries()];
+	}, [entries]);
+
+	// Game of the Week by records going into each week
+	const gamesOfTheWeek = useMemo(() => {
+		const out = new Set<string>();
+		const regular = games
+			.filter((g) => !g.playoffs)
+			.sort((a, b) => a.day - b.day);
+		const records = new Map<number, [number, number]>();
+		const days = [...new Set(regular.map((g) => g.day))];
+		for (const [i, day] of days.entries()) {
+			const week = regular.filter((g) => g.day === day);
+			const best = pickGameOfTheWeek(week, records);
+			if (best && i > 0) {
+				out.add(calendarKey(best));
+			}
+			for (const g of week) {
+				if (
+					g.homePts === undefined ||
+					g.awayPts === undefined ||
+					g.homePts === g.awayPts
+				) {
+					continue;
+				}
+				for (const [tid, won] of [
+					[g.homeTid, g.homePts > g.awayPts],
+					[g.awayTid, g.awayPts > g.homePts],
+				] as const) {
+					const r = records.get(tid) ?? [0, 0];
+					r[won ? 0 : 1] += 1;
+					records.set(tid, r);
+				}
+			}
+		}
+		return out;
+	}, [games]);
+
+	// Where we are: the next unplayed game day
+	const isCurrent = season === currentSeason;
+	const nextEntry = useMemo(
+		() =>
+			isCurrent && currentDay !== undefined
+				? entries.find(
+						(e) => e.game.day === currentDay && e.game.homePts === undefined,
+					)
+				: undefined,
+		[isCurrent, currentDay, entries],
+	);
+	const currentWeekId = nextEntry
+		? nextEntry.info.week !== undefined
+			? `w${nextEntry.info.week}`
+			: `p${nextEntry.info.round}`
+		: undefined;
+	const myNext = useMemo(
+		() =>
+			isCurrent
+				? entries.find(
+						(e) =>
+							e.game.homePts === undefined &&
+							(e.game.homeTid === focusTid || e.game.awayTid === focusTid),
+					)
+				: undefined,
+		[isCurrent, entries, focusTid],
+	);
+
+	const [selectedWeek, setSelectedWeek] = useState<string | undefined>();
+	const [view, setViewState] = useState<CalView>(readView);
+	const setView = (v: CalView) => {
+		setViewState(v);
+		try {
+			localStorage.setItem(VIEW_KEY, v);
+		} catch {}
+	};
+	// A day picked in the month view: highlighted in the week list, which scrolls into view
+	const [focusDay, setFocusDay] = useState<string | undefined>();
+	const weekListRef = useRef<HTMLDivElement | null>(null);
+	// A game picked from the week highlights: outlined in the list and scrolled to
+	const [focusGame, setFocusGame] = useState<string | undefined>();
+	useEffect(() => {
+		if (focusGame) {
+			document
+				.getElementById(`nfl-game-${focusGame}`)
+				?.scrollIntoView({ behavior: "smooth", block: "center" });
+		}
