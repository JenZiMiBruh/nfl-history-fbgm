+// NFL history mod: the real Super Bowl logos from XXVI on, redrawn to follow the originals: the one-off host-city
+// crests of the 90s and 2000s (XXVI-XLIV), the silver trophy-and-stadium marks (XLV-50), and the trophy standing in
+// the numerals since LI, silver at first and filled with the host city's art from LVI. Same 256x256 canvas as the rest.
+// Also the themed marks for generated games after LXI (city art in the numerals, the look changing every few years).
+
+const SERIF = `'Times New Roman',Georgia,serif`;
+const BLOCK = `'Arial Black','Arial Bold',Impact,sans-serif`;
+const COND = `Impact,'Arial Narrow',sans-serif`;
+const NAVY = "#0B2265";
+const RED = "#C8102E";
+
+const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
+
+type T = {
+	x?: number;
+	y: number;
+	size: number;
+	fill: string;
+	font?: string;
+	stroke?: string;
+	sw?: number;
+	italic?: boolean;
+	ls?: number;
+	w?: number;
+	weight?: number;
+	shadow?: [number, number, string];
+	extrude?: [number, number, string, number];
+};
+
+// text, optionally squeezed to a width, with an outline, a drop shadow or a solid extrusion
+const txt = (t: string, o: T) => {
+	const a = `x='${o.x ?? 128}' y='${o.y}' text-anchor='middle' font-family="${o.font ?? BLOCK}" font-size='${o.size}' font-weight='${o.weight ?? 900}'${o.italic ? " font-style='italic'" : ""}${o.ls ? ` letter-spacing='${o.ls}'` : ""}${o.w ? ` textLength='${o.w}' lengthAdjust='spacingAndGlyphs'` : ""}`;
+	let out = "";
+	if (o.extrude) {
+		const [dx, dy, col, steps] = o.extrude;
+		for (let i = steps; i >= 1; i--) {
+			out += `<text ${a} fill='${col}' stroke='${col}' stroke-width='${o.sw ?? 0}' stroke-linejoin='round' transform='translate(${((dx * i) / steps).toFixed(1)} ${((dy * i) / steps).toFixed(1)})'>${esc(t)}</text>`;
+		}
+	}
+	if (o.shadow) {
+		out += `<text ${a} fill='${o.shadow[2]}' transform='translate(${o.shadow[0]} ${o.shadow[1]})'>${esc(t)}</text>`;
+	}
+	if (o.stroke) {
+		out += `<text ${a} fill='none' stroke='${o.stroke}' stroke-width='${o.sw ?? 6}' stroke-linejoin='round'>${esc(t)}</text>`;
+	}
+	return out + `<text ${a} fill='${o.fill}'>${esc(t)}</text>`;
+};
+
+// text bent along a circle or ellipse: over the top, or along the bottom reading left to right
+const arc = (
+	id: string,
+	t: string,
+	o: { cx?: number; cy: number; rx: number; ry?: number; top: boolean; size: number; fill: string; font?: string; ls?: number; weight?: number },
+) => {
+	const cx = o.cx ?? 128;
+	const ry = o.ry ?? o.rx;
+	const d = `M${cx - o.rx} ${o.cy} A${o.rx} ${ry} 0 0 ${o.top ? 1 : 0} ${cx + o.rx} ${o.cy}`;
+	return (
+		`<path id='${id}' d='${d}' fill='none'/>` +
+		`<text font-family="${o.font ?? "Arial"}" font-size='${o.size}' font-weight='${o.weight ?? 700}' letter-spacing='${o.ls ?? 1}' fill='${o.fill}'><textPath href='#${id}' startOffset='50%' text-anchor='middle'>${esc(t)}</textPath></text>`
+	);
+};
+
+const star = (cx: number, cy: number, r: number, fill: string, stroke?: string) => {
+	const pts: string[] = [];
+	for (let i = 0; i < 10; i++) {
+		const a = -Math.PI / 2 + (i * Math.PI) / 5;
+		const rr = i % 2 === 0 ? r : r * 0.42;
+		pts.push(`${(cx + rr * Math.cos(a)).toFixed(1)},${(cy + rr * Math.sin(a)).toFixed(1)}`);
+	}
+	return `<polygon points='${pts.join(" ")}' fill='${fill}'${stroke ? ` stroke='${stroke}' stroke-width='2' stroke-linejoin='round'` : ""}/>`;
+};
+
+const lin = (id: string, stops: string[], vertical = true) =>
+	`<linearGradient id='${id}' x1='0' y1='0' x2='${vertical ? 0 : 1}' y2='${vertical ? 1 : 0}'>${stops
+		.map((c, i) => `<stop offset='${(i / Math.max(1, stops.length - 1)).toFixed(2)}' stop-color='${c}'/>`)
+		.join("")}</linearGradient>`;
+
+const football = (cx: number, cy: number, rx: number, ry: number, fill: string, rot = 0, laces = "#fff") =>
+	`<g transform='rotate(${rot} ${cx} ${cy})'><path d='M${cx - rx} ${cy} Q${cx} ${cy - ry * 2} ${cx + rx} ${cy} Q${cx} ${cy + ry * 2} ${cx - rx} ${cy} Z' fill='${fill}'/>` +
+	`<path d='M${cx - rx * 0.4} ${cy} L${cx + rx * 0.4} ${cy}' stroke='${laces}' stroke-width='${(ry * 0.18).toFixed(1)}'/>` +
+	[-0.25, -0.08, 0.08, 0.25].map((k) => `<path d='M${cx + rx * k} ${cy - ry * 0.28} L${cx + rx * k} ${cy + ry * 0.28}' stroke='${laces}' stroke-width='${(ry * 0.14).toFixed(1)}'/>`).join("") +
+	`</g>`;
+
+// ---------- block numerals drawn as shapes (the modern marks) ----------
+const GLYPH: Record<string, { w: number; d: string }> = {
+	I: { w: 30, d: "M0 0 H30 V100 H0 Z" },
+	L: { w: 64, d: "M0 0 H30 V76 H64 V100 H0 Z" },
+	V: { w: 80, d: "M0 0 H30 L40 60 L50 0 H80 L55 100 H25 Z" },
+	X: { w: 80, d: "M0 0 H30 L40 28 L50 0 H80 L56 50 L80 100 H50 L40 72 L30 100 H0 L24 50 Z" },
+	// for generated games from XC on
+	C: { w: 72, d: "M0 0 H72 V24 H30 V76 H72 V100 H0 Z" },
+};
+
+// the glyphs of a numeral laid out left to right; "T" is a gap for the trophy
+const layout = (s: string, gap: number, tGap: number) => {
+	let x = 0;
+	const out: { ch: string; x: number; w: number }[] = [];
+	for (const ch of s) {
+		const w = ch === "T" ? tGap : GLYPH[ch]!.w;
+		out.push({ ch, x, w });
+		x += w + gap;
+	}
+	return { glyphs: out, width: x - gap };
+};
+
+// where the trophy stands: after the L
+const withTrophy = (num: string) => {
+	if (!num.startsWith("L")) {
+		return num.length > 1 ? `${num[0]}T${num.slice(1)}` : `T${num}`;
+	}
+	// every numeral keeps all its letters (LIV is L, I, V), the trophy standing after the L
+	return `LT${num.slice(1)}`;
+};
+
+const glyphPaths = (num: string, x: number, y: number, h: number, sx: number, gap: number, tGap: number) => {
+	const { glyphs, width } = layout(num, gap, tGap);
+	const k = h / 100;
+	const left = x - (width * k * sx) / 2;
+	const items = glyphs.map((g) => ({
+		...g,
+		tf: `translate(${(left + g.x * k * sx).toFixed(1)} ${y}) scale(${(k * sx).toFixed(3)} ${k.toFixed(3)})`,
+		cx: left + (g.x + g.w / 2) * k * sx,
+	}));
+	return { items, width: width * k * sx, left };
+};
+
+// ---------- the Lombardi trophy, in brushed silver ----------
+const trophyDefs = (p: string) =>
+	lin(`${p}ts`, ["#6E7680", "#F4F6F8", "#C5CBD1", "#E9ECEF", "#666E78"], false) +
+	`<radialGradient id='${p}tb' cx='0.38' cy='0.32' r='0.75'><stop offset='0' stop-color='#FFFFFF'/><stop offset='0.45' stop-color='#C9CFD6'/><stop offset='1' stop-color='#59616B'/></radialGradient>`;
+
+const trophy = (p: string, cx: number, top: number, h: number) => {
+	const u = h / 100;
+	const X = (v: number) => (cx + v * u).toFixed(1);
+	const Y = (v: number) => (top + v * u).toFixed(1);
+	const sw = (v: number) => (v * u).toFixed(2);
+	return (
+		`<g>` +
+		// base: two beveled steps
+		`<path d='M${X(-16)} ${Y(100)} L${X(16)} ${Y(100)} L${X(14.5)} ${Y(93)} L${X(-14.5)} ${Y(93)} Z' fill='url(#${p}ts)' stroke='#4B525B' stroke-width='${sw(0.6)}'/>` +
+		`<path d='M${X(-13.5)} ${Y(93)} L${X(13.5)} ${Y(93)} L${X(12.5)} ${Y(87)} L${X(-12.5)} ${Y(87)} Z' fill='url(#${p}ts)' stroke='#4B525B' stroke-width='${sw(0.5)}'/>` +
+		// stand: flaring from the cradle down to the base, lit down the middle
+		`<path d='M${X(-12)} ${Y(87)} C${X(-8)} ${Y(72)} ${X(-6)} ${Y(52)} ${X(-6.5)} ${Y(33)} L${X(6.5)} ${Y(33)} C${X(6)} ${Y(52)} ${X(8)} ${Y(72)} ${X(12)} ${Y(87)} Z' fill='url(#${p}ts)' stroke='#4B525B' stroke-width='${sw(0.5)}'/>` +
+		`<path d='M${X(-2.2)} ${Y(87)} C${X(-1.4)} ${Y(72)} ${X(-1)} ${Y(52)} ${X(-1.2)} ${Y(33)} L${X(1.2)} ${Y(33)} C${X(1)} ${Y(52)} ${X(1.4)} ${Y(72)} ${X(2.2)} ${Y(87)} Z' fill='#FFFFFF' opacity='0.6'/>` +
+		// NFL shield on the stand
+		`<path d='M${X(-4)} ${Y(56)} L${X(4)} ${Y(56)} L${X(4)} ${Y(62)} Q${X(4)} ${Y(65.5)} ${X(0)} ${Y(67)} Q${X(-4)} ${Y(65.5)} ${X(-4)} ${Y(62)} Z' fill='#013369' stroke='#fff' stroke-width='${sw(0.7)}'/>` +
+		`<path d='M${X(-4)} ${Y(56)} L${X(4)} ${Y(56)} L${X(4)} ${Y(59)} L${X(-4)} ${Y(59)} Z' fill='#fff'/>` +
+		// cradle
+		`<path d='M${X(-9.5)} ${Y(33)} L${X(9.5)} ${Y(33)} L${X(6.5)} ${Y(28)} L${X(-6.5)} ${Y(28)} Z' fill='url(#${p}ts)' stroke='#4B525B' stroke-width='${sw(0.4)}'/>` +
+		// the ball, tipped back, laces toward us
+		`<g transform='rotate(-42 ${X(1)} ${Y(16)})'>` +
+		`<ellipse cx='${X(1)}' cy='${Y(16)}' rx='${sw(23)}' ry='${sw(14)}' fill='url(#${p}tb)' stroke='#4B525B' stroke-width='${sw(0.6)}'/>` +
+		`<path d='M${X(-21)} ${Y(16)} Q${X(1)} ${Y(9)} ${X(23)} ${Y(16)}' fill='none' stroke='#8A929C' stroke-width='${sw(0.6)}'/>` +
+		`<path d='M${X(-21)} ${Y(16)} Q${X(1)} ${Y(25)} ${X(23)} ${Y(16)}' fill='none' stroke='#8A929C' stroke-width='${sw(0.6)}'/>` +
+		`<path d='M${X(-8)} ${Y(11)} Q${X(1)} ${Y(9)} ${X(10)} ${Y(11)}' fill='none' stroke='#6B737D' stroke-width='${sw(1.3)}'/>` +
+		[-5, -2, 1, 4, 7].map((d) => `<path d='M${X(d)} ${Y(8.4)} L${X(d)} ${Y(13)}' stroke='#6B737D' stroke-width='${sw(1)}'/>`).join("") +
+		`<ellipse cx='${X(-6)}' cy='${Y(10)}' rx='${sw(9)}' ry='${sw(3)}' fill='#fff' opacity='0.55'/>` +
+		`</g></g>`
+	);
+};
+
+// ---------- small pieces used by the 90s-2000s crests ----------
+const dateLines = (lines: string[], y: number, o: { size?: number; fill?: string; ls?: number; step?: number; font?: string } = {}) =>
+	lines
+		.map((t, i) =>
+			txt(t, {
+				y: y + i * (o.step ?? 13),
+				size: o.size ?? 10.5,
+				fill: o.fill ?? "#222",
+				font: o.font ?? "Arial",
+				weight: 700,
+				ls: o.ls ?? 0.5,
+				w: t.length * (o.size ?? 10.5) * 0.62 > 230 ? 230 : undefined,
+			}),
+		)
+		.join("");
+
+const rose = (cx: number, cy: number, r: number) => {
+	const P = (x: number, y: number) => `${(cx + x * r).toFixed(1)} ${(cy + y * r).toFixed(1)}`;
+	const w = (r * 0.09).toFixed(1);
+	return (
+		// back petals
+		`<path d='M${P(-0.95, -0.05)} Q${P(-1, -0.95)} ${P(-0.25, -0.95)} Q${P(0, -1.15)} ${P(0.25, -0.95)} Q${P(1, -0.95)} ${P(0.95, -0.05)} Z' fill='#C8243F' stroke='#fff' stroke-width='${w}' stroke-linejoin='round'/>` +
+		// the bud
+		`<path d='M${P(-0.5, -0.2)} Q${P(-0.5, -0.75)} ${P(0, -0.75)} Q${P(0.5, -0.75)} ${P(0.5, -0.2)} Z' fill='#9E1B32' stroke='#fff' stroke-width='${w}'/>` +
+		`<path d='M${P(-0.3, -0.35)} Q${P(0, -0.65)} ${P(0.3, -0.35)} Q${P(0, -0.2)} ${P(-0.1, -0.42)}' fill='none' stroke='#fff' stroke-width='${w}'/>` +
+		// the cup of front petals
+		`<path d='M${P(-1, -0.15)} Q${P(-0.5, 0.15)} ${P(0, -0.2)} Q${P(0.5, 0.15)} ${P(1, -0.15)} Q${P(1, 0.95)} ${P(0, 1)} Q${P(-1, 0.95)} ${P(-1, -0.15)} Z' fill='#B5173A' stroke='#fff' stroke-width='${w}' stroke-linejoin='round'/>` +
+		`<path d='M${P(-0.7, 0.2)} Q${P(0, 0.75)} ${P(0.7, 0.2)}' fill='none' stroke='#fff' stroke-width='${w}'/>` +
+		`<path d='M${P(0, 0.42)} L${P(0, 1)}' stroke='#fff' stroke-width='${w}'/>`
+	);
+};
+
+const leaf = (cx: number, cy: number, r: number, rot: number) =>
+	`<path transform='rotate(${rot} ${cx} ${cy})' d='M${cx} ${cy} Q${cx + r} ${cy - r * 0.6} ${cx + r * 2} ${cy} Q${cx + r} ${cy + r * 0.6} ${cx} ${cy} Z' fill='#2E8B3E' stroke='#fff' stroke-width='1.5'/>`;
+
+// a rough outline of the lower 48 states, 0-100 wide, 0-60 tall
+const USA =
+	"M2 10 L10 6 L22 8 L34 7 L46 8 L58 9 L66 7 L72 10 L78 6 L84 9 L88 4 L94 2 L98 6 L94 12 L90 16 L92 20 L88 26 L84 30 L82 38 L86 50 L84 58 L80 56 L76 46 L70 44 L62 46 L56 52 L52 56 L48 50 L42 48 L36 52 L30 46 L24 44 L18 40 L12 38 L6 32 L2 22 Z";
+
+const crest = (n: number, p: string): string | undefined => {
+	switch (n) {
+		case 26: {
+			const pts: string[] = [];
+			for (let i = 0; i < 56; i++) {
+				const a = (i * Math.PI) / 28;
+				const r = i % 2 ? 62 : 67;
+				pts.push(`${(128 + r * Math.cos(a)).toFixed(1)},${(120 + r * Math.sin(a)).toFixed(1)}`);
