new file mode 100644
index 000000000..a55351f58
--- /dev/null
+++ b/src/worker/core/player/realDeaths.ts
@@ -0,0 +1,66 @@
+import { PLAYER, PHASE } from "../../../common/constants.ts";
+import { season } from "../index.ts";
+import { idb } from "../../db/index.ts";
+import { g, helpers, logEvent } from "../../util/index.ts";
+import type { Conditions, Player } from "../../../common/types.ts";
+
+// NFL history mod: real deaths on their real week. nflDeathWeeks is { leagueSeason: [[pid, week], ...] }; week 99 means
+// the offseason, handled at the draft. An active player is skipped until he has retired.
+// Died young or right after playing: the Tragic Deaths page, which lists "tragedy" events. Other deaths only make the
+// news for players people would know.
+export const logRealDeath = (p: Player, conditions?: Conditions) => {
+	const diedYear = p.diedYear as number;
+	const age = diedYear - p.born.year;
+	const tragic = age < 50 || diedYear - p.retiredYear <= 1;
+	const notable =
+		p.hof ||
+		Math.max(...p.ratings.map((r) => r.ovr)) >= 70 ||
+		p.statsTids.includes(g.get("userTid"));
+	if (!tragic && !notable) {
+		return;
+	}
+	logEvent(
+		{
+			type: tragic ? "tragedy" : "retired",
+			text: `<a href="${helpers.leagueUrl(["player", p.pid])}">${p.firstName} ${p.lastName}</a> died ${p.nflDeathCause ? `${p.nflDeathCause} ` : ""}at age ${age}.`,
+			showNotification: false,
+			pids: [p.pid],
+			score: 20,
+		},
+		conditions,
+	);
+};
+
+const runDeaths = async (maxWeek: number, conditions?: Conditions) => {
+	const seasonNow = g.get("season");
+	const list: [number, number][] | undefined = (g as any).nflDeathWeeks?.[
+		seasonNow
+	];
+	if (!list || (Object.hasOwn(g, "nflDeaths") && !g.get("nflDeaths"))) {
+		return;
+	}
+	for (const [pid, week] of list) {
+		if (week > maxWeek) {
+			continue;
+		}
+		const p = await idb.merged.players.get(pid);
+		if (!p || p.tid !== PLAYER.RETIRED || typeof p.diedYear === "number") {
+			continue;
+		}
+		p.diedYear = Math.max(p.nflDeath ?? seasonNow, p.retiredYear) - 1;
+		await idb.cache.players.put(p);
+		logRealDeath(p, conditions);
+	}
+};
+
+export const processWeeklyDeaths = async (conditions?: Conditions) => {
+	if (g.get("phase") !== PHASE.REGULAR_SEASON) {
+		return;
+	}
+	const schedule = await season.getSchedule();
+	const weeksLeft = new Set(schedule.map((game) => game.day)).size;
+	await runDeaths(Math.max(1, g.get("numGames") + 1 - weeksLeft), conditions);
+};
+
+export const processOffseasonDeaths = (conditions?: Conditions) =>
+	runDeaths(Infinity, conditions);
