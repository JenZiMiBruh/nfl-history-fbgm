@@ -0,0 +1,1193 @@
+// NFL history mod: the world around the field in the 3D view. Team benches with Gatorade coolers and tables, each
+// head coach in a headset in front of his bench, TV camera operators who follow the play along the near sideline,
+// photographers kneeling behind the end zones, and the chain gang on the far sideline holding the down markers at the
+// line of scrimmage and the line to gain.
+import * as THREE from "three";
+import { mergeGeometries } from "three/examples/jsm/utils/BufferGeometryUtils.js";
+import { generate } from "facesjs";
+import {
+	CARD_GEO,
+	cardMaterial,
+	cartoonFace,
+	drawCardBack,
+	drawCardFront,
+} from "./NflField3D.tsx";
+
+const W = 120;
+const H = 53.3;
+
+type Kind = "camera" | "photo" | "chain" | "coach";
+
+const shadeHex = (hex: string, amt: number) => {
+	const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
+	if (!m) return hex;
+	const n = parseInt(m[1]!, 16);
+	const f = (c: number) =>
+		Math.max(
+			0,
+			Math.min(255, Math.round(amt < 0 ? c * (1 + amt) : c + (255 - c) * amt)),
+		);
+	return `rgb(${f((n >> 16) & 255)},${f((n >> 8) & 255)},${f(n & 255)})`;
+};
+
+// A sideline person, drawn once on a canvas: khakis or dark pants, a polo or vest, a cap, and what he carries
+const drawPerson = (
+	kind: Kind,
+	shirt: string,
+	skin: string,
+	facing: 1 | -1,
+	face?: HTMLImageElement,
+) => {
+	if (face) return drawPersonFace(kind, shirt, skin, facing, face);
+	const c = document.createElement("canvas");
+	c.width = 128;
+	c.height = 192;
+	const g = c.getContext("2d")!;
+	g.lineCap = "round";
+	const cx = 64;
+	const kneel = kind === "photo";
+	const pants =
+		kind === "coach" ? "#1f2937" : kind === "chain" ? "#111827" : "#9a8a6a";
+	// Legs
+	g.strokeStyle = pants;
+	g.lineWidth = 18;
+	g.beginPath();
+	if (kneel) {
+		g.moveTo(cx - 10, 130);
+		g.lineTo(cx - 30, 160);
+		g.lineTo(cx - 10, 178);
+		g.moveTo(cx + 10, 130);
+		g.lineTo(cx + 18, 178);
+	} else {
+		g.moveTo(cx - 11, 120);
+		g.lineTo(cx - 13, 178);
+		g.moveTo(cx + 11, 120);
+		g.lineTo(cx + 13, 178);
+	}
+	g.stroke();
+	g.fillStyle = "#111111";
+	g.beginPath();
+	g.ellipse(cx - 12 + facing * 4, 182, 13, 6, 0, 0, Math.PI * 2);
+	g.ellipse(cx + 14 + facing * 4, 182, 13, 6, 0, 0, Math.PI * 2);
+	g.fill();
+	// Torso
+	const top = kneel ? 78 : 62;
+	const grad = g.createLinearGradient(cx - 30, 0, cx + 30, 0);
+	grad.addColorStop(0, shadeHex(shirt, -0.25));
+	grad.addColorStop(0.5, shirt);
+	grad.addColorStop(1, shadeHex(shirt, -0.3));
+	g.fillStyle = grad;
+	g.beginPath();
+	g.moveTo(cx - 26, top + 6);
+	g.quadraticCurveTo(cx, top - 4, cx + 26, top + 6);
+	g.lineTo(cx + 22, top + 62);
+	g.lineTo(cx - 22, top + 62);
+	g.closePath();
+	g.fill();
+	if (kind === "chain") {
+		// Reflective vest stripes
+		g.fillStyle = "#f97316";
+		g.fillRect(cx - 22, top + 20, 44, 7);
+		g.fillRect(cx - 22, top + 38, 44, 7);
+	}
+	// Arms and what they hold
+	g.strokeStyle = shadeHex(shirt, -0.15);
+	g.lineWidth = 13;
+	g.beginPath();
+	if (kind === "camera") {
+		g.moveTo(cx - 22, top + 12);
+		g.lineTo(cx - 8, top - 6);
+		g.moveTo(cx + 22, top + 12);
+		g.lineTo(cx + 10, top + 4);
+	} else if (kind === "photo") {
+		g.moveTo(cx - 22, top + 12);
+		g.lineTo(cx + facing * 14, top + 4);
+		g.moveTo(cx + 22, top + 12);
+		g.lineTo(cx + facing * 22, top + 10);
+	} else if (kind === "coach") {
+		g.moveTo(cx - 24, top + 12);
+		g.lineTo(cx - 26, top + 52);
+		g.moveTo(cx + 24, top + 12);
+		g.lineTo(cx + 18, top + 30);
+	} else {
+		g.moveTo(cx - 24, top + 12);
+		g.lineTo(cx - 30, top + 44);
+		g.moveTo(cx + 24, top + 12);
+		g.lineTo(cx + 30, top + 44);
+	}
+	g.stroke();
+	if (kind === "coach") {
+		// Play sheet
+		g.fillStyle = "#f8fafc";
+		g.fillRect(cx + 12, top + 22, 18, 24);
+		g.strokeStyle = "#ef4444";
+		g.lineWidth = 2;
+		g.strokeRect(cx + 12, top + 22, 18, 24);
+	}
+	// Head and cap
+	const hy = top - 18;
+	g.fillStyle = skin;
+	g.beginPath();
+	g.arc(cx, hy, 17, 0, Math.PI * 2);
+	g.fill();
+	g.fillStyle = "#111111";
+	g.beginPath();
+	g.arc(cx + facing * 6, hy - 2, 2.2, 0, Math.PI * 2);
+	g.fill();
+	g.fillStyle =
+		kind === "coach" ? shirt : kind === "chain" ? "#111111" : "#1e293b";
+	g.beginPath();
+	g.arc(cx, hy - 5, 17, Math.PI, Math.PI * 2);
+	g.fill();
+	g.fillRect(cx + (facing > 0 ? 0 : -24), hy - 7, 24, 5);
+	if (kind === "coach") {
+		// Headset
+		g.strokeStyle = "#111111";
+		g.lineWidth = 3;
+		g.beginPath();
+		g.arc(cx, hy - 2, 19, Math.PI * 1.1, Math.PI * 1.9);
+		g.stroke();
+		g.fillStyle = "#111111";
+		g.fillRect(cx - 21, hy - 4, 6, 10);
+		g.beginPath();
+		g.moveTo(cx - 18, hy + 6);
+		g.lineTo(cx + facing * 8, hy + 12);
+		g.stroke();
+	}
+	if (kind === "camera") {
+		// Broadcast camera on the shoulder, lens toward the field
+		g.fillStyle = "#1f2937";
+		g.fillRect(cx - 20, hy - 6, 40, 20);
+		g.fillStyle = "#0f172a";
+		g.beginPath();
+		g.arc(cx, hy + 4, 8, 0, Math.PI * 2);
+		g.fill();
+		g.fillStyle = "#38bdf8";
+		g.beginPath();
+		g.arc(cx, hy + 4, 4, 0, Math.PI * 2);
+		g.fill();
+		g.fillStyle = "#ef4444";
+		g.fillRect(cx + 14, hy - 4, 4, 4);
+	}
+	if (kind === "photo") {
+		// Long lens
+		g.fillStyle = "#e5e7eb";
+		g.fillRect(cx + (facing > 0 ? 8 : -40), top + 2, 32, 9);
+		g.fillStyle = "#111111";
+		g.fillRect(cx - 6, top - 2, 14, 14);
+	}
+	return c;
+};
+
+// A sideline person in the same cartoon style as the players: the face picture on top, then the shirt, pants, shoes,
+// and what he carries (camera, long lens, chain pole, play sheet and headset)
+const drawPersonFace = (
+	kind: Kind,
+	shirt: string,
+	skin: string,
+	facing: 1 | -1,
+	face: HTMLImageElement,
+) => {
+	const c = document.createElement("canvas");
+	c.width = 128;
+	c.height = 192;
+	const g = c.getContext("2d")!;
+	g.lineCap = "round";
+	g.lineJoin = "round";
+	const OUTL = "#1a1a1a";
+	const cx = 64;
+	const kneel = kind === "photo";
+	const pants =
+		kind === "coach" ? "#1f2937" : kind === "chain" ? "#111827" : "#9a8a6a";
+	const bw = 92;
+	const bh = 138;
+	const top = kneel ? 22 : 4;
+	// Legs
+	const legs = (x0: number, x1: number, y1: number) => {
+		g.strokeStyle = OUTL;
+		g.lineWidth = 19;
+		g.beginPath();
+		g.moveTo(x0, top + 150);
+		g.lineTo(x1, y1);
+		g.stroke();
+		g.strokeStyle = pants;
+		g.lineWidth = 13;
+		g.beginPath();
+		g.moveTo(x0, top + 150);
+		g.lineTo(x1, y1);
+		g.stroke();
+		g.fillStyle = OUTL;
+		g.beginPath();
+		g.ellipse(x1 + facing * 4, y1 + 3, 11, 5, 0, 0, Math.PI * 2);
+		g.fill();
+	};
+	if (kneel) {
+		legs(cx - 10, cx - 22, 184);
+		legs(cx + 10, cx + 16, 184);
+	} else {
+		legs(cx - 10, cx - 11, 184);
+		legs(cx + 10, cx + 11, 184);
+	}
+	// Shirt below the picture's shoulders
+	g.fillStyle = shirt;
+	g.strokeStyle = OUTL;
+	g.lineWidth = 3.5;
+	g.beginPath();
+	g.moveTo(cx - bw / 2 + 4, top + 128);
+	g.lineTo(cx + bw / 2 - 4, top + 128);
+	g.lineTo(cx + 28, top + 156);
+	g.lineTo(cx - 28, top + 156);
+	g.closePath();
+	g.fill();
+	g.stroke();
+	if (kind === "chain") {
+		g.fillStyle = "#f97316";
+		g.fillRect(cx - 30, top + 136, 60, 6);
+		g.fillRect(cx - 28, top + 147, 56, 5);
+	}
+	g.drawImage(
+		face,
+		0,
+		0,
+		face.naturalWidth || 400,
+		face.naturalHeight || 600,
+		cx - bw / 2,
+		top,
+		bw,
+		bh,
+	);
+	// Arms and gear
+	const arm = (sx: number, ex: number, ey: number) => {
+		g.strokeStyle = OUTL;
+		g.lineWidth = 15;
+		g.beginPath();
+		g.moveTo(sx, top + 126);
+		g.lineTo(ex, ey);
+		g.stroke();
+		g.strokeStyle = shirt;
+		g.lineWidth = 10;
+		g.beginPath();
+		g.moveTo(sx, top + 126);
+		g.lineTo(sx + (ex - sx) * 0.6, top + 126 + (ey - top - 126) * 0.6);
+		g.stroke();
+		g.strokeStyle = skin;
+		g.beginPath();
+		g.moveTo(sx + (ex - sx) * 0.6, top + 126 + (ey - top - 126) * 0.6);
+		g.lineTo(ex, ey);
+		g.stroke();
+	};
+	if (kind === "camera") {
+		arm(cx - 40, cx - 26, top + 66);
+		arm(cx + 40, cx + 22, top + 104);
+		// Shoulder camera beside the head
+		g.fillStyle = "#1f2937";
+		g.strokeStyle = OUTL;
+		g.lineWidth = 3;
+		const camX = cx - facing * 34;
+		g.fillRect(camX - 22, top + 46, 44, 26);
+		g.strokeRect(camX - 22, top + 46, 44, 26);
+		g.fillStyle = "#0f172a";
+		g.fillRect(camX + facing * 22 - (facing > 0 ? 0 : 14), top + 50, 14, 18);
+		g.fillStyle = "#ef4444";
+		g.fillRect(camX - facing * 16, top + 49, 5, 5);
+	} else if (kind === "photo") {
+		arm(cx - 40, cx + facing * 18, top + 112);
+		arm(cx + 40, cx + facing * 30, top + 116);
+		g.fillStyle = "#e5e7eb";
+		g.strokeStyle = OUTL;
+		g.lineWidth = 2.5;
+		g.fillRect(cx + (facing > 0 ? 16 : -56), top + 104, 40, 11);
+		g.strokeRect(cx + (facing > 0 ? 16 : -56), top + 104, 40, 11);
+	} else if (kind === "coach") {
+		arm(cx - 40, cx - 42, top + 170);
+		arm(cx + 40, cx + 30, top + 150);
+		g.fillStyle = "#f8fafc";
+		g.strokeStyle = "#ef4444";
+		g.lineWidth = 2;
+		g.fillRect(cx + 22, top + 134, 20, 26);
+		g.strokeRect(cx + 22, top + 134, 20, 26);
+		// Headset over the head
+		g.strokeStyle = OUTL;
+		g.lineWidth = 4;
+		g.beginPath();
+		g.arc(cx, top + 62, 38, Math.PI * 1.08, Math.PI * 1.92);
+		g.stroke();
+		g.fillStyle = OUTL;
+		g.fillRect(cx - 40, top + 56, 9, 16);
+		g.fillRect(cx + 31, top + 56, 9, 16);
+	} else {
+		arm(cx - 40, cx - 44, top + 168);
+		arm(cx + 40, cx + 44, top + 168);
+	}
+	return c;
+};
+
+const SKINS = [
+	"#f1c7a5",
+	"#d9a37c",
+	"#a8703f",
+	"#7b4a2a",
+	"#e8b896",
+	"#5b3a24",
+];
+
+type Person = {
+	sprite: THREE.Object3D;
+	kind: Kind;
+	x: number;
+	z: number;
+	tx: number;
+	base: number;
+};
+
+export class Sideline {
+	group = new THREE.Group();
+	people: Person[] = [];
+	benches: THREE.Mesh[] = [];
+	poles: THREE.Mesh[] = [];
+	chain: THREE.Mesh;
+	marker: THREE.Mesh;
+	built = "";
+	// Pylons: knocked over when a player runs into one during a play, stood back up between plays
+	pylons: { m: THREE.Mesh; x: number; z: number; fall: number; dir: number }[] =
+		[];
+
+	constructor(scene: THREE.Scene) {
+		scene.add(this.group);
+		const poleMat = new THREE.MeshStandardMaterial({
+			color: "#f97316",
+			roughness: 0.5,
+		});
+		for (let i = 0; i < 2; i++) {
+			const pole = new THREE.Mesh(
+				new THREE.CylinderGeometry(0.06, 0.06, 2.4),
+				poleMat,
+			);
+			pole.castShadow = false; /* (static props: no shadow pass; see the performance note in NflField3D) */
+			const cap = new THREE.Mesh(
+				new THREE.BoxGeometry(0.5, 0.35, 0.08),
+				new THREE.MeshStandardMaterial({ color: "#facc15" }),
+			);
+			cap.position.y = 1.2;
+			pole.add(cap);
+			this.group.add(pole);
+			this.poles.push(pole);
+		}
+		this.chain = new THREE.Mesh(
+			new THREE.BoxGeometry(10, 0.04, 0.04),
+			new THREE.MeshStandardMaterial({
+				color: "#d1d5db",
+				metalness: 0.7,
+				roughness: 0.4,
+			}),
+		);
+		this.group.add(this.chain);
+		// The down box (shows the down)
+		this.marker = new THREE.Mesh(
+			new THREE.CylinderGeometry(0.06, 0.06, 2.6),
+			poleMat,
+		);
