+			? shade(shellC, -0.3)
+			: stripeC;
+	g.lineWidth = 9;
+	g.beginPath();
+	g.ellipse(
+		sx + f * r * 0.05,
+		cy + r * 0.25,
+		r * 0.95,
+		r * 1.25,
+		f * 0.35,
+		Math.PI * 1.05,
+		Math.PI * 1.6,
+	);
+	g.stroke();
+	// The logo (or the number) on the side
+	const lx = sx - f * r * 0.3;
+	const ly = cy + r * 0.05;
+	if (logo && logo.complete && logo.naturalWidth) {
+		const lw = r * 0.95;
+		const lh = (lw * logo.naturalHeight) / logo.naturalWidth;
