+							onClick={() => vote(o.id)}
+							className="text-start"
+							style={{
+								position: "relative",
+								overflow: "hidden",
+								display: "flex",
+								alignItems: "center",
+								gap: 10,
+								padding: "9px 12px",
+								borderRadius: 8,
