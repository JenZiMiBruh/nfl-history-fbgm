+		g.lineWidth = 5;
+		g.beginPath();
+		g.moveTo(cx - 62, 112);
+		g.quadraticCurveTo(cx - 48, 100, cx - 34, 102);
+		g.moveTo(cx + 62, 112);
+		g.quadraticCurveTo(cx + 48, 100, cx + 34, 102);
+		g.stroke();
+		if (o.num) {
+			g.font = '900 56px "Arial Black", Impact, Arial, sans-serif';
+			g.textAlign = "center";
+			g.textBaseline = "middle";
+			g.lineWidth = 7;
