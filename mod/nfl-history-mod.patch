new file mode 100644
index 000000000..e0d9ed08c
--- /dev/null
+++ b/tools/native/noIntlRegex.ts
@@ -0,0 +1,31 @@
+// The Android V8 build has no ICU, so regexes with Unicode property escapes (\p{...}) don't compile. Swap the
+// three the engine uses for plain character ranges. Each replacement must match, so a library update that changes
+// them fails the build instead of shipping a broken engine.
+const REPLACEMENTS: [from: string, to: string][] = [
+	// Award prefixes: first letter of each word ("Most Valuable Player" -> "MVP")
+	[String.raw`/\b\p{L}/gu`, String.raw`/\b[A-Za-zÀ-ÖØ-öø-ɏ]/g`],
+	// Search: strip accents after NFD splits them off as combining marks
+	[String.raw`/\p{Diacritic}/gu`, String.raw`/[̀-ͯ]/g`],
+	// Library check for non-ASCII text
+	[String.raw`/\P{ASCII}/u`, String.raw`/[^\x00-\x7F]/`],
+	// Emoji check (built from a string, so the backslashes are doubled)
+	[String.raw`\\p{Extended_Pictographic}`, String.raw`\\u{1F000}-\\u{1FAFF}\\u2600-\\u27BF\\u2B00-\\u2BFF`],
+	[String.raw`\\p{Regional_Indicator}`, String.raw`\\u{1F1E6}-\\u{1F1FF}`],
+	[String.raw`\\p{Emoji_Component}`, String.raw`\\u{1F3FB}-\\u{1F3FF}\\u200D\\uFE0F\\u20E3#*0-9\\u{E0020}-\\u{E007F}\\u{1F1E6}-\\u{1F1FF}`],
+];
+
+export const removeUnicodePropertyEscapes = (code: string) => {
+	let out = code;
+	for (const [from, to] of REPLACEMENTS) {
+		if (!out.includes(from)) {
+			throw new Error(`noIntlRegex: pattern not found: ${from}`);
+		}
+		out = out.split(from).join(to);
+	}
+	// \p{...} and \P{...} (negated), in regex literals or strings
+	const left = out.match(/\\\\?[pP]\{[A-Za-z_=]+\}/);
+	if (left) {
+		throw new Error(`noIntlRegex: unhandled Unicode property escape: ${left[0]}`);
+	}
+	return out;
+};
diff --git a/tools/native/shims.ts b/tools/native/shims.ts
new file mode 100644
index 000000000..10d8eece2
--- /dev/null
+++ b/tools/native/shims.ts
@@ -0,0 +1,584 @@
+// Gridiron Almanac native engine: browser features Football GM's worker needs, for a bare V8 with no browser.
+// The app (Kotlin, or tools/native/harness.ts on a PC) provides globalThis.__host:
+//   setTimer(id, ms) / clearTimer(id)     the app calls __engine.fireTimer(id) when a timer is due
+//   post(json)                            a message from the engine to the app
+//   log(level, text)
+//   readText(path) -> string | null       bundled files (name lists)
+//   fileSize(path) -> number, readBytes(path, offset, length) -> Uint8Array   league files
+// and calls __engine.receive(json) to send the engine a message.
+import {
+	ReadableStream,
+	TransformStream,
+	WritableStream,
+	ByteLengthQueuingStrategy,
+	CountQueuingStrategy,
+} from "web-streams-polyfill";
+
+type Host = {
+	setTimer(id: number, ms: number): void;
+	clearTimer(id: number): void;
+	post(json: string): void;
+	log(level: string, text: string): void;
+	readText(path: string): string | null;
+	fileSize(path: string): number;
+	readBytes(path: string, offset: number, length: number): Uint8Array;
+};
+
+const g = globalThis as any;
+const host: Host = g.__host;
+
+g.self = g;
+g.window = undefined;
+
+// ---------------------------------------------------------------- console
+const fmt = (args: unknown[]) =>
+	args
+		.map((a) => {
+			if (typeof a === "string") return a;
+			if (a instanceof Error || (a && typeof a === "object" && "message" in (a as any))) {
+				const e = a as any;
+				return `${e.name ?? e.constructor?.name}: ${e.message}\n${e.stack ?? ""}`;
+			}
+			if (a && typeof a === "object") {
+				const o = a as any;
