+// The player drawn the way Football GM draws him: his face picture (head, neck and shoulders in a football jersey,
+// in his uniform's colors) is the top of the body, and the rest continues below it in the same flat cartoon style
+// with the same dark outline: the bottom of the jersey with his number, pants, socks, cleats and arms.
+const OUT = "#1a1a1a";
+const drawBust = (
+	g: CanvasRenderingContext2D,
+	o: DrawOpts,
+	face: HTMLImageElement,
