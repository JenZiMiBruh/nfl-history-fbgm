+	const j = atSeason(JERSEYS[tid], realSeason);
+	const n = atSeason(NUMBERS[tid], realSeason);
+	if (!j || !n) {
+		return undefined;
+	}
+	return {
+		body: j[1],
+		stripe1: j[2],
+		stripe2: j[3],
+		numberFill: n[1],
+		numberOutline: n[2],
+		numberInner:
+			((n as unknown[])[3] as string | null | undefined) ?? undefined,
+		outlineScale: (n as unknown[])[4] as number | undefined,
+		font: atSeason(FONTS[tid], realSeason)?.[1] ?? "block",
+		sleeve: atSeason(STYLES[tid], realSeason)?.[1] ?? "stripes",
+		sides: atSeason(STYLES[tid], realSeason)?.[2] ?? "none",
+		cut:
+			realSeason < 1985 ? "classic" : realSeason < 2012 ? "nineties" : "modern",
+		nameOnBack: realSeason >= 1970 || AFL.has(tid),
+		numberGradient: (() => {
+			const g = atSeason(GRADIENTS[tid], realSeason);
+			return g &&
+				realSeason >= g[0] &&
+				realSeason < (GRADIENT_END[tid] ?? Infinity)
+				? ([g[1], g[2]] as [string, string])
+				: undefined;
+		})(),
+		sleeveMark: (() => {
+			const forced = atSeason(SLEEVE_MARKS[tid], realSeason);
+			if (forced && realSeason >= forced[0]) {
+				return forced[1];
+			}
+			const sleeve = atSeason(STYLES[tid], realSeason)?.[1] ?? "stripes";
+			if ((sleeve === "plain" || sleeve === "cuffs") && realSeason >= 1995) {
+				return "logo";
+			}
