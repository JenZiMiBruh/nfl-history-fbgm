+					style={{
+						position: "absolute",
+						inset: 0,
+						zIndex: 5,
+						background:
+							"radial-gradient(ellipse at center, #1b2436, #05070c 75%)",
+						opacity: coverOp,
+						display: "flex",
+						alignItems: "center",
+						justifyContent: "center",
+						color: "#cbd5e1",
+						fontWeight: 700,
+						letterSpacing: 3,
