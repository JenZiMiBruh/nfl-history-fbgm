+					}}
+				/>
+			) : null}
+			{bits.map((b, i) => (
+				<span
+					key={i}
+					style={{
+						position: "absolute",
+						top: -20,
+						left: `${b.left}%`,
+						fontSize: b.size + 8,
+						color: "#ffffff",
+						opacity: 0.85,
+						animation: `nfli-fall ${b.dur + 2}s linear ${b.delay}s infinite`,
+					}}
+				>
+					{piece(i)}
+				</span>
+			))}
+		</div>
+	);
+};
