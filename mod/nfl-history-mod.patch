+					<Tap b={b}>
+						<div
+							className="d-flex align-items-center px-2"
+							style={{
+								background:
+									"repeating-linear-gradient(135deg, #b91c1c 0 8px, #ffffff 8px 16px)",
+								minWidth: 90,
+								justifyContent: "center",
+							}}
+						>
+							<span
+								style={{
+									background: "rgba(255,255,255,.94)",
+									color: "#14532d",
+									borderRadius: 3,
+									padding: "1px 7px",
+									fontFamily: f,
+									fontWeight: 700,
+									lineHeight: 1.05,
+									textAlign: "center",
+								}}
+							>
+								<span style={{ fontSize: ".68rem", display: "block" }}>
+									{b.gameOver ? "" : b.quarter}
+								</span>
+								<span
+									style={{
+										fontSize: "1.1rem",
+										fontVariantNumeric: "tabular-nums",
+									}}
+								>
+									{b.gameOver ? "FINAL" : b.time}
+								</span>
+							</span>
+						</div>
+						{down ? (
+							<div
+								className="d-flex align-items-center px-3"
+								style={{
+									background: b.redZone ? "#b91c1c" : "#14532d",
+									color: "#fde68a",
+									fontFamily: f,
+									fontWeight: 700,
+									fontSize: ".9rem",
+									whiteSpace: "nowrap",
+								}}
+							>
+								{down}
+							</div>
+						) : null}
+					</Tap>
+				</div>
+				<div
+					className="d-flex align-items-center"
+					style={{
+						background: "#7f1d1d",
+						color: "#fde68a",
+						fontFamily: f,
+						fontSize: ".72rem",
+						letterSpacing: 1,
+						fontWeight: 600,
+					}}
+				>
+					<span className="px-2">🎄 {b.p.name.toUpperCase()}</span>
+					<span className="px-2" style={{ opacity: 0.85 }}>
+						{weatherText(b.info)}
+					</span>
+				</div>
+			</div>
+		</div>
+	);
+}
