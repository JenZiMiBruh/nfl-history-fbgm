+				delay: (i * 0.29) % 4,
+				dur: 3 + ((i * 7) % 5) * 0.6,
+				size: 6 + ((i * 13) % 4) * 3,
+				rot: (i * 47) % 360,
+			})),
+		[],
+	);
+	if (!kind) return null;
+	if (kind === "fireworks" || kind === "sb") {
+		return (
+			<div
+				style={{
+					position: "absolute",
+					inset: 0,
+					pointerEvents: "none",
+					overflow: "hidden",
+				}}
+			>
+				{Array.from({ length: 6 }, (_, i) => (
+					<span
+						key={i}
+						style={{
+							position: "absolute",
+							left: `${12 + i * 15}%`,
+							top: `${12 + ((i * 23) % 30)}%`,
