+				))}
+				<text x="20" y="24.5" textAnchor="middle" fontFamily="'Arial Black',Impact,sans-serif" fontWeight="900" fontSize="13" fill="#fff" letterSpacing="-0.4">
+					NFL
+				</text>
+			</>
+		)}
