+	const numColor =
+		side?.num ??
+		(o.away ? P : readableOn(jersey) === "#ffffff" ? "#ffffff" : "#111111");
+	const cx = SPR_W / 2;
+	g.lineCap = "round";
+	g.lineJoin = "round";
+	// Where the face picture sits: 400x600 drawn 132 wide from the top; its shoulders end at y=198
+	const bw = 132;
+	const bh = 198;
+	const bx = cx - bw / 2;
+	// ---- Legs (behind everything) ----
+	const swing = [0, 0.34, 0, -0.34][o.stride ?? 0]!;
+	const leg = (hipX: number, a: number) => {
+		const kneeX = hipX + Math.sin(a) * 18;
+		const footX = kneeX + Math.sin(a * 0.5) * 6;
+		const footY = 280 - (a < 0 ? 5 : 0);
+		g.strokeStyle = OUT;
+		g.lineWidth = 26;
+		g.beginPath();
+		g.moveTo(hipX, 238);
+		g.lineTo(kneeX, 258);
+		g.lineTo(footX, footY);
+		g.stroke();
+		g.strokeStyle = pants;
+		g.lineWidth = 20;
+		g.beginPath();
+		g.moveTo(hipX, 238);
+		g.lineTo(kneeX, 258);
+		g.stroke();
+		g.strokeStyle = sock;
+		g.lineWidth = 17;
+		g.beginPath();
+		g.moveTo(kneeX, 260);
+		g.lineTo(footX, footY - 2);
+		g.stroke();
+		g.fillStyle = OUT;
+		g.beginPath();
+		g.ellipse(footX + f * 5, footY + 3, 14, 6.5, 0, 0, Math.PI * 2);
+		g.fill();
+	};
