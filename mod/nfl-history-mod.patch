+
+	// Labels and callouts drawn in HTML over the 3D view, so they stay sharp
+	const w = wrap.current?.clientWidth ?? 800;
+	const h = Math.round(w * 0.56);
+	// Tags under the players: just the key players (default), or everyone on the field with numbers, names or both
+	const tagMode = (() => {
+		try {
+			return (localStorage.getItem("nflTags") ?? "key") as
+				| "key"
+				| "num"
