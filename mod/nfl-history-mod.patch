+							textShadow: "0 2px 12px rgba(0,0,0,.55)",
+							animation: "nflc-in .5s ease-out .25s both",
+							...font(type),
+						}}
+					>
+						{ad.beats[step - 1]}
+					</div>
+				</div>
+			) : (
+				// The end card: mark, brand, tagline, web address
+				<div
+					style={{
+						position: "absolute",
+						inset: 0,
+						display: "flex",
+						flexDirection: "column",
+						alignItems: "center",
+						justifyContent: "center",
+						gap: 10,
+						background: `linear-gradient(160deg, ${mid}, ${dark} 70%)`,
+						animation: "nflc-fade .4s ease-out both",
+						textAlign: "center",
+						padding: "0 24px",
+					}}
+				>
+					<div style={{ animation: "nflc-in .5s ease-out both" }}>
+						<Mark ad={ad} size={64} />
+					</div>
+					<div
+						style={{
+							position: "relative",
+							overflow: "hidden",
+							fontSize: "clamp(26px, 6vw, 52px)",
+							lineHeight: 1.05,
+							animation: "nflc-in .5s ease-out .1s both",
+							...font(type),
+						}}
+					>
+						{ad.brand}
+						<span
+							style={{
+								position: "absolute",
+								top: 0,
+								bottom: 0,
+								left: 0,
+								width: "25%",
+								background:
+									"linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent)",
+								animation: "nflc-sweep 1.4s ease-in-out .6s both",
+							}}
+						/>
+					</div>
+					<div
+						style={{
+							fontSize: "clamp(14px, 2.6vw, 22px)",
+							opacity: 0.92,
+							animation: "nflc-in .5s ease-out .35s both",
+							fontFamily: "Arial, Helvetica, sans-serif",
+						}}
+					>
+						{ad.line}
+					</div>
+					<div
+						style={{
+							marginTop: 4,
+							fontSize: 13,
+							letterSpacing: 1,
+							opacity: 0.7,
+							animation: "nflc-in .5s ease-out .55s both",
+							fontFamily: "Arial, Helvetica, sans-serif",
+						}}
+					>
+						{ad.url}
+					</div>
+				</div>
+			)}
+			{step > 0 ? (
+				<div
+					style={{
+						position: "absolute",
+						left: 12,
+						right: 12,
+						bottom: 6,
+						fontSize: 9,
+						opacity: 0.6,
+						fontFamily: "Arial, sans-serif",
+						textAlign: "center",
+					}}
+				>
+					{ad.fine}
+				</div>
+			) : null}
+			{film && step > 0 ? (
+				// (an older game: a little film grain and a soft vignette)
+				<div
+					aria-hidden="true"
+					style={{
+						position: "absolute",
+						inset: 0,
+						pointerEvents: "none",
+						background:
+							"radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,.45)), repeating-linear-gradient(0deg, rgba(255,255,255,.03) 0 1px, transparent 1px 3px)",
+					}}
+				/>
+			) : null}
+		</div>
+	);
+};
diff --git a/src/ui/views/LiveGame/NflCrew.ts b/src/ui/views/LiveGame/NflCrew.ts
