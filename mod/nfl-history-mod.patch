+	const leg = (hipX: number, a: number) => {
+		const kneeX = hipX + Math.sin(a) * 30;
+		const kneeY = 238 - Math.abs(Math.sin(a)) * 4;
+		const footX = kneeX + Math.sin(a * 0.4) * 10 - (a > 0 ? 6 : 0);
+		const footY = 272 - (a < 0 ? 8 : 0);
+		g.strokeStyle = shade(pants, -0.08);
+		g.lineWidth = 30;
+		g.beginPath();
+		g.moveTo(hipX, 204);
+		g.lineTo(kneeX, kneeY);
+		g.stroke();
+		g.strokeStyle = sock;
+		g.lineWidth = 21;
+		g.beginPath();
+		g.moveTo(kneeX, kneeY + 6);
+		g.lineTo(footX, footY);
+		g.stroke();
+		g.strokeStyle = "#ffffff";
+		g.beginPath();
+		g.moveTo(footX + (kneeX - footX) * 0.22, footY - 9);
+		g.lineTo(footX, footY);
+		g.stroke();
