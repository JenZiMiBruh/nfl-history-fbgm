+// NFL history mod: the bowl around the field in the 3D view. Team-colored fascia bands between the decks, upper decks
+// behind both end zones, a roof canopy along the top, light towers (glowing at night), a video board showing the
+// matchup, a dome ceiling for indoor stadiums, and a crowd that is drawn seat by seat in the home team's colors and
+// jumps up (arms raised) on big plays.
+import * as THREE from "three";
+
+const W = 120;
+const H = 53.3;
+const MID = H / 2;
+
+const canvas = (w: number, h: number) => {
+	const c = document.createElement("canvas");
+	c.width = w;
+	c.height = h;
+	return c;
+};
+
+const shadeHex = (hex: string, amt: number) => {
+	const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
+	if (!m) return hex;
+	const n = parseInt(m[1]!, 16);
+	const f = (c: number) =>
+		Math.max(
+			0,
+			Math.min(255, Math.round(amt < 0 ? c * (1 + amt) : c + (255 - c) * amt)),
+		);
+	return `rgb(${f((n >> 16) & 255)},${f((n >> 8) & 255)},${f(n & 255)})`;
+};
+
+// A section of the crowd, seat by seat: seat rows in the team colors, fans in jerseys and shirts, some empty seats,
+// now and then a sign. `excited`: everyone standing with arms up.
+export const crowdSection = (
+	colors: string[],
+	seed: number,
+	excited: boolean,
+) => {
+	const c = canvas(1024, 384);
+	const g = c.getContext("2d")!;
+	let r = seed;
+	const rand = () => (r = (r * 9301 + 49297) % 233280) / 233280;
+	const skins = [
+		"#f1c9a5",
+		"#e0ac83",
+		"#c68642",
+		"#8d5524",
+		"#5c3a21",
+		"#f5d0b5",
+	];
+	const seatA = shadeHex(colors[0] ?? "#334155", -0.45);
+	const seatB = shadeHex(colors[0] ?? "#334155", -0.6);
+	g.fillStyle = "#11151c";
+	g.fillRect(0, 0, c.width, c.height);
+	const rows = 12;
+	const rowH = c.height / rows;
+	for (let row = 0; row < rows; row++) {
+		const y0 = row * rowH;
+		// The seat row and its riser
+		g.fillStyle = row % 2 ? seatA : seatB;
+		g.fillRect(0, y0 + rowH * 0.55, c.width, rowH * 0.45);
+		g.fillStyle = "rgba(0,0,0,.35)";
+		g.fillRect(0, y0 + rowH * 0.92, c.width, rowH * 0.08);
+		const n = 56;
+		for (let i = 0; i < n; i++) {
+			// An aisle every 14 seats
+			if (i % 14 === 13) {
+				g.fillStyle = "#3b4250";
+				g.fillRect((i / n) * c.width, y0, c.width / n, rowH);
+				continue;
+			}
+			if (rand() < 0.07) continue; // empty seat
+			const x = ((i + 0.5) / n) * c.width + (row % 2) * 3;
+			const standing = excited ? rand() < 0.9 : rand() < 0.12;
+			const head = y0 + rowH * (standing ? 0.18 : 0.34);
+			const shirtRoll = rand();
+			const shirt =
+				shirtRoll < 0.58
+					? colors[0]!
+					: shirtRoll < 0.78
+						? (colors[1] ?? "#ffffff")
+						: ["#cbd5e1", "#334155", "#e2e8f0", "#111827"][
+								Math.floor(rand() * 4)
+							]!;
+			// Body
+			g.fillStyle = shirt;
+			g.beginPath();
+			g.ellipse(
+				x,
+				head + rowH * 0.32,
+				7,
+				rowH * (standing ? 0.3 : 0.22),
+				0,
+				0,
+				Math.PI * 2,
+			);
+			g.fill();
+			// Arms up when excited (or a few fans at any time)
+			if (excited || rand() < 0.04) {
+				g.strokeStyle = shirt;
+				g.lineWidth = 3;
+				g.beginPath();
+				g.moveTo(x - 5, head + 6);
+				g.lineTo(x - 9, head - 8);
+				g.moveTo(x + 5, head + 6);
+				g.lineTo(x + 9, head - 8);
+				g.stroke();
+			}
+			// Head and maybe a cap
+			g.fillStyle = skins[Math.floor(rand() * skins.length)]!;
+			g.beginPath();
+			g.arc(x, head, 4.5, 0, Math.PI * 2);
+			g.fill();
+			if (rand() < 0.18) {
+				g.fillStyle = shirt;
+				g.fillRect(x - 5, head - 6, 10, 3);
+			}
+		}
+		// Now and then a sign held up
+		if (rand() < 0.12) {
+			const sx = rand() * (c.width - 60);
+			g.fillStyle = rand() < 0.5 ? "#ffffff" : (colors[1] ?? "#ffffff");
+			g.fillRect(sx, y0 + 2, 44, rowH * 0.45);
+			g.fillStyle = colors[0] ?? "#111111";
+			g.font = "bold 9px Arial";
+			g.fillText(
+				["GO!", "D-FENSE", "#1", "LET'S GO", "MVP"][Math.floor(rand() * 5)]!,
+				sx + 4,
+				y0 + rowH * 0.32,
+			);
+		}
+	}
+	const tex = new THREE.CanvasTexture(c);
+	tex.colorSpace = THREE.SRGBColorSpace;
+	tex.wrapS = THREE.RepeatWrapping;
+	tex.wrapT = THREE.RepeatWrapping;
+	tex.anisotropy = 4;
+	return tex;
+};
+
+type Look = {
+	home: { abbrev: string; region: string; name: string; colors: string[] };
+	away: { abbrev: string; colors: string[] };
+	night: boolean;
+	indoors: boolean;
+	stadium?: string;
+};
+
+export class StadiumDecor {
+	group = new THREE.Group();
+	glows: THREE.Sprite[] = [];
+	lamps: THREE.Mesh[] = [];
+	board?: THREE.Mesh;
+	built = "";
+
+	constructor(scene: THREE.Scene) {
+		scene.add(this.group);
+	}
+
+	configure(l: Look) {
+		const sig = `${l.home.abbrev}|${l.away.abbrev}|${l.home.colors.join()}|${l.night}|${l.indoors}`;
+		if (sig === this.built) return;
+		this.built = sig;
+		for (const ch of [...this.group.children]) this.group.remove(ch);
+		this.glows = [];
+		this.lamps = [];
+		const P = l.home.colors[0] ?? "#334155";
+		const S = l.home.colors[1] ?? "#ffffff";
+		const mat = (
+			color: string,
+			extra: Partial<THREE.MeshStandardMaterialParameters> = {},
+		) => new THREE.MeshStandardMaterial({ color, roughness: 0.8, ...extra });
+
+		// Fascia bands between the decks along the far side, in the home colors, with the stadium name
+		const fascia = (y: number, z: number, len: number) => {
+			const c = canvas(2048, 64);
+			const g = c.getContext("2d")!;
+			g.fillStyle = shadeHex(P, -0.2);
+			g.fillRect(0, 0, c.width, c.height);
+			g.fillStyle = S;
+			g.fillRect(0, 0, c.width, 6);
+			g.fillRect(0, c.height - 6, c.width, 6);
+			g.font = "900 34px Arial Black, Arial";
+			g.textAlign = "center";
+			g.textBaseline = "middle";
+			const text = `${(l.stadium ?? `${l.home.region} ${l.home.name}`).toUpperCase()}`;
+			for (const x of [256, 1024, 1792]) g.fillText(text, x, 34, 700);
+			const tex = new THREE.CanvasTexture(c);
+			tex.colorSpace = THREE.SRGBColorSpace;
+			const m = new THREE.Mesh(new THREE.BoxGeometry(len, 1.8, 0.6), [
+				mat(P),
+				mat(P),
+				mat(P),
+				mat(P),
+				new THREE.MeshStandardMaterial({ map: tex, roughness: 0.6 }),
+				mat(P),
+			]);
+			m.position.set(W / 2, y, z);
+			this.group.add(m);
+		};
+		fascia(18.8, -21.5, W + 50);
+		fascia(39, -45, W + 80);
+
+		// Upper decks behind both end zones
+		const deck = (x: number, rotY: number) => {
+			const tex = crowdSection(l.home.colors, Math.round(x * 7 + 3), false);
+			tex.repeat.set(4, 1.5);
+			const m = new THREE.Mesh(
+				new THREE.PlaneGeometry(H + 50, 30),
+				new THREE.MeshStandardMaterial({ map: tex, roughness: 0.9 }),
+			);
+			m.position.set(x, 26, MID);
+			m.rotation.order = "YXZ";
+			m.rotation.y = rotY;
+			m.rotation.x = -0.75;
+			m.userData.crowd = {
+				colors: l.home.colors,
+				seed: Math.round(x * 7 + 3),
+				repeat: [4, 1.5],
+			};
+			this.group.add(m);
+		};
+		deck(-38, Math.PI / 2);
+		deck(W + 38, -Math.PI / 2);
+
+		// Roof canopy along the top of the far stands
+		const roof = new THREE.Mesh(
+			new THREE.BoxGeometry(W + 110, 1.2, 18),
+			mat("#1f2430", { metalness: 0.4 }),
+		);
+		roof.position.set(W / 2, 55, -58);
+		this.group.add(roof);
+
+		// Light towers on the corners of the far side and the ends
+		for (const [x, z] of [
+			[-30, -40],
+			[W + 30, -40],
+			[-48, MID + 20],
+			[W + 48, MID + 20],
+		] as [number, number][]) {
+			const pole = new THREE.Mesh(
+				new THREE.CylinderGeometry(0.6, 0.9, 64),
+				mat("#3b4250", { metalness: 0.5 }),
+			);
+			pole.position.set(x, 32, z);
+			this.group.add(pole);
+			const bank = new THREE.Mesh(
+				new THREE.BoxGeometry(9, 5, 1),
+				new THREE.MeshStandardMaterial({
+					color: "#e5e7eb",
+					emissive: l.night ? "#fff7d6" : "#000000",
+					emissiveIntensity: l.night ? 1.4 : 0,
+					roughness: 0.4,
+				}),
+			);
+			bank.position.set(x, 64, z);
+			bank.lookAt(W / 2, 0, MID);
+			this.group.add(bank);
+			this.lamps.push(bank);
+			if (l.night && !l.indoors) {
+				const glow = new THREE.Sprite(
+					new THREE.SpriteMaterial({
+						map: glowTexture(),
+						color: "#fff2c4",
+						transparent: true,
+						depthWrite: false,
+						blending: THREE.AdditiveBlending,
+						opacity: 0.85,
+					}),
+				);
+				glow.scale.set(26, 26, 1);
+				glow.position.set(x, 64, z);
+				this.group.add(glow);
+				this.glows.push(glow);
