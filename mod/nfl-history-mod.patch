+// A football helmet in three-quarter view, looking toward f (+1 right, -1 left): a shiny shell with the team
+// stripe, the logo on the side, the ear hole, the face behind the mask, and the cage
+const drawHelmet = (
+	g: CanvasRenderingContext2D,
+	cx: number,
+	cy: number,
+	r: number,
+	f: number,
+	shellC: string,
+	stripeC: string,
+	logo?: HTMLImageElement,
+	face?: HTMLImageElement,
+	num?: string,
+	skin = "#c68a5e",
+	maskC = "#cbd5e1",
+) => {
+	const sx = cx - f * 4;
+	// Shell outline: round on top and back, cut away low at the front for the face
+	const shellPath = () => {
+		g.beginPath();
+		g.moveTo(sx + f * r * 0.98, cy + r * 0.05);
+		g.bezierCurveTo(
+			sx + f * r * 1.02,
+			cy - r * 0.9,
+			sx - f * r * 0.6,
+			cy - r * 1.18,
+			sx - f * r * 0.98,
+			cy - r * 0.15,
+		);
+		g.bezierCurveTo(
+			sx - f * r * 1.08,
+			cy + r * 0.45,
+			sx - f * r * 0.75,
+			cy + r * 0.88,
+			sx - f * r * 0.15,
+			cy + r * 0.86,
+		);
+		g.lineTo(sx + f * r * 0.1, cy + r * 0.55);
+		g.quadraticCurveTo(
+			sx + f * r * 0.5,
+			cy + r * 0.12,
+			sx + f * r * 0.98,
+			cy + r * 0.05,
+		);
+		g.closePath();
+	};
+	// The face, seen through the front opening
+	g.save();
+	g.beginPath();
+	g.ellipse(
+		sx + f * r * 0.55,
+		cy + r * 0.38,
+		r * 0.55,
+		r * 0.6,
+		0,
+		0,
+		Math.PI * 2,
+	);
+	g.clip();
+	g.fillStyle = shade(skin, -0.35);
+	g.fillRect(sx - r * 2, cy - r * 2, r * 4, r * 4);
+	if (face) {
+		// The whole head behind the shell, shifted toward the front: only the face shows in the opening
+		const c = faceCrop(face);
+		const w = r * 2.05;
+		const h = (w * c.sh) / c.sw;
+		g.drawImage(
+			face,
+			c.sx,
+			c.sy,
+			c.sw,
+			c.sh,
+			sx + f * r * 0.5 - w / 2,
+			cy - h * 0.5,
+			w,
+			h,
+		);
+	}
+	g.restore();
+	// Shell with a highlight
+	const sg = g.createRadialGradient(
+		sx - f * r * 0.25,
+		cy - r * 0.5,
+		r * 0.1,
+		sx,
+		cy,
+		r * 1.2,
+	);
+	sg.addColorStop(0, shade(shellC, 0.45));
+	sg.addColorStop(0.35, shellC);
+	sg.addColorStop(1, shade(shellC, -0.45));
