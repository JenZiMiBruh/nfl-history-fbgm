+				<span
+					style={{
+						display: "flex",
+						alignItems: "center",
+						gap: 8,
+						fontSize: ".72rem",
+						opacity: 0.85,
+					}}
+				>
+					<span>
+						{pace === "manual" ? "Click to continue" : "Click to skip ahead"}
+					</span>
+					<button
+						type="button"
+						className="btn btn-sm btn-outline-light py-0"
+						title="Auto: each card moves on by itself. Manual: each waits for your click."
+						onClick={(e) => {
+							e.stopPropagation();
+							setCardPace(pace === "manual" ? "auto" : "manual");
+						}}
+					>
+						{pace === "manual" ? "Manual" : "Auto"}
+					</button>
+				</span>
+			</div>
+		</div>
+	);
+};
