+import { useEffect, useState } from "react";
+import { toWorker } from "../../util/toWorker.ts";
+import { useLocal } from "../../util/local.ts";
+
+// NFL history mod: color the interface with the user's team colors (primary, secondary, accent)
+const luminance = (hex: string) => {
+	const n = Number.parseInt(
+		hex.replace("#", "").padEnd(6, "0").slice(0, 6),
+		16,
+	);
+	const channel = (c: number) => {
+		const v = c / 255;
+		return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+	};
+	return (
+		0.2126 * channel((n >> 16) & 255) +
+		0.7152 * channel((n >> 8) & 255) +
+		0.0722 * channel(n & 255)
+	);
+};
+
+const textOn = (hex: string) => (luminance(hex) > 0.4 ? "#111111" : "#ffffff");
+
+export const TeamTheme = () => {
+	const { lid, phase, season, teamInfoCache, userTid } = useLocal([
+		"lid",
+		"phase",
+		"season",
+		"teamInfoCache",
+		"userTid",
+	]);
+	const [colors, setColors] = useState<[string, string, string] | undefined>();
+
+	// Ask the worker for the user's team colors whenever the league, team or season changes (colors can change by era)
+	useEffect(() => {
+		let cancelled = false;
+		if (lid === undefined) {
+			setColors(undefined);
+			return;
+		}
+		toWorker("main", "getUserTeamColors", undefined)
+			.then((result) => {
+				if (!cancelled) {
+					setColors(result ?? teamInfoCache[userTid]?.colors);
+				}
+			})
+			.catch(() => {
+				if (!cancelled) {
+					setColors(teamInfoCache[userTid]?.colors);
+				}
+			});
+		return () => {
+			cancelled = true;
+		};
+	}, [lid, phase, season, teamInfoCache, userTid]);
+
+	useEffect(() => {
+		let style = document.getElementById(
+			"team-theme",
+		) as HTMLStyleElement | null;
+		if (!colors) {
+			style?.remove();
+			return;
+		}
+		if (!style) {
+			style = document.createElement("style");
+			style.id = "team-theme";
+			document.head.append(style);
+		}
+		const [primary, secondary, accent] = colors;
+		// Use whichever of secondary/accent stands out more against the primary color for highlights
+		const highlight =
+			Math.abs(luminance(secondary) - luminance(primary)) >=
+			Math.abs(luminance(accent) - luminance(primary))
+				? secondary
+				: accent;
+		const text = textOn(primary);
+		style.textContent = `
+:root { --team-primary: ${primary}; --team-secondary: ${secondary}; --team-accent: ${accent}; }
+.navbar.fixed-top { background: ${primary} !important; border-bottom: 4px solid ${highlight} !important; }
+.navbar.fixed-top .navbar-brand, .navbar.fixed-top .nav-link, .navbar.fixed-top .navbar-text, .navbar.fixed-top .dropdown-toggle { color: ${text} !important; }
+.navbar.fixed-top .navbar-toggler { border-color: ${text}; }
+.navbar.fixed-top .navbar-toggler-icon { filter: ${text === "#ffffff" ? "invert(1)" : "none"}; }
+.btn-primary { background-color: ${primary} !important; border-color: ${highlight} !important; color: ${text} !important; }
+.nav-tabs .nav-link.active, .nav-pills .nav-link.active { border-top: 3px solid ${primary}; }
+.nav-pills .nav-link.active { background-color: ${primary}; color: ${text}; }
+.progress-bar { background-color: ${primary}; }
+.sidebar .nav-link.active, .sidebar .active > .nav-link { border-left: 4px solid ${primary}; }
+h1 { border-bottom: 3px solid ${primary}; padding-bottom: 4px; display: inline-block; }
+table.table thead th { border-bottom: 2px solid ${primary}; }
+`;
+	}, [colors?.join(",")]);
+
+	return null;
+};
