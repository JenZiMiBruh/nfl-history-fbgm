@@ -0,0 +1,231 @@
+// NFL history mod: the Madden cover vote. From Madden NFL 2000 on, eight of last season's stars are on the ballot; you
+// vote once, the fans' votes are simulated, and when the regular season starts the winner is that year's cover. Before
+// that the game had John Madden on the cover (1989-1999), and before 1989 there was no game.
+import { useState } from "react";
+import type { FaceConfig } from "facesjs";
+import useTitleBar from "../hooks/useTitleBar.tsx";
+import type { View } from "../../common/types.ts";
+import {
+	maddenTitle,
+	type NflCoverPlayer,
+	type NflCoverSeason,
+} from "../../common/nflCover.ts";
+import { toWorker } from "../util/toWorker.ts";
+import { PlayerPicture } from "../components/PlayerPicture.tsx";
+import { MaddenCover } from "../components/MaddenCover.tsx";
+
+export { MaddenCover };
+
+// A ballot card: the player, last season's line, and the vote button / share
+const BallotCard = ({
+	p,
+	share,
+	picked,
+	onVote,
+}: {
+	p: NflCoverPlayer;
+	share?: number;
+	picked?: boolean;
+	onVote?: () => void;
+}) => {
+	const [c1, c2] = p.colors;
+	return (
+		<div
+			style={{
+				background: `linear-gradient(160deg, ${c1} 0%, ${c1} 60%, #0b0b0f 100%)`,
+				border: picked ? `3px solid ${c2}` : "1px solid rgba(0,0,0,.25)",
+				borderRadius: 8,
+				color: "#fff",
+				overflow: "hidden",
+				width: 190,
+				display: "flex",
+				flexDirection: "column",
+			}}
+		>
+			<div style={{ height: 190, display: "flex", justifyContent: "center", position: "relative", overflow: "hidden" }}>
+				{p.logo ? (
+					<img alt="" src={p.logo} style={{ position: "absolute", right: 6, top: 6, width: 36 }} />
+				) : null}
+				<div style={{ width: 104, flex: "none", marginTop: 4 }}>
+					<PlayerPicture colors={p.colors} face={p.face as FaceConfig | undefined} imgURL={p.face ? undefined : p.imgURL} nfl={p.nfl as any} />
+				</div>
+			</div>
+			<div style={{ padding: "8px 10px", background: "rgba(0,0,0,.55)", flex: 1 }}>
+				<div style={{ fontSize: 17, fontWeight: 800, lineHeight: 1.1 }}>{p.name}</div>
+				<div style={{ fontSize: 12, opacity: 0.85 }}>
+					{p.pos} · {p.region} {p.teamName}
+				</div>
+				{p.line ? <div style={{ fontSize: 12, marginTop: 2 }}>{p.line}</div> : null}
+				{p.why ? <div className="badge bg-warning text-dark" style={{ marginTop: 4 }}>{p.why}</div> : null}
+				{share !== undefined ? (
+					<div style={{ marginTop: 6 }}>
+						<div style={{ height: 6, background: "rgba(255,255,255,.2)", borderRadius: 3 }}>
+							<div style={{ width: `${share}%`, height: "100%", background: c2, borderRadius: 3 }} />
+						</div>
+						<div style={{ fontSize: 12, marginTop: 2 }}>{share}% of the vote</div>
+					</div>
+				) : null}
+				{onVote ? (
+					<button className="btn btn-light btn-sm mt-2 w-100" onClick={onVote} type="button">
+						Vote
+					</button>
+				) : null}
+			</div>
+		</div>
+	);
+};
+
+const winnerOf = (c: NflCoverSeason) => c.candidates.find((p) => p.pid === c.winner);
+
+const NflCoverVote = ({
+	season,
+	title,
+	firstVoteSeason,
+	open,
+	current,
+	liveShares,
+	past,
+	realLater,
+}: View<"nflCoverVote">) => {
+	useTitleBar({ title: "Madden Cover Vote" });
+	const [busy, setBusy] = useState(false);
+
+	const vote = async (pid: number) => {
+		setBusy(true);
+		try {
+			await toWorker("main", "castCoverVote", pid);
+		} finally {
+			setBusy(false);
+		}
+	};
+
+	let body;
+	if (!title) {
+		body = (
+			<p>
+				There's no Madden game yet. The first one, John Madden Football, comes out in 1988, and fans start
+				voting on the cover with Madden NFL 2000.
+			</p>
+		);
+	} else if (season < firstVoteSeason) {
+		body = (
+			<p>
+				<b>{title}</b> has John Madden himself on the cover. Players start appearing on the cover, and fans
+				start voting, with Madden NFL 2000.
+			</p>
+		);
+	} else if (!current) {
+		body = <p>The {title} ballot isn't ready yet.</p>;
+	} else if (current.winner !== undefined || current.real) {
+		const w = winnerOf(current);
+		body = (
+			<>
+				<h2>{title}</h2>
+				{w ? <MaddenCover p={w} season={season} width={320} /> : null}
+				{current.real ? <p className="mt-2">The real cover. Fans start voting with next year's game.</p> : null}
+				<h3 className={current.real ? "d-none" : "mt-4"}>Final vote</h3>
+				<div className="d-flex flex-wrap gap-3">
+					{current.candidates.map((p, i) => (
+						<BallotCard key={p.pid} p={p} picked={current.userPick === p.pid} share={current.shares?.[i]} />
+					))}
+				</div>
+			</>
+		);
+	} else {
+		const voted = current.userPick !== undefined;
+		body = (
+			<>
+				<h2>Who should be on the cover of {title}?</h2>
+				<p>
+					{voted
+						? "Thanks for voting. The fans are still voting; the cover is revealed when the regular season starts."
+						: open
+							? "You get one vote. Voting closes when the regular season starts."
+							: "Voting has closed."}
+				</p>
+				<div className="d-flex flex-wrap gap-3">
+					{current.candidates.map((p, i) => (
+						<BallotCard
+							key={p.pid}
+							p={p}
+							picked={current.userPick === p.pid}
+							share={liveShares?.[i]}
+							onVote={open && !voted && !busy ? () => vote(p.pid) : undefined}
+						/>
+					))}
+				</div>
+			</>
+		);
+	}
+
+	return (
+		<>
+			{body}
+			{past.length > 0 ? (
+				<>
+					<h2 className="mt-5">Past covers</h2>
+					<div className="d-flex flex-wrap gap-3">
+						{past.map((c) => {
+							const w = winnerOf(c);
+							return (
+								<div key={c.season} style={{ width: 180 }}>
+									{w ? (
+										<MaddenCover p={w} season={c.season} width={180} />
+									) : (
+										// Madden NFL 23: John Madden's tribute cover
+										<div
+											className="d-flex align-items-center justify-content-center text-center"
+											style={{ width: 180, height: 252, borderRadius: 6, background: "#111", color: "#fff", padding: 12 }}
+										>
+											<div>
+												<div className="fw-bold">{maddenTitle(c.season)}</div>
+												<div className="small mt-2">John Madden tribute cover</div>
+											</div>
+										</div>
+									)}
+									<div className="small mt-1 text-body-secondary">
+										{maddenTitle(c.season)}
+										{c.coStar ? ` · with ${c.coStar.name}` : ""}
+										{c.real ? " · real cover" : ""}
+									</div>
+								</div>
+							);
+						})}
+					</div>
+				</>
+			) : null}
+			{realLater.length > 0 ? (
+				<>
+					<h2 className="mt-5">Real-life covers</h2>
+					<p className="text-body-secondary">The real Madden covers from the years since this league began.</p>
+					<div className="d-flex flex-wrap gap-3">
+						{realLater.map((c) => {
+							const w = winnerOf(c);
+							return (
+								<div key={c.season} style={{ width: 180 }}>
+									{w ? (
+										<MaddenCover p={w} season={c.season} width={180} />
+									) : (
+										<div className="d-flex align-items-center justify-content-center text-center" style={{ width: 180, height: 252, borderRadius: 6, background: "#111", color: "#fff", padding: 12 }}>
+											<div>
+												<div className="fw-bold">{maddenTitle(c.season)}</div>
+												<div className="small mt-2">John Madden tribute cover</div>
+											</div>
+										</div>
+									)}
+									<div className="small mt-1 text-body-secondary">
+										{maddenTitle(c.season)}
+										{w ? ` · ${w.name}` : ""}
+										{c.coStar ? ` & ${c.coStar.name}` : ""}
+									</div>
+								</div>
+							);
+						})}
+					</div>
+				</>
+			) : null}
+		</>
+	);
+};
+
+export default NflCoverVote;
