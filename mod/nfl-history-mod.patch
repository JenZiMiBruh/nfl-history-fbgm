+// Gridiron Almanac native engine: Football GM's worker, run in a bare V8 inside the Android app.
+// Order matters: browser stand-ins first, then the in-memory database, then the game.
+import "./shims.ts";
+import "fake-indexeddb/auto";
+import "../../src/worker/index.ts";
diff --git a/tools/native/harness.mjs b/tools/native/harness.mjs
new file mode 100644
index 000000000..4dc92ad7c
--- /dev/null
+++ b/tools/native/harness.mjs
@@ -0,0 +1,126 @@
+// Runs build/native/engine.js in an empty V8 context (no browser, no Node APIs, no Intl), playing the part the
+// Android app will: timers, messages, file reads. Proves the engine works headless before porting this to Kotlin.
+// Usage: node --max-old-space-size=8000 tools/native/harness.mjs <league.json> [tid]
+import vm from "node:vm";
+import fs from "node:fs";
+import path from "node:path";
+
+const leaguePath = process.argv[2];
+const tid = process.argv[3] !== undefined ? Number(process.argv[3]) : undefined;
+const t0 = Date.now();
+const log = (...a) => console.log(`[${((Date.now() - t0) / 1000).toFixed(1)}s]`, ...a);
+
+const ctx = vm.createContext({});
+vm.runInContext("delete globalThis.Intl;", ctx);
+const CtxUint8Array = vm.runInContext("Uint8Array", ctx);
+
+// ---- host: what the Kotlin app will implement
+const timers = new Map();
+const delayHist = {};
+const hostCalls = { setTimer: 0, post: 0, readBytes: 0 };
+let onMessage = () => {};
+ctx.__host = {
+	setTimer(id, ms) {
+		hostCalls.setTimer++;
+		delayHist[ms] = (delayHist[ms] ?? 0) + 1;
+		// Zero-delay timers run right away (Node's setTimeout waits at least 1 ms; the database queues thousands)
+		const fire = () => {
+			timers.delete(id);
+			ctx.__engine.fireTimer(id);
+		};
+		timers.set(id, ms <= 0 ? { immediate: setImmediate(fire) } : { timeout: setTimeout(fire, ms) });
+	},
+	clearTimer(id) {
+		const t = timers.get(id);
+		if (t?.immediate) clearImmediate(t.immediate);
+		else if (t) clearTimeout(t.timeout);
+		timers.delete(id);
+	},
+	post(json) {
+		hostCalls.post++;
+		onMessage(JSON.parse(json));
+	},
+	log(level, text) {
+		if (level !== "debug") console.log(`  engine ${level}:`, text.slice(0, 400));
+	},
+	readText(p) {
+		// Name lists and other bundled files come from the web build
+		const file = path.join("build", p.replace(/^\//, ""));
+		if (fs.existsSync(file)) return fs.readFileSync(file, "utf8");
+		const dir = path.dirname(file);
+		const base = path.basename(file).replace(/\.json$/, "");
+		const match = fs.existsSync(dir) && fs.readdirSync(dir).find((f) => f.startsWith(base + "-") && f.endsWith(".json"));
+		return match ? fs.readFileSync(path.join(dir, match), "utf8") : null;
+	},
+	fileSize(p) {
+		return fs.statSync(p).size;
+	},
+	readBytes(p, offset, length) {
+		const fd = fs.openSync(p, "r");
+		const buf = Buffer.alloc(length);
+		fs.readSync(fd, buf, 0, length, offset);
+		fs.closeSync(fd);
+		// Hand the engine a Uint8Array from its own realm
+		const u8 = new CtxUint8Array(length);
+		u8.set(buf);
+		return u8;
+	},
+};
+
+// ---- message protocol (promise-worker-bi)
+let nextId = 0;
+const pending = new Map();
+const uiCalls = new Map();
+onMessage = (m) => {
+	if (m[0] === 1) {
+		const p = pending.get(m[1]);
+		pending.delete(m[1]);
+		if (p) m[2] ? p.reject(m[2]) : p.resolve(m[3]);
+	} else if (m[0] === 0) {
+		// The engine asking the UI to do something: count it and say "done"
+		const name = m[2]?.[0];
+		uiCalls.set(name, (uiCalls.get(name) ?? 0) + 1);
+		if (name === "updateLocal" && m[2][1]?.[0]?.gameSimInProgress === false) gameSimDone?.();
+		ctx.__engine.receive(JSON.stringify([1, m[1], null, undefined]));
+	} else if (m[0] === 5) {
+		log("engine error:", m[1]);
+	}
+};
+const call = (type, name, param) =>
+	new Promise((resolve, reject) => {
+		const id = nextId++;
+		pending.set(id, { resolve, reject });
+		ctx.__engine.receive(JSON.stringify([0, id, [type, name, param], 0]));
+	});
+let gameSimDone;
+const simDone = () => new Promise((r) => (gameSimDone = r));
+
+// ---- run
+const engine = fs.readFileSync("build/native/engine.js", "utf8");
+vm.runInContext(engine, ctx, { filename: "engine.js" });
+log("engine loaded", (engine.length / 1e6).toFixed(1) + " MB");
+
+await call("main", "init", { bbgmVersion: "native", enableLogging: false, heartbeatID: "native", mobile: true, useSharedWorker: false });
+log("init done");
+
+const lid = await call("native", "createLeagueFromFile", { path: leaguePath, tid });
+log("host calls so far", JSON.stringify(hostCalls));
+log("league created, lid", lid, "heap", Math.round(process.memoryUsage().heapUsed / 1e6), "MB");
+await call("native", "openLeague", { lid });
+log("league opened");
+try { const st = await call("native", "standings"); log("standings rows", st.length, JSON.stringify(st[0])); } catch (e) { log("standings failed", e?.message ?? e); }
+try { log("status", JSON.stringify(await call("native", "status"))); } catch (e) { log("status failed", e?.message ?? e); }
+
+if (process.env.PLAY) { for (const action of process.env.PLAY.split(",")) { const done = simDone(); await call("playMenu", action, undefined); await Promise.race([done, new Promise((r) => setTimeout(r, 30000))]); log(action, JSON.stringify(await call("native", "status"))); } }
+if (process.env.TO_REGULAR) { const done = simDone(); await call("playMenu", "untilRegularSeason", undefined); await Promise.race([done, new Promise((r) => setTimeout(r, 3000))]); log("status", JSON.stringify(await call("native", "status"))); }
+for (let week = 1; week <= (Number(process.env.WEEKS) || 2); week++) {
+	const done = simDone();
+	const ts = Date.now();
+	await call("playMenu", "week", undefined);
+	await Promise.race([done, new Promise((r) => setTimeout(r, 1000))]);
+	log(`simmed week ${week} in ${((Date.now() - ts) / 1000).toFixed(1)}s`);
+}
+if (process.env.DUMP) { const json = await call("native", "dumpLeague"); fs.writeFileSync(process.env.DUMP, typeof json === "string" ? json : JSON.stringify(json)); log("dumped league to", process.env.DUMP); }
+log("timer delays (ms: count)", JSON.stringify(delayHist));
+log("UI calls seen:", JSON.stringify(Object.fromEntries(uiCalls)));
+process.exit(0);
