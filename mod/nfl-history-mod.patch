@@ -0,0 +1,125 @@
+// NFL history mod: the live game's presentation settings. Every feature of the broadcast and the animated field can be
+// turned off on its own (the gear on the field). Saved in this browser. Any code can ask fx("replays") and listen for
+// changes ("nfl-fx" on window).
+
+export const FX = {
+	intro: { label: "Game open", group: "Broadcast" },
+	overlaysInField: {
+		label: "Graphics inside the game window (off: over the whole screen)",
+		group: "Broadcast",
+	},
+	bugOnField: {
+		label: "Score bug on the field (off: above it)",
+		group: "Broadcast",
+	},
+	pregame: {
+		label: "Pregame show (lineups, leaders, standings)",
+		group: "Broadcast",
+	},
+	breakCards: {
+		label: "Cards at halftime, quarter breaks and timeouts",
+		group: "Broadcast",
+	},
+	popups: {
+		label: "Pop-up graphics (touchdowns, injuries, penalties...)",
+		group: "Broadcast",
+	},
+	funFacts: {
+		label: "Fun facts in the quiet moments (streaks, the series, milestones)",
+		group: "Broadcast",
+	},
+	winProb: {
+		label: "Win probability (meter under the bug, and big swings)",
+		group: "Broadcast",
+	},
+	cutaways: {
+		label: "Cutaways: the crowd, the sidelines, timeouts",
+		group: "Cutscenes",
+	},
+	qbIntro: { label: "Quarterback walk-out cutscene", group: "Cutscenes" },
+	coinToss: { label: "Coin toss cutscene", group: "Cutscenes" },
+	refCalls: { label: "Referee announcing penalties", group: "Cutscenes" },
+	refVoice: {
+		label: "Referee's voice (spoken, off by default)",
+		group: "Cutscenes",
+	},
+	weatherShot: {
+		label: "Weather shot before kickoff (rain, snow, wind, cold, heat)",
+		group: "Cutscenes",
+	},
+	replays: { label: "Instant replays of big plays", group: "Cutscenes" },
+	switchEnds: {
+		label: "Camera sweep when teams switch ends",
+		group: "Cutscenes",
+	},
+	crowd: {
+		label: "Live crowd (fans, the wave, camera flashes)",
+		group: "Stadium",
+	},
+	crew: {
+		label: "Broadcast crew (Skycam, cart camera, cranes, kick nets)",
+		group: "Stadium",
+	},
+	sidelineLife: { label: "Sideline people moving around", group: "Stadium" },
+	ballTrail: {
+		label: "Trail and glow on kicks and deep balls",
+		group: "Field",
+	},
+	tackleFx: { label: "Tackle impact and dust", group: "Field" },
+	jukes: { label: "Jukes and spin moves", group: "Field" },
+} as const;
+export type FxKey = keyof typeof FX;
+
+const KEY = "nflFx";
+let cache: Partial<Record<FxKey, boolean>> | undefined;
+const load = () => {
+	if (!cache) {
+		try {
+			cache = JSON.parse(localStorage.getItem(KEY) ?? "{}");
+		} catch {
+			cache = {};
+		}
+	}
+	return cache!;
+};
+
+// On unless turned off
+// On unless turned off; the referee's spoken voice is off unless turned on
+const OFF_BY_DEFAULT: FxKey[] = ["refVoice"];
+export const fx = (k: FxKey) =>
+	OFF_BY_DEFAULT.includes(k) ? load()[k] === true : load()[k] !== false;
+export const setFx = (k: FxKey, on: boolean) => {
+	const c = { ...load(), [k]: on };
+	cache = c;
+	try {
+		localStorage.setItem(KEY, JSON.stringify(c));
+	} catch {
+		// no storage: this session only
+	}
+	window.dispatchEvent(new Event("nfl-fx"));
+};
+
+// How the full-screen cards and the game open move on: "auto" (each on a timer) or "manual" (each waits for a click).
+// A click anywhere always moves on. Changes are announced with "nfl-pace".
+export type CardPace = "auto" | "manual";
+export const cardPace = (): CardPace => {
+	try {
+		return localStorage.getItem("nflCardPace") === "manual" ? "manual" : "auto";
+	} catch {
+		return "auto";
+	}
+};
+export const setCardPace = (p: CardPace) => {
+	try {
+		localStorage.setItem("nflCardPace", p);
+	} catch {
+		// no storage: this session only
+	}
+	window.dispatchEvent(new Event("nfl-pace"));
+};
+// A click on a full-screen graphic (anywhere but a button or a menu): move on to the next card or scene
+export const advance = () => window.dispatchEvent(new Event("nfl-advance"));
+export const isControl = (t: EventTarget | null) =>
+	!!(t as HTMLElement | null)?.closest?.(
+		"button, select, input, a, label, textarea",
+	);
diff --git a/src/ui/views/LiveGame/NflSideline.ts b/src/ui/views/LiveGame/NflSideline.ts
