@@ -0,0 +1,60 @@
+import { idb } from "../../db/index.ts";
+import { g } from "../../util/index.ts";
+import newSchedulePlayoffsDay from "./newSchedulePlayoffsDay.ts";
+
+// NFL history mod: a league started at a later playoff round. The rounds before it are filled in from the real bracket
+// and the chosen round is left to play, with the real matchups. Runs once, right after the playoffs are set up.
+const nflStartBracket = async () => {
+	const start = (g as any).nflStartBracket as
+		| { season: number; round: number; series: any[][] }
+		| undefined;
+	const season = g.get("season");
+	if (!start || start.season !== season) {
+		return;
+	}
+	const playoffSeries = await idb.cache.playoffSeries.get(season);
+	if (!playoffSeries || playoffSeries.series.length <= start.round) {
+		return;
+	}
+
+	for (let r = 0; r <= start.round; r++) {
+		playoffSeries.series[r] = start.series[r]!.map((matchup) => {
+			const copy = JSON.parse(JSON.stringify(matchup));
+			if (r === start.round) {
+				for (const side of [copy.home, copy.away]) {
+					if (side) {
+						side.won = 0;
+						delete side.pts;
+					}
+				}
+			}
+			return copy;
+		});
+	}
+	playoffSeries.currentRound = start.round;
+	await idb.cache.playoffSeries.put(playoffSeries);
+
+	// Rounds won so far: a team reaching round r has won (or had a bye through) r rounds
+	const teamSeasons = await idb.cache.teamSeasons.indexGetAll(
+		"teamSeasonsBySeasonTid",
+		[[season], [season, "Z"]],
+	);
+	for (let r = 1; r <= start.round; r++) {
+		for (const { home, away } of playoffSeries.series[r]!) {
+			for (const side of [home, away]) {
+				const teamSeason = side
+					? teamSeasons.find((ts) => ts.tid === side.tid)
+					: undefined;
+				if (teamSeason) {
+					teamSeason.playoffRoundsWon = r;
+					await idb.cache.teamSeasons.put(teamSeason);
+				}
+			}
+		}
+	}
+
+	await idb.cache.schedule.clear();
+	await newSchedulePlayoffsDay();
+};
+
+export default nflStartBracket;
