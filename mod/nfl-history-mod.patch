+// NFL history mod: how players physically move on the animated field: a locomotion engine.
+//
+// A player isn't a puck that can be pushed any direction: he runs the way he's facing. Each body has a position, a
+// heading and a speed, and every frame:
+//   - he looks at where the play wants him (a spot, or a moving target he leads, like a runner he's chasing)
+//   - his speed follows a braking curve: as fast as he wants until he has to slow down to stop right on his spot (or to
+//     match a moving target's speed), so he arrives and stops instead of overshooting or circling it
+//   - he turns toward it at a rate that drops as he speeds up; a sharp cut at speed makes him plant and slow first
+//   - he moves along his heading (never sideways), so nothing slides
+//   - only small adjustments (a step or two, standing in the huddle or at the line) are shuffles in any direction
+// Bodies don't overlap: contact pushes positions apart and costs the weaker player some speed. Nobody ever teleports.
+// The rest of the code reads pos, vel (heading times speed) and speed, as before.
+
+export type Pt = { x: number; y: number };
+
+export type Body = {
+	key: string;
+	pos: Pt;
+	vel: Pt;
+	top: number; // top speed, yards per second
+	accel: number; // yards per second per second
+	heading: number; // radians, the way he's facing and running
+	speed: number; // yards per second, along the heading
+	lastGoal?: Pt;
+	gvS?: Pt; // the target's velocity, smoothed
+};
+
+export type Goal = {
+	at: Pt;
+	// 0-1 share of his top speed he'll use (a jog between plays, a sprint in the play)
+	effort: number;
+	// The ball carrier and anyone the play must keep exact: tracks tightly and isn't shoved by others
+	priority?: boolean;
+	// Skip collisions with the players on the field (people on the sideline)
+	ghost?: boolean;
+	// In a block (the blocker or the man he's on): pushing against each other is the point, so never slipped through
+	engaged?: boolean;
+};
+
+// Typical speeds by position (yards/second at full sprint), with a small random spread per player
+const SPEED: Record<string, number> = {
+	QB: 8.4,
+	RB: 9.6,
+	WR: 9.8,
+	TE: 8.8,
+	OL: 7.3,
+	DL: 7.7,
+	LB: 8.8,
+	CB: 9.8,
+	S: 9.4,
+	K: 7.6,
+	P: 7.6,
+	KR: 9.8,
+	PR: 9.8,
+};
+const ACCEL: Record<string, number> = {
+	QB: 10,
+	RB: 13,
+	WR: 13,
+	TE: 10,
+	OL: 7,
+	DL: 8,
+	LB: 10,
+	CB: 13,
+	S: 12,
+	K: 8,
+	P: 8,
+	KR: 13,
+	PR: 13,
+};
+
+const rand = (key: string) => {
+	let h = 9;
+	for (let i = 0; i < key.length; i++) h = (h * 31 + key.charCodeAt(i)) | 0;
+	return ((h >>> 0) % 1000) / 1000;
+};
+const wrap = (a: number) => {
+	while (a > Math.PI) a -= Math.PI * 2;
+	while (a < -Math.PI) a += Math.PI * 2;
+	return a;
+};
+
+// Below this distance from his spot a player shuffles (moves any direction at walking pace) instead of turning to run
+const SHUFFLE = 1.1;
+
+export class Motion {
+	bodies = new Map<string, Body>();
+	// Debug: counts of odd movement, readable from the console as window.__nflDiag
+	diag = { circles: 0, stuck: 0, unstuck: 0, samples: [] as string[] };
+	clock = 0;
+	// (reused every step)
+	private activeBuf: Body[] = [];
+	private ghostBuf: Body[] = [];
+
+	// Ratings (0-100) set top speed and burst: a 99-speed receiver is about 10.6 yards a second, a 30-speed lineman 7
+	rate(
+		key: string,
+		move: { spd: number; elu: number; stre: number } | undefined,
+	) {
+		const b = this.bodies.get(key);
+		if (!b || !move || (b as any).rated) return;
+		(b as any).rated = true;
+		b.top = 6.6 + (move.spd / 100) * 4.1;
+		b.accel = 7 + (move.spd / 100) * 5 + (move.elu / 100) * 3;
+		(b as any).elu = move.elu;
+		(b as any).stre = move.stre;
+	}
+
+	body(key: string, start: Pt, pos?: string) {
+		let b = this.bodies.get(key);
+		if (!b) {
+			const r = rand(key);
+			const p = pos && SPEED[pos] !== undefined ? pos : "LB";
+			b = {
+				key,
+				pos: { ...start },
+				vel: { x: 0, y: 0 },
+				top: SPEED[p]! * (0.95 + r * 0.1),
+				accel: ACCEL[p]! * (0.92 + r * 0.16),
+				heading: 0,
+				speed: 0,
+			};
+			this.bodies.set(key, b);
+		} else if (pos && SPEED[pos] !== undefined && !(b as any).rated) {
+			const r = rand(key);
+			b.top = SPEED[pos]! * (0.95 + r * 0.1);
+			b.accel = ACCEL[pos]! * (0.92 + r * 0.16);
+		}
+		return b;
+	}
+
+	// Move everyone toward their goals over dt seconds (game time), in small steps
+	step(goals: Map<string, Goal>, dt: number) {
+		if (dt <= 0) return;
+		const h = Math.min(dt, 1 / 60);
+		const steps = Math.max(1, Math.ceil(dt / h));
+		const sub = dt / steps;
+		for (let s = 0; s < steps; s++) this.sub(goals, sub);
+	}
+
+	private sub(goals: Map<string, Goal>, dt: number) {
+		this.clock += dt;
+		const active = this.activeBuf;
+		const ghosts = this.ghostBuf;
+		active.length = 0;
+		ghosts.length = 0;
+		for (const [key, g] of goals) {
+			const b = this.bodies.get(key);
+			if (!b) continue;
+			// Someone else moved him (a quick-pace sub, a correction): keep speed and heading consistent with that
+			if (b.speed === undefined) b.speed = Math.hypot(b.vel.x, b.vel.y);
+			if (b.heading === undefined)
+				b.heading = Math.atan2(b.vel.y, b.vel.x) || 0;
+			// The target's own movement, smoothed (a path's corners shouldn't yank him); a jump (a new play) resets it
+			// (all updated in place: no new objects per body per step, which would churn the garbage collector)
+			const rx = b.lastGoal ? (g.at.x - b.lastGoal.x) / dt : 0;
+			const ry = b.lastGoal ? (g.at.y - b.lastGoal.y) / dt : 0;
+			if (b.lastGoal) {
+				b.lastGoal.x = g.at.x;
+				b.lastGoal.y = g.at.y;
+			} else b.lastGoal = { x: g.at.x, y: g.at.y };
+			const rawLen = Math.hypot(rx, ry);
+			if (!b.gvS) b.gvS = { x: 0, y: 0 };
+			if (rawLen > b.top * 1.6) {
+				b.gvS.x = 0;
+				b.gvS.y = 0;
+			} else {
+				const kS = 1 - Math.exp(-dt * 6);
+				b.gvS.x += (rx - b.gvS.x) * kS;
+				b.gvS.y += (ry - b.gvS.y) * kS;
+			}
+			const gv = b.gvS;
+			const gvLen = Math.hypot(gv.x, gv.y);
+			const maxSpd =
+				b.top *
+				(g.priority ? 1.1 : 1) *
+				Math.max(0.15, Math.min(1.05, g.effort));
+			const accel = b.accel * (g.priority ? 1.4 : 1);
+			// Players stop faster than they start
+			const decel = accel * 1.7;
+
+			// Where he's going: a moving target is led (he runs to where it will be)
+			const d0 = Math.hypot(g.at.x - b.pos.x, g.at.y - b.pos.y);
+			const lead = gvLen > 0.8 ? Math.min(0.7, d0 / Math.max(1, b.top)) : 0;
+			const tx = g.at.x + gv.x * lead;
+			const ty = g.at.y + gv.y * lead;
+			const ex = tx - b.pos.x;
+			const ey = ty - b.pos.y;
+			const dist = Math.hypot(ex, ey);
+
+			// How fast he wants to go: the braking curve (so he can stop exactly there, or arrive at the target's speed)
+			const arrive = Math.min(maxSpd, gvLen);
+			let want = Math.min(
+				maxSpd,
+				Math.sqrt(arrive * arrive + 2 * decel * Math.max(0, dist - 0.04)),
+			);
+			if (dist < 0.04 && gvLen < 0.05) want = 0;
+
+			if (dist < SHUFFLE && b.speed < 2.6 && gvLen < 2.5) {
+				// Close: a shuffle step straight to the spot at walking pace, keeping the way he faces (settling in the
+				// huddle, at the line, beside the pile); his speed eases to the shuffle pace
+				const shuffle = Math.min(want, 2.4, dist * 4);
+				b.speed += Math.max(
+					-decel * dt,
+					Math.min(accel * dt, shuffle - b.speed),
+				);
+				const s = Math.max(0, b.speed);
+				const ux = dist > 1e-6 ? ex / dist : 0;
+				const uy = dist > 1e-6 ? ey / dist : 0;
+				b.vel.x = ux * s;
+				b.vel.y = uy * s;
+				const step = Math.min(dist, s * dt);
+				b.pos.x += ux * step;
+				b.pos.y += uy * step;
+				// Turn (slowly) to face where the target is heading, or keep his facing
+				if (gvLen > 0.5)
+					b.heading += Math.max(
+						-4 * dt,
+						Math.min(4 * dt, wrap(Math.atan2(gv.y, gv.x) - b.heading)),
+					);
+			} else {
+				// Running: turn toward it (slower the faster he goes), cut by planting first, move along the heading
+				const want_h = Math.atan2(ey, ex);
+				const da = wrap(want_h - b.heading);
+				const turnRate = 11 / (1 + b.speed * 0.32); // radians per second
+				// A sharp cut at speed: plant and slow down before turning (the sharper the cut, the more speed he sheds)
+				const sharp = Math.abs(da);
+				if (sharp > 0.9 && b.speed > 2)
+					want = Math.min(
+						want,
+						b.speed * (1 - Math.min(0.85, (sharp - 0.9) * 0.6)),
+					);
+				// Reversing outright from a standstill: turn on the spot
+				const turn =
+					b.speed < 1.2
+						? Math.max(-12 * dt, Math.min(12 * dt, da))
+						: Math.max(-turnRate * dt, Math.min(turnRate * dt, da));
+				b.heading = wrap(b.heading + turn);
+				// Speed toward the wanted speed, but only once he's roughly facing the right way
+				const facing = Math.cos(wrap(want_h - b.heading));
+				const target =
+					facing > 0.3
+						? want * Math.min(1, facing * 1.3)
+						: Math.min(want, b.speed * 0.5);
+				b.speed += Math.max(
+					-decel * dt,
+					Math.min(accel * dt, target - b.speed),
+				);
+				b.speed = Math.max(0, b.speed);
+				b.vel.x = Math.cos(b.heading) * b.speed;
+				b.vel.y = Math.sin(b.heading) * b.speed;
+				// Never run past a spot that has stopped: the last step lands on it
+				const step = b.speed * dt;
+				if (gvLen < 0.3 && step >= dist && facing > 0.9) {
+					b.pos.x = tx;
+					b.pos.y = ty;
+					b.speed = Math.min(b.speed, 1);
+				} else {
+					b.pos.x += b.vel.x * dt;
+					b.pos.y += b.vel.y * dt;
+				}
+			}
+
+			// Debug: far from his spot for a long time while trying to get there
+			{
+				const d: any = b;
+				if (dist > 4 && gvLen < 0.5 && !g.ghost) {
+					d.farT = (d.farT ?? 0) + dt;
+					if (d.farT > 6) {
+						this.diag.stuck++;
+						if (this.diag.samples.length < 40)
+							this.diag.samples.push(
+								`stuck ${key} dist=${dist.toFixed(1)} speed=${b.speed.toFixed(1)} pos=${b.pos.x.toFixed(0)},${b.pos.y.toFixed(0)} goal=${g.at.x.toFixed(0)},${g.at.y.toFixed(0)} effort=${g.effort}`,
+							);
+						d.farT = 0;
+					}
+				} else d.farT = 0;
+				// Circling: turning through a full circle within 2.5 seconds while running
+				if (b.speed > 1.5) {
+					if (d.lastHead !== undefined)
+						d.turnAcc = (d.turnAcc ?? 0) + wrap(b.heading - d.lastHead);
+					d.lastHead = b.heading;
+				} else d.lastHead = undefined;
+				d.turnT = (d.turnT ?? 0) + dt;
+				if (d.turnT > 2.5) {
+					if (Math.abs(d.turnAcc ?? 0) > Math.PI * 2) {
+						this.diag.circles++;
+						if (this.diag.samples.length < 40)
+							this.diag.samples.push(
+								`circle ${key} dist=${dist.toFixed(1)} goalSpeed=${gvLen.toFixed(1)} speed=${b.speed.toFixed(1)} ghost=${!!g.ghost}`,
+							);
+					}
+					d.turnAcc = 0;
+					d.turnT = 0;
+				}
+			}
+			// The failsafe: someone trying to get somewhere who hasn't gotten any closer for a second while pressed against
+			// other players is jammed; he slips through them for a moment instead of standing stuck
+			{
+				const d: any = b;
+				// (any target, moving or not: what matters is he's touching someone and getting nowhere)
+				const touching = this.clock - (d.contactAt ?? -1e9) < 0.25;
+				if (dist > 1.1) {
+					if (
+						d.bestDist === undefined ||
+						dist < d.bestDist - 0.2 ||
+						!touching
+					) {
+						d.bestDist = dist;
+						d.bestAt = this.clock;
+					} else if (
+						this.clock - d.bestAt > 0.8 &&
+						!(d.phaseUntil > this.clock) &&
+						!g.engaged
+					) {
+						d.phaseUntil = this.clock + 1.0;
+						d.bestAt = this.clock;
+						this.diag.unstuck++;
+					}
+				} else d.bestDist = undefined;
+			}
+			const phasing = ((b as any).phaseUntil ?? 0) > this.clock;
+			if (!g.ghost && !phasing) active.push(b);
+			else if (g.ghost) ghosts.push(b);
+		}
+
+		// Sideline people keep a little space from each other: a gentle nudge apart
+		const RG = 1.05;
+		for (let i = 0; i < ghosts.length; i++) {
+			const A = ghosts[i]!;
+			for (let j = i + 1; j < ghosts.length; j++) {
+				const B = ghosts[j]!;
+				const dx = B.pos.x - A.pos.x;
+				if (dx > RG || dx < -RG) continue;
+				const dy = B.pos.y - A.pos.y;
+				if (dy > RG || dy < -RG) continue;
+				const d = Math.hypot(dx, dy) || 0.001;
+				if (d >= RG) continue;
+				const push = (RG - d) * 0.25;
+				A.pos.x -= (dx / d) * push;
+				A.pos.y -= (dy / d) * push;
+				B.pos.x += (dx / d) * push;
+				B.pos.y += (dy / d) * push;
+			}
+		}
+		// Players on the field don't overlap (about a yard between centers): contact pushes them apart, the weaker one more,
+		// and running into someone costs speed (not direction: nobody gets knocked sideways into a slide)
+		const R = 0.95;
+		for (let i = 0; i < active.length; i++) {
+			const A = active[i]!;
+			const pa = goals.get(A.key)?.priority;
+			for (let j = i + 1; j < active.length; j++) {
+				const B = active[j]!;
+				const dx = B.pos.x - A.pos.x;
+				if (dx > R || dx < -R) continue;
+				const dy = B.pos.y - A.pos.y;
+				if (dy > R || dy < -R) continue;
+				const d = Math.hypot(dx, dy) || 0.001;
+				if (d >= R) continue;
+				const pb = goals.get(B.key)?.priority;
+				const push = R - d;
+				(A as any).contactAt = this.clock;
+				(B as any).contactAt = this.clock;
+				const ux = dx / d;
+				const uy = dy / d;
+				const sa = (A as any).stre ?? 50;
+				const sb = (B as any).stre ?? 50;
+				const share = sb / (sa + sb || 1);
+				const wa = pa ? 0 : pb ? 1 : share;
+				const wb = pb ? 0 : pa ? 1 : 1 - share;
+				A.pos.x -= ux * push * wa;
+				A.pos.y -= uy * push * wa;
+				B.pos.x += ux * push * wb;
+				B.pos.y += uy * push * wb;
+				// Running into someone: whoever is running into the other loses speed
+				const intoA = Math.cos(A.heading) * ux + Math.sin(A.heading) * uy; // A running toward B
+				const intoB = -(Math.cos(B.heading) * ux + Math.sin(B.heading) * uy);
+				if (intoA > 0.3 && wa > 0) A.speed *= 1 - 0.12 * intoA * wa;
+				if (intoB > 0.3 && wb > 0) B.speed *= 1 - 0.12 * intoB * wb;
+				A.vel.x = Math.cos(A.heading) * A.speed;
+				A.vel.y = Math.sin(A.heading) * A.speed;
+				B.vel.x = Math.cos(B.heading) * B.speed;
+				B.vel.y = Math.sin(B.heading) * B.speed;
+			}
+		}
+	}
+}
