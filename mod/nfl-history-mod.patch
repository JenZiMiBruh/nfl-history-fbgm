--- /dev/null
+++ b/src/ui/components/faceJersey.ts
@@ -0,0 +1,332 @@
+// NFL history mod: the era's real jersey on player faces. facesjs draws its jersey from a table of SVG strings
+// (svgs.jersey); this builds one from the jersey card's design (JerseyNumber.tsx, jerseyDesigns.ts) in facesjs's
+// 400 x 600 frame, registers it under its own id, and the face asks for that id. So the jersey is drawn exactly where
+// facesjs's own one goes: over the body, under the head, widened with the body size.
+import { svgs } from "facesjs";
+import type { NflJersey } from "../../common/nflJerseys.ts";
+import { sideDesign, sleeveDesign } from "./jerseyDesigns.ts";
+import {
+	contrast,
+	familyOf,
+	fitTransform,
+	luminance,
+	measureInk,
+} from "./JerseyNumber.tsx";
+
+export type FaceJersey = {
+	jersey: NflJersey;
+	number?: string;
+	// that season's primary logo, for the sleeves of the eras that had it there
+	logo?: string;
+};
+
+// The face is drawn taller than facesjs's 400 x 600 when it wears a mod jersey (MyFace sets the view box), so the
+// chest and the number show
+export const FACE_HEIGHT = 770;
+
+// The jersey over shoulder pads: big rounded pads out past the neck, a short cap sleeve over each one ending at the
+// armpit, the upper arms below it and the chest running past the bottom of the frame
+const OUTLINE =
+	"M120 505 C100 488 85 480 60 482 C25 485 4 500 3 530 C2 555 6 575 10 592 Q40 612 72 608 L78 785 L322 785 L328 608 Q360 612 390 592 C394 575 398 555 397 530 C396 500 375 485 340 482 C315 480 300 488 280 505 C280 540 230 530 200 550 C170 530 120 540 120 505 Z";
+const NECK = "M120 505c0 35 50 25 80 45 30-20 80-10 80-45";
+// the upper arms under the cap sleeves, in the face's skin color with facesjs's black line
+const ARMS =
+	"M12 585 C6 630 10 730 18 785 L80 785 L76 600 Z M388 585 C394 630 390 730 382 785 L320 785 L324 600 Z";
+// a soft shadow on the arm under each sleeve
+const CUFF_SHADOW =
+	"M10 592 Q40 612 72 608 L74 621 Q40 627 12 607 Z M390 592 Q360 612 328 608 L326 621 Q360 627 388 607 Z";
+// where each pad meets the chest, and the light along the top of the pads
+const PAD_CREASE = "M74 606 Q92 556 132 522 M326 606 Q308 556 268 522";
+// tapered tiger stripes on each pad, three reaching in from the outside and two from the chest side
+type Pt2 = [number, number];
+const TIGER_PADS = (
+	[
+		[
+			[-6, 510],
+			[-6, 526],
+			[44, 524],
+		],
+		[
+			[-6, 546],
+			[-6, 564],
+			[50, 558],
+		],
+		[
+			[-6, 584],
+			[-6, 602],
+			[40, 598],
+		],
+		[
+			[96, 532],
+			[100, 548],
+			[54, 545],
+		],
+		[
+			[84, 568],
+			[88, 584],
+			[48, 580],
+		],
+	] as [Pt2, Pt2, Pt2][]
+)
+	.flatMap((pts) => [
+		pts,
+		pts.map(([x, y]): Pt2 => [400 - x, y]) as [Pt2, Pt2, Pt2],
+	])
+	// each one bows upward like a claw, wide at its edge and curling to its point
+	.map(([[ax, ay], [bx, by], [tx, ty]]) => {
+		return `M${ax} ${ay} Q${(ax + tx) / 2} ${(ay + ty) / 2 - 7} ${tx} ${ty} Q${(bx + tx) / 2} ${(by + ty) / 2 - 3} ${bx} ${by} Z`;
+	})
+	.join(" ");
+const PAD_LIGHT = "M22 512 Q45 490 92 488 M378 512 Q355 490 308 488";
+
+// The card's 100 x 112 jersey laid over the bust: its torso (x 22-78) spans the chest, and its sleeves droop down the
+// sides so their stripes sit low on the upper arms
+const SX = 4.3;
+const SY = 3.9;
+const Y0 = 464;
+const px = (x: number) => 200 + (x - 50) * SX;
+const py = (y: number, x = 50) =>
+	Y0 + y * SY + 0 * Math.max(0, Math.abs(x - 50) - 28);
+const n2 = (v: number) => v.toFixed(1);
+
+// Moves a design path (absolute M/L/Q/H/V/Z, as jerseyDesigns.ts writes them) from the card into the bust
+const mapPath = (d: string) => {
+	const tokens = d.match(/[hlmqvz]|-?\d*\.?\d+(?:e-?\d+)?/gi) ?? [];
+	const out: string[] = [];
+	let cmd = "";
+	let cx = 0;
+	let cy = 0;
+	let i = 0;
+	const num = () => Number(tokens[i++]);
+	while (i < tokens.length) {
+		const tok = tokens[i]!;
+		if (/^[a-z]$/i.test(tok)) {
+			cmd = tok.toUpperCase();
+			i++;
+			if (cmd === "Z") {
+				out.push("Z");
+				continue;
+			}
+		}
+		if (cmd === "M" || cmd === "L") {
+			cx = num();
+			cy = num();
+			out.push(`${cmd}${n2(px(cx))} ${n2(py(cy, cx))}`);
+		} else if (cmd === "Q") {
+			const qx = num();
+			const qy = num();
+			cx = num();
+			cy = num();
+			out.push(
+				`Q${n2(px(qx))} ${n2(py(qy, qx))} ${n2(px(cx))} ${n2(py(cy, cx))}`,
+			);
+		} else if (cmd === "H") {
+			cx = num();
+			out.push(`L${n2(px(cx))} ${n2(py(cy, cx))}`);
+		} else if (cmd === "V") {
+			cy = num();
+			out.push(`L${n2(px(cx))} ${n2(py(cy, cx))}`);
+		} else {
+			// anything else isn't written by the designs; skip it rather than loop
+			i++;
+		}
+	}
+	return out.join(" ");
+};
+
+const esc = (s: string) =>
+	s
+		.replaceAll("&", "&amp;")
+		.replaceAll("<", "&lt;")
+		.replaceAll(">", "&gt;")
+		.replaceAll('"', "&quot;");
+
+// short stable hash, for the registered id and the SVG ids inside it
+const hash = (s: string) => {
+	let h = 5381;
+	for (let i = 0; i < s.length; i++) {
+		h = ((h << 5) + h + s.charCodeAt(i)) | 0;
+	}
+	return (h >>> 0).toString(36);
+};
+
+// facesjs walks every child node of a jersey wider or narrower than usual (body size) to scale its strokes, and stops
+// at a text node, so the numbers live in a hidden SVG on the page and the jersey shows them with <use>
+const SVG_NS = "http://www.w3.org/2000/svg";
+const sharedDefs = (markup: string) => {
+	const id = `nflfjd${hash(markup)}`;
+	if (typeof document === "undefined" || document.getElementById(id)) {
+		return id;
+	}
+	let holder: Element | null = document.getElementById("nfl-face-defs");
+	if (!holder) {
+		holder = document.createElementNS(SVG_NS, "svg");
+		holder.id = "nfl-face-defs";
+		holder.setAttribute("aria-hidden", "true");
+		holder.setAttribute(
+			"style",
+			"position:absolute;width:0;height:0;overflow:hidden",
+		);
+		holder.append(document.createElementNS(SVG_NS, "defs"));
+		document.body.append(holder);
+	}
+	holder.firstElementChild!.insertAdjacentHTML(
+		"beforeend",
+		`<g id="${id}">${markup}</g>`,
+	);
+	return id;
+};
+
+export const faceJerseyFamily = (fj: FaceJersey) =>
+	familyOf(fj.jersey.font ?? "block");
+
+// Builds the jersey, registers it with facesjs and returns its id
+// bodySize: facesjs widens or narrows the whole jersey by it, so the sleeve marks are placed to land in the same spot
+export const registerFaceJersey = (fj: FaceJersey, bodySize = 1) => {
+	const real = fj.jersey;
+	const body = real.body;
+	const numberFill = real.numberFill;
+	const numberStroke = real.numberOutline ?? body;
+	const trim = contrast(body, real.stripe1) >= 1.4 ? real.stripe1 : numberFill;
+	const stripe = contrast(body, real.stripe2) >= 1.4 ? real.stripe2 : trim;
+	const cut = real.cut;
+	const number = (fj.number ?? "").trim();
+
+	const key = hash(JSON.stringify([fj, bodySize]));
+	// where a mark meant for x on a normal body has to go so it shows there after the scaling (never past the pad)
+	const onPad = (x: number) => 200 + (x - 200) / Math.max(bodySize, 1);
+	const clip = `nflfj${key}c`;
+	const grad = `nflfj${key}g`;
+	const family = familyOf(real.font ?? "block").replaceAll('"', "'");
+	const numberPaint = real.numberGradient ? `url(#${grad})` : numberFill;
+
+	// the number, stitched twill like the card's: outline, the inner trim color where there is one, the fill
+	const twill = (transform: string, strokeW0: number) => {
+		if (!number) {
+			return "";
+		}
+		const ink = measureInk(number, familyOf(real.font ?? "block"), 5);
+		const strokeW = strokeW0 * (real.outlineScale ?? 1);
+		const digits = ink.xs
+			? [...number]
+					.map(
+						(c, i) => `<tspan x="${ink.xs![i]!.toFixed(2)}">${esc(c)}</tspan>`,
+					)
+					.join("")
+			: esc(number);
+		const text = (fill: string, sw?: number) =>
+			`<text x="0" y="0" font-size="40" font-family="${family}" fill="${fill}"${
+				sw
+					? ` stroke="${fill}" stroke-width="${sw.toFixed(2)}" stroke-linejoin="round"`
+					: ""
+			}>${digits}</text>`;
+		const gradDef = real.numberGradient
+			? `<linearGradient id="${grad}" x1="0" y1="0" x2="0" y2="1"><stop offset="0.15" stop-color="${real.numberGradient[0]}"/><stop offset="0.95" stop-color="${real.numberGradient[1]}"/></linearGradient>`
+			: "";
+		const id = sharedDefs(
+			`${gradDef}${text(
+				numberStroke,
+				real.numberInner ? strokeW * 1.9 : strokeW,
+			)}${real.numberInner ? text(real.numberInner, strokeW) : ""}${text(numberPaint)}`,
+		);
+		return `<use href="#${id}" transform="${transform}"/>`;
+	};
+	const numberInk = number
+		? measureInk(number, familyOf(real.font ?? "block"), 5)
+		: undefined;
+
+	// The bust ends above the elbow, so every era's sleeve designs use the short modern sleeve: its cuff (and the stripes
+	// and cuffs near it) lands inside the frame. The era still shows in the collar and the designs themselves.
+	const designCut = "modern";
+	// Bengals tiger stripes drawn for the pads themselves: the card's, squeezed onto the cap sleeve, turn into slivers
+	const tiger = (real.sleeve ?? "stripes") === "tiger";
+	const designs = [
+		...(tiger
+			? [{ d: TIGER_PADS, role: "trim" as const }]
+			: sleeveDesign(real.sleeve ?? "stripes", designCut)),
+		...sideDesign(real.sides ?? "none", designCut),
+	]
+		.map(
+			(p) =>
+				`<path fill="${p.role === "trim" ? trim : p.role === "stripe" ? stripe : body}" d="${p.d === TIGER_PADS ? p.d : mapPath(p.d)}"/>`,
+		)
+		.join("");
+
+	// TV numbers or the logo on the sleeves
+	let sleeveMarks = "";
+	// on the middle of each pad, tilted with its slope: above the stripes when there are any
+	if (real.sleeveMark === "tv" && numberInk) {
+		const y = real.sleeve === "plain" ? 548 : 530;
+		sleeveMarks = [1, -1]
+			.map(
+				(side) =>
+					`<g transform="translate(${onPad(side === 1 ? 47 : 353)} ${y}) rotate(${side * -12})">${twill(fitTransform(numberInk, 0, 0, 46, 32), 4)}</g>`,
+			)
+			.join("");
+	} else if (real.sleeveMark === "logo" && fj.logo) {
+		const size = 48;
+		sleeveMarks = [1, -1]
+			.map(
+				(side) =>
+					`<image href="${esc(fj.logo!)}" x="${onPad(side === 1 ? 44 : 356) - size / 2}" y="${545 - size / 2}" width="${size}" height="${size}" preserveAspectRatio="xMidYMid meet"/>`,
+			)
+			.join("");
+	}
+
+	// collar trim along the V-neck: half of the stroke is clipped off with the neck, so it's drawn twice as wide
+	const collarW = cut === "classic" ? 30 : cut === "nineties" ? 22 : 16;
+
+	// the number on the chest the same size as on the jersey card's front: its 42 x 36 box scaled onto the bust, so every
+	// number is the same height and only one too wide for it gets smaller
+	const chest = numberInk
+		? twill(fitTransform(numberInk, 200, 658, 42 * SX, 36 * SY), 3.4)
+		: "";
+
+	const lightBody = luminance(body) > 0.5;
+	const svg =
+		`<defs><clipPath id="${clip}"><path d="${OUTLINE}"/></clipPath>` +
+		// the jersey card's fabric: mesh dots, shade toward the sides, light from above
+		`<pattern id="${clip}m" width="12" height="12" patternUnits="userSpaceOnUse"><circle cx="6" cy="6" r="1.6" fill="${lightBody ? "#000" : "#fff"}" opacity="0.05"/></pattern>` +
+		`<linearGradient id="${clip}s" x1="0" x2="1"><stop offset="0" stop-color="#000" stop-opacity="0.24"/><stop offset="0.25" stop-color="#000" stop-opacity="0"/><stop offset="0.75" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity="0.24"/></linearGradient>` +
+		`<linearGradient id="${clip}h" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="0.2"/><stop offset="0.35" stop-color="#fff" stop-opacity="0"/><stop offset="0.85" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity="0.12"/></linearGradient>` +
+		`</defs>` +
+		`<path fill="$[skinColor]" stroke="#000" stroke-width="6" d="${ARMS}"/>` +
+		`<path fill="#000" fill-opacity="0.16" d="${CUFF_SHADOW}"/>` +
+		`<path fill="${body}" d="${OUTLINE}"/>` +
+		`<g clip-path="url(#${clip})">` +
+		`${designs}${sleeveMarks}` +
+		`<path fill="none" stroke="#000" stroke-opacity="0.25" stroke-width="3" d="${PAD_CREASE}"/>` +
+		`<path fill="none" stroke="#fff" stroke-opacity="0.22" stroke-width="5" stroke-linecap="round" d="${PAD_LIGHT}"/>` +
+		(cut !== "classic"
+			? `<rect x="0" y="480" width="400" height="310" fill="url(#${clip}m)"/>`
+			: "") +
+		(cut === "modern"
+			? `<path fill="none" stroke="#000" stroke-opacity="0.13" stroke-width="3" d="${mapPath("M31 42 Q35 72 32 107 M69 42 Q65 72 68 107")}"/>`
+			: "") +
+		`<rect x="0" y="480" width="400" height="310" fill="url(#${clip}s)"/>` +
+		`<rect x="0" y="480" width="400" height="310" fill="url(#${clip}h)"/>` +
+		`<path fill="none" stroke="${trim}" stroke-width="${collarW}" stroke-linejoin="round" d="${NECK}"/>` +
+		`</g>` +
+		chest +
+		`<path fill="none" stroke="#000" stroke-width="6" d="${OUTLINE}"/>`;
+
+	const id = `nfl-${key}-${hash(svg)}`;
+	const table = (svgs as Record<string, Record<string, string>>).jersey!;
+	table[id] ??= svg;
+	return id;
+};
+
+// facesjs's body (the skin under the jersey) runs to the bottom of its frame as wide as the shoulders, so it would show
+// beside the arms under the sleeves. With a mod jersey the face uses a copy cut off just under the shoulders.
+export const registerFaceBody = (bodyId: string) => {
+	const table = (svgs as Record<string, Record<string, string>>).body!;
+	const original = table[bodyId];
+	if (!original) {
+		return bodyId;
+	}
+	const id = `nfl-${bodyId}`;
+	table[id] ??=
+		`<defs><clipPath id="nflfjbody"><rect x="-50" y="0" width="500" height="596"/></clipPath></defs>` +
+		`<g clip-path="url(#nflfjbody)">${original}</g>`;
+	return id;
+};
