+				line({ t: "IX", y: 200, size: 120, fill: "#3BA9D9", font: SERIF, italic: true, stroke: "#1E6E9A", sw: 2, w: 120 })
+			);
+		case 10:
+			// SUPER over BOWL, the big X standing beside both
+			return (
+				line({ t: "SUPER", x: 18, anchor: "start", y: 118, size: 58, fill: "#1D4FA8", font: HELV, weight: 700, ls: -2, w: 148 }) +
+				line({ t: "BOWL", x: 18, anchor: "start", y: 172, size: 58, fill: "#1D4FA8", font: HELV, weight: 700, ls: -2, w: 136 }) +
+				line({ t: "X", x: 240, anchor: "end", y: 172, size: 132, fill: "#1D4FA8", font: HELV, weight: 700, w: 86 })
+			);
+		case 11:
+			return line({ t: "SUPER BOWL XI", y: 142, size: 46, fill: "#fff", font: BLOCK, extrude: [3, 3, "#2B4BB0", 3], stroke: "#E31B23", sw: 3, w: 236 });
+		case 12:
+			return (
+				line({ t: "SUPER BOWL", y: 112, size: 44, fill: "#7B3F9E", font: BLOCK, stroke: "#4A1F66", sw: 2, w: 224 }) +
+				line({ t: "XII", x: 150, y: 196, size: 88, fill: "#C5D62A", font: SCRIPT, italic: true, stroke: "#5A7A12", sw: 3, w: 130 })
