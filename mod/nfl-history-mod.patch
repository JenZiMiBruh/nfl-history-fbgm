+// ---- Player sprites: one consistent shape for everyone ----
+// A face (Football GM's cartoon) is drawn with the browser's DOM; the element must be in the page, because the face
+// library measures its parts to place them (off the page every measurement is zero, which is what misplaced the eyes).
+const faceImages = new Map<string, Promise<HTMLImageElement | undefined>>();
+// (each picture is fetched once per session: the photos warmed before kickoff are the ones the sprites then use)
+const imageCache = new Map<string, Promise<HTMLImageElement | undefined>>();
+export const loadImage = (src: string) => {
+	const hit = imageCache.get(src);
+	if (hit) return hit;
+	const p = new Promise<HTMLImageElement | undefined>((resolve) => {
+		const img = new Image();
+		img.crossOrigin = "anonymous";
+		img.onload = () => resolve(img);
+		img.onerror = () => {
+			imageCache.delete(src); // a failed load can try again later
+			resolve(undefined);
+		};
+		img.src = src;
+	});
+	// (generated faces are data: URLs drawn once each and cached by the face code itself)
+	if (!src.startsWith("data:")) imageCache.set(src, p);
+	return p;
+};
+// Faces are drawn one at a time, a few milliseconds apart, so a stadium full of them never freezes the page
+// Players on the field come first; sideline players, crew and fans only when the browser has spare time, so the
+// start of the game never stutters
+type FaceJob = { run: () => void };
+const faceHi: FaceJob[] = [];
+const faceLo: FaceJob[] = [];
+let facePumping = false;
+let faceHiRunning = 0;
+export const fieldFacesPending = () => faceHi.length + faceHiRunning;
+// The intro waits for everyone, the sideline too
+if (typeof window !== "undefined")
+	(window as any).__nflFacesPending = () =>
+		faceHi.length + faceHiRunning + faceLo.length + helmetsRunning;
+const idle = (cb: (deadline: { timeRemaining: () => number }) => void) => {
+	const ric = (window as any).requestIdleCallback as
+		| undefined
+		| ((f: any, o?: any) => number);
+	if (ric) ric(cb, { timeout: 400 });
+	else setTimeout(() => cb({ timeRemaining: () => 8 }), 30);
+};
+const pumpFaces = () => {
+	if (facePumping) return;
+	facePumping = true;
+	const step = (deadline: { timeRemaining: () => number }) => {
+		// One face per idle slot when there's time (each takes a few milliseconds)
+		const rush = !!(window as any).__nflLoadingCover;
+		// Behind the loading screen nothing else is happening: draw a batch at a time (about 30 ms of work)
+		const t0 = performance.now();
+		do {
+			const job =
+				faceHi.shift() ??
+				(rush || deadline.timeRemaining() > 6 ? faceLo.shift() : undefined);
+			if (!job) break;
+			job.run();
+		} while (rush && performance.now() - t0 < 30);
+		if (faceHi.length || faceLo.length)
+			(rush
+				? (cb: typeof step) =>
+						setTimeout(() => cb({ timeRemaining: () => 50 }), 0)
+				: idle)(step);
+		else facePumping = false;
+	};
+	idle(step);
+};
+// NFL history mod: a short fingerprint of a face, so the face caches are keyed by the face itself. Keyed by player
+// alone, a made-up stand-in drawn before his real face arrived stayed on the field for the rest of the session.
+export const faceFingerprint = (face: unknown) => {
+	const s = JSON.stringify(face ?? null);
+	let h = 2166136261;
+	for (let i = 0; i < s.length; i++) {
+		h ^= s.charCodeAt(i);
+		h = Math.imul(h, 16777619);
+	}
+	return (h >>> 0).toString(36);
+};
+export const cartoonFace = (
+	pid: number,
+	face: any,
+	colors: string[],
+	jersey?: string,
+	low = false,
+) => {
+	const key = `${pid}:${faceFingerprint(face)}:${colors.join(",")}`;
+	const cached = faceImages.get(key);
+	if (cached) return cached;
+	const job = new Promise<HTMLImageElement | undefined>((resolve) => {
+		if (low)
+			faceLo.push({
+				run: () => void drawFace(pid, face, colors, jersey).then(resolve),
+			});
+		else
+			faceHi.push({
+				run: () => {
+					faceHiRunning++;
+					void drawFace(pid, face, colors, jersey).then((r) => {
+						faceHiRunning--;
+						resolve(r);
+					});
+				},
+			});
+	});
+	faceImages.set(key, job);
+	pumpFaces();
+	return job;
+};
+const drawFace = (
+	pid: number,
+	face: any,
+	colors: string[],
+	jersey?: string,
+) => {
+	// No hats (the face library has a Santa hat among its random accessories): a bare head for the field
+	if (
+		typeof face?.accessories?.id === "string" &&
+		/hat/i.test(face.accessories.id)
+	)
+		face = { ...face, accessories: { ...face.accessories, id: "none" } };
+	const key = `${pid}:${faceFingerprint(face)}:${colors.join(",")}`;
+	let p: Promise<HTMLImageElement | undefined> | undefined;
+	{
+		const host = document.createElement("div");
+		host.style.cssText =
+			"position:fixed;left:-10000px;top:0;width:400px;height:600px;visibility:hidden;pointer-events:none";
+		document.body.appendChild(host);
+		let svg = "";
+		for (const overrides of [
+			{ teamColors: colors, jersey: { id: jersey ?? "football" } },
+			{ teamColors: colors, jersey: { id: "football" } },
+			{ teamColors: colors },
+		]) {
+			try {
+				host.innerHTML = "";
+				display(host, face, overrides as any);
+				svg = host.innerHTML;
+				if (svg.includes("<svg")) break;
+			} catch {
+				svg = "";
+			}
+		}
+		host.remove();
+		// A fixed size: with width="100%" the browser draws the image blank on a canvas
+		svg = svg.replace('width="100%" height="100%"', 'width="400" height="600"');
+		if (!svg.includes("xmlns="))
+			svg = svg.replace("<svg", '<svg xmlns="http://www.w3.org/2000/svg"');
+		if (svg.includes("xlink:") && !svg.includes("xmlns:xlink"))
+			svg = svg.replace(
+				"<svg",
+				'<svg xmlns:xlink="http://www.w3.org/1999/xlink"',
+			);
+		p = svg.includes("<svg")
+			? loadImage(`data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`)
+			: Promise.resolve(undefined);
+		faceImages.set(key, p);
+	}
+	return p;
+};
