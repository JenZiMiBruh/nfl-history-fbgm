+								}}
+							/>
+						))
+					: null}
+			</div>
+		);
+	}
+	const piece = (i: number) =>
+		kind === "christmas"
+			? "❄"
+			: kind === "thanksgiving"
+				? ["🍂", "🍁"][i % 2]
+				: ["🦇", "🎃"][i % 2];
