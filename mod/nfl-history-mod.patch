+// NFL history mod: Real Draft Ratings switched in a league. Off: prospects take their real first-season ratings (the draft
+// ones are kept on the player). On: the kept ones come back.
+const applyNflDraftRatings = async (
+	gameAttributes: Partial<GameAttributesLeague>,
+) => {
+	const next = gameAttributes.nflRealDraftRatings;
+	if (next === undefined || next === g.get("nflRealDraftRatings")) {
+		return;
+	}
+	const prospects: any[] = await idb.cache.players.indexGetAll(
+		"playersByTeam",
+		PLAYER.UNDRAFTED,
+	);
+	for (const p of prospects) {
+		const ratings = p.ratings.at(-1);
+		if (next) {
+			if (!p.nflDraftRatings) {
+				continue;
+			}
+			Object.assign(ratings, p.nflDraftRatings);
+			delete p.nflDraftRatings;
+		} else {
+			const seasons = Object.keys(p.realRatings ?? {}).map(Number);
+			if (seasons.length === 0) {
+				continue;
+			}
+			const real = p.realRatings[Math.min(...seasons)];
+			const kept: Record<string, number> = {};
+			for (const key of Object.keys(real)) {
+				kept[key] = ratings[key];
+				ratings[key] = real[key];
+			}
+			p.nflDraftRatings = kept;
+		}
+		await player.develop(p, 0);
+		await player.updateValues(p);
+		await idb.cache.players.put(p);
+	}
+};
