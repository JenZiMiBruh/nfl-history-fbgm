+// NFL history mod: the Calendar page's other two views. The wall calendar (the default) shows a real month with each
+// day's games as logo pairs; the featured view puts one game in a big team-colored banner, with the week's games
+// beside the league's projected wins. The list view is the original page, in NflCalendar.tsx.
+import { useMemo, useState, type ReactNode } from "react";
+import { Modal } from "../components/Modal.tsx";
+import { helpers } from "../util/helpers.ts";
+import { toWorker } from "../util/toWorker.ts";
+import type { View } from "../../common/types.ts";
+import { calendarKey, type NflGameInfo } from "../../common/nflCalendar.ts";
+import { readableOn, slotStyle } from "../components/NflGameInfo.tsx";
+import { GameLine, projectTeam } from "../components/NflProjections.tsx";
+
+type Game = View<"nflCalendar">["games"][number];
+type Teams = View<"nflCalendar">["teams"];
+type Team = Teams[number];
+export type Entry = { game: Game; info: NflGameInfo };
+
+const MONTHS = [
+	"January",
+	"February",
+	"March",
+	"April",
+	"May",
+	"June",
+	"July",
+	"August",
+	"September",
+	"October",
+	"November",
+	"December",
+];
+const WEEKDAYS = [
+	"Sunday",
+	"Monday",
+	"Tuesday",
+	"Wednesday",
+	"Thursday",
+	"Friday",
+	"Saturday",
+];
+const dayKey = (date: Date) => date.toISOString().slice(0, 10);
+
+const Logo = ({ t, size }: { t: Team | undefined; size: number }) =>
+	t?.imgURL ? (
+		<img
+			src={t.imgURL}
+			alt={t.abbrev}
+			title={`${t.region} ${t.name}`}
+			style={{ width: size, height: size, objectFit: "contain", flex: "none" }}
+		/>
+	) : (
+		<span
+			className="fw-bold"
+			style={{ fontSize: size * 0.4, width: size, textAlign: "center" }}
+		>
+			{t?.abbrev ?? "TBD"}
+		</span>
+	);
+
+const CSS = `
+.nflw-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
+.nflw-dow { text-align: center; font-size: .75rem; color: var(--bs-secondary-color); padding-bottom: 2px; }
+.nflw-cell { min-height: 104px; border-radius: 6px; padding: 5px 6px; background: var(--bs-tertiary-bg); border: 1px solid transparent; text-align: left; color: inherit; display: flex; flex-direction: column; gap: 3px; }
+.nflw-cell.empty { background: transparent; }
+.nflw-cell.quiet { opacity: .45; }
+.nflw-cell.games { cursor: pointer; }
+.nflw-cell.games:hover { border-color: var(--bs-border-color); }
+.nflw-cell.sel { border-color: var(--bs-primary) !important; box-shadow: 0 0 0 1px var(--bs-primary); }
+.nflw-num { display: flex; justify-content: space-between; align-items: baseline; font-weight: 600; font-size: .85rem; }
+.nflw-tag { font-size: .68rem; font-weight: 700; letter-spacing: .02em; }
+.nflw-pairs { display: flex; flex-wrap: wrap; gap: 3px 6px; }
+.nflw-pair { display: inline-flex; align-items: center; gap: 1px; border-radius: 4px; padding: 1px; }
+.nflw-pair.mine { box-shadow: 0 0 0 2px var(--bs-body-color); }
+.nflw-more { font-size: .72rem; color: var(--bs-secondary-color); }
+.nflw-ev { font-size: .68rem; font-weight: 700; line-height: 1.15; padding-left: 4px; border-left: 3px solid; }
+.nflw-card { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 10px; padding: 12px 4px; border-bottom: 1px solid var(--bs-border-color); }
+.nflw-card:last-child { border-bottom: 0; }
+.nflw-side { display: flex; align-items: center; gap: 10px; min-width: 0; }
+.nflw-side.home { justify-content: flex-end; text-align: right; }
+.nflw-team { font-weight: 700; line-height: 1.1; }
+.nflw-score { font-size: 1.6rem; font-weight: 800; font-variant-numeric: tabular-nums; }
+.nflf-hero { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); border-radius: 10px; overflow: hidden; margin-bottom: 18px; border: 1px solid var(--bs-border-color); }
+.nflf-side { display: flex; align-items: center; gap: 14px; padding: 18px 22px; min-width: 0; }
+.nflf-side.home { justify-content: flex-end; text-align: right; }
+.nflf-name { font-size: 1.6rem; font-weight: 800; line-height: 1.05; }
+.nflf-region { font-size: .85rem; opacity: .85; }
+.nflf-mid { padding: 10px 22px; text-align: center; display: flex; flex-direction: column; justify-content: center; gap: 2px; background: var(--bs-body-bg); }
+.nflf-cols { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 28px; align-items: start; }
+@media (max-width: 767px) {
+	.nflw-cell { min-height: 70px; padding: 3px; }
+	.nflw-pair img { width: 14px !important; height: 14px !important; }
+	.nflf-hero { grid-template-columns: 1fr; }
+	.nflf-side, .nflf-side.home { justify-content: flex-start; text-align: left; padding: 12px 16px; }
+	.nflf-name { font-size: 1.2rem; }
+	.nflf-cols { grid-template-columns: 1fr; }
+}
+`;
+
+// ---- Wall calendar ----------------------------------------------------------------------------------------------
+
+// A league date on the calendar: the trade deadline, season start and end, playoffs, Super Bowl, free agency, draft
+export type CalEvent = { date: Date; label: string; color: string; note?: string };
+
+// One game in the day pop-up: both teams big, the score or kickoff, the slot and network, and Watch
+const DayGame = ({
+	e,
+	teams,
+	season,
+	canWatch,
+}: {
+	e: Entry;
+	teams: Teams;
+	season: number;
+	canWatch: boolean;
+}) => {
+	const { game, info } = e;
+	const away = teams[game.awayTid];
+	const home = teams[game.homeTid];
+	const played = game.homePts !== undefined && game.awayPts !== undefined;
+	const st = slotStyle(info);
+	const side = (t: Team | undefined, pts: number | undefined, other: number | undefined, isHome: boolean) => {
+		const name = (
+			<div style={{ minWidth: 0 }}>
+				<div className="small text-body-secondary text-truncate">{t?.region ?? ""}</div>
+				<div className="nflw-team text-truncate">{t?.name ?? "TBD"}</div>
+			</div>
+		);
+		const score = played ? (
+			<span className={`nflw-score${pts! < other! ? " text-body-secondary" : ""}`}>{pts}</span>
+		) : null;
+		return (
+			<div className={`nflw-side${isHome ? " home" : ""}`}>
+				{isHome ? (
+					<>
+						{score}
+						{name}
+						<Logo t={t} size={40} />
+					</>
+				) : (
+					<>
+						<Logo t={t} size={40} />
+						{name}
+						{score}
+					</>
+				)}
+			</div>
+		);
+	};
+	return (
+		<div className="nflw-card">
+			{side(away, game.awayPts, game.homePts, false)}
+			<div className="text-center" style={{ minWidth: 120 }}>
+				<div className="fw-bold">
+					{played ? "Final" : `${info.timeEstimated ? "~" : ""}${info.timeText}`}
+				</div>
+				{st ? (
+					<span className="badge" style={{ background: st.bg, color: st.fg }}>
+						{st.label}
+						{info.network ? ` · ${info.network}` : ""}
+					</span>
+				) : info.network ? (
+					<div className="small">{info.network}</div>
+				) : null}
+				<div className="small mt-1">
+					<GameLine teams={teams as any} game={game} />
+				</div>
+				<div className="d-flex justify-content-center gap-1 mt-1">
+					{canWatch && game.gid !== undefined ? (
+						<>
+							<button
+								type="button"
+								className="btn btn-sm btn-success"
+								onClick={() => toWorker("actions", "liveGame", game.gid!)}
+							>
+								Watch
+							</button>
+							<button
+								type="button"
+								className="btn btn-sm btn-secondary"
+								onClick={() => toWorker("actions", "simGame", game.gid!)}
+							>
+								Sim
+							</button>
+						</>
+					) : !played && !game.pending && game.gid !== undefined ? (
+						<button
+							type="button"
+							className="btn btn-sm btn-secondary"
+							onClick={() => toWorker("actions", "simToGame", game.gid!)}
+							title="Sim every game before this one"
+						>
+							Sim to
+						</button>
+					) : played && game.gid !== undefined && home ? (
+						<a
+							className="btn btn-sm btn-secondary"
+							href={helpers.leagueUrl([
+								"game_log",
+								`${home.abbrev}_${game.homeTid}`,
+								season,
+								game.gid,
+							])}
+						>
+							Box score
+						</a>
+					) : null}
+				</div>
+			</div>
+			{side(home, game.homePts, game.awayPts, true)}
+			<div className="small text-body-secondary text-center" style={{ gridColumn: "1 / -1", marginTop: -4 }}>
+				{info.stadium}
+				{info.weatherText ? ` · ${info.weatherText}` : ""}
+			</div>
+		</div>
+	);
+};
+
+export const WallCalendar = ({
+	entries,
+	events,
+	teams,
+	focusTid,
+	season,
+	startEntry,
+	gamesOfTheWeek,
+	canWatch,
+}: {
+	entries: Entry[];
+	events: CalEvent[];
+	teams: Teams;
+	focusTid: number;
+	season: number;
+	startEntry: Entry | undefined;
+	gamesOfTheWeek: Set<string>;
+	canWatch: (e: Entry) => boolean;
+}) => {
+	const byDate = useMemo(() => {
+		const map = new Map<string, Entry[]>();
+		for (const e of entries) {
+			const k = dayKey(e.info.date);
+			map.set(k, [...(map.get(k) ?? []), e]);
+		}
+		return map;
+	}, [entries]);
+	const eventsByDate = useMemo(() => {
+		const map = new Map<string, CalEvent[]>();
+		for (const ev of events) {
+			const k = dayKey(ev.date);
+			map.set(k, [...(map.get(k) ?? []), ev]);
+		}
+		return map;
+	}, [events]);
+
+	// The months that have games or league dates, in order
+	const months = useMemo(() => {
+		const dates = [...entries.map((e) => e.info.date), ...events.map((e) => e.date)];
+		const keys = [...new Set(dates.map((d) => d.getUTCFullYear() * 12 + d.getUTCMonth()))].sort(
+			(a, b) => a - b,
+		);
+		return keys.map((k) => [Math.floor(k / 12), k % 12] as [number, number]);
+	}, [entries, events]);
+
+	const start = startEntry ?? entries[0];
+	const [monthIndex, setMonthIndex] = useState<number | undefined>();
+	const [open, setOpen] = useState<string | undefined>();
+	const startMonth = start
+		? months.findIndex(
+				([y, m]) =>
+					y === start.info.date.getUTCFullYear() &&
+					m === start.info.date.getUTCMonth(),
+			)
+		: 0;
+	if (months.length === 0) return null;
+	const mi = Math.max(0, Math.min(months.length - 1, monthIndex ?? Math.max(0, startMonth)));
+	const [y, m] = months[mi]!;
+	const nextKey = start ? dayKey(start.info.date) : undefined;
+
+	const first = new Date(Date.UTC(y, m, 1));
+	const daysInMonth = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
+	const cells: (Date | undefined)[] = [];
+	for (let i = 0; i < first.getUTCDay(); i++) cells.push(undefined);
+	for (let d = 1; d <= daysInMonth; d++) cells.push(new Date(Date.UTC(y, m, d)));
+	while (cells.length % 7) cells.push(undefined);
+
+	const openList = open ? (byDate.get(open) ?? []) : [];
+	const openEvents = open ? (eventsByDate.get(open) ?? []) : [];
+	const openDate = open ? new Date(`${open}T12:00:00Z`) : undefined;
+	const name = (tid: number) => (tid < 0 ? "TBD" : (teams[tid]?.abbrev ?? "?"));
+
+	return (
+		<div className="mb-4" style={{ maxWidth: 1040 }}>
+			<style>{CSS}</style>
+			<div className="d-flex align-items-center gap-2 mb-2">
+				<button
+					type="button"
+					className="btn btn-sm btn-secondary"
+					disabled={mi <= 0}
+					onClick={() => setMonthIndex(mi - 1)}
+					aria-label="Previous month"
+				>
+					‹
+				</button>
+				<h2 className="mb-0" style={{ minWidth: 200 }}>
+					{MONTHS[m]} {y}
+				</h2>
+				<button
+					type="button"
+					className="btn btn-sm btn-secondary"
+					disabled={mi >= months.length - 1}
+					onClick={() => setMonthIndex(mi + 1)}
+					aria-label="Next month"
+				>
+					›
+				</button>
+			</div>
+			<div className="nflw-grid">
+				{["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map((d) => (
+					<div key={d} className="nflw-dow">
+						{d}
+					</div>
+				))}
+				{cells.map((date, i) => {
+					if (!date) return <div key={i} className="nflw-cell empty" />;
+					const k = dayKey(date);
+					const list = byDate.get(k) ?? [];
+					const evs = eventsByDate.get(k) ?? [];
+					const active = list.length > 0 || evs.length > 0;
+					// A day where every game is in one special slot (TNF, MNF, Thanksgiving, playoffs) takes that slot's color
+					const styles = list.map((e) => slotStyle(e.info));
+					const st =
+						list.length > 0 && styles.every((s) => s && s.label === styles[0]!.label)
+							? styles[0]
+							: list.some((e) => e.info.superBowl || e.info.round)
+								? styles.find(Boolean)
+								: undefined;
+					const shown = list.slice(0, evs.length ? 6 : 8);
+					return (
+						<button
+							type="button"
+							key={i}
+							disabled={!active}
+							className={`nflw-cell${active ? " games" : " quiet"}${k === nextKey ? " sel" : ""}`}
+							style={st ? { background: `${st.bg}40`, borderColor: st.bg } : undefined}
+							onClick={() => setOpen(k)}
+							title={
+								list.length
+									? list
+											.map(
+												(e) =>
+													`${name(e.game.awayTid)} ${e.game.neutralSite ? "vs" : "@"} ${name(e.game.homeTid)}`,
+											)
+											.join("\n")
+									: evs.map((ev) => ev.label).join("\n") || undefined
+							}
+						>
+							<span className="nflw-num">
+								{date.getUTCDate()}
+								{st ? (
+									<span className="nflw-tag" style={{ color: st.bg }}>
+										{st.label}
+									</span>
+								) : list.length > 1 ? (
+									<span className="nflw-more fw-normal">{list.length} games</span>
+								) : null}
+							</span>
+							{evs.map((ev) => (
+								<span key={ev.label} className="nflw-ev" style={{ borderColor: ev.color, color: ev.color }}>
+									{ev.label}
+								</span>
+							))}
+							<span className="nflw-pairs">
+								{shown.map((e) => {
+									const mine = e.game.homeTid === focusTid || e.game.awayTid === focusTid;
+									const gotw = gamesOfTheWeek.has(calendarKey(e.game));
+									return (
+										<span
+											key={calendarKey(e.game)}
+											className={`nflw-pair${mine ? " mine" : ""}`}
+											style={gotw && !mine ? { boxShadow: "0 0 0 2px #15803d" } : undefined}
+										>
+											<Logo t={teams[e.game.awayTid]} size={20} />
+											<Logo t={teams[e.game.homeTid]} size={20} />
+										</span>
+									);
+								})}
+								{list.length > shown.length ? (
+									<span className="nflw-more">+{list.length - shown.length}</span>
+								) : null}
+							</span>
+						</button>
+					);
+				})}
+			</div>
+			<div className="small text-body-secondary mt-2 d-flex flex-wrap gap-3">
+				<span>
+					<span
+						className="d-inline-block align-middle me-1"
+						style={{ width: 12, height: 12, borderRadius: 3, boxShadow: "0 0 0 2px var(--bs-body-color)" }}
+					/>
+					{teams[focusTid]?.abbrev ?? "Your"} game
+				</span>
+				<span>
+					<span
+						className="d-inline-block align-middle me-1"
+						style={{ width: 12, height: 12, borderRadius: 3, boxShadow: "0 0 0 2px #15803d" }}
+					/>
+					Game of the Week
+				</span>
+				<span>Click a day for its games</span>
+			</div>
+
+			<Modal show={open !== undefined} onHide={() => setOpen(undefined)} size="lg" scrollable>
+				<Modal.Header closeButton>
+					<Modal.Title>
+						{openDate
+							? `${WEEKDAYS[openDate.getUTCDay()]}, ${MONTHS[openDate.getUTCMonth()]} ${openDate.getUTCDate()}, ${openDate.getUTCFullYear()}`
+							: ""}
+						{openList[0] ? (
+							<span className="text-body-secondary fw-normal fs-6 ms-2">
+								{openList[0].info.round ??
+									(openList[0].info.week !== undefined ? `Week ${openList[0].info.week}` : "")}
+								{" · "}
+								{openList.length} game{openList.length === 1 ? "" : "s"}
+							</span>
+						) : null}
+					</Modal.Title>
+				</Modal.Header>
+				<Modal.Body>
+					{openEvents.map((ev) => (
+						<div
+							key={ev.label}
+							className="mb-2 ps-2"
+							style={{ borderLeft: `4px solid ${ev.color}` }}
+						>
+							<div className="fw-bold">{ev.label}</div>
+							{ev.note ? <div className="small text-body-secondary">{ev.note}</div> : null}
+						</div>
+					))}
+					{openList.map((e) => (
+						<DayGame
+							key={calendarKey(e.game)}
+							e={e}
+							teams={teams}
+							season={season}
+							canWatch={canWatch(e)}
+						/>
+					))}
+					{openList.length === 0 && openEvents.length === 0 ? (
+						<div className="text-body-secondary">Nothing on this day.</div>
+					) : null}
+				</Modal.Body>
+			</Modal>
+		</div>
+	);
+};
+
+// ---- Featured game + sidebar -------------------------------------------------------------------------------------
+
+const HeroSide = ({
+	t,
+	home,
+	pts,
+}: {
+	t: Team | undefined;
+	home?: boolean;
+	pts?: number;
+}) => {
+	const bg = t?.colors[0] ?? "#495057";
+	const fg = readableOn(bg);
+	const logo = <Logo t={t} size={64} />;
+	return (
+		<div
+			className={`nflf-side${home ? " home" : ""}`}
+			style={{ background: bg, color: fg }}
+		>
+			{home ? null : logo}
+			<div style={{ minWidth: 0 }}>
+				<div className="nflf-region">{t?.region ?? ""}</div>
+				<div className="nflf-name">{t?.name ?? "TBD"}</div>
+			</div>
+			{pts !== undefined ? (
+				<div className="fs-2 fw-bold" style={{ marginLeft: home ? 0 : "auto" }}>
+					{pts}
+				</div>
+			) : null}
+			{home ? logo : null}
+		</div>
+	);
+};
+
+export const FeaturedView = ({
+	week,
+	teams,
+	focusTid,
+	gamesOfTheWeek,
+	games,
+	showProjections,
+	renderGame,
+}: {
+	week: { label: string; sub: string; entries: Entry[] };
+	teams: Teams;
+	focusTid: number;
+	gamesOfTheWeek: Set<string>;
+	games: Game[];
+	showProjections: boolean;
+	renderGame: (e: Entry) => ReactNode;
+}) => {
+	// The banner: your game this week, else the Game of the Week, else the first primetime game
+	const mine = week.entries.find(
+		(e) => e.game.homeTid === focusTid || e.game.awayTid === focusTid,
+	);
+	const gotw = week.entries.find((e) => gamesOfTheWeek.has(calendarKey(e.game)));
+	const hero =
+		mine ?? gotw ?? week.entries.find((e) => e.info.primetime) ?? week.entries[0];
+
+	const days = useMemo(() => {
+		const out: { key: string; date: Date; entries: Entry[] }[] = [];
+		for (const e of week.entries) {
+			const k = dayKey(e.info.date);
+			let d = out.find((x) => x.key === k);
+			if (!d) {
+				d = { key: k, date: e.info.date, entries: [] };
+				out.push(d);
+			}
+			d.entries.push(e);
+		}
+		return out;
+	}, [week]);
+
+	const rows = useMemo(() => {
+		if (!showProjections) return [];
+		return Object.keys(teams)
+			.map(Number)
+			.filter(
+				(tid) =>
+					teams[tid]?.ovr !== undefined &&
+					games.some((g) => !g.playoffs && (g.homeTid === tid || g.awayTid === tid)),
+			)
+			.map((tid) => ({ tid, ...projectTeam(teams as any, games, tid) }))
+			.sort((a, b) => b.projW - a.projW);
+	}, [showProjections, teams, games]);
+	const most = Math.max(1, ...rows.map((r) => r.w + r.l + r.tie + r.left));
+
+	if (!hero) return null;
+	const played = hero.game.homePts !== undefined;
+	const st = slotStyle(hero.info);
+
+	return (
+		<div className="mb-4" style={{ maxWidth: 1100 }}>
+			<style>{CSS}</style>
+			<div className="nflf-hero">
+				<HeroSide t={teams[hero.game.awayTid]} pts={hero.game.awayPts} />
+				<div className="nflf-mid">
+					<div
+						className="small text-body-secondary text-uppercase fw-semibold"
+						style={{ letterSpacing: 1 }}
+					>
+						{hero === mine
+							? `${teams[focusTid]?.abbrev ?? "Your"} game`
+							: hero === gotw
+								? "Game of the Week"
+								: (st?.label ?? "Featured")}
+					</div>
+					<div className="fw-bold fs-5">
+						{played
+							? "Final"
+							: `${hero.info.dateText.split(",")[0]} ${hero.info.timeText.replace(" ET", "")}`}
+					</div>
+					{hero.info.network ? (
+						<div>
+							{st ? (
+								<span
+									className="badge"
+									style={{ background: st.bg, color: st.fg }}
+								>
+									{st.label} · {hero.info.network}
+								</span>
+							) : (
+								<span className="small">{hero.info.network}</span>
+							)}
+						</div>
+					) : null}
+					<div className="small">
+						<GameLine teams={teams as any} game={hero.game} />
+					</div>
+					<div className="small text-body-secondary">{hero.info.stadium}</div>
+				</div>
+				<HeroSide t={teams[hero.game.homeTid]} home pts={hero.game.homePts} />
+			</div>
+
+			<div className={rows.length ? "nflf-cols" : undefined}>
+				<div
+					className="rounded-3 overflow-hidden"
+					style={{ border: "1px solid var(--bs-border-color)" }}
+				>
+					{days.map((d) => (
+						<div key={d.key}>
+							<div
+								className="d-flex align-items-baseline gap-2 px-2 py-1"
+								style={{ background: "var(--bs-tertiary-bg)" }}
+							>
+								<span className="fw-bold">{WEEKDAYS[d.date.getUTCDay()]}</span>
+								<span className="text-body-secondary">
+									{MONTHS[d.date.getUTCMonth()]} {d.date.getUTCDate()}
+								</span>
+								<span className="text-body-secondary small ms-auto">
+									{d.entries.length} game{d.entries.length === 1 ? "" : "s"}
+								</span>
+							</div>
+							{d.entries.map((e) => (
+								<div key={calendarKey(e.game)}>{renderGame(e)}</div>
+							))}
+						</div>
+					))}
+				</div>
+				{rows.length ? (
+					<div>
+						<h3 className="mb-1">Projected wins</h3>
+						<div className="small text-body-secondary mb-2">
+							Record so far plus the betting lines of the games left
+						</div>
+						{rows.map((r, i) => {
+							const t = teams[r.tid]!;
+							return (
+								<div
+									key={r.tid}
+									className="d-flex align-items-center gap-2 small py-1"
+									style={{
+										fontWeight: r.tid === focusTid ? 700 : undefined,
+									}}
+								>
+									<span
+										className="text-body-secondary"
+										style={{ width: 18, textAlign: "right" }}
+									>
+										{i + 1}
+									</span>
+									<Logo t={t} size={18} />
+									<span style={{ width: 36 }}>{t.abbrev}</span>
+									<div
+										className="flex-grow-1 rounded"
+										style={{
+											height: 10,
+											background: "rgba(128,128,128,.18)",
+											position: "relative",
+											overflow: "hidden",
+										}}
+									>
+										<div
+											style={{
+												position: "absolute",
+												inset: 0,
+												width: `${(r.w / most) * 100}%`,
+												background: t.colors[0],
+											}}
+										/>
+										<div
+											style={{
+												position: "absolute",
+												top: 0,
+												bottom: 0,
+												left: `${(r.w / most) * 100}%`,
+												width: `${((r.projW - r.w) / most) * 100}%`,
+												background: t.colors[0],
+												opacity: 0.4,
+											}}
+										/>
+									</div>
+									<span
+										style={{
+											width: 34,
+											textAlign: "right",
+											fontVariantNumeric: "tabular-nums",
+										}}
+									>
+										{r.projW.toFixed(1)}
+									</span>
+								</div>
+							);
+						})}
+					</div>
+				) : null}
+			</div>
+		</div>
+	);
+};
