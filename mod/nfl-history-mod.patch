+						<button
+							className="btn btn-primary"
+							type="button"
+							onClick={build}
+							disabled={disabled}
+						>
+							Build league
+						</button>
+					</div>
+				)}
+				{status ? <p className="mt-2 mb-0">{status}</p> : null}
+				{loaded && (window as any).NFL_MOD_BUILT ? (
