+			return `<path d='M52 136 L52 120 Q128 88 204 120 L204 136 Z' ${s}/>` + [70, 90, 110, 146, 166, 186].map((x) => `<path d='M${x} 136 L${x} ${118 - (40 - Math.abs(x - 128)) * 0.3}' stroke='#59616B' stroke-width='1.5'/>`).join("");
+		case 46: // Indianapolis: brick front, arched windows, gabled roof
+			return `<path d='M50 136 L50 108 L90 108 L104 96 L152 96 L166 108 L206 108 L206 136 Z' ${s}/>` + [60, 74, 88, 168, 182, 196].map((x) => `<path d='M${x - 4} 132 L${x - 4} 118 Q${x} 112 ${x + 4} 118 L${x + 4} 132 Z' fill='#7C848E'/>`).join("");
+		case 47: // the Superdome
+			return `<path d='M48 136 L56 118 Q128 92 200 118 L208 136 Z' ${s}/>` + [124, 130].map((y) => `<path d='M58 ${y} Q128 ${y - 12} 198 ${y}' stroke='#59616B' stroke-width='1.5' fill='none'/>`).join("");
+		case 48: // the New York skyline behind the Meadowlands
+			return `<path d='M40 136 L40 112 L52 112 L52 98 L60 98 L60 110 L72 110 L72 90 L80 82 L88 90 L88 136 Z M168 136 L168 96 L176 96 L180 74 L184 96 L192 96 L192 106 L204 106 L204 118 L216 118 L216 136 Z' ${s}/>` + `<path d='M84 136 L84 112 L172 112 L172 136 Z' ${s}/>`;
+		case 49: // Glendale: the ribbed roof
+			return `<path d='M48 136 L56 112 Q128 96 200 112 L208 136 Z' ${s}/>` + [64, 78, 92, 106, 150, 164, 178, 192].map((x) => `<path d='M${x} 134 L${x + (x < 128 ? 3 : -3)} ${112 - (60 - Math.abs(x - 128)) * 0.12}' stroke='#59616B' stroke-width='2'/>`).join("");
+		default: // 50: the Bay Area towers
+			return `<path d='M44 140 L44 112 L60 112 L60 122 L76 122 L76 104 L88 104 L88 140 Z M168 140 L168 106 L182 106 L182 118 L198 118 L198 100 L212 100 L212 140 Z' ${s}/>`;
