+// NFL history mod: the player intro, like the cutscene a video game shows when a quarterback takes the field for the first
+// time, dressed in the game's broadcast package. The player stands big on the left (his own face and jersey, cut out,
+// no frame) in front of his number, huge; light streaks and his team's colors sweep across behind him. On the right:
+// his name, his bio (size, age, college, draft spot, career honors), his season so far in stat boxes and his key
+// ratings filling in.
+import { liveFace } from "./liveFaces.ts";
+import { useEffect, useState } from "react";
+import type { Presentation } from "./NflScoreboard.tsx";
+import { PlayerPicture } from "../../components/PlayerPicture.tsx";
+import { Logo, Ovr, SKINS, type Starter } from "./NflPregame.tsx";
+
+type T = {
+	tid: number;
+	region: string;
+	name: string;
+	abbrev: string;
+	colors?: string[];
+	imgURL?: string;
+	imgURLSmall?: string;
+};
+
+// The NFL passer rating (0 to 158.3)
+const passerRating = (s: any) => {
+	if (!s?.pss) return undefined;
+	const c = (x: number) => Math.max(0, Math.min(2.375, x));
+	const a = c((s.pssCmp / s.pss - 0.3) * 5);
+	const b = c((s.pssYds / s.pss - 3) * 0.25);
+	const t = c((s.pssTD / s.pss) * 20);
+	const i = c(2.375 - (s.pssInt / s.pss) * 25);
+	return ((a + b + t + i) / 6) * 100;
+};
+
+const RATINGS: Record<string, [string, string][]> = {
+	QB: [
+		["thp", "Arm strength"],
+		["tha", "Accuracy"],
+		["thv", "Vision"],
+		["spd", "Speed"],
+	],
+	RB: [
+		["spd", "Speed"],
+		["elu", "Elusiveness"],
+		["bsc", "Ball carrying"],
+		["stre", "Strength"],
+	],
+	WR: [
+		["spd", "Speed"],
+		["hnd", "Hands"],
+		["rtr", "Route running"],
+		["elu", "Elusiveness"],
+	],
+	TE: [
+		["hnd", "Hands"],
+		["rbk", "Run blocking"],
+		["rtr", "Route running"],
+		["stre", "Strength"],
+	],
+};
+
+const height = (inches?: number) =>
+	inches ? `${Math.floor(inches / 12)}'${inches % 12}"` : undefined;
+
+export const NflPlayerIntro = ({
+	player,
+	team,
+	theme,
+	onDone,
+}: {
+	player: Starter & { bio?: any };
+	team: T;
+	theme: Presentation;
+	onDone: () => void;
+}) => {
+	const skin = SKINS[theme.pkg] ?? SKINS.glossy;
+	const c = team.colors?.[0] ?? "#334155";
+	const c2 = team.colors?.[1] ?? "#ffffff";
+	const c3 = team.colors?.[2] ?? c2;
+	const s = player.stats ?? {};
+	const bio = player.bio ?? {};
+	const played = (s.gp ?? 0) > 0;
+	const [go, setGo] = useState(false);
+	useEffect(() => {
+		const a = setTimeout(() => setGo(true), 60);
+		const b = setTimeout(onDone, 7500);
+		return () => {
+			clearTimeout(a);
+			clearTimeout(b);
+		};
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, []);
+	const pos = player.pos;
+	const boxes: [string, string][] =
+		pos === "QB"
+			? [
+					["CMP%", s.pss ? ((100 * s.pssCmp) / s.pss).toFixed(1) : "–"],
+					["YARDS", s.pss ? String(Math.round(s.pssYds)) : "–"],
+					["TD", s.pss ? String(s.pssTD) : "–"],
+					["INT", s.pss ? String(s.pssInt) : "–"],
+					["RATING", s.pss ? passerRating(s)!.toFixed(1) : "–"],
+				]
+			: pos === "RB"
+				? [
+						["CARRIES", String(s.rus ?? 0)],
+						["YARDS", String(Math.round(s.rusYds ?? 0))],
+						["AVG", s.rus ? (s.rusYds / s.rus).toFixed(1) : "–"],
+						["TD", String(s.rusTD ?? 0)],
+						["REC", String(s.rec ?? 0)],
+					]
+				: [
+						["REC", String(s.rec ?? 0)],
+						["YARDS", String(Math.round(s.recYds ?? 0))],
+						["AVG", s.rec ? (s.recYds / s.rec).toFixed(1) : "–"],
+						["TD", String(s.recTD ?? 0)],
+						["GAMES", String(s.gp ?? 0)],
+					];
+	const parts = player.name.split(" ");
+	const first = parts.slice(0, -1).join(" ");
+	const lastName = parts.at(-1) ?? player.name;
+	const draft =
+		bio.draft && bio.draft.round > 0
+			? `${bio.draft.year} draft · Round ${bio.draft.round}, pick ${bio.draft.pick}`
+			: bio.draft
+				? "Undrafted"
+				: undefined;
+	const facts = [
+		height(bio.hgt),
+		bio.weight ? `${bio.weight} lbs` : undefined,
+		bio.age ? `Age ${bio.age}` : undefined,
+		bio.college || undefined,
+		draft,
+	].filter(Boolean) as string[];
+	const honors = [
+		bio.mvp ? `${bio.mvp}× MVP` : undefined,
+		bio.allLeague ? `${bio.allLeague}× All-Pro` : undefined,
