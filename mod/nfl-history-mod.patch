+// NFL history mod: the live game's debug tool (gear menu > Debug tools). Everything to check that the animated game
+// works and how it looks, without waiting for it to happen in a real game:
+//   - readouts: frames per second, the game-flow state (busy, held, cutscene, queue), the movement diagnostics (circling,
+//     stuck, slip-throughs) and the watchdog's log
+//   - scenarios: any kind of play, made up on the spot from the two rosters and played on the field right now
+//   - triggers: every cutscene and graphic on demand
+//   - overrides: time of day, weather, broadcast package, era (season)
+// The overrides live in window.__nflOverride; the field and the broadcast read them every frame.
+import { useEffect, useState } from "react";
+import { createPortal } from "react-dom";
+import { cutscenes } from "./NflCutscene.ts";
+import { ScoreboardMatrix } from "./NflScoreboard.tsx";
+
+export type Override = {
+	hour?: number;
+	weather?: 0 | 1 | 2;
+	pkg?: string;
+	season?: number;
+	// a holiday look on any game: decorations on the bug and holiday timeouts
+	holiday?: "none" | "christmas" | "thanksgiving" | "halloween" | "gold";
+	v: number;
+};
+export const override = (): Override =>
+	((window as any).__nflOverride ??= { v: 0 });
+const bump = (patch: Partial<Override>) => {
+	const o = override();
+	Object.assign(o, patch, { v: o.v + 1 });
+};
+
+export const SCENARIOS = [
+	["run", "Run"],
+	["bigrun", "Big run (TD)"],
+	["pass", "Pass complete"],
+	["deep", "Deep pass (TD)"],
+	["incomplete", "Incomplete"],
+	["interception", "Interception"],
+	["sack", "Sack"],
+	["fumble", "Fumble lost"],
+	["punt", "Punt"],
+	["puntTD", "Punt return TD"],
+	["kickoff", "Kickoff return"],
+	["touchback", "Kickoff touchback"],
+	["onside", "Onside kick"],
+	["fg", "Field goal good"],
+	["fgMiss", "Field goal no good"],
+	["xp", "Extra point"],
+	["kneel", "Kneel"],
+] as const;
+export type Scenario = (typeof SCENARIOS)[number][0];
+
+const fire = (name: string, detail?: unknown) =>
+	window.dispatchEvent(new CustomEvent(name, { detail }));
+
+export const NflDebug = ({
+	onScenario,
+	onTrigger,
+	teams,
+}: {
+	onScenario: (s: Scenario) => void;
+	onTrigger: (t: string) => void;
+	teams?: [any, any];
+}) => {
+	const [boards, setBoards] = useState(false);
+	const [, setTick] = useState(0);
+	const [fps, setFps] = useState(0);
+	useEffect(() => {
+		let frames = 0;
+		let last = performance.now();
+		let raf = 0;
+		const loop = () => {
+			frames++;
+			const now = performance.now();
+			if (now - last >= 1000) {
+				setFps(Math.round((frames * 1000) / (now - last)));
+				frames = 0;
+				last = now;
+				setTick((x) => x + 1);
+			}
+			raf = requestAnimationFrame(loop);
+		};
+		raf = requestAnimationFrame(loop);
+		return () => cancelAnimationFrame(raf);
+	}, []);
+	const d: any = (window as any).__nflDiag ?? {};
+	const gate: any = (window as any).__nflFieldGate ?? {};
+	const sc = cutscenes.current();
+	const o = override();
+	const b = (label: string, onClick: () => void) => (
+		<button
+			key={label}
+			type="button"
+			onClick={onClick}
+			style={{
+				background: "#1f2937",
+				color: "#ffffff",
+				border: "1px solid #374151",
+				borderRadius: 3,
+				fontSize: 11,
+				padding: "1px 6px",
+				margin: 2,
+			}}
+		>
+			{label}
+		</button>
+	);
+	const row = { display: "flex", flexWrap: "wrap" as const, marginBottom: 4 };
+	const h = {
+		fontWeight: 800,
+		letterSpacing: 2,
+		fontSize: 10,
+		opacity: 0.7,
+		textTransform: "uppercase" as const,
+		margin: "4px 0 2px",
+	};
+	return (
+		<div
+			style={{
+				position: "absolute",
+				left: 8,
+				bottom: 8,
+				zIndex: 25,
+				width: 380,
+				maxHeight: "70%",
+				overflowY: "auto",
+				background: "rgba(5,7,12,.94)",
+				color: "#e5e7eb",
+				border: "1px solid #374151",
+				borderRadius: 6,
+				padding: "6px 8px",
+				fontSize: 12,
+				fontFamily: "ui-monospace, Consolas, monospace",
+			}}
+		>
+			<div style={h}>Readouts</div>
+			<div>
+				{fps} fps · busy {String(!!gate.busy)} · held {String(!!gate.held)} ·
+				cutscene {sc ? `${sc.key} ${Math.round(sc.k * 100)}%` : "none"}
+			</div>
+			<div style={{ color: "#93c5fd" }}>{d.state ?? ""}</div>
+			{d.waitOn ? (
+				<div style={{ color: "#fca5a5" }}>snap waiting on: {d.waitOn}</div>
+			) : null}
+			<div>
+				circles {d.circles ?? 0} · stuck {d.stuck ?? 0} · slip-throughs{" "}
+				{d.unstuck ?? 0} · snaps {d.snaps ?? 0} · offside {d.offside ?? 0}
+			</div>
+			{(d.watchdog ?? []).slice(-3).map((w: string, i: number) => (
+				<div key={i} style={{ color: "#fbbf24" }}>
+					⚠ {w}
+				</div>
+			))}
+			<div style={h}>Scenarios (played now, made up from the rosters)</div>
+			<div style={row}>
+				{SCENARIOS.map(([k, label]) => b(label, () => onScenario(k)))}
+			</div>
+			<div style={h}>Cutscenes and graphics</div>
+			<div style={row}>
+				{b("Coin toss", () => onTrigger("coin"))}
+				{b("QB walk-out", () => onTrigger("qb"))}
+				{b("Ref: holding", () =>
+					fire("nfl-penalty", {
+						penaltyName: "Holding",
+						t: 0,
+						names: [],
+						yds: 10,
+						decision: "accept",
+					}),
+				)}
+				{b("Ref: 2 flags", () => {
+					fire("nfl-penalty", {
+						penaltyName: "False start",
+						t: 0,
+						names: [],
+						yds: 5,
+						decision: "accept",
+					});
+					setTimeout(
+						() =>
+							fire("nfl-penalty", {
+								penaltyName: "Offside",
+								t: 1,
+								names: [],
+								yds: 5,
+								decision: "accept",
+								offsetStatus: "offset",
+							}),
+						300,
+					);
+				})}
+				{b("Replay last play", () => onTrigger("replay"))}
+				{b("Switch ends sweep", () => onTrigger("orbit"))}
+				{b("Crowd wave", () => onTrigger("wave"))}
+				{b("TOUCHDOWN graphic", () => fire("nfl-td", 0))}
+				{b("Injury", () => onTrigger("injury"))}
+				{b("Halftime cards", () => onTrigger("halftime"))}
+				{b("Postgame show", () => fire("nfl-debug-final"))}
+				{b("Commercial", () => onTrigger("commercial"))}
+				{b("Skip cutscene", () => cutscenes.skip())}
+				{teams
+					? b("Scoreboard gallery (every combination)", () => setBoards(true))
+					: null}
+			</div>
+			<div style={h}>Overrides</div>
+			<div style={row}>
+				{[undefined, 13, 16.5, 18, 20].map((hr) =>
+					b(hr === undefined ? "Real time" : `${hr}:00`, () =>
+						bump({ hour: hr }),
+					),
+				)}
+			</div>
+			<div style={row}>
+				{([undefined, 0, 1, 2] as const).map((w) =>
+					b(
+						w === undefined ? "Real weather" : ["Clear", "Rain", "Snow"][w]!,
+						() => bump({ weather: w }),
+					),
+				)}
+			</div>
+			<div style={row}>
+				{[
+					undefined,
+					"glossy",
+					"flat",
+					"glass",
+					"angular",
+					"sleek",
+					"premium",
+					"caption",
+					"boxy",
+					"corner",
+					"xmas",
+				].map((p) => b(p ?? "Real package", () => bump({ pkg: p })))}
+			</div>
+			<div style={row}>
+				{(
+					[
+						undefined,
+						"none",
+						"christmas",
+						"thanksgiving",
+						"halloween",
+						"gold",
+					] as const
+				).map((h) =>
+					b(
+						h === undefined
+							? "Real holiday"
+							: h === "gold"
+								? "Super Bowl / Kickoff"
+								: h === "none"
+									? "No holiday"
+									: h[0]!.toUpperCase() + h.slice(1),
+						() => bump({ holiday: h }),
+					),
+				)}
+			</div>
+			<div style={row}>
+				{[undefined, 1975, 1990, 2002, 2020].map((y) =>
+					b(y === undefined ? "Real era" : String(y), () =>
+						bump({ season: y }),
+					),
+				)}
+			</div>
+			{boards && teams
+				? createPortal(
+						<div
+							style={{
+								position: "fixed",
+								inset: 0,
+								zIndex: 2000,
+								background: "rgba(2,6,23,.92)",
+								overflow: "auto",
+								padding: 16,
+								fontFamily: "system-ui, sans-serif",
+							}}
+						>
+							<button
+								type="button"
+								className="btn btn-light btn-sm mb-2"
+								onClick={() => setBoards(false)}
+							>
+								Close
+							</button>
+							<div style={{ maxWidth: 780 }}>
+								<ScoreboardMatrix
+									away={{ ...teams[1], pts: 0 }}
+									home={{ ...teams[0], pts: 0 }}
+								/>
+							</div>
+						</div>,
+						document.body,
+					)
+				: null}
+			<div style={{ opacity: 0.6, fontSize: 10 }}>
+				override:{" "}
+				{JSON.stringify({
+					hour: o.hour,
+					weather: o.weather,
+					pkg: o.pkg,
+					season: o.season,
+				})}
+			</div>
+		</div>
+	);
+};
