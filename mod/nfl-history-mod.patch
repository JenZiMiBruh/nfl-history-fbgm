+	helmetModel ??= new GLTFLoader()
+		.loadAsync("/nfl/models/helmet.glb")
+		.then((g) => {
+			const h = g.scene;
+			const bb = new THREE.Box3().setFromObject(h);
+			const size = bb.getSize(new THREE.Vector3());
+			const k = 2 / Math.max(size.x, size.y, size.z);
+			h.scale.setScalar(k);
+			h.position.copy(bb.getCenter(new THREE.Vector3()).multiplyScalar(-k));
+			const holder = new THREE.Group();
+			holder.add(h);
