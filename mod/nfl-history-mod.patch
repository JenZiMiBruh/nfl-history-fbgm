+export const ScoreboardMatrix = ({
+	away,
+	home,
+}: {
+	away: BoardTeam;
+	home: BoardTeam;
+}) => {
+	const PKGS: Package[] = [
+		"glossy",
+		"flat",
+		"glass",
+		"angular",
+		"sleek",
+		"premium",
+		"caption",
+		"boxy",
+		"corner",
+		"xmas",
+	];
+	const slotInfo = (
+		slot: string | undefined,
+		minutes: number,
+		weekday: number,
+		extra: Partial<NflGameInfo> = {},
+	): NflGameInfo => ({
+		date: new Date(Date.UTC(2026, 10, 1 + weekday)),
+		dateText: "",
+		minutes,
+		timeText: "",
+		timeEstimated: false,
+		slot,
+		primetime: minutes >= 19 * 60,
+		stadium: "Stadium",
+		indoors: false,
+		temp: 55,
+		wind: 6,
+		cond: 0,
+		weatherText: "",
+		real: true,
+		week: 9,
+		round: undefined,
+		superBowl: false,
+		...extra,
+	});
+	const SLOTS: [string, NflGameInfo][] = [
+		["Sunday early", slotInfo(undefined, 13 * 60, 0)],
+		["Sunday late", slotInfo(undefined, 16 * 60 + 25, 0)],
+		["Sunday Night", slotInfo("Sunday Night Football", 20 * 60 + 20, 0)],
+		["Monday Night", slotInfo("Monday Night Football", 20 * 60 + 15, 1)],
+		["Thursday Night", slotInfo("Thursday Night Football", 20 * 60 + 15, 4)],
+		["Saturday", slotInfo("Saturday", 16 * 60 + 30, 6)],
+		["Thanksgiving", slotInfo("Thanksgiving", 12 * 60 + 30, 4)],
+		[
+			"Christmas",
+			slotInfo("Christmas", 20 * 60 + 15, 5, { cond: 2, temp: 24 }),
+		],
+		["Kickoff game", slotInfo("NFL Kickoff", 20 * 60 + 20, 4)],
+		[
+			"Playoffs",
+			slotInfo(undefined, 16 * 60 + 30, 0, { round: "Divisional Round" }),
+		],
+		[
+			"Super Bowl",
+			slotInfo(undefined, 18 * 60 + 30, 0, {
+				round: "Super Bowl LXI",
+				superBowl: true,
+				indoors: true,
+			}),
+		],
+	];
+	const [pk, setPk] = useState<string>("glossy");
+	const [sl, setSl] = useState<string>("all");
+	const [si, setSi] = useState<string>("Normal");
+	const sel = (value: string, set: (v: string) => void, opts: string[]) => (
+		<select
+			value={value}
+			onChange={(e) => set(e.target.value)}
+			style={{ fontSize: 12 }}
+		>
+			<option value="all">All</option>
+			{opts.map((o) => (
+				<option key={o} value={o}>
+					{o}
+				</option>
+			))}
+		</select>
+	);
+	const combos: {
+		pkg: Package;
+		slot: [string, NflGameInfo];
+		sit: (typeof SITUATIONS)[number];
+	}[] = [];
+	for (const pkg of PKGS)
