+// NFL history mod: the live game field in 3D (three.js). A real broadcast camera over a textured field inside a stadium
+// bowl full of fans, with sunlight or stadium lights and real shadows. Players are camera-facing sprites (a jersey with
+// the number, and the player's photo, cartoon face or a helmet on top), all the same size. The play logic lives in
+// NflPlayField.tsx; this file only draws what it's given each frame.
+//
+// Units are yards: x 0-120 along the field (end zones 0-10 and 110-120), z 0-53.3 across it (0 is the far sideline),
+// y up.
+import { fx } from "./NflSettings.ts";
+import { useEffect, useRef } from "react";
+import * as THREE from "three";
+import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
+import { display, generate } from "facesjs";
+import { readableOn } from "../../components/NflGameInfo.tsx";
+import { nflUniformFor, type NflUniform } from "../../../common/nflUniforms.ts";
+import { nflJerseyFor } from "../../../common/nflJersey.ts";
+import { Sideline } from "./NflSideline.ts";
+import { crowdSection, StadiumDecor } from "./NflStadium.ts";
+import { cutscenes } from "./NflCutscene.ts";
+import { BroadcastCrew } from "./NflCrew.ts";
+
+export type PlayerStyle = "faces" | "cartoon" | "helmets";
+export type Frame3D = {
+	actors: {
+		key: string;
+		x: number;
+		y: number; // field y (across), becomes z
+		team: 0 | 1;
+		away: boolean;
+		num?: string;
+		pid?: number;
+		name?: string;
+		tag: boolean;
+		holding: boolean;
+		kneel: boolean;
+		hop: number; // yards up while running
+		ref?: boolean;
+		facing?: 1 | -1; // which way along the field the player is looking (+1 = screen right)
+		bench?: boolean; // on the sideline (drawn after the players on the field)
+		bare?: boolean; // on the sideline with his helmet off
+		faceField?: boolean; // on the sideline: standing, he faces the field (the far side toward the camera, the near side away)
+		pose?: "throw";
+		down?: number; // 0-1: knocked to the ground (a tackle); a little below 0 is the overshoot as he stands back up
+		downDir?: 1 | -1; // which way along the field he falls
+		spin?: number; // 0-1 through a spin move
+	}[];
+	// A tackle: a burst where the hit lands (k: 0-1 through the burst)
+	impact?: { x: number; y: number; k: number };
+	ball: {
+		x: number;
+		y: number;
+		z: number;
+		spin: number;
+		visible: boolean;
+		lift?: number;
+		mode?: "spiral" | "flip" | "none";
+		dx?: number;
+		dy?: number;
+		dz?: number;
+	};
+	los?: number;
+	fd?: number;
+	camX: number;
+	camZoom: number; // 1 = whole field, ~2 = tight
+	kickCam?: { goalX: number; fromX: number; y: number; kicker?: string }; // behind the kicker, looking at the uprights
+	closeUp?: { x: number; y: number }; // low and close (a touchdown celebration)
+	establishing?: boolean; // the wide shot from high above (the pregame)
+	offTeam?: 0 | 1; // the team with the ball
+	offDir?: 1 | -1; // which way it's going
+	callout?: { text: string; x: number; y: number };
+	flag?: { x: number; y: number; fromX?: number; fromY?: number; k?: number };
+	result?: { text: string; good: boolean; x: number };
+	crowdExcited: boolean;
+	crowdTeam?: 0 | 1; // whose fans are excited (0 home, 1 away)
+	crowdThird?: boolean; // third down, home team on defense: the home crowd stands and roars
+	crowdLeaving?: { team: 0 | 1; k: number }; // a fourth-quarter blowout: this side's fans leave (k: how many)
+	// A play is live (pylons can be knocked over)
+	inPlay?: boolean;
+	// The coin toss: the coin's position and how far it has flipped
+	coin?: { x: number; y: number; z: number; flip: number };
+};
+export type Setup3D = {
+	teams: {
+		name: string;
+		region: string;
+		abbrev: string;
+		colors: string[];
+		logo?: string;
+		// a generated home jersey (seasons after the real data ends)
+		kit?: { jersey: string; stripe: string; num: string };
+	}[];
+	homeLogo?: string;
+	night: boolean;
+	// Kickoff hour (local, 24h), for the sky: midday, sunset, night
+	hour?: number;
+	indoors: boolean;
+	weather: number; // 0 clear, 1 rain, 2 snow
+	stadium?: string;
+	faces: Map<number, { face?: any; imgURL?: string; jersey?: string }>;
+	// each player's side (0 home, 1 away), for drawing every face ahead of time
+	teamOf?: Map<number, number>;
+	style: PlayerStyle;
+	season?: number;
+	temp?: number;
+	crowdFill?: number;
+};
+
+const W = 120;
+const H = 53.3;
+const MID = H / 2;
+const POST_HALF = 3.08;
+// Which side a cutscene films someone from: in front of him from the field side (+1: from the near side, the usual
+// broadcast side; -1: from the field toward the near sideline, for someone standing on the near sideline)
+const cutsceneCamSide = (y: number) => (y > H + 0.5 ? -1 : 1);
+// The football, modeled: a prolate shape with pointed tips (a lathe of its true profile, 11 inches long, 22 around the
+// middle, at the field's scale), pebbled brown leather with the four panel seams, and the laces: a long stitch with eight
+// cross-stitches. The long axis is local X. It is never scaled unevenly, so it can't be squashed into a ball.
+const footballMesh = () => {
+	const L = 0.4; // half its length
+	const R = 0.215; // its radius at the middle (a real ball is plump: about 1.6 times as long as it is wide)
+	const prof: THREE.Vector2[] = [];
+	for (let i = 0; i <= 24; i++) {
+		const t = i / 24; // tip to tip
+		const yv = (t - 0.5) * 2 * L;
+		const r =
+			R * Math.pow(Math.max(0, 1 - Math.pow(Math.abs(t - 0.5) * 2, 2)), 0.5);
+		prof.push(new THREE.Vector2(Math.max(0.003, r), yv));
+	}
+	const geo = new THREE.LatheGeometry(prof, 28);
+	geo.rotateZ(-Math.PI / 2); // lathe axis Y -> the ball's long axis along X
+	// Leather: pebbled brown, darker toward the tips, the four seams running tip to tip
+	const c = document.createElement("canvas");
+	c.width = 256;
+	c.height = 128;
+	const g = c.getContext("2d")!;
+	const grad = g.createLinearGradient(0, 0, 0, 128);
+	grad.addColorStop(0, "#3d1f0b");
+	grad.addColorStop(0.5, "#7a3e17");
+	grad.addColorStop(1, "#3d1f0b");
+	g.fillStyle = grad;
+	g.fillRect(0, 0, 256, 128);
+	for (let i = 0; i < 2600; i++) {
+		g.fillStyle =
+			Math.random() < 0.5 ? "rgba(0,0,0,.18)" : "rgba(255,220,180,.07)";
+		g.fillRect(Math.random() * 256, Math.random() * 128, 1.5, 1.5);
+	}
+	g.strokeStyle = "rgba(20,8,2,.85)";
+	g.lineWidth = 2;
+	for (const u of [0, 64, 128, 192]) {
+		g.beginPath();
+		g.moveTo(u, 0);
+		g.lineTo(u, 128);
+		g.stroke();
+	}
+	const tex = new THREE.CanvasTexture(c);
+	tex.colorSpace = THREE.SRGBColorSpace;
+	const ball = new THREE.Mesh(
+		geo,
+		new THREE.MeshStandardMaterial({
+			map: tex,
+			roughness: 0.62,
+			metalness: 0.02,
+		}),
+	);
+	// The laces, on top, along the middle third
+	const white = new THREE.MeshStandardMaterial({
+		color: "#f5f5f0",
+		roughness: 0.5,
+	});
+	const spine = new THREE.Mesh(
+		new THREE.BoxGeometry(L * 0.62, 0.012, 0.02),
+		white,
+	);
+	spine.position.set(0, R + 0.004, 0);
+	ball.add(spine);
+	for (let i = 0; i < 8; i++) {
+		const st = new THREE.Mesh(
+			new THREE.BoxGeometry(0.016, 0.014, 0.075),
+			white,
+		);
+		st.position.set(-L * 0.28 + (i * L * 0.56) / 7, R - 0.002, 0);
+		ball.add(st);
+	}
+	return ball;
+};
+// How thick a player card is (yards)
+const CARD_DEPTH = 0.08;
+// The back of a card trimmed to the front's silhouette (pixel for pixel), so from any angle the two line up
+const matchOutline = (back: HTMLCanvasElement, front: HTMLCanvasElement) => {
+	const g = back.getContext("2d")!;
+	g.save();
+	g.globalCompositeOperation = "destination-in";
+	g.drawImage(front, 0, 0, back.width, back.height);
+	g.restore();
+	// and anywhere the front has body but the back drew nothing, filled with the back's main color
+	const out = document.createElement("canvas");
+	out.width = back.width;
+	out.height = back.height;
+	const o = out.getContext("2d")!;
+	o.drawImage(front, 0, 0, back.width, back.height);
+	o.globalCompositeOperation = "source-atop";
+	o.fillStyle = "#1b1b1b";
+	o.fillRect(0, 0, out.width, out.height);
+	o.globalCompositeOperation = "source-over";
+	o.drawImage(back, 0, 0);
+	return out;
+};
+// Points in the ball's flight trail
+const TRAIL = 22;
+const SPONSORS = [
+	"BLITZ COLA",
+	"ENDZONE AUTO",
+	"HUDDLE MOBILE",
+	"PIGSKIN PIZZA",
+	"AUDIBLE INSURANCE",
+	"SIDELINE SNEAKERS",
+	"HAIL MARY COFFEE",
+	"PLAY-ACTION BANK",
+	"TAILGATE TRUCKS",
+	"GRIDIRON GRILL",
+];
+
+// ---- Textures drawn on canvases ----
+const canvas = (w: number, h: number) => {
+	const c = document.createElement("canvas");
+	c.width = w;
+	c.height = h;
+	return c;
+};
+
+export const fieldTexture = (s: Setup3D, logo?: HTMLImageElement) => {
+	const PX = 24; // pixels per yard
+	const c = canvas(W * PX, Math.round(H * PX));
+	const g = c.getContext("2d")!;
+	// Turf. Grass outdoors: mowed stripes every 5 yards with a lighter crosscut, grass grain at two scales (blades and
+	// clumps), worn patches between the hashes where the play happens. Indoors: artificial turf, even and bright, no wear.
+	const turf = !!s.indoors;
+	g.fillStyle = turf ? "#2e8b3a" : "#2f7d32";
+	g.fillRect(0, 0, c.width, c.height);
+	for (let i = 0; i < 20; i++) {
+		g.fillStyle = turf
+			? i % 2
+				? "#2c8638"
+				: "#33923f"
+			: i % 2
+				? "#2c7230"
+				: "#368c3a";
+		g.fillRect((10 + i * 5) * PX, 0, 5 * PX, c.height);
+	}
+	if (!turf) {
+		// the crosscut: faint bands across the field
+		for (let y = 0; y < H; y += 5) {
+			g.fillStyle = (y / 5) % 2 ? "rgba(255,255,255,.025)" : "rgba(0,0,0,.03)";
+			g.fillRect(10 * PX, y * PX, 100 * PX, 5 * PX);
+		}
+	}
+	{
+		// grain: per-pixel noise (blades), plus soft clumps
+		const img = g.getImageData(0, 0, c.width, c.height);
+		const d = img.data;
+		for (let i = 0; i < d.length; i += 4) {
+			const n = (Math.random() - 0.5) * (turf ? 10 : 22);
+			d[i] = Math.max(0, Math.min(255, d[i]! + n * 0.6));
+			d[i + 1] = Math.max(0, Math.min(255, d[i + 1]! + n));
+			d[i + 2] = Math.max(0, Math.min(255, d[i + 2]! + n * 0.4));
+		}
+		g.putImageData(img, 0, 0);
+		if (!turf) {
+			for (let i = 0; i < 2600; i++) {
+				const x = Math.random() * c.width;
+				const y = Math.random() * c.height;
+				const r = (0.3 + Math.random() * 1.2) * PX;
+				const grd = g.createRadialGradient(x, y, 0, x, y, r);
+				const dark = Math.random() < 0.5;
+				grd.addColorStop(
+					0,
+					dark ? "rgba(10,40,12,.10)" : "rgba(120,170,80,.08)",
+				);
+				grd.addColorStop(1, "rgba(0,0,0,0)");
