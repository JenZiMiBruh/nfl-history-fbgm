+		return out;
+	},
+	// Houston: a big lone star over deep blue with orbit lines
+	space: (p, x0, y0, x1, y1) => {
+		const w = x1 - x0;
+		const h = y1 - y0;
+		let out = `<defs>${lin(`${p}sp`, ["#0B1F4D", "#1D4E9E"])}</defs><rect x='${x0}' y='${y0}' width='${w}' height='${h}' fill='url(#${p}sp)'/>`;
+		out += `<ellipse cx='${x0 + w / 2}' cy='${y0 + h / 2}' rx='${w * 0.55}' ry='${h * 0.25}' transform='rotate(-14 ${x0 + w / 2} ${y0 + h / 2})' fill='none' stroke='#C8102E' stroke-width='5'/>`;
+		for (let i = 0; i < 14; i++) {
+			out += star(x0 + ((i * 47) % 100) / 100 * w, y0 + ((i * 29) % 100) / 100 * h, 2.5, "#fff");
+		}
+		return out + star(x0 + w * 0.5, y0 + h * 0.5, h * 0.3, "#F2B71F");
+	},
+	// Tampa: orange sky over the bay, a pirate-red sail
+	bay_sunset: (p, x0, y0, x1, y1) => {
+		const w = x1 - x0;
+		const h = y1 - y0;
+		return (
+			`<defs>${lin(`${p}tb`, ["#F7A21B", "#E35205", "#7A1E2C"])}</defs><rect x='${x0}' y='${y0}' width='${w}' height='${h}' fill='url(#${p}tb)'/>` +
+			`<rect x='${x0}' y='${y0 + h * 0.66}' width='${w}' height='${h * 0.34}' fill='#008C95'/>` +
+			[0.72, 0.8, 0.9].map((k) => band(x0, x1, y0 + h * k, 1.5, "#7FE0D4")).join("") +
+			`<path d='M${x0 + w * 0.6} ${y0 + h * 0.66} L${x0 + w * 0.6} ${y0 + h * 0.1} L${x0 + w * 0.78} ${y0 + h * 0.6} Z' fill='#B5121B'/>`
+		);
+	},
+	// Minneapolis: violet night with green northern lights and snow
+	aurora: (p, x0, y0, x1, y1) => {
+		const w = x1 - x0;
+		const h = y1 - y0;
+		let out = `<defs>${lin(`${p}au`, ["#1B1046", "#4F2683", "#6A3FA0"])}</defs><rect x='${x0}' y='${y0}' width='${w}' height='${h}' fill='url(#${p}au)'/>`;
+		out += [0.25, 0.4].map((k, i) => `<path d='M${x0} ${y0 + h * k} Q${x0 + w * 0.3} ${y0 + h * (k - 0.2)} ${x0 + w * 0.55} ${y0 + h * k} T${x1} ${y0 + h * k}' stroke='${i ? "#4FC3F7" : "#5BE38C"}' stroke-width='6' fill='none' opacity='0.85'/>`).join("");
+		for (let i = 0; i < 18; i++) {
+			out += `<circle cx='${x0 + ((i * 61) % 100) / 100 * w}' cy='${y0 + ((i * 37) % 100) / 100 * h}' r='1.6' fill='#fff'/>`;
+		}
+		return out + `<path d='M${x0} ${y1} L${x0 + w * 0.25} ${y0 + h * 0.7} L${x0 + w * 0.45} ${y0 + h * 0.85} L${x0 + w * 0.7} ${y0 + h * 0.65} L${x1} ${y1} Z' fill='#E8EEF6'/>`;
+	},
+	// Arlington: a big silver-blue star on navy
+	lonestar: (p, x0, y0, x1, y1) => {
+		const w = x1 - x0;
+		const h = y1 - y0;
+		let out = `<rect x='${x0}' y='${y0}' width='${w}' height='${h}' fill='#003594'/>`;
+		for (let i = 0; i < 8; i++) {
+			out += `<rect x='${x0 + (w * i) / 8}' y='${y0}' width='${w / 16}' height='${h}' fill='#0B4BBF'/>`;
+		}
+		return out + star(x0 + w * 0.5, y0 + h * 0.52, h * 0.42, "#C9CED4", "#fff");
+	},
+	// Indianapolis: checkered flag and a racing stripe
+	racing: (p, x0, y0, x1, y1) => {
+		const w = x1 - x0;
+		const h = y1 - y0;
+		let out = `<rect x='${x0}' y='${y0}' width='${w}' height='${h}' fill='#002C5F'/>`;
+		const s = 10;
+		for (let gx = 0; gx * s < w; gx++) {
+			for (let gy = 0; gy * s < h * 0.45; gy++) {
+				if ((gx + gy) % 2 === 0) {
+					out += `<rect x='${x0 + gx * s}' y='${y0 + gy * s}' width='${s}' height='${s}' fill='#fff'/>`;
+				}
+			}
+		}
+		return out + `<polygon points='${x0},${y1} ${x0 + w * 0.2},${y0 + h * 0.55} ${x1},${y0 + h * 0.55} ${x1},${y1 - h * 0.25} ${x0 + w * 0.4},${y1}' fill='#C8102E'/>`;
+	},
+};
+
+// the host city's theme (generated games use these too)
+export const CITY_THEME: Record<string, string> = {
+	Inglewood: "sunset",
+	"Los Angeles": "sunset",
+	Pasadena: "sunset",
+	Glendale: "desert",
+	Tempe: "desert",
+	"Las Vegas": "neon",
+	"New Orleans": "filigree",
+	"Santa Clara": "bay",
+	Stanford: "bay",
+	Miami: "deco",
+	Atlanta: "peach",
