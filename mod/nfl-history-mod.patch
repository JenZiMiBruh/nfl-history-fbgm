+// NFL history mod: the league calendar, compact, on the dashboard. The same calendar as the Calendar page (the same
+// Calendar / List / Featured views), in a smaller box. It can be hidden, and brought back from the small link left in
+// its place; the choice is remembered on this device.
+import { useState } from "react";
+import { NflCalendarBody } from "../NflCalendar.tsx";
+import type { View } from "../../../common/types.ts";
+import { helpers } from "../../util/helpers.ts";
+
+const KEY = "nflDashboardCalendarHidden";
+const readHidden = () => {
+	try {
+		return localStorage.getItem(KEY) === "1";
+	} catch {
+		return false;
+	}
+};
+
+const DashboardCalendar = ({ data }: { data: unknown }) => {
+	const [hidden, setHidden] = useState(readHidden);
+	const set = (h: boolean) => {
+		setHidden(h);
+		try {
+			localStorage.setItem(KEY, h ? "1" : "0");
+		} catch {
+			// private window or blocked storage: it only stays hidden until the page reloads
+		}
+	};
+	if (!data) {
+		return null;
+	}
+	if (hidden) {
+		return (
+			<div className="mb-3 small">
+				<button type="button" className="btn btn-link btn-sm p-0" onClick={() => set(false)}>
+					Show the calendar
+				</button>
+			</div>
+		);
+	}
+	return (
+		<div className="mb-3 rounded-3 p-2" style={{ border: "1px solid var(--bs-border-color)" }}>
+			<div className="d-flex align-items-center mb-1">
+				<h2 className="mb-0" style={{ fontSize: "1.15rem" }}>
+					<a href={helpers.leagueUrl(["calendar"])}>Calendar</a>
+				</h2>
+				<button type="button" className="btn btn-link btn-sm ms-auto text-body-secondary" onClick={() => set(true)} title="Hide the calendar from the dashboard">
+					Hide
+				</button>
+			</div>
+			<div style={{ zoom: 0.82, maxHeight: 640, overflowY: "auto", overflowX: "hidden" }}>
+				<NflCalendarBody {...(data as View<"nflCalendar">)} embedded />
+			</div>
+		</div>
+	);
+};
+
+export default DashboardCalendar;
