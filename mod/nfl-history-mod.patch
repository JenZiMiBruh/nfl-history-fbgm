+			}
+		}
+		const PHASE_NAMES: Record<number, string> = {
+			0: "Preseason",
+			1: "Regular season",
+			3: "Playoffs",
+			4: "After playoffs",
+			5: "Draft",
+			8: "Free agency",
+		};
+		eventList = (
+			<div className="mt-3">
+				<div className="d-flex flex-wrap gap-2 align-items-center mb-2">
+					<b>
+						Scheduled events: {kept.size} of {league.scheduledEvents.length}{" "}
+						kept
+					</b>
+					<button
+						type="button"
+						className="btn btn-sm btn-light"
+						onClick={() => {
+							setMany(
+								league.scheduledEvents.map((e: any) => e.id),
+								true,
+							);
+						}}
+					>
+						All
+					</button>
+					<button
+						type="button"
+						className="btn btn-sm btn-light"
+						onClick={() => {
+							setKept(new Set());
+						}}
+					>
