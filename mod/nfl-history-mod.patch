+// NFL history mod: per-team RB1 workload, next to Play Through Injuries on the Roster page.
+// It sets how often the lead running back rests (the game sim's RB fatigue modifier).
+import { useState } from "react";
+import { HelpPopover } from "../../components/HelpPopover.tsx";
+import { toWorker } from "../../util/toWorker.ts";
+
+export const DEFAULT_RB_WORKLOAD = 1.1;
+
+const describe = (value: number) => {
+	if (value <= 0.85) {
+		return "Committee: carries spread across the backfield";
+	}
+	if (value < 1.05) {
+		return "Balanced: backups get regular work";
+	}
+	if (value <= 1.2) {
+		return "Lead back: RB1 gets most of the carries";
+	}
+	return "Workhorse: RB1 rarely leaves the field";
+};
+
+const RbWorkloadSlider = ({
+	t,
+}: {
+	t: {
+		tid: number;
+		rbWorkload?: number;
+	};
+}) => {
+	const [value, setValue] = useState(t.rbWorkload ?? DEFAULT_RB_WORKLOAD);
+	const id = "rb-workload";
+
+	return (
+		<div className="rb-workload mt-3">
+			<div className="d-flex align-items-center">
+				<b>RB1 Workload</b>
+				<HelpPopover className="ms-1" title="RB1 Workload">
+					<p>
+						How hard your lead running back is worked. Slide right and he rests
+						less and gets more of the carries; slide left to spread them across
+						the backfield.
+					</p>
+					<p>
+						1.0 is plain Football GM. The NFL History default is 1.1. Every team
+						has its own setting.
+					</p>
+				</HelpPopover>
+			</div>
+			<form className="mt-2">
+				<label className="visually-hidden" htmlFor={id}>
+					RB1 Workload
+				</label>
+				<input
+					type="range"
+					className="form-range"
+					id={id}
+					value={value}
+					min="0.7"
+					max="1.5"
+					step="0.05"
+					onChange={async (event) => {
+						const parsed = Number.parseFloat(event.target.value);
+						if (!Number.isNaN(parsed)) {
+							setValue(parsed);
+							await toWorker("main", "updateRbWorkload", {
+								tid: t.tid,
+								value: parsed,
+							});
+						}
+					}}
+				/>
+				<div style={{ marginTop: -5 }}>
+					{value.toFixed(2)}{" "}
+					<span className="text-body-secondary">({describe(value)})</span>
+				</div>
+			</form>
+		</div>
+	);
+};
+
+export default RbWorkloadSlider;
