new file mode 100644
index 000000000..728410280
--- /dev/null
+++ b/src/worker/core/game/nflRealMoves.ts
@@ -0,0 +1,81 @@
+// NFL history mod: real moves during a season (Jerry Rice to Seattle after 3 games in 2004). Each player's
+// realMoves lists [season, games played with his first team, new team, jersey]; after each day of games, players
+// whose team has played that many games move to the new team.
+import { PHASE, PLAYER } from "../../../common/constants.ts";
+import { idb } from "../../db/index.ts";
+import { g } from "../../util/index.ts";
+import { player, team } from "../index.ts";
+
+type RealMove = {
+	season: number;
+	afterGames: number;
+	tid: number;
+	jerseyNumber?: string;
+	done?: boolean;
+};
+
+export const applyNflRealMoves = async () => {
+	if (
+		__SPORT !== "football" ||
+		!Object.hasOwn(g, "nflHistoricalRosters") ||
+		!g.get("nflHistoricalRosters")
+	) {
+		return false;
+	}
+	const season = g.get("season");
+	const players = await idb.cache.players.indexGetAll("playersByTid", [
+		PLAYER.FREE_AGENT,
+		Infinity,
+	]);
+	const teamSeasons = await idb.cache.teamSeasons.indexGetAll(
+		"teamSeasonsBySeasonTid",
+		[[season], [season, "Z"]],
+	);
+	const gamesPlayed = (tid: number) => {
+		const ts = teamSeasons.find((row) => row.tid === tid);
+		return ts ? ts.won + ts.lost + ts.tied + (ts.otl ?? 0) : 0;
+	};
+	const teams = await idb.cache.teams.getAll();
+
+	const moved = new Set<number>();
+	for (const p of players) {
+		const moves = (p as any).realMoves as RealMove[] | undefined;
+		if (!moves) {
+			continue;
+		}
+		for (const m of moves) {
+			if (m.season !== season || m.done) {
+				continue;
+			}
+			// Count games for the team he's on now (or, for a free agent, the team he joins)
+			const from = p.tid >= 0 ? p.tid : m.tid;
+			if (gamesPlayed(from) < m.afterGames) {
+				break;
+			}
+			m.done = true;
+			const t = teams.find((t2) => t2.tid === m.tid);
+			if (!t || t.disabled || p.tid === m.tid) {
+				continue;
+			}
+			if (p.tid >= 0) {
+				moved.add(p.tid);
+			}
+			const contract =
+				p.contract.exp >= season
+					? p.contract
+					: { amount: player.genContract(p).amount, exp: season };
+			await player.sign(p, m.tid, contract, PHASE.REGULAR_SEASON);
+			if (m.jerseyNumber !== undefined) {
+				p.jerseyNumber = m.jerseyNumber;
+			}
+			moved.add(m.tid);
+			await idb.cache.players.put(p);
+		}
+	}
+	for (const tid of moved) {
+		if (!g.get("userTids").includes(tid)) {
+			await team.rosterAutoSort(tid);
+		}
+	}
+	return moved.size > 0;
+};
