+// NFL history mod: the real early Super Bowl logos (I-XXV), redrawn to follow the originals: plain period wordmarks for
+// the first games, "SUPER BOWL" with colored numerals through the 70s, and the one-off badges, ribbons and crests of
+// the 80s. Drawn on the same 256x256 canvas as the rest (common/nflSuperBowl.ts).
+
+const SERIF = `'Times New Roman',Georgia,serif`;
+const BLOCK = `'Arial Black','Arial Bold',Impact,sans-serif`;
+const COND = `Impact,'Arial Narrow',sans-serif`;
+const HELV = `'Helvetica Neue',Helvetica,Arial,sans-serif`;
+const SCRIPT = `'Brush Script MT','Segoe Script',cursive`;
+const COOPER = `'Cooper Black','Cooper Std',Georgia,serif`;
+const NAVY = "#1B2D5E";
+const RED = "#C8102E";
+const GOLD = "#C9A227";
+
+type Line = {
+	t: string;
+	y: number;
+	size: number;
+	fill: string;
+	x?: number;
+	anchor?: "start" | "middle" | "end";
+	font?: string;
+	stroke?: string;
+	sw?: number;
+	shadow?: string;
+	sh?: [number, number];
+	extrude?: [number, number, string, number];
+	italic?: boolean;
+	ls?: number;
+	weight?: number;
+	// squeeze to this width
+	w?: number;
+	clip?: string;
+};
+
+const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
+
+const line = (l: Line) => {
+	const attrs = `x='${l.x ?? 128}' y='${l.y}' text-anchor='${l.anchor ?? "middle"}' font-family="${l.font ?? BLOCK}" font-size='${l.size}' font-weight='${l.weight ?? 900}'${l.italic ? " font-style='italic'" : ""}${l.ls ? ` letter-spacing='${l.ls}'` : ""}${l.w ? ` textLength='${l.w}' lengthAdjust='spacingAndGlyphs'` : ""}${l.clip ? ` clip-path='url(#${l.clip})'` : ""}`;
+	let out = "";
+	if (l.extrude) {
+		const [dx, dy, col, steps] = l.extrude;
+		for (let i = steps; i >= 1; i--) {
+			out += `<text ${attrs} fill='${col}' transform='translate(${((dx * i) / steps).toFixed(1)} ${((dy * i) / steps).toFixed(1)})'>${esc(l.t)}</text>`;
+		}
+	}
+	if (l.shadow) {
+		const [dx, dy] = l.sh ?? [4, 4];
+		out += `<text ${attrs} fill='${l.shadow}' transform='translate(${dx} ${dy})'>${esc(l.t)}</text>`;
+	}
+	if (l.stroke) {
+		out += `<text ${attrs} fill='none' stroke='${l.stroke}' stroke-width='${l.sw ?? 6}' stroke-linejoin='round'>${esc(l.t)}</text>`;
+	}
+	return out + `<text ${attrs} fill='${l.fill}'>${esc(l.t)}</text>`;
+};
+
+const football = (cx: number, cy: number, rx: number, ry: number, fill: string, stroke: string, sw = 5) =>
+	`<path d='M${cx - rx} ${cy} Q${cx} ${cy - ry * 2} ${cx + rx} ${cy} Q${cx} ${cy + ry * 2} ${cx - rx} ${cy} Z' fill='${fill}' stroke='${stroke}' stroke-width='${sw}'/>`;
+
+// small print under a logo (the date and the stadium)
+const small = (lines: string[], y: number, fill = "#222", size = 10.5, font = HELV, step = 13) =>
+	lines
+		.map((t, i) =>
+			line({ t, y: y + i * step, size, fill, font, weight: 700, ls: 0.3, w: t.length * size * 0.6 > 232 ? 232 : undefined }),
+		)
+		.join("");
+
+// text bent along an arc
+const arcText = (id: string, t: string, d: string, size: number, fill: string, font = BLOCK, o: { italic?: boolean; ls?: number } = {}) =>
+	`<path id='${id}' d='${d}' fill='none'/><text font-family="${font}" font-weight='900' font-size='${size}'${o.italic ? " font-style='italic'" : ""} letter-spacing='${o.ls ?? 1}' fill='${fill}'><textPath href='#${id}' startOffset='50%' text-anchor='middle'>${esc(t)}</textPath></text>`;
+
+const lin = (id: string, stops: string[], vertical = true) =>
+	`<linearGradient id='${id}' x1='0' y1='0' x2='${vertical ? 0 : 1}' y2='${vertical ? 1 : 0}'>${stops
+		.map((c, i) => `<stop offset='${(i / Math.max(1, stops.length - 1)).toFixed(2)}' stop-color='${c}'/>`)
+		.join("")}</linearGradient>`;
+
+// Returns the logo body for a real early game, or undefined past XXV
