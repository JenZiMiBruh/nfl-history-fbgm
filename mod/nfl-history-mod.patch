+import { assert, test } from "vitest";
+import addDaysToSchedule from "./addDaysToSchedule.ts";
+
+// NFL history mod: teams 0 and 1 have a bye in week 1. Their week 2 game must stay in week 2.
+const week1 = [
+	{ homeTid: 2, awayTid: 3 },
+	{ homeTid: 4, awayTid: 5 },
+];
+const week2 = [
+	{ homeTid: 0, awayTid: 1 },
+	{ homeTid: 2, awayTid: 4 },
+];
+
+test("a game between two teams coming off a bye stays in its week", () => {
+	const days = addDaysToSchedule([
+		...week1,
+		{ homeTid: -5, awayTid: -5 },
+		...week2,
+	]);
+	assert.deepStrictEqual(
+		days.map((game) => game.day),
+		[1, 1, 2, 2],
+	);
+	assert.strictEqual(days.length, 4, "week markers are not games");
+});
+
+test("without a week marker the old behavior is unchanged", () => {
+	const days = addDaysToSchedule([...week1, ...week2]);
+	assert.deepStrictEqual(
+		days.map((game) => game.day),
+		[1, 1, 1, 2],
+	);
+});
+
+test("a week marker at the start or twice in a row adds no empty day", () => {
+	const days = addDaysToSchedule([
+		{ homeTid: -5, awayTid: -5 },
+		...week1,
+		{ homeTid: -5, awayTid: -5 },
+		{ homeTid: -5, awayTid: -5 },
+		...week2,
+	]);
+	assert.deepStrictEqual(
+		days.map((game) => game.day),
+		[1, 1, 2, 2],
+	);
+});
