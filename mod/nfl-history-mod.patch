+						<rect width="1600" height="900" fill="url(#nflcBg)" />
+						<Product ad={ad} shot={step === 1 ? 0 : 1} />
+					</svg>
+					<div
+						style={{
+							position: "absolute",
+							left: "6%",
+							bottom: "11%",
+							maxWidth: "60%",
+							fontSize: "clamp(16px, 3.4vw, 30px)",
