@@ -109,13 +109,473 @@ class LeagueFileVersionError extends Error {
 	}
 }
 
+// NFL history mod: build a league for any season straight from the NFL master file
+let nflScriptPromise: Promise<void> | undefined;
+const loadNflScript = () => {
+	if (!nflScriptPromise) {
+		nflScriptPromise = new Promise((resolve, reject) => {
+			const script = document.createElement("script");
+			// Cache-busted so a rebuilt picker (new league data) is always picked up
+			script.src = `/nfl/nfl_mod.js?v=${Date.now()}`;
+			script.onload = () => resolve();
+			script.onerror = () => {
+				nflScriptPromise = undefined;
+				reject(
+					new Error("Could not load /nfl/nfl_mod.js (run build_mod_assets.js)"),
+				);
+			};
+			document.head.append(script);
+		});
+	}
+	return nflScriptPromise;
+};
+let nflMaster: any;
+
+// The master as shipped (.json.gz) or unpacked (.json)
+const readMaster = async (blob: Blob) => {
+	const head = new Uint8Array(await blob.slice(0, 2).arrayBuffer());
+	const gz = head[0] === 0x1f && head[1] === 0x8b;
+	const text = gz
+		? await new Response(
+				blob.stream().pipeThrough(new DecompressionStream("gzip")),
+			).text()
+		: await blob.text();
+	return JSON.parse(text);
+};
+
+// Week-by-week real games for starting mid-season: installed with the mod, or the site's copy
+const nflWeekly: Record<number, any> = {};
+const loadWeekly = async (season: number) => {
+	if (nflWeekly[season] !== undefined) {
+		return nflWeekly[season];
+	}
+	for (const base of [
+		"/nfl/weekly/",
+		"https://jenzimibruh.github.io/nfl-history-fbgm/data/weekly/",
+	]) {
+		try {
+			const response = await fetch(`${base}${season}.json`);
+			if (response.ok) {
+				nflWeekly[season] = await response.json();
+				return nflWeekly[season];
+			}
+		} catch {
+			// try the next one
+		}
+	}
+	nflWeekly[season] = null;
+	return null;
+};
+
+const NflHistoryPicker = ({
+	disabled,
+	onFile,
+}: {
+	disabled: boolean;
+	onFile: (file: File) => void;
+}) => {
+	const [loaded, setLoaded] = useState(nflMaster !== undefined);
+	const [status, setStatus] = useState("");
+	const [season, setSeason] = useState(2026);
+	const [phase, setPhase] = useState("regular");
+	const [week, setWeek] = useState(1);
+	const [realDraftRatings, setRealDraftRatings] = useState(true);
+	const [autoTried, setAutoTried] = useState(nflMaster !== undefined);
+
+	// The master file comes with the mod: load it on its own, so there's nothing to pick
+	useEffect(() => {
+		if (nflMaster !== undefined) {
+			return;
+		}
+		let cancelled = false;
+		(async () => {
+			try {
+				setStatus("Loading NFL history (16 MB)...");
+				await loadNflScript();
+				const response = await fetch("/nfl/NFL_Master_1966_2026.json.gz");
+				if (!response.ok) {
+					throw new Error(`HTTP ${response.status}`);
+				}
+				const master = await readMaster(await response.blob());
+				if (!cancelled) {
+					nflMaster = master;
+					setLoaded(true);
+					setStatus("");
+				}
+			} catch {
+				if (!cancelled) {
+					setStatus("");
+				}
+			}
+			if (!cancelled) {
+				setAutoTried(true);
+			}
+		})();
+		return () => {
+			cancelled = true;
+		};
+	}, []);
+
+	const loadMaster = async (event: ChangeEvent<HTMLInputElement>) => {
+		const file = event.currentTarget.files?.[0];
+		if (!file) {
+			return;
+		}
+		try {
+			setStatus("Reading master file...");
+			await loadNflScript();
+			nflMaster = await readMaster(file);
+			setLoaded(true);
+			setStatus("");
+		} catch (error) {
+			setStatus(`Error: ${(error as Error).message}`);
+		}
+	};
+
+	// Weeks of the real schedule; the live season stops at the next week to play
+	const w = window as any;
+	const days: number[] = (w.NFL_DATA?.schedules?.[season] ?? []).map(
+		(g: any) => g.day,
+	);
+	let maxWeek = days.length > 0 ? Math.max(...days) : 1;
+	if (season >= 2026 && w.NFL_DATA?.live) {
+		maxWeek = Math.min(maxWeek, w.NFL_DATA.live.nextWeek);
+	}
+	const weekNow = Math.min(week, maxWeek);
+
+	// The built league waits here while the user picks which scheduled events to keep
+	const [league, setLeague] = useState<any>();
+	const [kept, setKept] = useState<Set<number>>(new Set());
+
+	const build = async () => {
+		setStatus(`Building NFL ${season + 1}...`);
+		setLeague(undefined);
+		// Let the status render before the slow synchronous slice
+		await new Promise((resolve) => setTimeout(resolve, 50));
+		try {
+			const w = window as any;
+			const data = w.NFL_DATA;
+			// Live = the next week to play, with every played week's real games, rosters, injuries and ratings (the
+			// master that comes with the mod has no events list for a live league of its own)
+			const live = phase === "live";
+			const startWeek =
+				phase === "regular"
+					? weekNow
+					: live
+						? (data.live?.nextWeek ?? 1)
+						: 1;
+			// (also for Playoffs, After Playoffs and Draft: the schedule shows the games already played)
+			const weekly =
+				startWeek > 1 || ["playoffs", "afterplayoffs", "draft"].includes(phase)
+					? await loadWeekly(season)
+					: undefined;
+			if (startWeek > 1 && !weekly) {
+				setStatus(
+					`Couldn't load the week-by-week data for ${season + 1}, which a Week ${startWeek} start needs.`,
+				);
+				return;
+			}
+			const built = w.SEASON_SLICER.sliceLeague(nflMaster, w.NFL_ERAS, {
+				season,
+				phase: live ? "regular" : phase,
+				week: startWeek,
+				realDraftRatings,
+				weekly: weekly ?? undefined,
+				...data,
+			});
+			setLeague(built);
+			setKept(new Set((built.scheduledEvents ?? []).map((e: any) => e.id)));
+			setStatus("");
+		} catch (error) {
+			setStatus(`Error: ${(error as Error).message}`);
+		}
+	};
+
+	const loadLeague = () => {
+		const w = window as any;
+		const filtered = w.SEASON_SLICER.keepEvents({ ...league }, [...kept]);
+		const file = new File(
+			w.SEASON_SLICER.toJsonChunks(filtered),
+			`NFL_${season + 1}_${phase === "regular" ? `Week${weekNow}` : phase}.json`,
+			{ type: "application/json" },
+		);
+		onFile(file);
+	};
+
+	const setMany = (ids: number[], on: boolean) => {
+		const next = new Set(kept);
+		for (const id of ids) {
+			if (on) {
+				next.add(id);
+			} else {
+				next.delete(id);
+			}
+		}
+		setKept(next);
+	};
+
+	let eventList = null;
+	if (league) {
