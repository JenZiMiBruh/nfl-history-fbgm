+				arcText(`${p}a`, "SUPER BOWL", "M28 147 Q128 114 228 147", 25, "#fff", BLOCK, { ls: 2 })
+			);
+		case 18:
+			return (
+				`<defs><pattern id='${p}s' width='10' height='9' patternUnits='userSpaceOnUse'><rect width='10' height='9' fill='#2E8BD0'/><rect y='6' width='10' height='2' fill='#fff'/></pattern></defs>` +
+				line({ t: "XVIII", y: 170, size: 108, fill: `url(#${p}s)`, font: SERIF, stroke: "#1B6FB0", sw: 3, w: 226 }) +
+				`<path d='M26 112 L16 126 L30 128 Z M230 112 L240 126 L226 128 Z' fill='#8B0A1F'/>` +
+				`<path d='M34 104 Q128 66 222 104 L222 130 Q128 92 34 130 Z' fill='${RED}' stroke='#fff' stroke-width='2'/>` +
+				arcText(`${p}a`, "SUPER BOWL", "M42 124 Q128 88 214 124", 22, "#fff", SCRIPT, { italic: true, ls: 1 }) +
+				small(["TAMPA STADIUM • TAMPA, FLORIDA", "JANUARY 22, 1984"], 196, "#1B6FB0", 12, HELV, 15)
+			);
+		case 19:
+			return (
+				`<defs>${lin(`${p}g`, ["#F2F4F6", "#B9C0C8", "#8A929C"])}</defs>` +
+				`<polygon points='8,122 62,80 194,80 248,122 194,164 62,164' fill='url(#${p}g)' stroke='#9E1B32' stroke-width='3' stroke-linejoin='round'/>` +
+				`<rect x='22' y='104' width='212' height='36' fill='#fff' stroke='${NAVY}' stroke-width='2.5'/>` +
+				line({ t: "XIX", y: 138, size: 40, fill: NAVY, font: BLOCK, stroke: "#fff", sw: 3, w: 116 }) +
+				`<rect x='88' y='62' width='80' height='30' rx='14' fill='#fff' stroke='#9E1B32' stroke-width='3'/>` +
