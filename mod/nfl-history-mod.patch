+// Rows of fans: shirts mostly in home colors, heads in a range of skin tones
+const crowdTexture = (colors: string[], seed: number) => {
+	const c = canvas(1024, 256);
+	const g = c.getContext("2d")!;
+	g.fillStyle = "#1e293b";
+	g.fillRect(0, 0, c.width, c.height);
+	const skins = [
+		"#f1c9a5",
+		"#e0ac83",
+		"#c68642",
+		"#8d5524",
+		"#5c3a21",
+		"#f5d0b5",
+	];
+	let r = seed;
+	const rand = () => (r = (r * 9301 + 49297) % 233280) / 233280;
+	for (let row = 0; row < 8; row++) {
+		const y = 16 + row * 30;
+		for (let i = 0; i < 64; i++) {
+			const x = 8 + i * 16 + (row % 2) * 8;
+			const shirt =
+				rand() < 0.62
+					? colors[0]!
+					: rand() < 0.5
+						? (colors[1] ?? "#ffffff")
+						: ["#cbd5e1", "#334155", "#e2e8f0"][Math.floor(rand() * 3)]!;
+			g.fillStyle = shirt;
+			g.fillRect(x - 6, y + 4, 12, 14);
+			g.fillStyle = skins[Math.floor(rand() * skins.length)]!;
+			g.beginPath();
+			g.arc(x, y, 5, 0, Math.PI * 2);
+			g.fill();
+			if (rand() < 0.15) {
+				g.fillStyle = shirt;
