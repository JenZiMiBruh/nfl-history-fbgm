+// ---------------------------------------------------------------- messages
+// JSON can't carry Errors, undefined in objects, or non-finite numbers: tag them.
+const replacer = (_key: string, value: any) => {
+	if (value instanceof Error || (value && typeof value === "object" && typeof value.message === "string" && typeof value.stack === "string")) {
+		return { __type: "Error", name: value.name, message: value.message, stack: value.stack };
+	}
+	if (typeof value === "number" && !Number.isFinite(value)) {
+		return { __type: "Number", value: String(value) };
+	}
+	if (value instanceof Map) return { __type: "Map", value: [...value] };
+	if (value instanceof Set) return { __type: "Set", value: [...value] };
+	return value;
+};
+const reviver = (_key: string, value: any) => {
+	if (value && typeof value === "object" && typeof value.__type === "string") {
+		if (value.__type === "Error") {
+			const e = new Error(value.message);
+			e.name = value.name;
+			return e;
+		}
+		if (value.__type === "Number") return Number(value.value);
+		if (value.__type === "Map") return new Map(value.value);
+		if (value.__type === "Set") return new Set(value.value);
+	}
+	return value;
+};
+g.postMessage = (message: unknown) => {
+	host.post(JSON.stringify(message, replacer));
+};
+
+g.__engine = {
+	fireTimer(id: number) {
+		const t = timers.get(id);
+		if (!t) return;
+		if (t.repeat) host.setTimer(id, Math.max(0, t.ms | 0));
+		else timers.delete(id);
+		t.fn();
+	},
+	receive(json: string) {
