+											event.stopPropagation();
+										}}
+									/>
+									{label} ({numKept}/{ids.length})
+								</summary>
+								<div
+									className="ms-4"
+									style={{ maxHeight: 300, overflowY: "auto" }}
+								>
+									{events.map((e: any) => (
+										<div key={e.id} className="form-check">
+											<input
+												type="checkbox"
+												className="form-check-input"
+												id={`nfl-event-${e.id}`}
+												checked={kept.has(e.id)}
+												onChange={(event) => {
+													setMany([e.id], event.target.checked);
+												}}
+											/>
+											<label
+												className="form-check-label"
+												htmlFor={`nfl-event-${e.id}`}
+											>
+												<span className="text-body-secondary">
+													{e.season}{" "}
+													{PHASE_NAMES[e.phase] ?? `phase ${e.phase}`}:
+												</span>{" "}
+												{w.SEASON_SLICER.describeEvent(
+													e,
+													w.NFL_ERAS,
+													nameByPid,
+												)}
+											</label>
+										</div>
+									))}
+								</div>
+							</details>
+						);
+					},
+				)}
+			</div>
+		);
+	}
+
+	const seasons = [];
+	for (let i = 2026; i >= 1966; i--) {
+		seasons.push(i);
+	}
+
+	return (
+		<div className="card mb-3">
+			<div className="card-body">
+				<h3 className="card-title">NFL History</h3>
+				{!loaded ? (
+					<>
+						<p className="mb-2">
+							Choose <code>NFL_Master_1966_2026.json</code> to start in any
+							season.
+						</p>
+						<input
+							type="file"
+							accept=".json,application/json"
+							onChange={loadMaster}
+							disabled={disabled}
+						/>
+					</>
+				) : (
+					<div className="d-flex flex-wrap gap-2 align-items-center">
+						<select
+							className="form-select w-auto"
+							value={season}
+							onChange={(event) => {
+								setSeason(Number.parseInt(event.target.value));
+								setLeague(undefined);
+								// Live is only for the current season; Playoffs / After Playoffs / Draft need a finished one
+								if (
+									(event.target.value !== "2026" && phase === "live") ||
+									(event.target.value === "2026" &&
+										["playoffs", "afterplayoffs", "draft"].includes(phase))
+								) {
+									setPhase("regular");
+								}
+							}}
+						>
+							{seasons.map((y) => (
+								<option key={y} value={y}>
+									{/* Seasons are named by the year they end (2009 = 2008-09) */}
+									{y + 1} ({y}-{String(y + 1).slice(2)})
+								</option>
+							))}
+						</select>
+						<select
+							className="form-select w-auto"
+							value={phase}
+							onChange={(event) => {
+								setPhase(event.target.value);
+								setLeague(undefined);
+							}}
+						>
+							<option value="preseason">Preseason</option>
+							<option value="regular">Regular Season, Week 1</option>
+							{season < 2026 ? (
+								<>
+									<option value="playoffs">Playoffs</option>
+									<option value="afterplayoffs">After Playoffs</option>
+									<option value="draft">Draft</option>
+								</>
+							) : null}
+							{season === 2026 ? (
+								<option value="live">Live (2027, through Week 8)</option>
+							) : null}
+						</select>
+						<button
+							className="btn btn-primary"
+							type="button"
+							onClick={build}
+							disabled={disabled}
+						>
+							Build league
+						</button>
+					</div>
+				)}
+				{status ? <p className="mt-2 mb-0">{status}</p> : null}
+				{loaded && (window as any).NFL_MOD_BUILT ? (
+					<p className="mt-2 mb-0 text-body-secondary small">
+						NFL data built {(window as any).NFL_MOD_BUILT}
+					</p>
+				) : null}
+				{eventList}
+			</div>
+		</div>
+	);
+};
