+				</clipPath>
+				<path d="M4.5 8 Q20 3 35.5 8 Q34 11 35.5 14 L35.5 29.5 Q35.5 40 20 45.5 Q4.5 40 4.5 29.5 L4.5 14 Q6 11 4.5 8 Z" fill="#fff" stroke="#013369" strokeWidth="2.2" />
+				<g clipPath="url(#nfls)">
+					<rect x="0" y="0" width="40" height="18.5" fill="#013369" />
+				</g>
+				<ellipse cx="20" cy="11.5" rx="4.6" ry="2.6" fill="#fff" />
+				<path d="M17.2 11.5 H22.8 M18.4 10.6 V12.4 M19.6 10.6 V12.4 M20.8 10.6 V12.4 M22 10.6 V12.4" stroke="#013369" strokeWidth="0.45" />
+				{[
+					[8.5, 11.2],
+					[11.5, 8.6],
+					[11.5, 14],
+					[14.2, 11.2],
+					[25.8, 11.2],
