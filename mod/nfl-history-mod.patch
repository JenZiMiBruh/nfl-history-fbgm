+// NFL history mod: the small logo slot holds a team's secondary logo; the "Secondary Logos" setting can turn that off
+export const chooseSmallLogo = (
+	small: string | undefined,
+	big: string | undefined,
+) => {
+	let on = false;
+	try {
+		on = localStorage.getItem("nflSecondaryLogos") === "true";
+	} catch {}
+	return on ? (small ?? big) : (big ?? small);
+};
