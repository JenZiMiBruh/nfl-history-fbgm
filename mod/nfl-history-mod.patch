+						✕
+					</button>
+				) : null}
+				<button
+					type="button"
+					className="btn btn-sm"
+					style={{
+						background: "rgba(2,6,23,.75)",
+						color: "#ffffff",
+						border: "1px solid rgba(255,255,255,.35)",
+						fontWeight: 700,
+					}}
+					onClick={() => {
+						if (!st) return;
+						st.camMode = st.camMode === "behind" ? "broadcast" : "behind";
+						try {
+							localStorage.setItem("nflCam", st.camMode);
+						} catch {
+							// no storage
+						}
+					}}
+					title="Switch camera"
+				>
+					{st?.camMode === "behind" ? "🎥 Behind the play" : "📺 Broadcast"}
+				</button>
+				<button
+					type="button"
+					className="btn btn-sm"
+					style={{
+						background: "rgba(2,6,23,.75)",
+						color: "#ffffff",
+						border: "1px solid rgba(255,255,255,.35)",
+						minWidth: 30,
+						fontWeight: 700,
+					}}
