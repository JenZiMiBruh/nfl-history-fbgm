+				<path d="M4.5 8 Q20 3 35.5 8 Q34 11 35.5 14 L35.5 29.5 Q35.5 40 20 45.5 Q4.5 40 4.5 29.5 L4.5 14 Q6 11 4.5 8 Z" fill="none" stroke="#fff" strokeWidth="1.4" />
+				{[9, 14.5, 20, 25.5, 31].map((x) => (
