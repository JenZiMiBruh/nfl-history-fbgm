+// Referees: a generated face each, kept for the whole game
+const refFaces = new Map<string, any>();
+export const refFace = (key: string) => {
+	let f = refFaces.get(key);
+	if (!f) {
+		f = generate(undefined, { gender: "male" } as any);
+		refFaces.set(key, f);
+	}
+	return f;
+};
