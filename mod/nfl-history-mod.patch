+const makeAds = (r: () => number): Ad[] => {
+	const cats = Object.keys(CAT) as Category[];
+	const used = new Set<string>();
+	const out: Ad[] = [];
+	for (let n = 0; out.length < 24 && n < 200; n++) {
+		const cat = cats[out.length % cats.length]!;
+		const c = CAT[cat];
+		const stem = pickOf(PARTS.first, r) + pickOf(PARTS.end, r);
+		if (used.has(stem)) continue;
+		used.add(stem);
+		const suffix = pickOf(c.suffix, r);
+		const brand = suffix ? `${stem} ${suffix}` : stem;
+		const pal = pickOf(c.palettes, r);
+		out.push({
+			brand,
+			line: pickOf(c.lines, r),
+			beats: pickOf(c.beats, r),
+			colors: [pal[0], pal[1]],
+			accent: pal[2],
+			cat,
+			kind: cat,
+			icon: "",
+			mark: pickOf(MARKS, r),
+			url: `${stem.toLowerCase()}${suffix.toLowerCase().replace(/[^a-z]/g, "")}.com`,
+			fine: pickOf(c.fine, r),
+		});
+	}
+	return out;
