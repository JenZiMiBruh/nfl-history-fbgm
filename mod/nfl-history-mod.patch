+	cut: "classic" | "nineties" | "modern";
+	nameOnBack: boolean;
+	// what sits on the sleeves besides the design: TV numbers (most jerseys until the 2010s), the team logo (from the
+	// mid-90s, on plain sleeves)
+	sleeveMark: "tv" | "logo" | "none";
+	numberGradient?: [string, string];
+	// a second, inner trim color between the number and its outline (Jaguars 1995-2008 gold inside black)
+	numberInner?: string;
+	// outline thickness relative to the usual (Jaguars 2009-11 "thicker, single color border")
+	outlineScale?: number;
+	// the name bar color when it differs from the numbers (God Mode builder)
+	nameColor?: string;
+};
