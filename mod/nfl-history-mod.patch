+// NFL history mod: a commercial break. The network bumper ("we'll be right back", in the game's broadcast look), then a
+// short spot for a made-up sponsor, built the way real spots are: a product shot with one line of copy, a second shot
+// with the benefit, then the end card (the logo mark, the brand in its own type, the tagline, the web address and the
+// fine print). Brands are generated each session from plain name parts (no football puns), the products are drawn
+// as simple shapes (no emoji), and an older game gets a film look. All drawn here, no files.
+import { useEffect, useState } from "react";
+import type { Presentation } from "./NflScoreboard.tsx";
+
+type Category =
+	| "car"
+	| "truck"
+	| "soda"
+	| "phone"
+	| "pizza"
+	| "burger"
+	| "bank"
+	| "insurance"
+	| "sneaker"
+	| "coffee";
+
+export type Ad = {
