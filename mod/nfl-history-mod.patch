+	g.lineTo(cx - 50, 140);
+	g.quadraticCurveTo(cx - 74, 128, cx - 66, 108);
+	g.quadraticCurveTo(cx - 46, 90, cx - 18, 94);
+	g.lineTo(cx + 18, 94);
+	g.quadraticCurveTo(cx + 46, 90, cx + 66, 108);
