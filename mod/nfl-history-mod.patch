+// The real uniform for a team in the live game, when its colors are this era's
+export const nflUniformFor = (
+	abbrev: string | undefined,
+	colors: string[] | undefined,
+): NflUniform | undefined => {
+	const u = abbrev ? NFL_UNIFORMS[abbrev] : undefined;
+	const c = colors?.[0]?.toLowerCase();
+	if (!u || !c) return undefined;
+	return c === u.era || c === u.alt ? u : undefined;
+};
