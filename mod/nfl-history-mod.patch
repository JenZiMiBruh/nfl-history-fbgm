+		g.items.map((it) => `<path transform='${it.tf}' d='${GLYPH[it.ch]!.d}' fill='url(#${p}nm)' stroke='#59616B' stroke-width='${(1.4 / k).toFixed(2)}'/>`).join("") +
+		txt(where, { y: 240, size: 10, fill: "#444", font: "Arial", weight: 700, ls: 1.5 })
