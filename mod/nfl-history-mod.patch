@@ -0,0 +1,369 @@
+// NFL history mod: championship banners that change with the era. Before the Super Bowl: a felt pennant reading NFL
+// CHAMPIONS. Super Bowl I to the 80s: a felt banner with stitched trim, the team logo and that game's Super Bowl logo.
+// From the 90s: a satin banner with the Super Bowl logo on top, the team logo, the year in a band. Super Bowl logos come
+// from common/nflSuperBowl.ts.
+import { useId } from "react";
+import {
+	superBowlLogo,
+	superBowlName,
+	superBowlNumber,
+} from "../../common/nflSuperBowl.ts";
+
+const lum = (hex: string) => {
+	const v = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
+	return 0.2126 * v[0]! + 0.7152 * v[1]! + 0.0722 * v[2]!;
+};
+const shade = (hex: string, k: number) =>
+	`#${[1, 3, 5]
+		.map((i) =>
+			Math.max(
+				0,
+				Math.min(255, Math.round(parseInt(hex.slice(i, i + 2), 16) * k)),
+			)
+				.toString(16)
+				.padStart(2, "0"),
+		)
+		.join("")}`;
+
+export const NflChampionshipBanner = ({
+	season,
+	colors,
+	logo,
+	width = 110,
+}: {
+	// league season (NFL History seasons are one later than the real season)
+	season: number;
+	colors: [string, string, string];
+	logo?: string;
+	width?: number;
+}) => {
+	const uid = "b" + useId().replace(/[^\dA-Za-z]/g, "");
+	const year = season - 1;
+	const n = superBowlNumber(season);
+	const main = colors[0];
+	const trim =
+		colors[1] && Math.abs(lum(colors[1]) - lum(main)) > 0.15
+			? colors[1]
+			: lum(main) > 0.5
+				? "#101820"
+				: "#FFFFFF";
+	const text = lum(main) > 0.55 ? "#101820" : "#FFFFFF";
+
+	if (n === undefined) {
+		// felt pennant
+		return (
+			<svg
+				viewBox="0 0 120 170"
+				width={width}
+				role="img"
+				aria-label={`${year} NFL champions`}
+			>
+				<defs>
+					<pattern
+						id={`${uid}f`}
+						width="3"
+						height="3"
+						patternUnits="userSpaceOnUse"
+					>
+						<circle cx="1" cy="1" r="0.6" fill="#000" opacity="0.12" />
+					</pattern>
+					<linearGradient id={`${uid}c`} x1="0" x2="1">
+						<stop offset="0" stopColor={shade(main, 0.62)} />
+						<stop offset="0.25" stopColor={shade(main, 0.9)} />
+						<stop offset="0.45" stopColor={shade(main, 1.12)} />
+						<stop offset="0.7" stopColor={shade(main, 0.88)} />
+						<stop offset="1" stopColor={shade(main, 0.6)} />
+					</linearGradient>
+				</defs>
+				<path d="M8 6 L112 6 L60 164 Z" fill={`url(#${uid}c)`} />
+				<path d="M8 6 L112 6 L60 164 Z" fill={`url(#${uid}f)`} />
+				<path
+					d="M14 12 L106 12 L60 152 Z"
+					fill="none"
+					stroke={trim}
+					strokeWidth="2.5"
+					strokeDasharray="4 3"
+				/>
+				<rect x="4" y="2" width="112" height="10" rx="3" fill={trim} />
+				<text
+					x="60"
+					y="34"
+					textAnchor="middle"
+					fontFamily="Georgia,serif"
+					fontWeight="700"
+					fontSize="10"
+					fill={text}
+					letterSpacing="1"
+					textLength="78"
+					lengthAdjust="spacingAndGlyphs"
+				>
+					NFL CHAMPIONS
+				</text>
+				{logo ? (
+					<image
+						href={logo}
+						x="36"
+						y="40"
+						width="48"
+						height="48"
+						preserveAspectRatio="xMidYMid meet"
+					/>
+				) : null}
+				<text
+					x="60"
+					y="104"
+					textAnchor="middle"
+					fontFamily="Georgia,serif"
+					fontWeight="700"
+					fontSize="16"
+					fill={text}
+				>
+					{year}
+				</text>
+			</svg>
+		);
+	}
+
+	if (year < 1990) {
+		// felt banner, stitched, pointed foot
+		return (
+			<svg
+				viewBox="0 0 120 200"
+				width={width}
+				role="img"
+				aria-label={`Super Bowl ${superBowlName(n)} champions`}
+			>
+				<defs>
+					<pattern
+						id={`${uid}f`}
+						width="3"
+						height="3"
+						patternUnits="userSpaceOnUse"
+					>
+						<circle cx="1" cy="1" r="0.6" fill="#000" opacity="0.12" />
+					</pattern>
+					<linearGradient id={`${uid}c`} x1="0" x2="1">
+						<stop offset="0" stopColor={shade(main, 0.62)} />
+						<stop offset="0.25" stopColor={shade(main, 0.9)} />
+						<stop offset="0.45" stopColor={shade(main, 1.12)} />
+						<stop offset="0.7" stopColor={shade(main, 0.88)} />
+						<stop offset="1" stopColor={shade(main, 0.6)} />
+					</linearGradient>
+				</defs>
+				<rect x="4" y="2" width="112" height="9" rx="3" fill={trim} />
+				<path
+					d="M10 8 L110 8 L110 170 L60 196 L10 170 Z"
+					fill={`url(#${uid}c)`}
+				/>
+				<path
+					d="M10 8 L110 8 L110 170 L60 196 L10 170 Z"
+					fill={`url(#${uid}f)`}
+				/>
+				<path
+					d="M16 14 L104 14 L104 166 L60 189 L16 166 Z"
+					fill="none"
+					stroke={trim}
+					strokeWidth="2"
+					strokeDasharray="4 3"
+				/>
+				{logo ? (
+					<image
+						href={logo}
+						x="34"
+						y="20"
+						width="52"
+						height="46"
+						preserveAspectRatio="xMidYMid meet"
+					/>
+				) : null}
+				<text
+					x="60"
+					y="88"
+					textAnchor="middle"
+					fontFamily="Georgia,serif"
+					fontWeight="700"
+					fontSize="10"
+					letterSpacing="1"
+					textLength="80"
+					lengthAdjust="spacingAndGlyphs"
+					fill={text}
+				>
+					WORLD CHAMPIONS
+				</text>
+				<image href={superBowlLogo(n, { bare: true })} x="30" y="94" width="60" height="60" />
+				<text
+					x="60"
+					y="170"
+					textAnchor="middle"
+					fontFamily="Georgia,serif"
+					fontWeight="700"
+					fontSize="14"
+					fill={text}
+				>
+					{year}
+				</text>
+			</svg>
+		);
+	}
+
+	// Stadium banner (1990 on): heavy cloth in the team color with vertical folds, a brushed-metal rod, a stitched trim
+	// border, SUPER BOWL and the numeral as the title, the team logo as the centerpiece on a soft light, that game's Super
+	// Bowl logo in a silver medallion, the year on a ribbon. From 2015 a swallowtail foot.
+	const modernEra = year >= 2015;
+	const shape = modernEra
+		? "M8 8 L112 8 L112 206 L60 190 L8 206 Z"
+		: "M8 8 L112 8 L112 188 L60 210 L8 188 Z";
+	const inset = modernEra
+		? "M13 13 L107 13 L107 199 L60 184 L13 199 Z"
+		: "M13 13 L107 13 L107 184 L60 204 L13 184 Z";
+	const numeral = superBowlName(n);
+	const dark = lum(main) < 0.35;
+	return (
+		<svg
+			viewBox="0 0 120 214"
+			width={width}
+			role="img"
+			aria-label={`Super Bowl ${numeral} champions`}
+		>
+			<defs>
+				{/* cloth: folds as soft vertical light and shade */}
+				<linearGradient id={`${uid}s`} x1="0" x2="1">
+					<stop offset="0" stopColor={shade(main, 0.62)} />
+					<stop offset="0.12" stopColor={shade(main, 0.95)} />
+					<stop offset="0.26" stopColor={shade(main, 0.8)} />
+					<stop offset="0.42" stopColor={shade(main, 1.1)} />
+					<stop offset="0.58" stopColor={shade(main, 0.86)} />
+					<stop offset="0.74" stopColor={shade(main, 1.06)} />
+					<stop offset="0.88" stopColor={shade(main, 0.84)} />
+					<stop offset="1" stopColor={shade(main, 0.6)} />
+				</linearGradient>
+				<linearGradient id={`${uid}v`} x1="0" y1="0" x2="0" y2="1">
+					<stop offset="0" stopColor="#000" stopOpacity="0.28" />
+					<stop offset="0.12" stopColor="#000" stopOpacity="0" />
+					<stop offset="0.85" stopColor="#000" stopOpacity="0" />
+					<stop offset="1" stopColor="#000" stopOpacity="0.25" />
+				</linearGradient>
+				<linearGradient id={`${uid}m`} x1="0" y1="0" x2="0" y2="1">
+					<stop offset="0" stopColor="#F5F7F9" />
+					<stop offset="0.5" stopColor="#A9B0B8" />
+					<stop offset="1" stopColor="#E3E7EB" />
+				</linearGradient>
+				<radialGradient id={`${uid}g`} cx="0.5" cy="0.5" r="0.5">
+					<stop
+						offset="0"
+						stopColor="#FFFFFF"
+						stopOpacity={dark ? 0.32 : 0.18}
+					/>
+					<stop offset="1" stopColor="#FFFFFF" stopOpacity="0" />
+				</radialGradient>
+				<radialGradient id={`${uid}d`} cx="0.45" cy="0.35" r="0.65">
+					<stop offset="0" stopColor="#FFFFFF" />
+					<stop offset="1" stopColor="#D5DAE0" />
+				</radialGradient>
+			</defs>
+			{/* rod with end caps */}
+			<rect
+				x="1"
+				y="2"
+				width="118"
+				height="7"
+				rx="3.5"
+				fill={`url(#${uid}m)`}
