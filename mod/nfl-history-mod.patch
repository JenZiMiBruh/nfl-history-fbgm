index 000000000..0a61af59d
--- /dev/null
+++ b/src/ui/views/LiveGame/NflCutscene.ts
@@ -0,0 +1,119 @@
+// NFL history mod: the cutscene director. Anything in the broadcast can queue a scene: "point the camera at this
+// player (or the referee), show this panel beside him, say this line, for this long". Scenes play one at a time, in
+// order. The 3D field (NflField3D.tsx) flies the camera in and pins the panel next to whoever the scene is about; the
+// animated field (NflPlayField.tsx) holds the snap while one is playing, so the game waits for it; the broadcast
+// (NflBroadcast.tsx) holds the play-by-play the same way.
+import { fx } from "./NflSettings.ts";
+import type { ReactNode } from "react";
+
+export type Scene = {
+	// Who the camera looks at: an actor key on the field ("p123" for a player, "ref0" for the referee), or a spot
+	key: string;
+	at?: { x: number; y: number };
+	// A 3D prop the field animates through the scene (the coin at the toss)
+	prop?: "coin";
+	// For the coin: which face it lands on
+	coin?: "Heads" | "Tails";
+	// How the camera frames him: a close-up from in front ("portrait") or a little wider ("medium")
+	shot: "portrait" | "medium";
+	// Which side of him the panel goes
+	side: "left" | "right";
+	ms: number;
+	// The panel beside the subject (or a function of how far along the scene is, 0-1, for panels that change as it plays)
+	panel: ReactNode | ((k: number) => ReactNode);
+	// Spoken out loud (the referee's announcement), if the sound is on
+	speak?: string;
+	// An instant replay: the field plays these recorded frames back (slow motion) instead of the live picture, the camera
+	// low behind the play (od: the way the offense was going)
+	replay?: { frames: { actors: any[]; ball: any }[]; od: 1 | -1 };
+	// A sweeping orbit around the whole stadium (the teams switching ends)
+	orbit?: boolean;
+	// Where the panel goes: beside the subject (default) or pinned in the top corner (the replay bug)
+	panelPos?: "beside" | "corner";
+};
+
+type Playing = Scene & { start: number };
+// (a scene that waited this long in line is about a moment long gone: dropped, not played)
+const STALE_MS = 15000;
+type Queued = Scene & { queuedAt: number };
+
+let queue: Queued[] = [];
+let now: Playing | undefined;
+const listeners = new Set<() => void>();
+const changed = () => {
+	for (const f of listeners) f();
+};
+
+// Out loud, with the browser's own voice (a referee's cadence: a bit slow and low)
+const say = (text: string) => {
+	try {
+		if (localStorage.getItem("nflIntroSound") === "off" || !fx("refVoice"))
+			return;
+		const synth = window.speechSynthesis;
+		if (!synth) return;
+		synth.cancel();
+		const u = new SpeechSynthesisUtterance(text);
+		u.rate = 0.98;
+		u.pitch = 0.82;
+		const voices = synth.getVoices();
+		const v =
+			voices.find(
+				(x) =>
+					/en-US/i.test(x.lang) && /male|david|guy|daniel|fred/i.test(x.name),
+			) ?? voices.find((x) => /^en/i.test(x.lang));
+		if (v) u.voice = v;
+		synth.speak(u);
+	} catch {
+		// no speech in this browser
+	}
+};
+
+const next = () => {
+	let s = queue.shift();
+	while (s && performance.now() - s.queuedAt > STALE_MS) s = queue.shift();
+	now = s ? { ...s, start: performance.now() } : undefined;
+	if (now?.speak) say(now.speak);
+	changed();
+};
+
+// Fast-forwarding (the play buttons skipping ahead): no graphics, no cutscenes for that stretch
+export const fastForwarding = () => {
+	try {
+		return Date.now() - ((window as any).__nflFF ?? 0) < 1500;
+	} catch {
+		return false;
+	}
+};
+
+export const cutscenes = {
+	play(scene: Scene) {
+		if (fastForwarding()) return;
+		queue.push({ ...scene, queuedAt: performance.now() });
+		if (!now) next();
+	},
+	// The scene playing right now (finished ones are cleared as they're asked about), and how far along it is (0-1)
+	current(): (Playing & { k: number }) | undefined {
+		if (now && performance.now() - now.start > now.ms) next();
+		return now
+			? { ...now, k: Math.min(1, (performance.now() - now.start) / now.ms) }
+			: undefined;
+	},
+	skip() {
+		try {
+			window.speechSynthesis?.cancel();
+		} catch {
+			// nothing to stop
+		}
+		next();
+	},
+	clear() {
+		queue = [];
+		now = undefined;
+		changed();
+	},
+	busy: () => !!cutscenes.current() || queue.length > 0,
+	subscribe(f: () => void) {
+		listeners.add(f);
+		return () => void listeners.delete(f);
+	},
+};
