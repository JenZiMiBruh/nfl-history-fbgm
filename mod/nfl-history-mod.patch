+// NFL history mod: a Super Bowl logo for every game, drawn here (no image files). The numeral is the hero, the Lombardi
+// trophy appears from the 90s on, and each game picks up its host city's colors. The style follows the era: plain
+// vintage roundels for the first games, 80s speed stripes, 90s-2000s crests, then the modern trophy-and-numerals look.
+// Real hosts through LXI (the 2026 season); later games get a host from a rotation of past host cities.
+
+import { realEarlyLogo } from "./nflSuperBowlReal.ts";
+import { generatedLogo, realLateLogo } from "./nflSuperBowlRealLate.ts";
+
+export const roman = (n: number) => {
+	const map: [number, string][] = [
+		[1000, "M"],
+		[900, "CM"],
+		[500, "D"],
+		[400, "CD"],
+		[100, "C"],
+		[90, "XC"],
+		[50, "L"],
+		[40, "XL"],
+		[10, "X"],
+		[9, "IX"],
+		[5, "V"],
+		[4, "IV"],
+		[1, "I"],
+	];
+	let out = "";
+	let x = n;
+	for (const [v, s] of map) {
+		while (x >= v) {
+			out += s;
+			x -= v;
+		}
+	}
+	return out;
+};
+
+// Super Bowl number for a league season (NFL History seasons are one later than the real season: league 1967 = the
+// 1966 season = Super Bowl I). undefined before the Super Bowl era.
+export const superBowlNumber = (leagueSeason: number) =>
+	leagueSeason >= 1967 ? leagueSeason - 1966 : undefined;
+
+// How the game is written: Roman, except 50
+export const superBowlName = (n: number) => (n === 50 ? "50" : roman(n));
+
