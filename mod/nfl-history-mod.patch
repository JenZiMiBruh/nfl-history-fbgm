+export const warmFaces = (
+	list: { pl: { face?: any; pid?: number }; colors: string[] }[],
+) => {
+	let k = 0;
+	const step = (dl?: { timeRemaining: () => number }) => {
+		while (k < list.length && (!dl || dl.timeRemaining() > 4)) {
+			const { pl, colors } = list[k++]!;
+			faceSrc(pl, colors);
+			if (!dl) break;
+		}
+		if (k < list.length) {
+			const ric = (window as any).requestIdleCallback;
+			if (ric) ric(step, { timeout: 400 });
+			else setTimeout(() => step(), 16);
+		}
+	};
+	step();
