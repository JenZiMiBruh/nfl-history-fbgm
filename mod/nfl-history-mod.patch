+// Builds build/native/engine.js: Football GM's worker as one classic script for V8 (no modules, no dynamic imports).
+// Usage: SPORT=football node tools/native/build.ts
+import path from "node:path";
+import { build } from "rolldown";
+import { rolldownConfig } from "../lib/rolldownConfig.ts";
+import { getSport } from "../lib/getSport.ts";
+import fs from "node:fs";
+import { removeUnicodePropertyEscapes } from "./noIntlRegex.ts";
+
+const sport = getSport();
+const config = rolldownConfig(sport, "worker", { nodeEnv: "test" });
+config.input = "tools/native/entry.ts";
+// Use our faster copy of fake-indexeddb's RecordStore (see tools/native/RecordStore.js)
+const fastRecordStore = path.resolve("tools/native/RecordStore.js");
+config.plugins = [
+	{
+		name: "fast-record-store",
+		resolveId(source: string, importer: string | undefined) {
+			if (importer && importer.includes("fake-indexeddb") && source.endsWith("/RecordStore.js")) {
+				return fastRecordStore;
+			}
+			return null;
+		},
+	},
+	...((config.plugins as any[]) ?? []),
+];
+config.platform = "browser";
+config.output = {
+	file: "build/native/engine.js",
+	format: "iife",
+	codeSplitting: false,
+	minify: true,
+	comments: false,
+	sourcemap: false,
+};
+config.transform!.define = { ...config.transform!.define, __NODE_ENV: JSON.stringify("production") };
+await build(config);
+const out = "build/native/engine.js";
+fs.writeFileSync(out, removeUnicodePropertyEscapes(fs.readFileSync(out, "utf8")));
+console.log("wrote build/native/engine.js");
