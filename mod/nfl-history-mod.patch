+	const mine = game.homeTid === userTid || game.awayTid === userTid;
+	// One line per game: time | away @ home (scores) | slot | stadium and weather
+	const team = (
+		tid: number,
+		t: Teams[number] | undefined,
+		pts: number | undefined,
+		other: number | undefined,
+	) => (
+		<span
+			className="d-inline-flex align-items-center gap-1"
+			style={{ minWidth: 92 }}
+		>
+			<Logo t={t} size={22} />
+			{tid >= 0 && t ? (
+				// Team name: that team's calendar
+				<a
+					href={helpers.leagueUrl(["calendar", season, `${t.abbrev}_${tid}`])}
+					className={`text-reset ${tid === userTid ? "fw-bold" : "fw-semibold"}`}
+					title={`${t.region} ${t.name} calendar`}
+				>
+					{t.abbrev}
+				</a>
+			) : (
+				<span className="fw-semibold">TBD</span>
+			)}
+			{played ? (
+				<span
+					className={pts! > other! ? "fw-bold" : "text-body-secondary"}
+					style={{ fontVariantNumeric: "tabular-nums" }}
+				>
+					{pts}
+				</span>
+			) : null}
+		</span>
+	);
+	const st = slotStyle(info);
+	const matchup = (
+		<span className="d-inline-flex align-items-center gap-2">
+			{team(game.awayTid, away, game.awayPts, game.homePts)}
+			<span className="text-body-secondary small">
+				{game.neutralSite || info.superBowl ? "vs" : "@"}
+			</span>
+			{team(game.homeTid, home, game.homePts, game.awayPts)}
+		</span>
+	);
+	return (
+		<div
+			id={`nfl-game-${calendarKey(game)}`}
+			className="d-flex flex-wrap align-items-center px-2 py-2 border-bottom"
+			style={{
+				columnGap: 14,
+				rowGap: 2,
+				borderLeft: `4px solid ${st ? st.bg : "transparent"}`,
+				// Your games: a neutral tint, so the text keeps its normal color in light and dark mode
+				background: mine ? "rgba(128, 128, 128, 0.16)" : undefined,
+				outline: focused ? "2px solid var(--bs-primary)" : undefined,
+				outlineOffset: -2,
+				scrollMarginTop: 90,
+			}}
+		>
+			<span
+				className="small text-body-secondary"
+				style={{ width: 82, fontVariantNumeric: "tabular-nums" }}
+			>
+				{info.timeEstimated ? "~" : ""}
+				{info.timeText.replace(" ET", "")}
+				{info.network ? (
+					<span
+						className="d-block"
+						style={{ fontSize: ".7rem", opacity: 0.85 }}
+					>
+						📺 {info.network}
+					</span>
+				) : null}
+			</span>
+			{matchup}
+			{played && game.gid !== undefined && home ? (
+				<a
+					href={helpers.leagueUrl([
+						"game_log",
