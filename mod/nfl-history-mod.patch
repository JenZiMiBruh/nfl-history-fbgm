+// (clear: barely dimmed, so the live stadium behind shows through, for the game open)
+// Full-screen graphics: inside the game window (scaled to fit it) or over the whole screen (the setting)
+const Overlay = ({
+	children,
+	onClose,
+	closeLabel,
+	clear,
+}: {
+	children: ReactNode;
+	onClose: () => void;
+	closeLabel: string;
+	clear?: boolean;
+}) => {
+	const tick = useFxTick();
+	const slot = useSlot("nfl-game-window", fx("overlaysInField"), tick);
+	// (inside the game window only when it's big enough to read there; on a phone the cards go full screen, laid out
+	// for the phone's width)
+	const win = slot && (clear || slot.clientWidth >= 640) ? slot : null;
+	const design = win
+		? 820
+		: Math.min(820, Math.max(380, window.innerWidth - 20));
+	const style: CSSProperties = {
+		position: win ? "absolute" : "fixed",
+		inset: 0,
+		zIndex: win ? 40 : 1050,
+		background: clear ? "rgba(2,6,23,.18)" : "rgba(2,6,23,.75)",
+		display: "flex",
+		flexDirection: "column",
+		alignItems: "center",
+		justifyContent: "center",
+		padding: win ? 8 : 16,
+		gap: win ? 6 : 12,
+	};
+	const el = (
+		<div
+			style={{ ...style, cursor: "pointer" }}
+			role="dialog"
+			aria-modal="true"
+			// (a click anywhere on it moves on to the next card or scene; the buttons keep their own jobs)
+			onClick={(e) => {
+				if (!isControl(e.target)) advance();
+			}}
+		>
+			<FitBox width={design}>{children}</FitBox>
+			<button type="button" className="btn btn-light btn-sm" onClick={onClose}>
+				{closeLabel}
+			</button>
+		</div>
+	);
+	return win ? createPortal(el, win) : el;
+};
+// Shrinks what's inside to fit the box (never grows it)
+const FitBox = ({
+	children,
+	width = 820,
+}: {
+	children: ReactNode;
+	width?: number;
+}) => {
+	const outer = useRef<HTMLDivElement>(null);
+	const inner = useRef<HTMLDivElement>(null);
+	const [k, setK] = useState(1);
+	useLayoutEffect(() => {
+		const o = outer.current;
+		const i = inner.current;
+		if (!o || !i) return;
+		// (it never grows, except in the theater, where the picture is big: up to its --nfl-ui-scale)
+		const cap = () =>
+			parseFloat(getComputedStyle(o).getPropertyValue("--nfl-ui-scale")) || 1;
+		const fit = () =>
+			setK(
+				Math.min(
+					cap(),
+					o.clientHeight / Math.max(1, i.offsetHeight),
+					o.clientWidth / Math.max(1, i.offsetWidth),
+				),
+			);
+		fit();
+		const ro = new ResizeObserver(fit);
+		ro.observe(o);
+		ro.observe(i);
+		return () => ro.disconnect();
+	}, []);
+	return (
+		<div
+			ref={outer}
+			style={{
+				flex: 1,
+				minHeight: 0,
+				width: "100%",
+				display: "flex",
+				alignItems: "center",
+				justifyContent: "center",
+				overflow: "hidden",
+			}}
+		>
+			<div
+				ref={inner}
+				style={{
+					width, // (always the same layout, scaled down evenly to fit)
+					flex: "none",
+					transform: `scale(${k})`,
+					transformOrigin: "center",
+				}}
+			>
+				{children}
+			</div>
+		</div>
+	);
+};
+// Re-render when a presentation setting changes
+const useFxTick = () => {
+	const [t, setT] = useState(0);
+	useEffect(() => {
+		const on = () => setT((x) => x + 1);
+		window.addEventListener("nfl-fx", on);
+		return () => window.removeEventListener("nfl-fx", on);
+	}, []);
+	return t;
+};
