diff --git a/src/ui/views/LiveGame/NflBroadcast.tsx b/src/ui/views/LiveGame/NflBroadcast.tsx
new file mode 100644
index 000000000..06a298c70
--- /dev/null
+++ b/src/ui/views/LiveGame/NflBroadcast.tsx
@@ -0,0 +1,2986 @@
+// NFL history mod: a TV-style presentation for the live game. A pregame open themed by the game's slot (day game,
+// primetime, holiday, playoffs, Super Bowl) and weather, a broadcast scorebug, pop-up graphics when something
+// happens (touchdowns, turnovers, 100-yard games, the two-minute warning, scoring drives, quarter stats), and
+// commercial breaks between quarters with made-up sponsors. Football only, and only for real (not exhibition) games.
+import { chooseSmallLogo } from "../../util/chooseSmallLogo.ts";
+import { override } from "./NflDebug.tsx";
+import { advance, fx, isControl } from "./NflSettings.ts";
+import {
+	useEffect,
+	useLayoutEffect,
+	useRef,
+	useState,
+	type CSSProperties,
+	type ReactNode,
+} from "react";
+import { createPortal } from "react-dom";
+import {
+	readableOn,
+	useNflGameInfo,
+	weatherIcon,
+} from "../../components/NflGameInfo.tsx";
+import { NflIntro } from "./NflIntro.tsx";
+import { toWorker } from "../../util/toWorker.ts";
+import { ADS, NflCommercial } from "./NflCommercial.tsx";
+import {
+	clearPregameCache,
+	NflPregame,
+	SKINS,
+	type CardId,
+	type Starter,
+} from "./NflPregame.tsx";
+import { NflPlayerIntro, NflPlayerPanel } from "./NflPlayerIntro.tsx";
+import { cutscenes, fastForwarding } from "./NflCutscene.ts";
+import {
+	eraPresentation,
+	LineScore,
+	NflScoreboard,
+	Particles,
+	presentationFor,
+} from "./NflScoreboard.tsx";
+import { safeLocalStorage } from "../../util/safeLocalStorage.ts";
+
+// Draws its child at a fixed design width and scales it down to fit narrow screens (phones), so every
+// scoreboard design keeps its proportions instead of squashing or dropping the score
+const FitWidth = ({
+	design,
+	children,
+}: {
+	design: number;
+	children: ReactNode;
+}) => {
+	const outer = useRef<HTMLDivElement>(null);
+	const inner = useRef<HTMLDivElement>(null);
+	const [scale, setScale] = useState(1);
+	const [h, setH] = useState<number | undefined>(undefined);
+	useEffect(() => {
+		const el = outer.current;
+		if (!el) return;
+		const fit = () => {
+			const w = el.clientWidth;
+			const k = w < design ? w / design : 1;
+			setScale(k);
+			setH(k < 1 && inner.current ? inner.current.offsetHeight * k : undefined);
+		};
+		fit();
+		const ro = new ResizeObserver(fit);
+		ro.observe(el);
+		if (inner.current) ro.observe(inner.current);
+		return () => ro.disconnect();
+	}, [design]);
+	return (
+		<div ref={outer} style={{ width: "100%", height: h, overflow: "hidden" }}>
+			<div
+				ref={inner}
+				style={
+					scale < 1
+						? {
+								width: design,
+								transform: `scale(${scale})`,
+								transformOrigin: "top left",
+							}
+						: undefined
+				}
+			>
+				{children}
+			</div>
+		</div>
+	);
+};
+
+type Team = {
+	abbrev: string;
+	region: string;
+	name: string;
+	colors: [string, string, string];
+	imgURL?: string;
+	imgURLSmall?: string;
+	pts: number;
+	won?: number;
+	lost?: number;
+	tied?: number;
+	players: ({ pid: number; name: string; pos: string } & Record<string, any>)[];
+	[key: string]: any;
+};
+type Play = {
+	t: 0 | 1;
+	yards: number;
+	turnover: boolean;
+	countsTowardsNumPlays: boolean;
+	countsTowardsYards: boolean;
+	scoreInfo?: { type: string; long: string; points: number };
+	intendedPossessionChange: boolean;
+};
+
+// (the sponsors and their commercials: NflCommercial.tsx)
+
+const ordinal = (q: number) =>
+	q > 4
+		? q === 5
+			? "OT"
+			: `${q - 4}OT`
+		: `${q}${["st", "nd", "rd", "th"][q - 1]}`;
+const seconds = (time: string | undefined) => {
+	if (!time) return undefined;
+	const [m, s] = time.split(":").map(Number);
+	return m! * 60 + (s ?? 0);
+};
+
+const TeamChip = ({ t, size = 40 }: { t: Team; size?: number }) => {
+	const bg = t.colors?.[0] ?? "#333333";
+	return (
+		<div className="d-flex align-items-center gap-2">
+			{t.imgURL || t.imgURLSmall ? (
+				<img
+					src={chooseSmallLogo(t.imgURLSmall, t.imgURL)}
+					alt=""
+					style={{
+						width: size,
+						height: size,
+						objectFit: "contain",
+						filter: "drop-shadow(0 1px 2px rgba(0,0,0,.5))",
+					}}
+				/>
+			) : (
+				<span
+					style={{
+						width: size,
+						height: size,
+						borderRadius: 6,
+						background: bg,
+						display: "inline-block",
+					}}
+				/>
+			)}
+		</div>
+	);
+};
+
+type Popup = {
+	id: number;
+	kind: "big" | "lower";
+	title: string;
+	body?: ReactNode;
+	color: string;
+	ms: number;
+	// (lower thirds) the small line above the title: PENALTY, SUBSTITUTION, INJURY, SCORING DRIVE, MILESTONE...
+	tag?: string;
+	// the team it's about: its logo on the color block
+	team?: {
+		imgURL?: string;
+		imgURLSmall?: string;
+		abbrev?: string;
+		colors?: string[];
+	};
+	// the numbers, big, as chips (10 YARDS, ACCEPTED; 245 YDS, 2 TD)
+	chips?: string[];
+	// a substitution: who comes in, who goes out
+	sub?: { inName: string; inInfo?: string; outName?: string; outInfo?: string };
+};
+
+export const NflBroadcast = ({
+	boxScore,
+	sportState,
+	playIndex,
+	quarter,
+	paused,
+	onPause,
+	onPlay,
+}: {
+	boxScore: any;
+	sportState: any;
+	playIndex: number;
+	quarter: number;
+	paused: boolean;
+	onPause: () => void;
+	onPlay: () => void;
+}) => {
+	const teams = boxScore.teams as [Team, Team];
+	const home = teams[0];
+	const away = teams[1];
+	const info = useNflGameInfo(
+		boxScore.season,
+		boxScore.day,
+		home.tid,
+		away.tid,
+	);
+	// The network look for the slot, in the style of the season's era
+	// (the debug tool can force a broadcast package and an era)
+	const ov = override();
+	const theme0 = eraPresentation(
+		ov.season ?? boxScore.season,
+		presentationFor(info),
+	);
+	const theme = ov.pkg ? { ...theme0, pkg: ov.pkg as any } : theme0;
+	const [, setOvTick] = useState(0);
+	useEffect(() => {
+		let v = ov.v;
+		const id = setInterval(() => {
+			if (override().v !== v) {
+				v = override().v;
+				setOvTick((x) => x + 1);
+			}
+		}, 400);
+		return () => clearInterval(id);
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, []);
+	// Wait for the game info (network, slot) before drawing the bug, so the plain one never flashes before MNF's, SNF's...
+	const [infoWait, setInfoWait] = useState(true);
+	useEffect(() => {
+		const id = setTimeout(() => setInfoWait(false), 1500);
+		return () => clearTimeout(id);
+	}, []);
+	const bugReady = !!info || !infoWait;
+	// The open waits until the field has drawn the players' faces (8 seconds at most), so it never plays over a half-loaded field
+	const [facesReady, setFacesReady] = useState(false);
+	useEffect(() => {
+		const t0 = Date.now();
+		const id = setInterval(() => {
+			const pending = (window as any).__nflFacesPending;
+			if (
+				Date.now() - t0 > 1000 &&
+				((typeof pending === "function" && pending() === 0) ||
+					Date.now() - t0 > 15000)
+			) {
+				setFacesReady(true);
+				clearInterval(id);
+			}
+		}, 200);
+		return () => clearInterval(id);
+	}, []);
+
+	const [adsOn, setAdsOn] = useState(() => {
+		try {
+			return safeLocalStorage.getItem("nflBroadcastAds") !== "off";
+		} catch {
+			return true;
+		}
+	});
+	const [intro, setIntro] = useState(playIndex <= 0 && fx("intro"));
+	// (with the open turned off, the pregame show starts the broadcast by itself)
+	// A fresh game: nothing cached from an earlier one
+	useState(() => {
+		clearPregameCache(boxScore.day);
+		return 0;
+	});
+	const [pregame, setPregame] = useState(
+		() => playIndex <= 0 && !fx("intro") && fx("pregame"),
+	);
+	// Field cutscenes need the 3D view (the other views get the full-screen versions)
+	const on3d = () => {
+		try {
+			const v = localStorage.getItem("nflFieldView3");
+			return (
+				!!(window as any).__nflFieldGate?.mounted && v !== "off" // (the alpha has only the 3D stadium: any field that's on is 3D)
+			);
+		} catch {
+			return false;
+		}
+	};
+	const possessionRef = useRef<0 | 1 | undefined>(undefined);
+	possessionRef.current = boxScore.possession;
+	const themeRef = useRef(theme);
+	themeRef.current = theme;
+	// A player intro (a quarterback's first snap): a short cutscene, the game waits for it
+	const [playerIntro, setPlayerIntro] = useState<{
+		player: Starter;
+		team: any;
+	}>();
+	// (the field stands still while it plays)
+	useEffect(() => {
+		const gate = (window as any).__nflFieldGate;
+		if (gate) gate.held = !!playerIntro;
+		return () => {
+			if (gate) gate.held = false;
+		};
+	}, [playerIntro]);
+	// Cards during a break in the game (halftime, the quarter-break commercials, a timeout), then maybe the commercial
+	const [breakCards, setBreakCards] = useState<{
+		label: string;
+		only: CardId[];
+		thenAd?: { ad: (typeof ADS)[number]; title: string; stats?: boolean };
+	}>();
+	const breakTurn = useRef(0);
+	// The rules for what fills a break: nothing more than twice a game, what hasn't been seen yet first
+	const cardSeen = useRef(new Map<CardId, number>());
+	const pickCards = (pool: CardId[], n: number): CardId[] => {
+		const ok = pool.filter((c) => (cardSeen.current.get(c) ?? 0) < 2);
+		const order = ok
+			.map((c, i) => ({
+				c,
+				r:
+					(cardSeen.current.get(c) ?? 0) * 10 +
+					(Math.sin((breakTurn.current + 1) * 12.99 + i * 78.2) + 1) / 2,
+			}))
+			.sort((a, b) => a.r - b.r);
+		const out = order.slice(0, n).map((x) => x.c);
+		for (const c of out)
+			cardSeen.current.set(c, (cardSeen.current.get(c) ?? 0) + 1);
+		breakTurn.current++;
+		return out;
+	};
+	const nextBreakCard = (): CardId | undefined =>
+		pickCards(
+			[
+				"gameleaders",
+				"around",
+				"standings",
+				"leagueleaders",
+				"gamestats",
+				"playoffs",
+				"mvp",
+			],
+			1,
+		)[0];
+	// Sponsors in turn, never the same commercial twice in a game
+	const adsUsed = useRef(new Set<number>());
+	const nextAd = () => {
+		const free = ADS.map((_, i) => i).filter((i) => !adsUsed.current.has(i));
+		const i = free.length
+			? free[Math.floor(Math.random() * free.length)]!
+			: Math.floor(Math.random() * ADS.length);
+		adsUsed.current.add(i);
+		return ADS[i]!;
+	};
+	const [ad, setAd] = useState<
+		{ ad: (typeof ADS)[number]; title: string; stats?: boolean } | undefined
+	>();
+	const [popups, setPopups] = useState<Popup[]>([]);
+	const [details, setDetails] = useState(false);
+	// A flag on the play (the animated field says when it's been thrown)
+	const [flagDown, setFlagDown] = useState<number>(0);
+	// TOUCHDOWN at the moment the ball crosses the goal line (from the animated field)
+	const tdShownAt = useRef(0);
+	const tdTeam = useRef(-1);
+	useEffect(() => {
+		const on = (e: Event) => {
+			const tIdx = (e as CustomEvent).detail as number;
+			const t = teams[tIdx];
+			if (!t) return;
+			tdShownAt.current = Date.now();
+			tdTeam.current = tIdx;
+			show({
+				kind: "big",
+				title: `TOUCHDOWN ${t.region.toUpperCase()}`,
+				color: t.colors?.[0] ?? "#111111",
+				ms: 2600,
+			});
+			// After it, a cutaway (never the same pattern twice in a row): the crowd going wild, or the scoring team's
+			// sideline celebrating, or straight on
+			if (on3d() && fx("cutaways") && !fastForwarding()) {
+				const r = Math.random();
+				const pick = r < 0.38 ? "crowd" : r < 0.76 ? "sideline" : "none";
+				if (pick !== "none" && pick !== lastCut.current) {
+					lastCut.current = pick;
+					setTimeout(
+						() => cutaway(pick as "crowd" | "sideline", tIdx as 0 | 1),
+						2900,
+					);
+				} else lastCut.current = "none";
+			}
+		};
+		window.addEventListener("nfl-td", on);
+		// Injuries and substitutions, as lower-thirds
+		const findP = (pid: number) => {
+			for (const t of teams) {
+				const p = t.players.find((x) => x.pid === pid);
+				if (p) return { p, t };
+			}
+			return undefined;
+		};
+		const label = (p: any) =>
+			`${p.jerseyNumber !== undefined ? `#${p.jerseyNumber} ` : ""}${p.name}${p.pos ? ` (${p.pos})` : ""}`;
+		const onInjury = (e: Event) => {
+			const f = findP((e as CustomEvent).detail.pid);
+			if (!f) return;
+			const inj: any = (f.p as any).injury;
+			const what =
+				inj && inj.type && inj.type !== "Healthy"
+					? `${inj.type}${inj.gamesRemaining ? ` · expected out ${inj.gamesRemaining} game${inj.gamesRemaining === 1 ? "" : "s"}` : ""}`
+					: "Injured on the play · questionable to return";
+			// A key player (a quarterback, or one of the team's best) going down is a big moment: the camera finds him on the
+			// field with the news beside him; anyone else gets the lower third
+			const pp: any = f.p;
+			const key = pp.pos === "QB" || (pp.ovr ?? 0) >= 72;
+			if (key && on3d() && fx("refCalls")) {
+				hold();
+				cutscenes.play({
+					key: `p${pp.pid}`,
+					shot: "medium",
+					side: "right",
+					ms: 5000,
+					panel: (
+						<div
+							style={{
+								width: 300,
+								color: "#ffffff",
+								fontFamily: "'Oswald', 'Arial Narrow', sans-serif",
+								background: "linear-gradient(160deg, #450a0af2, #05070cee)",
+								borderLeft: "6px solid #ef4444",
+								padding: "10px 12px",
+								boxShadow: "0 10px 30px rgba(0,0,0,.6)",
+							}}
+						>
+							<div
+								style={{
+									letterSpacing: 3,
+									fontSize: ".8rem",
+									color: "#fca5a5",
+								}}
+							>
+								✚ INJURY UPDATE
+							</div>
+							<div
+								style={{
+									fontSize: "1.6rem",
+									fontWeight: 900,
+									lineHeight: 1.05,
+									marginTop: 4,
+								}}
+							>
+								{label(f.p)}
+							</div>
+							<div style={{ fontWeight: 700, marginTop: 2 }}>
+								{f.t.region} {f.t.name}
+							</div>
+							<div style={{ marginTop: 6, opacity: 0.92 }}>{what}</div>
+							{pp.pos === "QB" ? (
+								<div style={{ marginTop: 4, color: "#fde68a" }}>
+									The backup will take over under center
+								</div>
+							) : null}
+						</div>
+					),
+				});
+				setTimeout(release, 5100);
+			} else
+				show({
+					kind: "lower",
+					tag: "Injury",
+					title: label(f.p),
+					body: what,
+					team: f.t as any,
+					color: f.t.colors?.[0] ?? "#b91c1c",
+					ms: 6000,
+				});
+		};
+		const onSub = (e: Event) => {
+			const dd = (e as CustomEvent).detail;
+			const a = findP(dd.inPid);
+			const b = findP(dd.outPid);
+			if (!a) return;
+			// Only a real substitution at that position: on a QB run the field puts the quarterback in the running back's
+			// spot, which isn't a QB coming in for a RB (nor the RB "coming back" for the QB on the next play)
+			const posOf = (x: typeof a) => String((x?.p as any)?.pos ?? "");
+			if (posOf(a) !== dd.role || (b && posOf(b) !== dd.role)) return;
+			show({
+				kind: "lower",
+				tag: `Substitution · ${a.t.region} ${a.t.name}`,
+				title: "",
+				sub: {
+					inName: a.p.name,
+					inInfo: `${(a.p as any).pos ?? ""}${a.p.jerseyNumber !== undefined ? ` · #${a.p.jerseyNumber}` : ""}`,
+					outName: b?.p.name,
+					outInfo: b
+						? `${(b.p as any).pos ?? ""}${b.p.jerseyNumber !== undefined ? ` · #${b.p.jerseyNumber}` : ""}`
+						: undefined,
+				},
+				team: a.t as any,
+				color: a.t.colors?.[0] ?? "#111111",
+				ms: 5500,
+			});
+		};
+		// A quarterback takes the field for the first time: his season so far and his key ratings
+		const onQb = (e: Event) => {
+			const dd = (e as CustomEvent).detail;
+			const f = findP(dd.pid);
+			if (!f) return;
+			// His full card (ratings, season, bio, honors) straight from the league
+			void (toWorker as any)("main", "getNflPlayerCard", {
+				pid: dd.pid,
+				day: boxScore.day,
+			}).then(
+				(card: any) => {
+					const p: any = f.p;
+					const player = card ?? {
+						pid: p.pid,
+						name: p.name,
+						num: p.jerseyNumber,
+						pos: "QB",
+						stats: {},
+					};
+					hold();
+					if (!fx("qbIntro")) {
+						release();
+						return;
+					}
+					if (on3d()) {
+						// On the 3D field: the camera finds him walking out to the line, his card beside him
+						cutscenes.play({
+							key: `p${dd.pid}`,
+							shot: "portrait",
+							side: "right",
+							ms: 7000,
+							panel: (
+								<NflPlayerPanel
+									player={player}
+									team={f.t as any}
+									theme={themeRef.current}
+								/>
+							),
+						});
+						setTimeout(release, 7100);
+					} else setPlayerIntro({ player, team: f.t as any });
+				},
+				() => undefined,
+			);
+		};
+		window.addEventListener("nfl-qb", onQb);
+		// The debug tool: halftime cards or a commercial right now
+		const onDebugBreak = (e: Event) => {
+			const what = (e as CustomEvent).detail;
+			hold();
+			if (what === "halftime")
+				setBreakCards({
+					label: "Halftime",
+					only: ["halftime", "around", "leagueleaders"],
+				});
+			else if (what === "commercial")
+				setAd({ ad: nextAd(), title: "Debug", stats: false });
+			else release();
+		};
+		window.addEventListener("nfl-debug-break", onDebugBreak);
+		// (the debug tool can show the postgame show too)
+		const onDebugFinal = () =>
+			setBreakCards({
+				label: "Postgame",
+				only: ["final", "gamestats", "gameleaders", "around"],
+			});
+		window.addEventListener("nfl-debug-final", onDebugFinal);
+		window.addEventListener("nfl-injury", onInjury);
+		window.addEventListener("nfl-sub", onSub);
+		return () => {
+			window.removeEventListener("nfl-td", on);
