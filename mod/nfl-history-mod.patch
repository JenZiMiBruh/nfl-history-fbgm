+// Gridiron Almanac native engine: browser features Football GM's worker needs, for a bare V8 with no browser.
+// The app (Kotlin, or tools/native/harness.ts on a PC) provides globalThis.__host:
+//   setTimer(id, ms) / clearTimer(id)     the app calls __engine.fireTimer(id) when a timer is due
+//   post(json)                            a message from the engine to the app
+//   log(level, text)
+//   readText(path) -> string | null       bundled files (name lists)
+//   fileSize(path) -> number, readBytes(path, offset, length) -> Uint8Array   league files
+// and calls __engine.receive(json) to send the engine a message.
+import {
+	ReadableStream,
+	TransformStream,
+	WritableStream,
+	ByteLengthQueuingStrategy,
+	CountQueuingStrategy,
+} from "web-streams-polyfill";
+
+type Host = {
+	setTimer(id: number, ms: number): void;
+	clearTimer(id: number): void;
+	post(json: string): void;
+	log(level: string, text: string): void;
+	readText(path: string): string | null;
+	fileSize(path: string): number;
+	readBytes(path: string, offset: number, length: number): Uint8Array;
+};
+
+const g = globalThis as any;
+const host: Host = g.__host;
+
+g.self = g;
+g.window = undefined;
+
+// ---------------------------------------------------------------- console
+const fmt = (args: unknown[]) =>
+	args
+		.map((a) => {
+			if (typeof a === "string") return a;
+			if (a instanceof Error || (a && typeof a === "object" && "message" in (a as any))) {
+				const e = a as any;
+				return `${e.name ?? e.constructor?.name}: ${e.message}\n${e.stack ?? ""}`;
+			}
+			if (a && typeof a === "object") {
+				const o = a as any;
+				const keys = Object.getOwnPropertyNames(o);
+				if (keys.length === 0 || o.constructor?.name !== "Object") {
+					return `[${o.constructor?.name ?? "object"}] ${keys.map((k) => k + "=" + String(o[k])).join(" ")}`;
+				}
+			}
+			try {
+				return JSON.stringify(a);
+			} catch {
+				return String(a);
+			}
+		})
+		.join(" ");
+g.console = {
+	log: (...a: unknown[]) => host.log("log", fmt(a)),
+	info: (...a: unknown[]) => host.log("info", fmt(a)),
+	debug: () => {},
+	warn: (...a: unknown[]) => host.log("warn", fmt(a)),
+	error: (...a: unknown[]) => host.log("error", fmt(a)),
+	time: () => {},
+	timeEnd: () => {},
+	trace: () => {},
+	table: () => {},
+};
+
+// ---------------------------------------------------------------- timers
+let nextTimer = 1;
+const timers = new Map<number, { fn: () => void; ms: number; repeat: boolean }>();
+g.setTimeout = (fn: any, ms = 0, ...args: unknown[]) => {
+	const id = nextTimer++;
+	timers.set(id, { fn: () => fn(...args), ms, repeat: false });
+	host.setTimer(id, Math.max(0, ms | 0));
+	return id;
+};
+g.setInterval = (fn: any, ms = 0, ...args: unknown[]) => {
+	const id = nextTimer++;
+	timers.set(id, { fn: () => fn(...args), ms, repeat: true });
+	host.setTimer(id, Math.max(0, ms | 0));
+	return id;
+};
+g.clearTimeout = g.clearInterval = (id: number) => {
+	if (timers.delete(id)) host.clearTimer(id);
+};
+g.setImmediate = (fn: any, ...args: unknown[]) => g.setTimeout(fn, 0, ...args);
+g.clearImmediate = g.clearTimeout;
+g.queueMicrotask ??= (fn: () => void) => {
+	Promise.resolve().then(fn);
+};
+g.requestIdleCallback = (fn: any) =>
+	g.setTimeout(() => fn({ didTimeout: false, timeRemaining: () => 50 }), 1);
+g.cancelIdleCallback = g.clearTimeout;
+
+const start = Date.now();
+g.performance ??= { now: () => Date.now() - start, mark() {}, measure() {} };
+
+// ---------------------------------------------------------------- events
+class Event {
+	type: string;
+	defaultPrevented = false;
+	target: unknown = null;
+	constructor(type: string, init?: any) {
+		this.type = type;
+		Object.assign(this, init);
+	}
+	preventDefault() {
+		this.defaultPrevented = true;
+	}
+	stopPropagation() {}
+	stopImmediatePropagation() {}
+}
+class ErrorEvent extends Event {}
+class MessageEvent extends Event {}
+class CustomEvent extends Event {
+	detail: unknown;
+	constructor(type: string, init?: any) {
+		super(type, init);
+		this.detail = init?.detail;
+	}
+}
+class EventTarget {
+	#listeners = new Map<string, Set<any>>();
+	addEventListener(type: string, fn: any) {
+		if (!fn) return;
+		if (!this.#listeners.has(type)) this.#listeners.set(type, new Set());
+		this.#listeners.get(type)!.add(fn);
+	}
+	removeEventListener(type: string, fn: any) {
+		this.#listeners.get(type)?.delete(fn);
+	}
+	dispatchEvent(e: any) {
+		e.target ??= this;
+		for (const fn of [...(this.#listeners.get(e.type) ?? [])]) {
+			if (typeof fn === "function") fn.call(this, e);
+			else fn.handleEvent(e);
+		}
+		return !e.defaultPrevented;
+	}
+}
+g.Event ??= Event;
+g.ErrorEvent ??= ErrorEvent;
+g.MessageEvent ??= MessageEvent;
+g.CustomEvent ??= CustomEvent;
+g.EventTarget ??= EventTarget;
+
+// The database throws and catches these as normal control flow (e.g. a row missing an index field), so skip the
+// costly stack trace.
+class DOMException extends Error {
+	code = 0;
+	constructor(message = "", name = "Error") {
+		const limit = (Error as any).stackTraceLimit;
+		(Error as any).stackTraceLimit = 0;
+		super(message);
+		(Error as any).stackTraceLimit = limit;
+		this.name = name;
+	}
+}
+g.DOMException ??= DOMException;
+
+// The global scope is an event target, like a worker's
+const globalTarget = new g.EventTarget();
+g.addEventListener = globalTarget.addEventListener.bind(globalTarget);
+g.removeEventListener = globalTarget.removeEventListener.bind(globalTarget);
+g.dispatchEvent = globalTarget.dispatchEvent.bind(globalTarget);
+
+// ---------------------------------------------------------------- messages
+// JSON can't carry Errors, undefined in objects, or non-finite numbers: tag them.
+const replacer = (_key: string, value: any) => {
+	if (value instanceof Error || (value && typeof value === "object" && typeof value.message === "string" && typeof value.stack === "string")) {
+		return { __type: "Error", name: value.name, message: value.message, stack: value.stack };
+	}
+	if (typeof value === "number" && !Number.isFinite(value)) {
+		return { __type: "Number", value: String(value) };
+	}
+	if (value instanceof Map) return { __type: "Map", value: [...value] };
+	if (value instanceof Set) return { __type: "Set", value: [...value] };
+	return value;
+};
+const reviver = (_key: string, value: any) => {
+	if (value && typeof value === "object" && typeof value.__type === "string") {
+		if (value.__type === "Error") {
+			const e = new Error(value.message);
+			e.name = value.name;
+			return e;
+		}
+		if (value.__type === "Number") return Number(value.value);
+		if (value.__type === "Map") return new Map(value.value);
+		if (value.__type === "Set") return new Set(value.value);
+	}
+	return value;
+};
+g.postMessage = (message: unknown) => {
+	host.post(JSON.stringify(message, replacer));
+};
+
+g.__engine = {
+	fireTimer(id: number) {
+		const t = timers.get(id);
+		if (!t) return;
+		if (t.repeat) host.setTimer(id, Math.max(0, t.ms | 0));
+		else timers.delete(id);
+		t.fn();
+	},
+	receive(json: string) {
+		g.dispatchEvent(new g.MessageEvent("message", { data: JSON.parse(json, reviver) }));
+	},
+};
+
+// ---------------------------------------------------------------- structuredClone (used by the database)
+const clone = (v: any, seen: Map<any, any>): any => {
+	if (v === null || typeof v !== "object") return v;
+	if (seen.has(v)) return seen.get(v);
+	if (v instanceof Date) return new Date(v.getTime());
+	if (v instanceof RegExp) return new RegExp(v.source, v.flags);
+	if (ArrayBuffer.isView(v)) return (v as any).slice();
+	if (v instanceof ArrayBuffer) return v.slice(0);
+	if (v instanceof Map) {
+		const m = new Map();
+		seen.set(v, m);
+		for (const [k, x] of v) m.set(clone(k, seen), clone(x, seen));
+		return m;
+	}
+	if (v instanceof Set) {
+		const s = new Set();
+		seen.set(v, s);
+		for (const x of v) s.add(clone(x, seen));
+		return s;
+	}
+	if (typeof v === "function") throw new g.DOMException("function could not be cloned", "DataCloneError");
+	const out: any = Array.isArray(v) ? [] : {};
+	seen.set(v, out);
+	for (const k of Object.keys(v)) {
+		const x = v[k];
+		if (typeof x === "function") throw new g.DOMException(`${k} could not be cloned`, "DataCloneError");
+		out[k] = clone(x, seen);
+	}
+	return out;
+};
+// Fast path for plain data (what the game stores): no loop tracking. Anything else, or very deep data, falls back
+// to the full clone above.
+const fastClone = (v: any, depth: number): any => {
+	if (v === null || typeof v !== "object") {
+		if (typeof v === "function") throw new g.DOMException("function could not be cloned", "DataCloneError");
+		return v;
+	}
+	if (depth > 64) throw fastClone;
+	if (Array.isArray(v)) {
+		const n = v.length;
+		const out = new Array(n);
+		for (let i = 0; i < n; i++) out[i] = fastClone(v[i], depth + 1);
+		return out;
+	}
+	const proto = Object.getPrototypeOf(v);
+	if (proto !== Object.prototype && proto !== null) {
+		if (v instanceof Date) return new Date(v.getTime());
+		throw fastClone;
+	}
+	const out: any = {};
+	for (const k in v) out[k] = fastClone(v[k], depth + 1);
+	return out;
+};
+g.structuredClone = (v: unknown) => {
+	try {
+		return fastClone(v, 0);
+	} catch (e) {
+		if (e !== fastClone) throw e;
+		return clone(v, new Map());
+	}
+};
+
+// ---------------------------------------------------------------- text encoding
+class TextEncoder {
+	encoding = "utf-8";
+	encode(s = "") {
+		const out: number[] = [];
+		for (let i = 0; i < s.length; i++) {
+			let c = s.charCodeAt(i);
+			if (c >= 0xd800 && c < 0xdc00 && i + 1 < s.length) {
+				const d = s.charCodeAt(i + 1);
+				if (d >= 0xdc00 && d < 0xe000) {
+					c = 0x10000 + ((c - 0xd800) << 10) + (d - 0xdc00);
+					i++;
+				}
+			}
+			if (c < 0x80) out.push(c);
+			else if (c < 0x800) out.push(0xc0 | (c >> 6), 0x80 | (c & 63));
+			else if (c < 0x10000) out.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));
+			else out.push(0xf0 | (c >> 18), 0x80 | ((c >> 12) & 63), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));
+		}
+		return new Uint8Array(out);
+	}
+}
+// Streaming UTF-8 decoder: keeps an incomplete multi-byte sequence for the next chunk.
+class TextDecoder {
+	encoding = "utf-8";
+	#pending: number[] = [];
+	decode(input?: ArrayBuffer | ArrayBufferView, options?: { stream?: boolean }) {
+		let bytes: Uint8Array;
+		if (input === undefined) bytes = new Uint8Array(0);
+		else if (input instanceof ArrayBuffer) bytes = new Uint8Array(input);
+		else bytes = new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+		if (this.#pending.length) {
+			const merged = new Uint8Array(this.#pending.length + bytes.length);
+			merged.set(this.#pending);
+			merged.set(bytes, this.#pending.length);
+			bytes = merged;
+			this.#pending = [];
+		}
+		let end = bytes.length;
+		if (options?.stream) {
+			// Back up over a trailing incomplete sequence
+			let i = end - 1;
+			let n = 0;
+			while (i >= 0 && n < 4 && (bytes[i]! & 0xc0) === 0x80) {
+				i--;
+				n++;
+			}
+			if (i >= 0) {
+				const b = bytes[i]!;
+				const need = b >= 0xf0 ? 4 : b >= 0xe0 ? 3 : b >= 0xc0 ? 2 : 1;
+				if (need > n + 1) end = i;
+			}
+			for (let j = end; j < bytes.length; j++) this.#pending.push(bytes[j]!);
+		}
+		let s = "";
+		const CHUNK = 8192;
+		const codes: number[] = [];
+		for (let i = 0; i < end; ) {
+			const b = bytes[i]!;
+			let c: number;
+			if (b < 0x80) {
+				c = b;
+				i += 1;
+			} else if (b < 0xe0) {
+				c = ((b & 31) << 6) | (bytes[i + 1]! & 63);
+				i += 2;
+			} else if (b < 0xf0) {
+				c = ((b & 15) << 12) | ((bytes[i + 1]! & 63) << 6) | (bytes[i + 2]! & 63);
+				i += 3;
+			} else {
+				c = ((b & 7) << 18) | ((bytes[i + 1]! & 63) << 12) | ((bytes[i + 2]! & 63) << 6) | (bytes[i + 3]! & 63);
+				i += 4;
+			}
+			if (c >= 0x10000) {
+				c -= 0x10000;
+				codes.push(0xd800 + (c >> 10), 0xdc00 + (c & 1023));
+			} else {
+				codes.push(c);
+			}
+			if (codes.length >= CHUNK) {
+				s += String.fromCharCode(...codes);
+				codes.length = 0;
+			}
+		}
+		if (codes.length) s += String.fromCharCode(...codes);
+		return s;
+	}
+}
+g.TextEncoder ??= TextEncoder;
+g.TextDecoder ??= TextDecoder;
+
+// ---------------------------------------------------------------- streams
+g.ReadableStream ??= ReadableStream;
+g.TransformStream ??= TransformStream;
+g.WritableStream ??= WritableStream;
+g.ByteLengthQueuingStrategy ??= ByteLengthQueuingStrategy;
+g.CountQueuingStrategy ??= CountQueuingStrategy;
+g.TextDecoderStream ??= class TextDecoderStream extends g.TransformStream {
+	constructor() {
+		const decoder = new g.TextDecoder();
+		super({
+			transform(chunk: Uint8Array, controller: any) {
+				const s = decoder.decode(chunk, { stream: true });
+				if (s) controller.enqueue(s);
+			},
+			flush(controller: any) {
+				const s = decoder.decode();
+				if (s) controller.enqueue(s);
+			},
+		});
+	}
+};
+g.TextEncoderStream ??= class TextEncoderStream extends g.TransformStream {
+	constructor() {
+		const encoder = new g.TextEncoder();
+		super({
+			transform(chunk: string, controller: any) {
+				controller.enqueue(encoder.encode(chunk));
+			},
+		});
+	}
+};
+
+// ---------------------------------------------------------------- files and fetch
+// A league file on the phone: read in 1 MB pieces as the game streams it.
+class HostFile {
+	name: string;
+	path: string;
+	size: number;
+	type = "application/json";
+	constructor(path: string, name?: string) {
+		this.path = path;
+		this.name = name ?? path.split(/[\\/]/).pop()!;
+		this.size = host.fileSize(path);
+	}
+	stream() {
+		const { path, size } = this;
+		let offset = 0;
+		return new g.ReadableStream({
+			pull(controller: any) {
+				if (offset >= size) {
+					controller.close();
+					return;
+				}
+				const n = Math.min(1 << 20, size - offset);
+				controller.enqueue(host.readBytes(path, offset, n));
+				offset += n;
+			},
+		});
+	}
+	async text() {
+		return new g.TextDecoder().decode(host.readBytes(this.path, 0, this.size));
+	}
+}
+g.__HostFile = HostFile;
+g.File ??= HostFile;
+g.Blob ??= class Blob {
+	parts: unknown[];
+	type: string;
+	constructor(parts: unknown[] = [], opts: { type?: string } = {}) {
+		this.parts = parts;
+		this.type = opts.type ?? "";
+	}
+};
+
+const makeResponse = (text: string | null, url: string) => ({
+	ok: text !== null,
+	status: text !== null ? 200 : 404,
+	url,
+	json: async () => JSON.parse(text ?? "null"),
+	text: async () => text ?? "",
+	body: null,
+});
+g.fetch = async (input: string | { url: string }) => {
+	const url = typeof input === "string" ? input : input.url;
+	// file:// paths are league files on the phone, streamed like a download
+	if (url.startsWith("file://")) {
+		const f = new HostFile(decodeURIComponent(url.slice("file://".length)));
+		return {
+			ok: true,
+			status: 200,
+			url,
+			headers: { get: (h: string) => (h.toLowerCase() === "content-length" ? String(f.size) : null) },
+			body: f.stream(),
+			json: async () => JSON.parse(await f.text()),
+			text: () => f.text(),
+		};
+	}
+	return makeResponse(host.readText(url.replace(/^https?:\/\/[^/]+/, "")), url);
+};
+
+// ---------------------------------------------------------------- Intl
+// The Android V8 build has no Intl. The engine only needs number formatting with commas (formatList falls back
+// on its own without Intl.ListFormat).
+if (typeof g.Intl === "undefined") {
+	class NumberFormat {
+		#max: number;
+		#min: number;
+		constructor(_locale?: string, opts: { maximumFractionDigits?: number; minimumFractionDigits?: number } = {}) {
+			this.#min = opts.minimumFractionDigits ?? 0;
+			this.#max = Math.max(this.#min, opts.maximumFractionDigits ?? 3);
+		}
+		format(n: number) {
+			if (!Number.isFinite(n)) return String(n);
+			const fixed = Math.abs(n).toFixed(this.#max);
+			let [int, frac = ""] = fixed.split(".");
+			frac = frac.replace(/0+$/, "");
+			while (frac.length < this.#min) frac += "0";
+			int = int!.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+			const sign = n < 0 && Number(fixed) !== 0 ? "-" : "";
+			return sign + int + (frac ? "." + frac : "");
+		}
+	}
+	g.Intl = { NumberFormat };
+}
+
+g.URLSearchParams ??= class URLSearchParams {
+	#pairs: [string, string][] = [];
+	constructor(init?: string | Record<string, string>) {
+		if (typeof init === "string") {
+			for (const part of init.replace(/^\?/, "").split("&").filter(Boolean)) {
+				const [k, v = ""] = part.split("=");
+				this.#pairs.push([decodeURIComponent(k!), decodeURIComponent(v)]);
+			}
+		} else if (init) {
+			for (const [k, v] of Object.entries(init)) this.#pairs.push([k, String(v)]);
+		}
+	}
+	append(k: string, v: string) {
+		this.#pairs.push([k, String(v)]);
+	}
+	set(k: string, v: string) {
+		this.#pairs = this.#pairs.filter(([x]) => x !== k);
+		this.#pairs.push([k, String(v)]);
+	}
+	get(k: string) {
+		return this.#pairs.find(([x]) => x === k)?.[1] ?? null;
+	}
+	has(k: string) {
+		return this.#pairs.some(([x]) => x === k);
+	}
+	toString() {
+		return this.#pairs.map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join("&");
+	}
+};
+g.FormData ??= class FormData {
+	#data = new Map<string, unknown>();
+	append(k: string, v: unknown) {
+		this.#data.set(k, v);
+	}
+	get(k: string) {
+		return this.#data.get(k);
+	}
+};
+
+// ---------------------------------------------------------------- misc
+g.navigator ??= {
+	userAgent: "GridironAlmanac (V8)",
+	hardwareConcurrency: 1,
+	language: "en-US",
+	languages: ["en-US"],
+	onLine: false,
+	storage: undefined,
+	locks: undefined,
+};
+g.location ??= {
+	href: "https://gridironalmanac.local/",
+	origin: "https://gridironalmanac.local",
+	protocol: "https:",
+	host: "gridironalmanac.local",
+	hostname: "gridironalmanac.local",
+	pathname: "/",
+	search: "",
+	hash: "",
+};
+g.crypto ??= {
+	getRandomValues(arr: any) {
+		for (let i = 0; i < arr.length; i++) arr[i] = Math.floor(Math.random() * 2 ** (8 * (arr.BYTES_PER_ELEMENT ?? 1)));
+		return arr;
+	},
+	randomUUID() {
+		const h = "0123456789abcdef";
+		let s = "";
+		for (let i = 0; i < 36; i++) s += [8, 13, 18, 23].includes(i) ? "-" : i === 14 ? "4" : h[Math.floor(Math.random() * 16)];
+		return s;
+	},
+};
+g.atob ??= (s: string) => {
+	const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	let out = "";
+	let bits = 0;
+	let value = 0;
+	for (const ch of s.replace(/=+$/, "")) {
+		value = (value << 6) | chars.indexOf(ch);
+		bits += 6;
+		if (bits >= 8) {
+			bits -= 8;
+			out += String.fromCharCode((value >> bits) & 255);
+		}
+	}
+	return out;
+};
+g.btoa ??= (s: string) => {
+	const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	let out = "";
+	for (let i = 0; i < s.length; i += 3) {
+		const a = s.charCodeAt(i);
+		const b = s.charCodeAt(i + 1);
+		const c = s.charCodeAt(i + 2);
+		out += chars[a >> 2]! + chars[((a & 3) << 4) | (b >> 4 || 0)]! + (Number.isNaN(b) ? "=" : chars[((b & 15) << 2) | (c >> 6 || 0)]!) + (Number.isNaN(c) ? "=" : chars[c & 63]!);
+	}
+	return out;
+};
