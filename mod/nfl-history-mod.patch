+// NFL history mod: a Madden box, laid out like the real cover of its year, measured off the real boxes (positions are
+// percent of the box width across and of its height down). Everything on the real box that came from the cover
+// athlete's team (the rings and arc of 2001, the paint of 2010-2012, the energy streaks of 2013-2014, the color walls
+// of 2019-2020, the collage of 2021, the stadium glow from 2022) is redrawn in this player's team colors. The cover star
+// is the mod's own picture of him: his face in that season's real jersey, number on the chest.
+import type { CSSProperties, ReactNode } from "react";
+import type { FaceConfig } from "facesjs";
+import { maddenTitle, type NflCoverPlayer } from "../../common/nflCover.ts";
+import { PlayerPicture } from "./PlayerPicture.tsx";
+import { EaBadge, EaDisc, EaStack, NflShield, TitleRow, Word, type TypeStyle } from "./maddenType.tsx";
+
+const yearMark = (season: number) => {
+	const t = maddenTitle(season) ?? `Madden NFL ${season}`;
+	const m = t.match(/('?\d+)$/);
+	return m ? m[1]! : String(season);
+};
+
+// ---------- colors ----------
+const rgb = (hex: string) => {
+	const h = hex.replace("#", "").padEnd(6, "0");
+	return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16));
+};
+const lum = (hex: string) => {
+	const [r, g, b] = rgb(hex).map((v) => v / 255);
+	return 0.2126 * r! + 0.7152 * g! + 0.0722 * b!;
+};
+const sat = (hex: string) => {
+	const v = rgb(hex);
+	return (Math.max(...v) - Math.min(...v)) / 255;
+};
+const mix = (a: string, b: string, k: number) => {
+	const x = rgb(a);
+	const y = rgb(b);
+	return `#${x.map((v, i) => Math.round(v + (y[i]! - v) * k).toString(16).padStart(2, "0")).join("")}`;
+};
+const teamLook = (colors: [string, string, string]) => {
+	const cs = colors.filter((c) => /^#[0-9a-f]{6}$/i.test(c));
+	const loud = [...cs].sort((a, b) => sat(b) * (0.3 + lum(b)) - sat(a) * (0.3 + lum(a)))[0] ?? "#c8102e";
+	const dark = [...cs].sort((a, b) => lum(a) - lum(b))[0] ?? "#13294b";
+	const main = cs[0] ?? dark;
+	const ring = lum(main) > 0.85 || lum(main) < 0.04 ? loud : main;
+	const second = cs.find((c) => c !== main && lum(c) < 0.9 && lum(c) > 0.04) ?? loud;
+	return { loud, dark, main, ring, second };
+};
+
+// seeded random numbers: the same box every time for a player and year
+const rnd = (seed: number) => {
+	let st = (seed * 2654435761) >>> 0;
+	return () => {
+		st = (st * 1664525 + 1013904223) >>> 0;
+		return st / 4294967296;
+	};
+};
+
+const Svg = ({ children, style }: { children: ReactNode; style?: CSSProperties }) => (
+	<svg viewBox="0 0 100 140" preserveAspectRatio="none" style={{ position: "absolute", inset: 0, width: "100%", height: "100%", ...style }}>
+		{children}
+	</svg>
+);
+
+// ---------- backgrounds and the shapes behind the title ----------
+// a soft white-to-silver box with light streaks (2002-2009)
+const SilverRoom = ({ dim = 0 }: { dim?: number }) => (
+	<>
+		<div style={{ position: "absolute", inset: 0, background: `radial-gradient(ellipse at 50% 30%, #ffffff 0%, ${mix("#eef1f4", "#9aa2ac", dim)} 55%, ${mix("#c4ccd5", "#5d646c", dim)} 100%)` }} />
+		<Svg>
+			{[-20, 0, 20, 40].map((x, i) => (
+				<polygon key={i} points={`${x},0 ${x + 14},0 ${x + 64},140 ${x + 50},140`} fill="#fff" opacity="0.22" />
+			))}
+		</Svg>
+	</>
+);
+
+// 2001: rings and the thick arc around the disc, in his team's color
+const Rings2001 = ({ c }: { c: string }) => (
+	<Svg>
+		{[34, 42, 50, 58, 66].map((r, i) => (
+			<circle key={r} cx="50" cy="105" r={r} fill="none" stroke={c} strokeOpacity={0.16 - i * 0.025} strokeWidth="4" />
+		))}
+		<path d="M9 92 A44 44 0 0 1 91 92 L84 96 A36 36 0 0 0 16 96 Z" fill={c} />
+		<path d="M10 91.5 A43 43 0 0 1 90 91.5" fill="none" stroke="#fff" strokeWidth="0.7" opacity="0.8" />
+		<path d="M70 132 A40 40 0 0 0 90 104 L94 106 A44 44 0 0 1 72 137 Z" fill={c} opacity="0.9" />
+	</Svg>
+);
+
