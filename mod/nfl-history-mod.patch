+				)}{" "}
+				Situation{" "}
+				{sel(
+					si,
+					setSi,
+					SITUATIONS.map((x) => x.name),
+				)}{" "}
+				· {combos.length} boards
+			</div>
+			<div className="d-flex flex-column gap-3">
+				{combos.slice(0, 120).map(({ pkg, slot, sit }, i) => (
+					<div key={i}>
+						<div className="small fw-semibold mb-1">
+							{pkg} · {slot[0]} · {sit.name}
+						</div>
