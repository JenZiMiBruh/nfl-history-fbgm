+// NFL history mod: the game open, the way a network starts its broadcast. It plays OVER the live stadium (the 3D field's
+// aerial shot shows through), in the game's broadcast package (its typeface and title treatment), with a theme:
+//
+//   scenes (each game picks one of several running orders, so no two weeks feel the same):
+//     network   - the slot's title (Sunday Night Football, Thanksgiving, the Super Bowl...) slams in over light rays
+//     matchup   - the two teams sweep in from their sides: logos, names, records, a VS burst
+//     stars     - the two quarterbacks head to head: faces, season lines
+//     story     - the storyline: a division game, holiday tradition, an unbeaten team, playoff stakes
+//     venue     - the stadium, kickoff time, the weather
+//   holiday touches: Christmas snow and lights, Thanksgiving leaves, Halloween week, fireworks for the season opener and
+//   the playoffs, confetti for the Super Bowl
+//
+// Then the pregame show (NflPregame.tsx) takes over.
+import { liveFace } from "./liveFaces.ts";
+import {
+	useEffect,
+	useMemo,
+	useRef,
+	useState,
+	type CSSProperties,
+} from "react";
+import { readableOn, weatherIcon } from "../../components/NflGameInfo.tsx";
+import { cardPace } from "./NflSettings.ts";
+import type { NflGameInfo } from "../../../common/nflCalendar.ts";
+import type { Presentation } from "./NflScoreboard.tsx";
+import {
+	loadFacts,
+	loadPregame,
+	SKINS,
+	statLine,
+	type PregameData,
+} from "./NflPregame.tsx";
+import { PlayerPicture } from "../../components/PlayerPicture.tsx";
+
+type T = {
+	tid?: number;
+	region: string;
+	name: string;
+	abbrev: string;
+	colors?: string[];
+	imgURL?: string;
+	imgURLSmall?: string;
+};
+type SceneName =
+	| "network"
+	| "matchup"
+	| "stars"
+	| "story"
+	| "venue"
+	| "conditions"
+	| "stakes";
+
+const SOUND_KEY = "nflIntroSound";
+const soundOn = () => {
+	try {
+		return localStorage.getItem(SOUND_KEY) !== "off";
+	} catch {
+		return true;
+	}
+};
+const hash = (s: string) => {
+	let h = 7;
+	for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
+	return Math.abs(h);
+};
+
+// A short brass fanfare (detuned saws through a filter, timpani on each chord), a different progression per slot
+const THEMES: Record<string, number[][]> = {
+	mnf: [
+		[50, 57, 62],
+		[48, 55, 60],
+		[53, 60, 65],
+		[55, 62, 67, 74],
+	],
+	snf: [
+		[52, 59, 64],
+		[57, 64, 69],
+		[55, 62, 67],
+		[60, 67, 72, 76],
+	],
+	tnf: [
+		[45, 52, 57],
+		[47, 54, 59],
+		[50, 57, 62],
+		[52, 59, 64, 71],
+	],
+	sb: [
+		[48, 55, 64],
+		[53, 60, 69],
+		[55, 62, 71],
+		[60, 67, 72, 79],
+	],
+	playoffs: [
+		[50, 57, 66],
+		[55, 62, 71],
+		[53, 60, 69],
+		[57, 64, 73, 76],
+	],
+	christmas: [
+		[55, 59, 62],
+		[60, 64, 67],
+		[57, 60, 64],
+		[62, 66, 69, 74],
