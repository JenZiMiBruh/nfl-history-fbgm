+				<clipPath id="nflo">
+					<path d="M4.5 8 Q20 3 35.5 8 Q34 11 35.5 14 L35.5 29.5 Q35.5 40 20 45.5 Q4.5 40 4.5 29.5 L4.5 14 Q6 11 4.5 8 Z" />
+				</clipPath>
+				<g clipPath="url(#nflo)">
+					<rect x="0" y="0" width="40" height="50" fill="#fff" />
+					<rect x="0" y="0" width="40" height="27" fill="#1c3f94" />
+					{[6, 11, 16, 21, 26, 31].map((x) => (
+						<rect key={x} x={x} y="27" width="2.6" height="20" fill="#d50a0a" />
