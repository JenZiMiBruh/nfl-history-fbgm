+export const cardMaterial = (c: HTMLCanvasElement, back: boolean) => {
+	const tex = new THREE.CanvasTexture(c);
+	tex.colorSpace = THREE.SRGBColorSpace;
+	tex.anisotropy = 4;
+	if (back) {
+		// Seen from behind the image would be mirrored: flip it
+		tex.wrapS = THREE.RepeatWrapping;
+		tex.repeat.x = -1;
+		tex.offset.x = 1;
+	}
+	// Partly self-lit so the picture stays bright whichever way the stadium lights fall, with the curve still shaded
+	return new THREE.MeshStandardMaterial({
+		map: tex,
+		emissive: new THREE.Color("#ffffff"),
+		emissiveMap: tex,
+		emissiveIntensity: 0.4,
+		transparent: true,
+		alphaTest: 0.4,
+		roughness: 0.75,
+		metalness: 0,
+		side: back ? THREE.BackSide : THREE.FrontSide,
+	});
+};
