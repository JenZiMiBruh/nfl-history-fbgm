+}: {
+	disabled: boolean;
+	onFile: (file: File) => void;
+}) => {
+	const [loaded, setLoaded] = useState(nflMaster !== undefined);
+	const [status, setStatus] = useState("");
+	const [season, setSeason] = useState(2026);
+	const [phase, setPhase] = useState("regular");
+	const [week, setWeek] = useState(1);
+	const [realDraftRatings, setRealDraftRatings] = useState(true);
+	// NFL history mod: 0 = the start of the playoffs; otherwise how many rounds are left (1 = the Super Bowl)
+	const [playoffRound, setPlayoffRound] = useState(0);
+	// The rounds that existed that season: two in 1966, three through 1977, four after that
+	const roundOptions: [number, string][] =
+		season <= 1966
+			? [
+					[0, "League championships"],
