+// The Android V8 build has no ICU, so regexes with Unicode property escapes (\p{...}) don't compile. Swap the
+// three the engine uses for plain character ranges. Each replacement must match, so a library update that changes
+// them fails the build instead of shipping a broken engine.
+const REPLACEMENTS: [from: string, to: string][] = [
+	// Award prefixes: first letter of each word ("Most Valuable Player" -> "MVP")
+	[String.raw`/\b\p{L}/gu`, String.raw`/\b[A-Za-zÀ-ÖØ-öø-ɏ]/g`],
+	// Search: strip accents after NFD splits them off as combining marks
+	[String.raw`/\p{Diacritic}/gu`, String.raw`/[̀-ͯ]/g`],
+	// Library check for non-ASCII text
+	[String.raw`/\P{ASCII}/u`, String.raw`/[^\x00-\x7F]/`],
+	// Emoji check (built from a string, so the backslashes are doubled)
+	[String.raw`\\p{Extended_Pictographic}`, String.raw`\\u{1F000}-\\u{1FAFF}\\u2600-\\u27BF\\u2B00-\\u2BFF`],
+	[String.raw`\\p{Regional_Indicator}`, String.raw`\\u{1F1E6}-\\u{1F1FF}`],
+	[String.raw`\\p{Emoji_Component}`, String.raw`\\u{1F3FB}-\\u{1F3FF}\\u200D\\uFE0F\\u20E3#*0-9\\u{E0020}-\\u{E007F}\\u{1F1E6}-\\u{1F1FF}`],
+];
+
+export const removeUnicodePropertyEscapes = (code: string) => {
+	let out = code;
+	for (const [from, to] of REPLACEMENTS) {
+		if (!out.includes(from)) {
+			throw new Error(`noIntlRegex: pattern not found: ${from}`);
+		}
+		out = out.split(from).join(to);
+	}
+	// \p{...} and \P{...} (negated), in regex literals or strings
+	const left = out.match(/\\\\?[pP]\{[A-Za-z_=]+\}/);
+	if (left) {
+		throw new Error(`noIntlRegex: unhandled Unicode property escape: ${left[0]}`);
+	}
+	return out;
+};
