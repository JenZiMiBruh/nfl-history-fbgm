+// NFL history mod: the Madden box lettering drawn as shapes, not a stand-in font: the squared, extra-heavy MADDEN of
+// the real boxes (upright 2006-2009, stenciled 2010-2014, slanted 2001-2005 and 2015-2021, tighter from 2022), the year
+// digits in the same face (with the slab "1" of 2010-2014), the NFL shield before and after the 2008 redesign, and the
+// EA SPORTS marks. Glyphs are drawn on a 100-unit cap height.
+import type { ReactNode } from "react";
+
+type Glyph = { w: number; d: string; holes?: string; cuts?: [number, number, number, number][] };
+
+// squared heavy capitals: rounded-square bowls, flat terminals, stems 26 units
+const G: Record<string, Glyph> = {
+	M: { w: 122, d: "M0 100 V0 H30 L61 50 L92 0 H122 V100 H96 V44 L68 90 H54 L26 44 V100 Z", cuts: [[26, 0, 6, 46], [90, 0, 6, 46]] },
+	A: { w: 104, d: "M0 100 V20 Q0 0 20 0 H84 Q104 0 104 20 V100 H78 V70 H26 V100 Z", holes: "M26 26 H78 V46 H26 Z", cuts: [[26, 0, 6, 26]] },
+	D: { w: 104, d: "M0 0 H80 Q104 0 104 24 V76 Q104 100 80 100 H0 Z", holes: "M26 24 H74 Q78 24 78 28 V72 Q78 76 74 76 H26 Z", cuts: [[26, 0, 6, 100]] },
+	E: { w: 94, d: "M0 0 H94 V24 H26 V39 H84 V61 H26 V76 H94 V100 H0 Z", cuts: [[26, 0, 6, 100]] },
+	N: { w: 104, d: "M0 100 V0 H28 L78 64 V0 H104 V100 H76 L26 36 V100 Z", cuts: [[26, 0, 6, 46], [72, 54, 6, 46]] },
+	"0": { w: 82, d: "M0 20 Q0 0 20 0 H62 Q82 0 82 20 V80 Q82 100 62 100 H20 Q0 100 0 80 Z", holes: "M26 24 H56 V76 H26 Z" },
+	"1": { w: 58, d: "M12 0 H54 V100 H28 V26 H12 Z" },
+	"2": { w: 82, d: "M0 0 H62 Q82 0 82 20 V42 Q82 62 62 62 H26 V76 H82 V100 H0 V58 Q0 38 20 38 H56 V24 H0 Z" },
+	"3": { w: 82, d: "M0 0 H62 Q82 0 82 20 V80 Q82 100 62 100 H0 V76 H56 V61 H16 V39 H56 V24 H0 Z" },
+	"4": { w: 82, d: "M0 0 H26 V40 H56 V0 H82 V100 H56 V64 H20 Q0 64 0 44 Z" },
+	"5": { w: 82, d: "M82 0 V24 H26 V38 H62 Q82 38 82 58 V80 Q82 100 62 100 H0 V76 H56 V62 H20 Q0 62 0 42 V0 Z" },
+	"6": { w: 82, d: "M82 0 V24 H26 V38 H62 Q82 38 82 58 V80 Q82 100 62 100 H20 Q0 100 0 80 V20 Q0 0 20 0 Z", holes: "M26 62 H56 V76 H26 Z" },
+	"7": { w: 82, d: "M0 0 H82 V28 L48 100 H20 L54 24 H0 Z" },
+	"8": { w: 82, d: "M0 20 Q0 0 20 0 H62 Q82 0 82 20 V80 Q82 100 62 100 H20 Q0 100 0 80 Z", holes: "M26 22 H56 V39 H26 Z M26 61 H56 V78 H26 Z" },
+	"9": { w: 82, d: "M0 100 V76 H56 V62 H20 Q0 62 0 42 V20 Q0 0 20 0 H62 Q82 0 82 20 V80 Q82 100 62 100 Z", holes: "M26 24 H56 V38 H26 Z" },
+	"'": { w: 22, d: "M2 0 H22 L14 34 H2 Z" },
+};
+// the slab "1" of 2010-2014: a flag and a foot
+const SLAB_ONE: Glyph = { w: 70, d: "M8 0 H52 V76 H66 V100 H6 V76 H26 V26 H8 Z" };
+
+export type TypeStyle = {
+	// slant in degrees (negative leans right)
+	skew?: number;
+	stencil?: boolean;
+	slabOne?: boolean;
+	// letter spacing in glyph units
+	track?: number;
+};
+
+// lays out a string of glyphs; returns paths in glyph units and the total width
+const layout = (text: string, st: TypeStyle) => {
+	let x = 0;
+	const parts: { g: Glyph; x: number }[] = [];
+	for (const ch of text) {
+		const g = ch === "1" && st.slabOne ? SLAB_ONE : G[ch];
+		if (!g) continue;
+		parts.push({ g, x });
+		x += g.w + (st.track ?? 10);
+	}
+	return { parts, w: Math.max(0, x - (st.track ?? 10)) };
+};
+
+export const textWidth = (text: string, st: TypeStyle = {}) => layout(text, st).w;
+
+let uid = 0;
+
+// A word in the Madden face, cap height h px. fill can be a color or "metal-dark" / "metal-silver" / "metal-red";
+// stroke draws an outline outside the letters; bevel adds a highlight line along the top edges.
+export const Word = ({
+	text,
+	h,
+	style = {},
+	fill,
+	stroke,
+	strokeW = 0,
+	shadow,
+}: {
+	text: string;
+	h: number;
+	style?: TypeStyle;
+	fill: string;
+	stroke?: string;
+	strokeW?: number;
+	shadow?: boolean;
+}) => {
+	const { parts, w } = layout(text, style);
+	const id = `mw${uid++}`;
+	const k = h / 100;
+	const skew = style.skew ?? 0;
+	const slantPad = Math.abs(Math.tan((skew * Math.PI) / 180)) * 100;
+	const pad = strokeW / k + 4;
+	const vbW = w + slantPad + pad * 2;
+	const vbH = 100 + pad * 2;
+	const metal: Record<string, string[]> = {
+		"metal-dark": ["#5d6168", "#2a2c30", "#141518", "#3a3d42"],
+		"metal-silver": ["#ffffff", "#d7dbe0", "#8f979f", "#e6e9ec"],
+		"metal-red": ["#ff4b4b", "#d6142b", "#9e0a1b", "#e3283a"],
+		"metal-navy": ["#4a6aa8", "#1c3a7a", "#0d214d", "#2c4c8c"],
+	};
+	const paint = metal[fill] ? `url(#${id}g)` : fill;
+	const glyphs = parts.map(({ g, x }, i) => (
+		<path key={i} transform={`translate(${x} 0)`} d={g.d + (g.holes ? ` ${g.holes}` : "")} fillRule="evenodd" />
+	));
+	const cutRects = style.stencil
+		? parts.flatMap(({ g, x }, i) => (g.cuts ?? []).map(([cx, cy, cw, ch], j) => <rect key={`${i}-${j}`} x={x + cx} y={cy} width={cw} height={ch} fill="#000" />))
+		: [];
+	const body = (attrs: Record<string, string | number>) => (
+		<g transform={`translate(${pad + (skew < 0 ? slantPad : 0)} ${pad}) skewX(${skew})`} {...(style.stencil ? { mask: `url(#${id}m)` } : {})} {...attrs}>
+			{glyphs}
+		</g>
+	);
+	return (
+		<svg viewBox={`0 0 ${vbW} ${vbH}`} style={{ height: vbH * k, width: vbW * k, flex: "none", display: "block", overflow: "visible" }}>
+			<defs>
+				{metal[fill] ? (
+					<linearGradient id={`${id}g`} x1="0" y1="0" x2="0" y2="1">
+						{metal[fill]!.map((c, i, a) => (
+							<stop key={i} offset={i / (a.length - 1)} stopColor={c} />
+						))}
+					</linearGradient>
+				) : null}
+				{style.stencil ? (
+					<mask id={`${id}m`} maskUnits="userSpaceOnUse" x={-pad} y={-pad} width={vbW + pad} height={vbH + pad}>
+						<rect x={-pad - 50} y={-pad} width={vbW + 100} height={vbH + pad * 2} fill="#fff" />
+						<g transform={`skewX(${skew})`}>{cutRects}</g>
+					</mask>
+				) : null}
+				{shadow ? (
+					<filter id={`${id}s`} x="-10%" y="-10%" width="120%" height="140%">
+						<feDropShadow dx="0" dy="3" stdDeviation="2.5" floodOpacity="0.45" />
+					</filter>
+				) : null}
+			</defs>
+			<g filter={shadow ? `url(#${id}s)` : undefined}>
+				{stroke && strokeW ? body({ fill: stroke, stroke, strokeWidth: (strokeW * 2) / k, strokeLinejoin: "round" }) : null}
+				{body({ fill: paint })}
+			</g>
+		</svg>
+	);
+};
+
+// ---------- the NFL shield ----------
+const star = (cx: number, cy: number, r: number) => {
+	const pts: string[] = [];
+	for (let i = 0; i < 10; i++) {
+		const a = -Math.PI / 2 + (i * Math.PI) / 5;
+		const rr = i % 2 === 0 ? r : r * 0.42;
+		pts.push(`${(cx + rr * Math.cos(a)).toFixed(2)},${(cy + rr * Math.sin(a)).toFixed(2)}`);
+	}
+	return pts.join(" ");
+};
+const SHIELD = "M2 6 Q20 0 38 6 Q36 10 38 14 L38 30 Q38 42 20 48 Q2 42 2 30 L2 14 Q4 10 2 6 Z";
+
+// The shield as it looked that year: the old one (stars over NFL, red and white stripes) through the 2007 season,
+// the 2008 one after (eight stars around a football on navy, red NFL letters on white)
+export const NflShield = ({ h, modern }: { h: number; modern: boolean }) => (
