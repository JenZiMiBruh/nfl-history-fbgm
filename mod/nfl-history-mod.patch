+// Which look this game gets (the same game always gets the same one)
+const Matchup = (props: {
+	off: Starter[];
+	offT: T;
+	def: Starter[];
+	defT: T;
+	skin: Skin;
+	accent: string;
+	seed: number;
+}) =>
+	props.seed % 3 === 2 ? <Formation {...props} /> : <LineupGroups {...props} />;
+const Formation = ({
+	off,
+	offT,
+	def,
+	defT,
+	skin,
+	accent,
+}: {
+	off: Starter[];
+	offT: T;
+	def: Starter[];
+	defT: T;
+	skin: Skin;
+	accent: string;
+}) => {
+	const placed: { s: Starter; t: T; x: number; y: number; k: number }[] = [];
+	const used: Record<string, number> = {};
+	[
+		...def.map((s) => ({ s, t: defT })),
+		...off.map((s) => ({ s, t: offT })),
+	].forEach(({ s, t }, k) => {
+		const i = used[s.pos] ?? 0;
+		used[s.pos] = i + 1;
+		const spot = SPOTS[s.pos]?.[i];
+		if (spot) placed.push({ s, t, x: spot[0], y: spot[1], k });
+	});
+	const chip = (t: T) => t.colors?.[0] ?? "#334155";
+	return (
+		<div
+			style={{
+				position: "relative",
+				height: 470,
+				borderRadius: skin.panelRadius,
+				overflow: "hidden",
+				background:
+					"repeating-linear-gradient(180deg, #2f7a35 0 40px, #2b7131 40px 80px)",
+				boxShadow: "inset 0 0 40px rgba(0,0,0,.5)",
+			}}
+		>
+			{/* Yard lines, the hash marks, the line of scrimmage and the first-down line */}
+			{[16, 32, 68, 84].map((y) => (
+				<div
+					key={y}
+					style={{
+						position: "absolute",
+						left: 0,
+						right: 0,
+						top: `${y}%`,
+						height: 2,
+						background: "rgba(255,255,255,.35)",
+					}}
+				/>
+			))}
+			<div
+				style={{
+					position: "absolute",
+					left: 0,
+					right: 0,
+					top: "50%",
+					height: 3,
+					background: "#3b82f6",
+					boxShadow: "0 0 8px #3b82f6",
+				}}
+			/>
+			<div
+				style={{
+					position: "absolute",
+					left: 0,
+					right: 0,
+					top: "31%",
+					height: 3,
+					background: "#facc15",
+					opacity: 0.85,
+				}}
+			/>
+			{/* Each team's logo faint on its half */}
+			<Logo
+				t={defT}
+				size={150}
+				style={{
+					position: "absolute",
+					left: "50%",
+					top: "4%",
+					transform: "translateX(-50%)",
+					opacity: 0.16,
+					filter: "none",
+				}}
+			/>
+			<Logo
+				t={offT}
+				size={150}
+				style={{
+					position: "absolute",
+					left: "50%",
+					bottom: "-6%",
+					transform: "translateX(-50%)",
+					opacity: 0.16,
+					filter: "none",
+				}}
+			/>
+			<div
+				style={{
+					position: "absolute",
+					left: 10,
+					top: 8,
+					fontWeight: 800,
+					fontSize: ".8rem",
+					letterSpacing: 2,
+					textTransform: "uppercase",
+					textShadow: "0 1px 2px #000",
+				}}
+			>
+				{defT.abbrev} defense
+			</div>
+			<div
+				style={{
+					position: "absolute",
+					left: 10,
+					bottom: 8,
+					fontWeight: 800,
+					fontSize: ".8rem",
+					letterSpacing: 2,
+					textTransform: "uppercase",
+					textShadow: "0 1px 2px #000",
+				}}
+			>
+				{offT.abbrev} offense
+			</div>
+			{placed.map(({ s, t, x, y, k }) => (
+				<div
+					key={s.pid}
+					style={{
+						position: "absolute",
+						left: `${x}%`,
+						top: `${y}%`,
+						transform: "translate(-50%, -50%)",
+						display: "flex",
+						flexDirection: "column",
+						alignItems: "center",
+						animation: `nflp-pop .35s ease-out ${0.04 * k}s both`,
+						zIndex: Math.round(y),
+					}}
+				>
+					<div style={{ position: "relative" }}>
+						<Face pl={s} t={t} size={32} />
+						<span style={{ position: "absolute", right: -10, top: -6 }}>
+							<Ovr ovr={s.ovr} size={20} />
+						</span>
+					</div>
+					<div
+						style={{
+							marginTop: 2,
+							background: chip(t),
+							color: "#ffffff",
+							borderRadius: 3,
+							padding: "0 5px",
+							fontSize: ".72rem",
+							fontWeight: 800,
+							whiteSpace: "nowrap",
+							boxShadow: `0 1px 4px rgba(0,0,0,.5), inset 0 -2px 0 ${accent}`,
+							fontStyle: skin.italic ? "italic" : undefined,
+						}}
+					>
+						{/* (linemen stand shoulder to shoulder: just their numbers, the rest get names) */}
+						{s.pos === "OL" || s.pos === "DL"
+							? `${s.num ? `${s.num} ` : ""}${last(s.name).toUpperCase().slice(0, 9)}`
+							: `${s.num ? `${s.num} ` : ""}${last(s.name).toUpperCase()}`}
+					</div>
+				</div>
+			))}
+		</div>
+	);
+};
+
+// What shows depends on the point in the season: the tape and the matchups always; season leaders once games have been
+// played; standings from week 5; the playoff picture and MVP race from week 9; none of the races in the playoffs
+export type CardId =
+	| "tape"
+	| "matchups"
+	| "leaders"
+	| "standings"
+	| "playoffs"
+	| "mvp"
+	| "gamestats"
+	| "gameleaders"
+	| "around"
+	| "leagueleaders"
+	| "final"
+	| "halftime"
+	| "stakes"
+	| "keymatch";
+// A phone: the cards lay out in one column where they would use two
+const NARROW = typeof window !== "undefined" && window.innerWidth < 600;
+const idOf = (title: string): CardId =>
+	title === "What's at stake"
+		? "stakes"
+		: title === "Key matchups"
+			? "keymatch"
+			: title === "Final"
+				? "final"
+				: title === "Halftime"
+					? "halftime"
+					: title === "Tale of the tape"
+						? "tape"
+						: title.includes(" vs ")
+							? "matchups"
+							: title === "Season leaders"
+								? "leaders"
+								: title === "Division standings"
+									? "standings"
+									: title === "Playoff picture"
+										? "playoffs"
+										: title === "The game so far"
+											? "gamestats"
+											: title === "Leaders this game"
+												? "gameleaders"
+												: title === "Around the league"
+													? "around"
+													: title === "League leaders"
+														? "leagueleaders"
+														: "mvp";
+// (only: just these cards, for a break in the game: halftime, a commercial, a timeout; label: shown above them)
+// (game: the box score so far, for the in-game cards; day/gid: which week, for the rest of the league's games)
+export const NflPregame = ({
