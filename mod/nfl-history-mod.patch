index 000000000..3cd90e12c
--- /dev/null
+++ b/src/common/nflJersey.ts
@@ -0,0 +1,75 @@
+// NFL history mod: what a team wears in a game, for any season. Its real current uniform when the league's colors are
+// this era's (common/nflUniforms.ts, generated), otherwise the era's colors from the league ([jersey body, stripe,
+// accent]) with the classic rules: dark jersey at home, white on the road. Teams that wear white at home (the Cowboys)
+// do the opposite. Kept apart from nflUniforms.ts because that file is regenerated.
+import { nflUniformFor } from "./nflUniforms.ts";
+
+const lum = (hex: string) => {
+	const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
+	if (!m) return 0.5;
+	const n = parseInt(m[1]!, 16);
+	return (
+		(0.299 * ((n >> 16) & 255) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) /
+		255
+	);
+};
+const WHITE_AT_HOME = new Set(["DAL"]);
+export type NflJersey = { jersey: string; stripe: string; num: string };
+export const nflJerseyFor = (
+	abbrev: string | undefined,
+	colors: string[] | undefined,
+	away: boolean,
+	// a generated home jersey (seasons after the real data ends): home wears it, road is white trimmed in its color
+	gen?: NflJersey,
+): NflJersey => {
+	if (gen) {
+		const whiteBody = lum(gen.jersey) > 0.8;
+		if (away !== whiteBody) {
+			const trim = whiteBody ? gen.num : gen.jersey;
+			return { jersey: "#ffffff", stripe: trim, num: trim };
+		}
+		if (whiteBody) {
+			const c = colors?.find((x) => lum(x) < 0.6) ?? "#334155";
+			return { jersey: c, stripe: "#ffffff", num: "#ffffff" };
+		}
+		return gen;
+	}
+	const cols =
+		colors && colors.length ? colors : ["#334155", "#ffffff", "#000000"];
+	const real = nflUniformFor(abbrev, cols);
+	const side = real ? (away ? real.road : real.home) : undefined;
+	if (side?.jersey) {
+		const stripe =
+			side.stripe && side.stripe.toLowerCase() !== side.jersey.toLowerCase()
+				? side.stripe
+				: (cols[1] ?? "#ffffff");
+		return {
+			jersey: side.jersey,
+			stripe,
+			num: side.num ?? (lum(side.jersey) > 0.6 ? cols[0]! : "#ffffff"),
+		};
+	}
+	const primary = cols[0]!;
+	const second = cols[1] ?? "#ffffff";
+	const third = cols[2] ?? "#000000";
+	const colored: NflJersey =
+		lum(primary) > 0.8
+			? { jersey: second, stripe: primary, num: primary }
+			: {
+					jersey: primary,
+					stripe: second,
+					num:
+						lum(primary) > 0.6
+							? third
+							: lum(second) > 0.6 || second.toLowerCase() === "#ffffff"
+								? second
+								: "#ffffff",
+				};
+	const white: NflJersey = {
+		jersey: "#ffffff",
+		stripe: colored.jersey,
+		num: colored.jersey,
+	};
+	const whiteHome = abbrev ? WHITE_AT_HOME.has(abbrev) : false;
+	return away !== whiteHome ? white : colored;
+};
