diff --git a/src/ui/components/Controller/NflWhatsNew.tsx b/src/ui/components/Controller/NflWhatsNew.tsx
new file mode 100644
index 000000000..3c319a2c3
--- /dev/null
+++ b/src/ui/components/Controller/NflWhatsNew.tsx
@@ -0,0 +1,295 @@
+import { useEffect, useState, type ReactNode } from "react";
+import { Modal } from "react-bootstrap";
+
+// NFL history mod: the mod's version in the corner, its changelog in the game, and a pop up the first time a new version
+// is opened. The launcher copies version.json and CHANGELOG.md next to the mod's other files.
+const SEEN_KEY = "nflModVersionSeen";
+const RELEASES = "https://api.github.com/repos/JenZiMiBruh/nfl-history-fbgm/releases/latest";
+
+const isNewer = (a: string, b: string) => {
+	const pa = a.replace(/^v/, "").split(".").map(Number);
+	const pb = b.replace(/^v/, "").split(".").map(Number);
+	for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
+		if ((pa[i] ?? 0) !== (pb[i] ?? 0)) {
+			return (pa[i] ?? 0) > (pb[i] ?? 0);
+		}
+	}
+	return false;
+};
+
+// **bold** and [links](https://...), the only formatting the changelog uses
+const inline = (text: string) =>
+	text.split("**").map((part, i) => {
+		const pieces: ReactNode[] = [];
+		let last = 0;
+		for (const m of part.matchAll(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g)) {
+			pieces.push(part.slice(last, m.index));
+			pieces.push(
+				<a key={m.index} href={m[2]} target="_blank" rel="noopener noreferrer">
+					{m[1]}
+				</a>,
+			);
+			last = m.index + m[0].length;
+		}
+		pieces.push(part.slice(last));
+		return i % 2 ? <b key={i}>{pieces}</b> : <span key={i}>{pieces}</span>;
+	});
+
+// Fan polls: the same ones as the site's Updates page, read from the site so a poll can change without a mod update.
+// A vote is one GoatCounter event on vote/<poll>/<option> (no cookies, no account; GoatCounter keeps event paths
+// without a leading slash), and this browser remembers it.
+const POLLS = "https://jenzimibruh.github.io/nfl-history-fbgm/data/polls.json";
+const GOATCOUNTER = "https://galloade.goatcounter.com";
+type Poll = {
+	id: string;
+	q: string;
+	note: string;
+	options: { id: string; label: string; desc: string }[];
+};
+const voteKey = (id: string) => `nflh-vote-${id}`;
+const readCount = (path: string) =>
+	fetch(`${GOATCOUNTER}/counter/${encodeURIComponent(path)}.json`)
+		.then((r) => (r.ok ? r.json() : { count: "0" }))
+		.then((j) => Number(String(j.count).replace(/[^0-9]/g, "")) || 0)
+		.catch(() => 0);
+
+const NflPoll = () => {
+	const [poll, setPoll] = useState<Poll>();
+	const [voted, setVoted] = useState<string | null>(null);
+	const [totals, setTotals] = useState<number[]>();
+	const [sending, setSending] = useState(false);
+	const [problem, setProblem] = useState("");
+
+	useEffect(() => {
+		(async () => {
+			try {
+				const data = await fetch(POLLS, { cache: "no-cache" }).then((r) =>
+					r.json(),
+				);
+				const p: Poll | undefined = data.polls.find(
+					(x: Poll) => x.id === data.inGame,
+				);
+				if (!p) {
+					return;
+				}
+				let mine: string | null = null;
+				try {
+					mine = localStorage.getItem(voteKey(p.id));
+				} catch {}
+				setVoted(mine);
+				setPoll(p);
+				if (mine) {
+					setTotals(
+						await Promise.all(
+							p.options.map((o) => readCount(`vote/${p.id}/${o.id}`)),
+						),
+					);
+				}
+			} catch {
+				// offline: no poll
+			}
+		})();
+	}, []);
+
+	if (!poll) {
+		return null;
+	}
+
+	const vote = async (option: string) => {
+		if (voted || sending) {
+			return;
+		}
+		setSending(true);
+		setProblem("");
+		// Through the launcher: GoatCounter drops counts sent straight from a local page like this one. A launcher from
+		// before voting (still running right after an update) doesn't know the request, so the vote isn't kept
+		const query = new URLSearchParams({ poll: poll.id, option });
+		const ok = await fetch(`http://${location.hostname}:3099/vote?${query}`, {
+			method: "POST",
+		})
+			.then((r) => r.ok)
+			.catch(() => false);
+		setSending(false);
+		if (!ok) {
+			setProblem(
+				"Your vote didn't go through. Close the mod window and run Install_and_Play again, then vote here or on the NFL History site.",
+			);
+			return;
+		}
+		try {
+			localStorage.setItem(voteKey(poll.id), option);
+		} catch {}
+		setVoted(option);
+		const counts = await Promise.all(
+			poll.options.map((o) => readCount(`vote/${poll.id}/${o.id}`)),
+		);
+		// Your own vote counts right away, before GoatCounter has it
+		setTotals(
+			counts.map((n, i) => n + (poll.options[i]!.id === option ? 1 : 0)),
+		);
+	};
+
+	const sum = totals ? totals.reduce((a, b) => a + b, 0) : 0;
+	return (
+		<div className="border-bottom pb-3 mb-3">
+			<h5 className="mb-1">Have your say: {poll.q}</h5>
+			<p className="text-body-secondary small mb-2">
+				{voted
+					? `Thanks for voting · ${sum.toLocaleString()} ${sum === 1 ? "vote" : "votes"} so far`
+					: problem || "One tap, no account needed."}
+			</p>
+			<div className="d-flex flex-wrap gap-2">
+				{poll.options.map((o, i) => {
+					const pct = totals && sum ? Math.round((totals[i]! / sum) * 100) : 0;
+					return (
+						<button
+							key={o.id}
+							type="button"
+							title={o.desc}
+							disabled={!!voted || sending}
+							className={`btn btn-sm ${voted === o.id ? "btn-primary" : "btn-outline-secondary"}`}
+							onClick={() => vote(o.id)}
+						>
+							{o.label}
+							{voted && totals ? ` · ${pct}%` : ""}
+						</button>
+					);
+				})}
+			</div>
+		</div>
+	);
+};
+
+const render = (md: string, newestOnly: boolean) => {
+	const out: ReactNode[] = [];
+	let list: ReactNode[] = [];
+	let sections = 0;
+	const flush = () => {
+		if (list.length > 0) {
+			out.push(<ul key={out.length}>{list}</ul>);
+			list = [];
+		}
+	};
+	for (const line of md.split(/\r?\n/)) {
+		if (line.startsWith("## ")) {
+			sections += 1;
+			if (newestOnly && sections > 1) {
+				break;
+			}
+			flush();
+			out.push(<h4 key={out.length}>{line.slice(3)}</h4>);
+		} else if (sections > 0 && line.startsWith("- ")) {
+			list.push(<li key={list.length}>{inline(line.slice(2))}</li>);
+		}
+	}
+	flush();
+	return out;
+};
+
+export const NflWhatsNew = () => {
+	const [version, setVersion] = useState<string>();
+	const [changelog, setChangelog] = useState("");
+	const [show, setShow] = useState<"new" | "all" | undefined>();
+	const [latest, setLatest] = useState<string>();
+	const [updateStatus, setUpdateStatus] = useState("");
+
+	const update = async () => {
+		try {
+			const response = await fetch(`http://${location.hostname}:3099/update`, { method: "POST" });
+			if (!response.ok) {
+				throw new Error();
+			}
+			setUpdateStatus("Updating... the game restarts by itself, and this page reloads when it is ready.");
+			// Wait for the game to come back on the new version
+			const timer = setInterval(async () => {
+				try {
+					const v = await fetch("/nfl/version.json", { cache: "no-store" }).then((r) => r.json());
+					if (v.version === latest?.replace(/^v/, "")) {
+						clearInterval(timer);
+						location.reload();
+					}
+				} catch {
+					// still restarting
+				}
+			}, 5000);
+		} catch {
+			setUpdateStatus("Close the mod window and run Install_and_Play again to update.");
+		}
+	};
+
+	useEffect(() => {
+		(async () => {
+			try {
+				const [v, md] = await Promise.all([
+					fetch("/nfl/version.json").then((r) => r.json()),
+					fetch("/nfl/CHANGELOG.md").then((r) => r.text()),
+				]);
+				setVersion(v.version);
+				setChangelog(md);
+				fetch(RELEASES)
+					.then((r) => r.json())
+					.then((rel) => {
+						if (rel.tag_name && isNewer(rel.tag_name, v.version)) {
+							setLatest(rel.tag_name);
+						}
+					})
+					.catch(() => {});
+				if (localStorage.getItem(SEEN_KEY) !== v.version) {
+					localStorage.setItem(SEEN_KEY, v.version);
+					setShow("new");
+				}
+			} catch {
+				// no files (or no storage): nothing to show
+			}
+		})();
+	}, []);
+
+	if (!version) {
+		return null;
+	}
+
+	return (
+		<>
+			{/* In the page flow at the bottom, not fixed: a fixed button covered the sidebar and roster rows on phones */}
+			<div className="d-flex flex-wrap align-items-start gap-2 px-3 pb-3">
+			<button
+				className="btn btn-sm btn-link text-body-secondary p-0"
+				type="button"
+				onClick={() => setShow("all")}
+			>
+				NFL History v{version} · What's new
+			</button>
+			{latest ? (
+				<div className="alert alert-info mb-0" style={{ maxWidth: 340 }}>
+					<div className="mb-2">Update available: <b>{latest}</b></div>
+					{updateStatus ? <div>{updateStatus}</div> : (
+						<button className="btn btn-sm btn-primary" type="button" onClick={update}>Update now</button>
+					)}
+				</div>
+			) : null}
+			</div>
+			<Modal show={show !== undefined} onHide={() => setShow(undefined)} size="lg" scrollable>
+				<Modal.Header closeButton>
+					<Modal.Title>
+						{show === "new" ? "What's new in the NFL History mod" : "NFL History changelog"}
+					</Modal.Title>
+				</Modal.Header>
+				<Modal.Body>
+					{/* The poll first, where it's seen without scrolling past the changelog */}
+					<NflPoll />
+					{render(changelog, show === "new")}
+				</Modal.Body>
+				<Modal.Footer>
+					{show === "new" ? (
+						<button className="btn btn-secondary" type="button" onClick={() => setShow("all")}>
+							Full changelog
+						</button>
+					) : null}
+					<button className="btn btn-primary" type="button" onClick={() => setShow(undefined)}>
+						Close
+					</button>
+				</Modal.Footer>
+			</Modal>
+		</>
+	);
+};
