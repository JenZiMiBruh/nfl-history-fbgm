+	g.fillStyle = "rgba(255,255,255,.35)";
+	g.beginPath();
+	g.ellipse(
+		sx - f * r * 0.15,
+		cy - r * 0.62,
+		r * 0.42,
+		r * 0.14,
+		-f * 0.35,
+		0,
+		Math.PI * 2,
+	);
+	g.fill();
+	g.restore();
+	shellPath();
+	g.strokeStyle = shade(shellC, -0.6);
+	g.lineWidth = 3;
+	g.stroke();
+	// Ear hole
+	g.fillStyle = shade(shellC, -0.55);
+	g.beginPath();
+	g.arc(sx + f * r * 0.05, cy + r * 0.38, r * 0.1, 0, Math.PI * 2);
+	g.fill();
+	// Face mask: two bars across the face and one down the front, bolted to the shell
+	const mx = sx + f * r * 0.55;
+	g.strokeStyle = maskC;
+	g.lineWidth = 5;
+	g.beginPath();
+	g.moveTo(sx + f * r * 0.08, cy + r * 0.22);
+	g.quadraticCurveTo(
+		mx + f * r * 0.5,
+		cy + r * 0.18,
+		mx + f * r * 0.55,
+		cy + r * 0.32,
+	);
+	g.moveTo(sx + f * r * 0.12, cy + r * 0.62);
+	g.quadraticCurveTo(
+		mx + f * r * 0.45,
+		cy + r * 0.6,
+		mx + f * r * 0.5,
+		cy + r * 0.66,
+	);
+	g.moveTo(mx + f * r * 0.55, cy + r * 0.3);
+	g.quadraticCurveTo(
