+				// Bench backrests with the team's letters
+				const bc = document.createElement("canvas");
+				bc.width = 512;
+				bc.height = 64;
+				const bg2 = bc.getContext("2d")!;
+				bg2.fillStyle = shadeHex(col, -0.15);
+				bg2.fillRect(0, 0, 512, 64);
+				bg2.fillStyle = colors[tIdx][1] ?? "#ffffff";
+				bg2.font = "900 42px Arial Black, Arial";
+				bg2.textAlign = "center";
+				bg2.textBaseline = "middle";
+				bg2.fillText(abbrevs[tIdx] || "", 256, 34);
+				const btex = new THREE.CanvasTexture(bc);
+				btex.colorSpace = THREE.SRGBColorSpace;
+				for (let i = 0; i < 3; i++) {
+					const back = new THREE.Mesh(
+						new THREE.BoxGeometry(14, 0.7, 0.12),
+						new THREE.MeshStandardMaterial({ map: btex, roughness: 0.7 }),
+					);
+					back.position.set(
+						37 + i * 16,
+						0.85,
+						near ? H + 8.4 + 0.42 : -6.6 - 0.42,
+					);
+					if (near) back.rotation.y = Math.PI;
+					this.group.add(back);
+				}
+			}
+			// More of a team area on both sidelines: two more benches (the row runs from the 15 to past the far 30), a medical
+			// tent, equipment trunks, big sideline fans, a helmet cart, and a row of helmets on the turf in front of the benches
+			{
+				for (const bx of [21, 85]) {
+					const bench = new THREE.Mesh(
+						new THREE.BoxGeometry(14, 0.5, 0.8),
+						std(shadeHex(col, -0.3)),
+					);
+					put(bench, bx, 0.25, zb);
+					const backrest = new THREE.Mesh(
+						new THREE.BoxGeometry(14, 0.7, 0.12),
+						std(shadeHex(col, -0.15)),
+					);
+					put(backrest, bx, 0.85, near ? zb + 0.42 : zb - 0.42);
+				}
+				// (the medical tent is the one above)
+				// Equipment trunks
+				for (let i = 0; i < 4; i++) {
+					const trunk = new THREE.Mesh(
+						new THREE.BoxGeometry(1.3, 0.8, 0.8),
+						std(i % 2 ? "#111827" : shadeHex(col, -0.4)),
+					);
+					put(trunk, 12 + i * 1.5, 0.4, near ? H + 9.8 : -8);
+				}
+				// Big sideline fans (or heaters) by the benches
+				for (const fx0 of [30, 62, 93]) {
+					const fan = new THREE.Group();
+					const housing = new THREE.Mesh(
+						new THREE.CylinderGeometry(0.75, 0.75, 0.45, 18),
+						std("#27272a"),
+					);
+					housing.rotation.x = Math.PI / 2;
+					housing.position.y = 1.1;
+					const grill = new THREE.Mesh(
+						new THREE.CircleGeometry(0.68, 18),
+						std("#9ca3af", { metalness: 0.6 }),
+					);
+					grill.position.set(0, 1.1, near ? -0.24 : 0.24);
+					if (near) grill.rotation.y = Math.PI;
+					const stand = new THREE.Mesh(
+						new THREE.BoxGeometry(0.9, 0.4, 0.6),
+						std("#3f3f46"),
+					);
+					stand.position.y = 0.2;
+					fan.add(housing, grill, stand);
+					put(fan, fx0, 0, near ? H + 6.4 : -4.8);
+				}
+				// Helmets lined up on the turf in front of the benches
+				const shell = std(colors[tIdx][0] ?? "#334155", {
+					roughness: 0.35,
+					metalness: 0.2,
+				});
+				for (let i = 0; i < 16; i++) {
+					const helmet = new THREE.Mesh(
+						new THREE.SphereGeometry(
+							0.2,
+							10,
+							8,
+							0,
+							Math.PI * 2,
+							0,
+							Math.PI * 0.62,
+						),
+						shell,
+					);
+					put(
+						helmet,
+						31 + i * 2.6 + (i % 3) * 0.3,
+						0.1,
+						near ? zb - 1.0 : zb + 1.0,
+					);
+				}
+			}
+			// Head coach, a couple of assistants, at the edge of the coaches' box
+			add("coach", col, 60, tIdx === 0 ? -2.2 : H + 2.6, tIdx === 0 ? 1 : -1);
+			add(
+				"coach",
+				shadeHex(col, -0.2),
+				55,
+				tIdx === 0 ? -2.6 : H + 3.2,
+				1,
+				0.97,
+			);
+			add(
+				"coach",
+				shadeHex(col, -0.2),
+				66,
+				tIdx === 0 ? -2.6 : H + 3.2,
+				-1,
+				0.97,
+			);
+		});
+		// Orange pylons at the four corners of each end zone
+		for (const x of [0, 10, 110, 120]) {
+			for (const z of [0, H]) {
+				const pylon = new THREE.Mesh(
+					new THREE.BoxGeometry(0.35, 1.2, 0.35),
+					new THREE.MeshStandardMaterial({ color: "#f97316", roughness: 0.5 }),
+				);
+				pylon.position.set(x, 0.6, z);
+				pylon.castShadow = false; /* (static props: no shadow pass; see the performance note in NflField3D) */
+				this.group.add(pylon);
+				this.pylons.push({ m: pylon, x, z, fall: 0, dir: 0 });
+			}
+		}
+		// TV camera operators: two on the near sideline and one on the far side, following the ball
+		add("camera", "#111827", 50, H + 1.9, -1);
+		add("camera", "#111827", 70, H + 1.9, -1);
+		// (the far side's camera is the cart camera now: NflCrew.ts)
+		// Photographers kneeling behind each end zone
+		for (const end of [-2.4, W + 2.4]) {
+			for (const z of [8, 17, 36, 45])
+				add("photo", "#334155", end, z, end < 0 ? 1 : -1, 0.9);
+		}
+		// The chain gang (three in vests) on the far sideline
+		add("chain", "#111827", 40, -1.4, 1);
+		add("chain", "#111827", 50, -1.4, 1);
+		add("chain", "#111827", 45, -1.4, 1);
+		this.mergeStatic();
+	}
+
+	// Performance: everything on the sidelines that never moves (benches, tables, coolers, props, banners...) is merged
+	// into one mesh per material, so hundreds of small objects cost a handful of draw calls. The people, the chains and
+	// the down marker, and the pylons (they tip over) stay separate.
+	private mergeStatic() {
+		const keep = new Set<THREE.Object3D>([
+			...this.poles,
+			this.chain,
+			this.marker,
+			...this.people.map((p) => p.sprite),
+			...this.pylons.map((p) => p.m),
+		]);
+		const byMat = new Map<THREE.Material, THREE.BufferGeometry[]>();
+		const remove: THREE.Object3D[] = [];
+		this.group.updateMatrixWorld(true);
+		const inv = new THREE.Matrix4().copy(this.group.matrixWorld).invert();
+		for (const ch of this.group.children) {
+			if (keep.has(ch)) continue;
+			let ok = true;
+			ch.traverse((o: any) => {
+				if (
+					o.isMesh &&
+					(Array.isArray(o.material) || !o.geometry.attributes.uv)
+				)
+					ok = false;
+				if (o.isLine || o.isPoints || o.isSprite) ok = false;
+			});
+			if (!ok) continue;
+			ch.traverse((o: any) => {
+				if (!o.isMesh) return;
+				const g = (o.geometry as THREE.BufferGeometry).index
+					? (o.geometry as THREE.BufferGeometry).toNonIndexed()
+					: (o.geometry as THREE.BufferGeometry).clone();
+				for (const name of Object.keys(g.attributes))
+					if (!["position", "normal", "uv"].includes(name))
+						g.deleteAttribute(name);
+				g.applyMatrix4(
+					new THREE.Matrix4().multiplyMatrices(inv, o.matrixWorld),
+				);
+				const list = byMat.get(o.material) ?? [];
+				list.push(g);
+				byMat.set(o.material, list);
+			});
+			remove.push(ch);
+		}
+		for (const ch of remove) this.group.remove(ch);
+		for (const [m, geos] of byMat) {
+			const merged = mergeGeometries(geos, false);
+			if (!merged) continue;
+			const mesh = new THREE.Mesh(merged, m);
+			mesh.receiveShadow = true;
+			mesh.matrixAutoUpdate = false;
+			this.group.add(mesh);
+			for (const g of geos) g.dispose();
+		}
+	}
+
+	update(
+		ballX: number,
+		los: number | undefined,
+		fd: number | undefined,
+		dt: number,
+		players: { x: number; y: number }[] = [],
+		inPlay = false,
+	) {
+		for (const py of this.pylons) {
+			if (inPlay && py.fall === 0) {
+				// A player runs into it: it tips over, away from him
+				for (const pl of players) {
+					const dx = py.x - pl.x;
+					const dz = py.z - pl.y;
+					if (dx * dx + dz * dz < 0.7 * 0.7) {
+						py.fall = 0.001;
+						py.dir = Math.atan2(dz, dx);
+						break;
+					}
+				}
+			}
+			if (!inPlay && py.fall > 0) py.fall = Math.max(0, py.fall - dt * 2);
+			else if (py.fall > 0) py.fall = Math.min(1, py.fall + dt * 6);
+			// Tip over around its base, toward py.dir
+			const a = py.fall * (Math.PI / 2);
+			py.m.rotation.set(Math.sin(py.dir) * a, 0, -Math.cos(py.dir) * a);
+			py.m.position.set(
+				py.x + Math.cos(py.dir) * Math.sin(a) * 0.6,
+				0.6 * Math.cos(a) + 0.18 * Math.sin(a),
+				py.z + Math.sin(py.dir) * Math.sin(a) * 0.6,
+			);
+		}
+		// Chains and the down box
+		const show = los !== undefined && fd !== undefined;
+		for (const p of this.poles) p.visible = show;
+		this.chain.visible = show;
+		this.marker.visible = los !== undefined;
+		if (show) {
+			this.poles[0]!.position.set(los!, 1.2, -1.0);
+			this.poles[1]!.position.set(fd!, 1.2, -1.0);
+			this.chain.position.set((los! + fd!) / 2, 0.6, -1.0);
+			this.chain.scale.x = Math.max(0.05, Math.abs(fd! - los!) / 10);
+		}
+		if (los !== undefined) this.marker.position.set(los, 1.3, -1.6);
+		let chainIdx = 0;
+		const k = Math.min(1, dt * 1.5);
+		for (const p of this.people) {
+			if (p.kind === "camera") {
+				// Keep up with the play, a few yards apart from each other
+				p.tx = Math.max(8, Math.min(112, ballX + (p.base - 60) * 0.5));
+			} else if (p.kind === "chain") {
+				const spots = [los, fd, los];
+				const at = spots[chainIdx++ % 3];
+				if (at !== undefined) p.tx = at + (chainIdx === 3 ? -0.8 : 0);
+			} else continue;
+			p.x += (p.tx - p.x) * k;
+			p.sprite.position.x = p.x;
+		}
+	}
+}
