+					([category, label]: [string, string]) => {
+						const events = league.scheduledEvents.filter(
+							(e: any) => w.SEASON_SLICER.eventCategory(e) === category,
+						);
+						if (events.length === 0) {
+							return null;
+						}
+						const ids = events.map((e: any) => e.id);
+						const numKept = ids.filter((id: number) => kept.has(id)).length;
+						return (
+							<details key={category} className="mb-1">
+								<summary>
+									<input
+										type="checkbox"
+										className="form-check-input me-2"
+										checked={numKept === ids.length}
+										ref={(el) => {
+											if (el) {
+												el.indeterminate = numKept > 0 && numKept < ids.length;
+											}
+										}}
+										onChange={(event) => {
