+// NFL history mod: the yearly cover vote. Before each season, eight of last season's stars are on the ballot; the user
+// votes once, the fans' votes are simulated, and when the regular season starts the winner becomes that year's cover.
+// Kept per league in the game attribute nflCovers, by cover season.
+
+export type NflCoverPlayer = {
+	pid: number;
+	name: string;
+	pos: string;
+	tid: number;
+	abbrev: string;
+	region: string;
+	teamName: string;
+	colors: [string, string, string];
+	logo?: string;
+	face?: unknown;
+	imgURL?: string;
+	ovr: number;
+	// last season's headline line ("4,183 pass yds, 38 TD")
+	line: string;
+	// how much the fans want him (from his season, awards, team success and buzz), and why ("MVP", "Champion")
+	pop?: number;
+	why?: string;
+	// the mod's real jersey for his face (that season's), so the cover shows our picture of him in his team's uniform
+	nfl?: { jersey: unknown; number?: string; logo?: string };
+};
+
+export type NflCoverSeason = {
+	season: number;
+	// the ballot, fixed when it first opens
+	candidates: NflCoverPlayer[];
+	userPick?: number;
+	// once decided: the winner and every candidate's share of the vote (percent, same order as candidates)
+	winner?: number;
+	shares?: number[];
+	// a real cover from before the league started (no vote); a second real cover athlete if it was shared
+	real?: boolean;
+	coStar?: NflCoverPlayer;
+};
+
+export type NflCovers = Record<number, NflCoverSeason>;
+
+// The game's name for a cover season (a league season, which is one later than the real season, the same as the
+// game's title year: league 2000 = the 1999 season = Madden NFL 2000). undefined before the first game.
+// - 1989-1993: John Madden Football, John Madden on the cover, no vote
+// - 1994-1999: Madden NFL '94 to '99, still John Madden on the cover, no vote
+// - 2000 on: a player on the cover, voted on. Four-digit titles through 2005, then Madden NFL 06, 07 ...
+export const FIRST_VOTE_SEASON = 2000;
+export const maddenTitle = (coverSeason: number) => {
+	if (coverSeason < 1989) return undefined;
+	const yy = String(coverSeason % 100).padStart(2, "0");
+	if (coverSeason <= 1993)
+		return coverSeason <= 1990 ? "John Madden Football" : `John Madden Football '${yy}`;
+	if (coverSeason <= 1999) return `Madden NFL '${yy}`;
+	if (coverSeason <= 2005) return `Madden NFL ${coverSeason}`;
+	if (coverSeason === 2014) return "Madden NFL 25";
+	return `Madden NFL ${yy}`;
+};
+
+// The real covers, by title year (= league season). A league started in season S has every real cover up to S; fans
+// vote from S + 1 on. Two names = a shared cover (the first is the one shown big). The real team abbreviation that year.
+export const REAL_COVERS: Record<number, { name: string; pos: string; abbrev: string }[]> = {
+	2000: [{ name: "Barry Sanders", pos: "RB", abbrev: "DET" }],
+	2001: [{ name: "Eddie George", pos: "RB", abbrev: "TEN" }],
+	2002: [{ name: "Daunte Culpepper", pos: "QB", abbrev: "MIN" }],
+	2003: [{ name: "Marshall Faulk", pos: "RB", abbrev: "STL" }],
+	2004: [{ name: "Michael Vick", pos: "QB", abbrev: "ATL" }],
+	2005: [{ name: "Ray Lewis", pos: "LB", abbrev: "BAL" }],
+	2006: [{ name: "Donovan McNabb", pos: "QB", abbrev: "PHI" }],
+	2007: [{ name: "Shaun Alexander", pos: "RB", abbrev: "SEA" }],
+	2008: [{ name: "Vince Young", pos: "QB", abbrev: "TEN" }],
+	2009: [{ name: "Brett Favre", pos: "QB", abbrev: "NYJ" }],
+	2010: [
+		{ name: "Larry Fitzgerald", pos: "WR", abbrev: "ARI" },
+		{ name: "Troy Polamalu", pos: "S", abbrev: "PIT" },
+	],
+	2011: [{ name: "Drew Brees", pos: "QB", abbrev: "NO" }],
+	2012: [{ name: "Peyton Hillis", pos: "RB", abbrev: "CLE" }],
+	2013: [{ name: "Calvin Johnson", pos: "WR", abbrev: "DET" }],
+	2014: [
+		{ name: "Adrian Peterson", pos: "RB", abbrev: "MIN" },
+		{ name: "Barry Sanders", pos: "RB", abbrev: "DET" },
