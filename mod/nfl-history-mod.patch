+				| "off";
+		} catch {
+			return "key" as const;
+		}
+	})();
+	const tags =
+		st && !cutscenes.current()
+			? frame.actors
+					.filter((a) =>
+						tagMode === "off"
+							? false
+							: tagMode === "key"
