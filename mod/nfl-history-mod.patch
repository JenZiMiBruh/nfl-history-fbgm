+// A team's whole season, one row per week: the bye week included, playoffs after
+const TeamSchedule = ({
+	entries,
+	weeks,
+	teams,
+	tid,
+	season,
+	gamesOfTheWeek,
+	watchDay,
+}: {
+	watchDay: number | undefined;
+	entries: Entry[];
+	weeks: [string, { label: string; sub: string; entries: Entry[] }][];
+	teams: Teams;
+	tid: number;
+	season: number;
+	gamesOfTheWeek: Set<string>;
+}) => {
+	const rows: { label: string; sub: string; entry?: Entry }[] = [];
+	for (const [, w] of weeks) {
+		const entry = w.entries.find(
+			(e) => e.game.homeTid === tid || e.game.awayTid === tid,
+		);
+		// Playoff rounds the team isn't in are left out; a regular season week without a game is the bye
+		if (!entry && !w.label.startsWith("Week")) {
+			continue;
+		}
+		rows.push({ label: w.label, sub: w.sub, entry });
+	}
+	if (rows.length === 0) {
+		return <p className="text-body-secondary">No games yet this season.</p>;
+	}
+	let won = 0;
+	let lost = 0;
+	let tied = 0;
+	return (
+		<div
+			className="mb-4 rounded-3 overflow-hidden"
+			style={{ border: "1px solid var(--bs-border-color)", maxWidth: 980 }}
+		>
+			{rows.map(({ label, sub, entry }, i) => {
+				if (!entry) {
+					return (
+						<div
+							key={i}
+							className="d-flex align-items-center gap-3 px-2 py-2 border-bottom text-body-secondary"
+							style={{ background: "var(--bs-tertiary-bg)" }}
+						>
+							<span className="fw-semibold" style={{ width: 92 }}>
+								{label}
+							</span>
+							<span className="fst-italic">Bye week</span>
+							<span className="small ms-auto">{sub}</span>
+						</div>
+					);
+				}
+				const { game, info } = entry;
+				const home = game.homeTid === tid;
+				const oppTid = home ? game.awayTid : game.homeTid;
+				const opp = oppTid >= 0 ? teams[oppTid] : undefined;
+				const played = game.homePts !== undefined && game.awayPts !== undefined;
+				let result: string | undefined;
+				let resultColor: string | undefined;
+				if (played) {
+					const us = home ? game.homePts! : game.awayPts!;
+					const them = home ? game.awayPts! : game.homePts!;
+					if (!game.playoffs) {
+						if (us > them) won++;
+						else if (us < them) lost++;
+						else tied++;
+					}
+					result = `${us > them ? "W" : us < them ? "L" : "T"} ${us}-${them}`;
+					resultColor =
+						us > them ? "#15803d" : us < them ? "#b91c1c" : "#475569";
+				}
+				const st = slotStyle(info);
+				const homeTeam = teams[game.homeTid];
+				return (
+					<div
+						key={i}
+						className="d-flex flex-wrap align-items-center px-2 py-2 border-bottom"
+						style={{
+							columnGap: 14,
+							rowGap: 2,
+							borderLeft: `4px solid ${st ? st.bg : "transparent"}`,
+						}}
+					>
+						<span className="fw-semibold" style={{ width: 92 }}>
+							{label}
+						</span>
+						<span className="small text-body-secondary" style={{ width: 200 }}>
+							{info.dateText.replace(/, \d{4}$/, "")} ·{" "}
+							{info.timeEstimated ? "~" : ""}
+							{info.timeText.replace(" ET", "")}
+							{info.network ? <> · {info.network}</> : null}
+						</span>
+						<span
+							className="d-inline-flex align-items-center gap-2"
+							style={{ minWidth: 150 }}
+						>
+							<span className="text-body-secondary small" style={{ width: 18 }}>
+								{game.neutralSite || info.superBowl ? "vs" : home ? "vs" : "@"}
+							</span>
+							{opp ? (
+								<a
+									href={helpers.leagueUrl([
+										"calendar",
+										season,
+										`${opp.abbrev}_${oppTid}`,
+									])}
+									className="d-inline-flex align-items-center gap-2 text-reset text-decoration-none"
+									title={`${opp.region} ${opp.name} calendar`}
+								>
+									{opp.imgURL ? (
+										<img
+											src={opp.imgURL}
+											alt=""
+											style={{ width: 22, height: 22, objectFit: "contain" }}
+										/>
+									) : null}
+									<span className="fw-semibold">{`${opp.region} ${opp.name}`}</span>
+								</a>
+							) : (
+								<span className="fw-semibold">TBD</span>
+							)}
+						</span>
+						<span>
+							<Pill info={info} />
+							{gamesOfTheWeek.has(calendarKey(game)) ? (
+								<span
+									className="badge"
+									style={{
+										background: "#15803d",
+										color: readableOn("#15803d"),
+									}}
+								>
+									⭐ Game of the Week
+								</span>
+							) : null}
+						</span>
+						{watchDay !== undefined &&
+						game.day === watchDay &&
+						!played &&
+						!game.pending &&
+						game.gid !== undefined ? (
+							<span className="d-inline-flex gap-1">
+								<button
+									type="button"
+									className="btn btn-sm btn-success py-0"
+									onClick={() => toWorker("actions", "liveGame", game.gid!)}
+								>
+									▶ Watch
+								</button>
+								<button
+									type="button"
+									className="btn btn-sm btn-outline-secondary py-0"
+									onClick={() => toWorker("actions", "simGame", game.gid!)}
+								>
+									Sim
+								</button>
+							</span>
+						) : !played && !game.pending && game.gid !== undefined ? (
+							<button
+								type="button"
+								className="btn btn-sm btn-outline-primary py-0"
+								onClick={() => toWorker("actions", "simToGame", game.gid!)}
+								title="Sim every game before this one"
+							>
+								⏩ Sim to
+							</button>
+						) : null}
+						<GameLine teams={teams as any} game={game} />
+						<span className="ms-auto d-inline-flex align-items-center gap-3">
+							<span className="small text-body-secondary text-truncate">
+								{info.weatherText ? (
+									<>
+										{weatherIcon(info)} {info.weatherText}
+									</>
+								) : null}
+							</span>
+							{played && game.gid !== undefined && homeTeam ? (
+								<a
+									href={helpers.leagueUrl([
+										"game_log",
+										`${homeTeam.abbrev}_${game.homeTid}`,
+										season,
+										game.gid,
+									])}
+									className="fw-bold text-decoration-none badge"
+									style={{
+										background: resultColor,
+										color: readableOn(resultColor ?? "#475569"),
+										minWidth: 64,
+										fontSize: "0.8rem",
+									}}
+								>
+									{result}
+								</a>
+							) : (
+								<span style={{ minWidth: 64 }} />
+							)}
+							{played && !game.playoffs ? (
+								<span
+									className="small text-body-secondary"
+									style={{
+										minWidth: 40,
+										textAlign: "right",
+										fontVariantNumeric: "tabular-nums",
+									}}
+								>
+									{won}-{lost}
+									{tied ? `-${tied}` : ""}
+								</span>
+							) : (
+								<span style={{ minWidth: 40 }} />
+							)}
+						</span>
+					</div>
+				);
+			})}
+		</div>
+	);
+};
+
+// Above a week's games: the headline games (primetime, holidays, Game of the Week), your game, and who's on bye
+const WeekHighlights = ({
+	week,
+	teams,
+	focusTid,
+	gamesOfTheWeek,
+	season,
+	onPick,
+}: {
+	season: number;
+	onPick: (e: Entry) => void;
+	week: { label: string; sub: string; entries: Entry[] };
+	teams: Teams;
+	focusTid: number;
+	gamesOfTheWeek: Set<string>;
+}) => {
+	const name = (tid: number) => (tid < 0 ? "TBD" : (teams[tid]?.abbrev ?? "?"));
+	const matchup = (e: Entry) =>
+		`${name(e.game.awayTid)} ${e.game.neutralSite ? "vs" : "@"} ${name(e.game.homeTid)}`;
+	const headline = week.entries.filter(
+		(e) =>
+			e.info.primetime ||
+			e.info.round ||
+			/Thanksgiving|Christmas|International/.test(e.info.slot ?? ""),
+	);
+	const gotw = week.entries.find((e) =>
+		gamesOfTheWeek.has(calendarKey(e.game)),
+	);
+	const mine = week.entries.find(
+		(e) => e.game.homeTid === focusTid || e.game.awayTid === focusTid,
+	);
+	const playing = new Set(
+		week.entries.flatMap((e) => [e.game.homeTid, e.game.awayTid]),
+	);
+	const byes = week.label.startsWith("Week")
+		? Object.keys(teams)
+				.map(Number)
+				.filter((tid) => !playing.has(tid))
+		: [];
+	const played = week.entries.filter(
+		(e) => e.game.homePts !== undefined,
+	).length;
+	const chip: CSSProperties = {
+		border: "1px solid var(--bs-border-color)",
+		borderRadius: 8,
+		padding: "6px 10px",
+		background: "var(--bs-body-bg)",
+	};
+	return (
+		<div className="d-flex flex-wrap gap-2 mb-2" style={{ maxWidth: 980 }}>
+			<div style={chip}>
+				<div className="small text-body-secondary">Games</div>
+				<div className="fw-bold">
+					{week.entries.length}
+					{played > 0 ? (
+						<span className="fw-normal text-body-secondary small">
+							{" "}
+							· {played} played
+						</span>
+					) : null}
+				</div>
+			</div>
+			{mine ? (
+				<button
+					type="button"
+					onClick={() => onPick(mine)}
+					title="Jump to this game"
+					className="text-start"
+					style={{
+						...chip,
+						borderColor: "var(--bs-primary)",
+						color: "inherit",
+						cursor: "pointer",
+					}}
+				>
+					<div className="small text-body-secondary">
+						{teams[focusTid]?.abbrev ?? "Your"} game
+					</div>
+					<div className="fw-bold">
+						{matchup(mine)}
+						<span className="fw-normal small text-body-secondary">
+							{" "}
+							· {mine.info.dateText.split(",")[0]}{" "}
+							{mine.info.timeText.replace(" ET", "")}
+						</span>
+					</div>
+				</button>
+			) : week.label.startsWith("Week") ? (
+				<div style={chip}>
+					<div className="small text-body-secondary">
+						{teams[focusTid]?.abbrev}
+					</div>
+					<div className="fw-bold">Bye week</div>
+				</div>
+			) : null}
+			{gotw ? (
+				<button
+					type="button"
+					onClick={() => onPick(gotw)}
+					title="Jump to this game"
+					className="text-start"
+					style={{ ...chip, color: "inherit", cursor: "pointer" }}
+				>
+					<div className="small text-body-secondary">⭐ Game of the Week</div>
+					<div className="fw-bold">{matchup(gotw)}</div>
+				</button>
+			) : null}
+			{headline.map((e) => (
+				<button
+					type="button"
+					key={calendarKey(e.game)}
+					onClick={() => onPick(e)}
+					title="Jump to this game"
+					className="text-start"
+					style={{ ...chip, color: "inherit", cursor: "pointer" }}
+				>
+					<div className="small">
+						<Pill info={e.info} />
+					</div>
+					<div className="fw-bold">{matchup(e)}</div>
+				</button>
+			))}
+			{byes.length > 0 ? (
+				<div style={chip}>
+					<div className="small text-body-secondary">On bye</div>
+					<div className="fw-semibold small d-flex flex-wrap gap-2">
+						{byes.map((tid) =>
+							teams[tid] ? (
+								<a
+									key={tid}
+									href={helpers.leagueUrl([
+										"calendar",
+										season,
+										`${teams[tid]!.abbrev}_${tid}`,
+									])}
+									className="text-reset"
+								>
+									{teams[tid]!.abbrev}
+								</a>
+							) : null,
+						)}
+					</div>
+				</div>
+			) : null}
+		</div>
+	);
+};
