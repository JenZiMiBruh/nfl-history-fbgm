+// NFL history mod: broadcast score bugs for the live game. Six original packages, each with its own typeface,
+// shapes and color handling, in the visual language TV networks use (no network names or logos):
+//   glossy  - Sunday 1:00: black glossy bar, slanted team-color wedges, tall italic numbers, yellow down flag
+//   flat    - late games, Saturdays, holidays: clean light bar, team-color top stripes, dark text, navy clock
+//   glass   - Sunday night and primetime: compact frosted dark box, thin team bars, clock row underneath
+//   angular - Monday night: black bar with cut corners, heavy italic type, white score boxes, magenta accents
+//   sleek   - Thursday night and international: separate rounded charcoal pills, colored scores
+//   premium - playoffs, Super Bowl, Kickoff: taller navy bar with silver hairlines and a round ribbon
+// Every color pair is fixed (light on dark or dark on light), so the bugs read the same in light and dark mode.
+import { chooseSmallLogo } from "../../util/chooseSmallLogo.ts";
+import {
+	createContext,
+	useContext,
+	useEffect,
+	useMemo,
+	type CSSProperties,
+	type ReactNode,
+	useState,
+} from "react";
+import { helpers } from "../../util/helpers.ts";
+import { readableOn } from "../../components/NflGameInfo.tsx";
+import type { NflGameInfo } from "../../../common/nflCalendar.ts";
+
+export type Package =
+	| "glossy"
+	| "flat"
+	| "glass"
+	| "angular"
+	| "sleek"
+	| "premium"
+	| "caption"
+	| "boxy"
+	| "corner"
+	| "xmas";
+export type Presentation = {
+	key: string;
+	name: string; // the tag: "SUNDAY NIGHT FOOTBALL", "THANKSGIVING", "SUPER BOWL LXI"
+	pkg: Package;
+	accent: string;
+	night: boolean;
+};
+
+export type BoardTeam = {
+	tid?: number;
+	abbrev: string;
+	region: string;
+	name: string;
+	colors?: string[];
+	imgURL?: string;
+	imgURLSmall?: string;
+	pts: number;
+	ptsQtrs?: number[];
+	timeouts?: number;
+};
+
+const FONTS: Record<Package, string> = {
+	glossy: "'Teko', 'Oswald', 'Arial Narrow', sans-serif",
+	flat: "'Roboto Condensed', 'Arial Narrow', Arial, sans-serif",
+	glass: "'Bebas Neue', 'Oswald', 'Arial Narrow', sans-serif",
+	angular: "'Barlow Condensed', 'Arial Narrow', Arial, sans-serif",
+	sleek: "'Saira Condensed', 'Roboto Condensed', 'Arial Narrow', sans-serif",
+	premium: "'Oswald', 'Arial Narrow', Arial, sans-serif",
+	xmas: "'Oswald', 'Arial Narrow', Arial, sans-serif",
+} as Record<Package, string>;
+
+// Load the packages' typefaces once (when offline, the fallbacks above are used)
+export const useBroadcastFonts = () => {
+	useEffect(() => {
+		if (document.getElementById("nfl-broadcast-fonts")) return;
+		const link = document.createElement("link");
+		link.id = "nfl-broadcast-fonts";
+		link.rel = "stylesheet";
+		link.href =
+			"https://fonts.googleapis.com/css2?family=Teko:wght@500;700&family=Bebas+Neue&family=Barlow+Condensed:ital,wght@0,700;1,800&family=Saira+Condensed:wght@600;800&family=Oswald:wght@500;700&family=Roboto+Condensed:wght@600;800&family=Russo+One&family=Courier+Prime:wght@700&display=swap";
+		document.head.appendChild(link);
+	}, []);
+};
+
+export const presentationFor = (
+	info: NflGameInfo | undefined,
+): Presentation => {
+	const hour = info ? Math.floor(info.minutes / 60) : 13;
+	const night = hour >= 18;
+	const slot = info?.slot ?? "";
+	const p = (
+		key: string,
+		name: string,
+		pkg: Package,
+		accent: string,
+	): Presentation => ({ key, name, pkg, accent, night });
+	if (info?.superBowl)
+		return p("sb", info.round ?? "Super Bowl", "premium", "#e2e8f0");
+	if (info?.round) return p("playoffs", info.round, "premium", "#cbd5e1");
+	if (slot.includes("Kickoff"))
+		return p("kickoff", "NFL Kickoff", "premium", "#fbbf24");
+	if (slot.includes("Christmas"))
+		return p(
+			"christmas",
+			"Christmas Day",
+			info && info.date.getUTCFullYear() % 2 === 1 ? "flat" : "xmas",
+			"#b91c1c",
+		);
+	if (slot.includes("Thanksgiving"))
+		return p("thanksgiving", "Thanksgiving", "flat", "#b45309");
+	if (slot.includes("International"))
+		return p("intl", "International Series", "sleek", "#5eead4");
+	if (slot.includes("Monday"))
+		return {
+			...p("mnf", "Monday Night Football", "angular", "#ec4899"),
+			night: true,
+		};
+	if (slot.includes("Thursday"))
+		return {
+			...p("tnf", "Thursday Night Football", "sleek", "#c084fc"),
+			night: true,
+		};
+	if (slot.includes("Sunday Night") || (night && info?.date.getUTCDay() === 0))
+		return {
+			...p("snf", "Sunday Night Football", "glass", "#93c5fd"),
+			night: true,
+		};
+	if (night) return p("night", "Primetime", "glass", "#a5b4fc");
+	if (info && info.date.getUTCDay() === 6)
+		return p("saturday", "Saturday", "flat", "#1d4ed8");
+	if (hour >= 16) return p("late", "Late Game", "flat", "#0f3d91");
+	return p(
+		"early",
+		info && info.date.getUTCDay() === 0 ? "Sunday" : "NFL",
+		"glossy",
+		"#ffd400",
+	);
+};
+
+// Era looks: before the always-on score bug (1994) TV showed the score in a caption bar now and then; the late 80s had
+// boxy computer graphics; from 1994 to the mid 2000s, the score sat in a box in the top corner. The game's slot (MNF,
+// Thanksgiving...) still sets the tag.
+export const eraPresentation = (
+	season: number | undefined,
+	p: Presentation,
+): Presentation => {
+	if (season === undefined) return p;
+	if (season < 1987) return { ...p, pkg: "caption" };
+	if (season < 1995) return { ...p, pkg: "boxy" };
+	if (season < 2007) return { ...p, pkg: "corner" };
+	return p;
+};
+
+// Weather tags and effects
+export const weatherTags = (info: NflGameInfo | undefined) => {
+	const tags: string[] = [];
+	if (!info) return tags;
+	if (info.indoors) return ["Indoors"];
+	if (info.temp !== undefined) tags.push(`${info.temp}°F`);
+	if (info.cond === 2) tags.push("Snow");
+	if (info.cond === 1) tags.push("Rain");
+	if (info.cond === 3) tags.push("Fog");
+	if (info.wind !== undefined && info.wind >= 15)
+		tags.push(`Wind ${info.wind}`);
+	return tags;
+};
+
+export const Particles = ({
+	cond,
+	count = 40,
+}: {
+	cond: number;
+	count?: number;
+}) => {
+	const drops = useMemo(
+		() =>
+			Array.from({ length: count }, () => ({
+				left: Math.random() * 100,
+				delay: Math.random() * 3,
+				dur: cond === 2 ? 3 + Math.random() * 3 : 0.6 + Math.random() * 0.5,
+				size: cond === 2 ? 2 + Math.random() * 2 : 1,
+			})),
+		[cond, count],
+	);
+	if (cond !== 1 && cond !== 2) return null;
+	return (
+		<div
+			aria-hidden
+			style={{
+				position: "absolute",
+				inset: 0,
+				overflow: "hidden",
+				pointerEvents: "none",
+			}}
+		>
+			{drops.map((d, i) => (
+				<span
+					key={i}
+					className={cond === 2 ? "nflb-snow" : "nflb-rain"}
+					style={{
+						left: `${d.left}%`,
+						animationDelay: `${d.delay}s`,
+						animationDuration: `${d.dur}s`,
+						width: cond === 2 ? d.size : 1,
+						height: cond === 2 ? d.size : 14,
+					}}
+				/>
+			))}
+		</div>
+	);
+};
+
+const shade = (hex: string, amount: number) => {
+	const n = Number.parseInt((hex || "#333333").slice(1), 16);
+	const f = (c: number) =>
+		Math.max(0, Math.min(255, Math.round(c * (1 - amount))));
+	return `#${[(n >> 16) & 255, (n >> 8) & 255, n & 255].map((c) => f(c).toString(16).padStart(2, "0")).join("")}`;
+};
+const colorOf = (t: BoardTeam) => t.colors?.[0] ?? "#334155";
+
+const Logo = ({ t, size }: { t: BoardTeam; size: number }) =>
+	t.imgURLSmall || t.imgURL ? (
+		<img
+			src={chooseSmallLogo(t.imgURLSmall, t.imgURL)}
+			alt=""
+			style={{
+				width: size,
+				height: size,
+				objectFit: "contain", // A thin white outline traced around the logo, so a logo in the team color still shows on the team-color panel
+				filter:
+					"drop-shadow(1px 0 0 #fff) drop-shadow(-1px 0 0 #fff) drop-shadow(0 1px 0 #fff) drop-shadow(0 -1px 0 #fff) drop-shadow(0 1px 2px rgba(0,0,0,.45))",
+				flexShrink: 0,
+			}}
+		/>
+	) : null;
+
+// Holidays dress the timeouts: Christmas lights (a used timeout is a burnt-out bulb), little pumpkins at Halloween
+const HolidayCtx = createContext<"christmas" | "halloween" | undefined>(
+	undefined,
+);
+const BULBS = ["#ef4444", "#22c55e", "#3b82f6"];
+const Timeouts = ({
+	n = 3,
+	color,
+	vertical,
+}: {
+	n?: number;
+	color: string;
+	vertical?: boolean;
+}) => {
+	const hol = useContext(HolidayCtx);
+	if (hol === "christmas")
+		return (
+			<span
+				className="d-inline-flex align-items-start"
+				style={{
+					gap: 4,
+					flexDirection: vertical ? "column" : "row",
+					borderTop: vertical ? undefined : "1px solid rgba(20,83,45,.9)",
+					paddingTop: 0,
+					marginTop: -1,
+				}}
+				aria-label={`${n} timeouts left`}
+				title={`${n} timeouts left`}
+			>
+				{[0, 1, 2].map((i) => (
+					<span
+						key={i}
+						style={{
+							width: 6,
+							height: 8,
+							borderRadius: "40% 40% 50% 50% / 30% 30% 70% 70%",
+							background: i < n ? BULBS[i] : "#4b5563",
+							boxShadow: i < n ? `0 0 6px ${BULBS[i]}` : "none",
+							animation:
+								i < n
+									? `nflh-blink 1.6s ease-in-out ${i * 0.4}s infinite`
+									: undefined,
+							borderTop: "2px solid #374151",
+						}}
+					/>
+				))}
+			</span>
+		);
+	if (hol === "halloween")
+		return (
+			<span
+				className="d-inline-flex"
+				style={{ gap: 3, flexDirection: vertical ? "column" : "row" }}
+				aria-label={`${n} timeouts left`}
+				title={`${n} timeouts left`}
+			>
+				{[0, 1, 2].map((i) => (
+					<span
+						key={i}
+						style={{
+							width: 8,
+							height: 7,
+							borderRadius: "45%",
+							background: i < n ? "#f97316" : "#4b5563",
+							boxShadow:
+								i < n ? "inset 0 -2px 0 #c2410c, 0 0 5px #f97316" : "none",
+							borderTop: "2px solid #15803d",
+						}}
+					/>
+				))}
+			</span>
+		);
+	return (
+		<span
+			className="d-inline-flex"
+			style={{ gap: 3, flexDirection: vertical ? "column" : "row" }}
+			aria-label={`${n} timeouts left`}
+			title={`${n} timeouts left`}
+		>
+			{[0, 1, 2].map((i) => (
+				<span
+					key={i}
+					style={{
+						width: vertical ? 4 : 11,
+						height: vertical ? 8 : 4,
+						borderRadius: 2,
+						background: color,
+						opacity: i < n ? 1 : 0.25,
+					}}
+				/>
+			))}
+		</span>
+	);
+};
+// The team name with its timeouts underneath
+const NameTO = ({
+	children,
+	n,
+	color,
+	right,
+}: {
+	children: ReactNode;
+	n?: number;
+	color: string;
+	right?: boolean;
+}) => (
+	<span
+		className="d-inline-flex flex-column"
+		style={{
+			lineHeight: 1,
+			gap: 4,
+			alignItems: right ? "flex-end" : "flex-start",
+		}}
+	>
+		{children}
+		<Timeouts n={n} color={color} />
+	</span>
+);
+
+export type BoardProps = {
+	p: Presentation;
+	info: NflGameInfo | undefined;
+	away: BoardTeam;
+	home: BoardTeam;
+	possession: 0 | 1 | undefined; // 0 home, 1 away
+	quarter: string; // "2ND"
+	time: string; // "7:43"
+	situation: string | undefined;
+	redZone: boolean;
+	gameOver: boolean;
+	season?: number;
+	onToggleDetails?: () => void;
+	detailsOpen?: boolean;
+};
+
+// Team names link to the roster, like the game's own scoreboard
+const TeamLink = ({
+	t,
+	season,
+	children,
+	style,
+}: {
+	t: BoardTeam;
+	season?: number;
+	children: ReactNode;
+	style?: CSSProperties;
+}) =>
+	t.tid !== undefined && t.tid >= 0 && season !== undefined ? (
+		<a
+			href={helpers.leagueUrl(["roster", `${t.abbrev}_${t.tid}`, season])}
+			style={{
+				color: "inherit",
+				textDecoration: "none",
+				display: "inline-flex",
+				alignItems: "center",
+				gap: 6,
+				...style,
+			}}
+			title={`${t.region} ${t.name} roster`}
+		>
+			{children}
+		</a>
+	) : (
+		<span
+			style={{ display: "inline-flex", alignItems: "center", gap: 6, ...style }}
+		>
+			{children}
+		</span>
+	);
+
+// The clock and down boxes open the line score and stats
+const Tap = ({
+	b,
+	children,
+	style,
+}: {
+	b: BoardProps;
+	children: ReactNode;
+	style?: CSSProperties;
+}) => (
+	<button
+		type="button"
+		onClick={b.onToggleDetails}
+		aria-expanded={b.detailsOpen}
+		title={
+			b.detailsOpen ? "Hide line score and stats" : "Show line score and stats"
+		}
+		style={{
+			border: 0,
+			padding: 0,
+			margin: 0,
+			background: "transparent",
+			color: "inherit",
+			font: "inherit",
+			cursor: "pointer",
+			display: "flex",
+			alignItems: "stretch",
+			...style,
+		}}
+	>
+		{children}
+	</button>
+);
+
+const weatherText = (info: NflGameInfo | undefined) =>
+	weatherTags(info).join(" · ");
+const clockText = (b: BoardProps) =>
+	b.gameOver ? "FINAL" : `${b.quarter} ${b.time}`;
+const downText = (b: BoardProps) =>
+	b.gameOver || !b.situation ? undefined : b.situation.toUpperCase();
+
+// ---- caption: 1960s to mid 80s, the score as a plain TV caption ----
+const Caption = (b: BoardProps) => {
+	const f = '"Courier Prime", "Courier New", monospace';
+	return (
+		<Tap b={b} style={{ width: "100%" }}>
+			<div
+				className="d-flex align-items-center flex-wrap"
+				style={{
+					width: "100%",
+					background: "rgba(10,10,10,.82)",
+					color: "#f5f5f0",
+					fontFamily: f,
+					fontWeight: 700,
+					fontSize: "1.15rem",
+					letterSpacing: 2,
+					padding: "6px 14px",
+					gap: 18,
+					textTransform: "uppercase",
+					textShadow: "1px 1px 0 #000",
+				}}
+			>
+				<span>
+					{b.away.abbrev} {b.away.pts}
+				</span>
+				<span>
+					{b.home.abbrev} {b.home.pts}
+				</span>
+				<span style={{ opacity: 0.9 }}>{clockText(b)}</span>
+				{downText(b) ? (
+					<span style={{ opacity: 0.8, fontSize: "0.95rem" }}>
+						{downText(b)}
+					</span>
+				) : null}
+			</div>
+		</Tap>
+	);
+};
+
+// ---- boxy: late 80s, early 90s computer graphics ----
+// A chip color that stands out on a near-black box
+const lumOf = (hex: string) => {
+	const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
+	if (!m) return 0.5;
+	const n = parseInt(m[1]!, 16);
+	return (
+		(0.299 * ((n >> 16) & 255) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) /
+		255
+	);
+};
+const chip = (t: BoardTeam) => {
+	const c = colorOf(t);
+	const c2 = t.colors?.[1];
+	return lumOf(c) < 0.2 && c2 && lumOf(c2) > lumOf(c) ? c2 : c;
+};
+const Boxy = (b: BoardProps) => {
+	const f = '"Russo One", "Arial Black", sans-serif';
+	const box = (t: BoardTeam, has: boolean) => (
+		<div
+			className="d-flex align-items-center"
+			style={{
+				background: "#0b0f19",
+				border: "2px solid #64748b",
+				color: "#ffffff",
+				fontFamily: f,
+				padding: "2px 8px",
+				gap: 8,
+				minWidth: 0,
+			}}
+		>
+			{/* A team color that would vanish on the dark box gives way to the team's second color; a white outline either way */}
+			<span
+				style={{
+					color: readableOn(chip(t)),
+					background: chip(t),
+					padding: "0 6px",
+					fontSize: "1rem",
+					outline: "2px solid #ffffff",
+					outlineOffset: -1,
+				}}
+			>
+				{t.abbrev}
+			</span>
+			<span style={{ fontSize: "1.5rem", fontVariantNumeric: "tabular-nums" }}>
+				{t.pts}
+			</span>
+			{has ? <span style={{ color: "#fde047" }}>◀</span> : null}
+		</div>
+	);
+	return (
+		<div
+			className="d-flex align-items-stretch flex-wrap"
+			style={{
+				gap: 4,
+				background: "linear-gradient(180deg, #0f172a, #1e293b)",
+				padding: 4,
+				boxShadow: "0 3px 10px rgba(0,0,0,.4)",
+			}}
+		>
+			{box(b.away, b.possession === 1)}
+			{box(b.home, b.possession === 0)}
+			<Tap b={b}>
+				<div
+					className="d-flex align-items-center"
+					style={{
+						background: "#fde047",
+						color: "#111827",
+						fontFamily: f,
+						padding: "2px 10px",
+						gap: 10,
+					}}
+				>
+					<span>{clockText(b)}</span>
+					{downText(b) ? (
+						<span style={{ fontSize: "0.85rem" }}>{downText(b)}</span>
+					) : null}
+				</div>
+			</Tap>
+		</div>
+	);
+};
+
+// ---- corner: mid 90s to mid 2000s, the score box in the top corner ----
+const Corner = (b: BoardProps) => {
+	const f = '"Oswald", "Arial Narrow", sans-serif';
+	const row = (t: BoardTeam, has: boolean) => (
+		<div className="d-flex align-items-center" style={{ height: 26, gap: 6 }}>
+			<span
+				style={{
+					width: 52,
+					background: colorOf(t),
+					color: readableOn(colorOf(t)),
+					fontFamily: f,
+					fontWeight: 700,
+					textAlign: "center",
+					fontSize: "1rem",
+				}}
+			>
+				{t.abbrev}
+			</span>
+			<span
+				style={{
+					width: 36,
+					textAlign: "right",
+					fontFamily: f,
+					fontWeight: 700,
+					fontSize: "1.25rem",
+					color: "#ffffff",
+					fontVariantNumeric: "tabular-nums",
+				}}
+			>
+				{t.pts}
+			</span>
+			<span style={{ width: 10, color: "#fbbf24" }}>{has ? "●" : ""}</span>
+		</div>
+	);
+	return (
+		<div
+			className="d-inline-flex align-items-stretch"
+			style={{
+				background: "linear-gradient(180deg, #2b2b2b, #0d0d0d)",
+				border: "2px solid #c9a227",
+				borderRadius: 3,
+				boxShadow: "0 3px 10px rgba(0,0,0,.45)",
+			}}
+		>
+			<div className="px-2 py-1">
+				{row(b.away, b.possession === 1)}
+				{row(b.home, b.possession === 0)}
+			</div>
+			<Tap b={b}>
+				<div
+					className="d-flex flex-column justify-content-center px-2"
+					style={{
+						borderLeft: "2px solid #c9a227",
+						color: "#ffffff",
